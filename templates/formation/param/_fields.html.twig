{# Macros de champ « façon ORéOF » pour les sections Paramètre de la formation. #}

{% macro divider(title) %}
    <div class="flex items-center gap-3 text-gray-400 my-6 first:mt-0">
        <div class="h-px flex-1 bg-gray-200"></div>
        <span class="text-sm">{{ title }}</span>
        <div class="h-px flex-1 bg-gray-200"></div>
    </div>
{% endmacro %}

{% macro label(text, required, help) %}
    <div class="flex items-start justify-between gap-3">
        <span class="fld-label">{{ text }}</span>
        {% if required %}<span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide shrink-0">{{ 'common.required_badge'|trans({}, 'common') }}</span>{% endif %}
    </div>
    {% if help %}<div class="fld-help">{{ ux_icon('ph:info', {class: 'icon'}) }} {{ help }}</div>{% endif %}
{% endmacro %}

{% macro text(name, value, placeholder, prefix, def) %}
    {% import _self as fld %}
    <input name="{{ prefix|default('p') }}[{{ name }}]" value="{{ value }}" placeholder="{{ placeholder|default('') }}" class="fld mt-1"{{ fld.lengthBounds(def|default(null)) }}>
{% endmacro %}

{# Bornes min/max d'un FieldDef texte = longueur en caractères (cf. éditeur de champ des types d'ELP). #}
{% macro lengthBounds(def) -%}
    {%- if def and def.min is not null %} minlength="{{ def.min|round }}"{% endif -%}
    {%- if def and def.max is not null %} maxlength="{{ def.max|round }}"{% endif -%}
{%- endmacro %}

{# options : liste simple de libellés (valeur = libellé). #}
{% macro select(name, value, options, placeholder, prefix) %}
    <select name="{{ prefix|default('p') }}[{{ name }}]" class="fld mt-1">
        <option value="">{{ placeholder|default('formation.fields.default_placeholder'|trans({}, 'formation')) }}</option>
        {% for opt in options %}
            <option value="{{ opt }}" {{ value == opt ? 'selected' }}>{{ opt }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{#
 Champ générique piloté par un FieldDef (constructeur de formulaire « Organisation »/
 « Présentation », cf. NodeTypeController) : rend le widget de son type (field_widget), lit sa
 valeur dans `data` (blob p[]), pose son libellé/aide/obligatoire via label().
 N'est JAMAIS appelé pour un champ verrouillé (def.locked) — ceux-là gardent leur
 markup dédié, écrit à la main, dans le gabarit appelant.
#}
{% macro field(key, def, data, errors, hint) %}
    {% import _self as fld %}
    {{ fld.label(def.label, def.required, def.help) }}
    {% if hint %}<div class="fld-help" style="color:#b45309">{{ ux_icon('ph:git-branch', {class: 'icon'}) }} {{ hint }}</div>{% endif %}
    {{ field_widget(def, key, data[key] ?? '', 'p[' ~ key ~ ']') }}
    {# erreurs du champ (règles de l'onglet, bornes) ; mises à jour en direct par autosave_controller #}
    <div class="fld-error" data-field-errors="{{ key }}">{% for m in errors|default([]) %}<div>⚠ {{ m }}</div>{% endfor %}</div>
{% endmacro %}

{% macro textarea(name, value, help, prefix, def) %}
    {% include 'field_type/_rich_textarea.html.twig' with {name: prefix|default('p') ~ '[' ~ name ~ ']', value: value, help: help, def: def|default(null)} only %}
{% endmacro %}
