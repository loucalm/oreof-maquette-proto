{% extends 'diplome/wizard/_layout.html.twig' %}
{% block step_content %}
<p class="text-sm mb-4 text-secondary-500">{{ 'diplome.wizard.depart.help'|trans({}, 'diplome') }}</p>
{{ form_start(form, {attr: {id: 'wizard-form', class: 'space-y-4'}}) }}
    {% include 'diplome/wizard/_field.html.twig' with {field: form.basedOnVersionId} %}
{{ form_end(form) }}
{% endblock %}
{% block step_next %}
    <button form="wizard-form" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</button>
{% endblock %}
