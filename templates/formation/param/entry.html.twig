{# Gabarit générique d'une entrée de fiche : les sections Formation et Parcours
   partagent la même structure ; les champs adossés à l'entité sont inclus depuis
   templates/formation/param/bound/. `sections` : un formulaire, ou deux pour une formation
   sans parcours dont le parcours unique a une entrée de même clé (remplie à la suite). #}
{% import 'formation/param/_fields.html.twig' as fld %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ statusKey|default(entryKey) }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ title }}</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ breadcrumb|join(' › ') }}</div>
    </div>

    <div class="panel-scroll">
    {% for section in sections %}
    <form method="post" action="{{ section.saveUrl }}" data-fiche="{{ section.fiche.fiche }}" data-turbo-frame="_top"
          data-controller="autosave" data-autosave-key-value="{{ statusKey|default(entryKey) }}"
          class="panel-card space-y-5{{ not loop.first ? ' mt-4' }}">

        <fieldset {{ preview_active(formation) ? 'disabled' }} class="space-y-5">
        {% for f in section.fields %}
            {% if f.type == 'separator' %}
                {{ fld.divider(f.label) }}
            {% elseif f.key in section.fiche.bound|keys %}
                <div>{% include 'formation/param/bound/' ~ section.fiche.fiche ~ '/' ~ f.key ~ '.html.twig' with {f: f, value: section.fiche.bound[f.key]} only %}</div>
            {% else %}
                <div>{{ fld.field(f.key, f, section.data, section.issues[f.key] ?? [], section.hints[f.key] ?? null) }}</div>
            {% endif %}
        {% endfor %}
        </fieldset>

        <div class="pt-2 border-t" style="border-color:var(--c-border)">
            <button data-autosave-target="submit" class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <span data-autosave-target="status" class="text-xs" style="color:var(--c-muted)" aria-live="polite"></span>
        </div>
    </form>
    {% endfor %}
    </div>
</div>
</turbo-frame>
