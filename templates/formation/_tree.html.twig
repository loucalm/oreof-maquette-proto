{# Arbre récursif façon maquette Figma. Params : views (list<NodeView>), parentId, focus #}
<ul class="tree-list {{ parentId is not null ? 'tree-children' : '' }}"
    data-tree-target="list" data-parent-id="{{ parentId ?? '' }}">
    {% for view in views %}
        {% set node = view.node %}
        {% set hasChildren = view.children is not empty %}
        {% set canHaveChildren = not node.formation.isLeafType(node.type.key) %}
        <li data-node-id="{{ node.id }}" data-node-type="{{ node.type.key }}">
            <div class="tree-row {{ focus and focus == node.id ~ '' ? 'is-active' }}">
                <span class="drag-handle" data-tree-target="handle" title="Glisser pour déplacer">⠿</span>
                <span class="status-dot" data-status="{{ view.status }}"
                      title="{{ view.status == 'ok' ? 'Complet' : (view.status == 'incomplete' ? 'Incomplet' : 'Vide') }}"></span>
                <span class="type-badge"><span class="opacity-70">{{ node.type.icon }}</span> [{{ node.type.label }}]</span>
                {% if view.ref %}<span class="tree-ref" title="Référence calculée">{{ view.ref }}</span>{% endif %}
                <a href="{{ node_url(node) }}" data-turbo-frame="node-panel"
                   class="tree-label" data-tree-target="link">{{ node.label ?: '—' }}</a>

                {% if view.ectsTarget %}
                    <span class="tree-ects {{ view.ectsReached ? 'text-green-600' : 'text-gray-400' }}">{{ view.totalEcts|round }}/{{ view.ectsTarget }}</span>
                {% endif %}

                {% if hasChildren %}
                    <button type="button" class="tree-chevron" data-action="tree#toggle" aria-label="Plier/déplier">›</button>
                {% else %}
                    <span class="tree-chevron-spacer"></span>
                {% endif %}
            </div>
            {% if hasChildren %}
                {{ include('formation/_tree.html.twig', {views: view.children, parentId: node.id, focus: focus}) }}
            {% elseif canHaveChildren %}
                {# nœud non-feuille encore vide : zone de dépôt pour le glisser-déposer #}
                <ul class="tree-list tree-children tree-list--empty"
                    data-tree-target="list" data-parent-id="{{ node.id }}"></ul>
            {% endif %}
        </li>
    {% endfor %}
</ul>
