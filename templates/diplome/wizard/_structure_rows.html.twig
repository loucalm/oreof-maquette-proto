{# Lignes des collections de l'étape Structure (aussi utilisées pour le prototype d'ajout). #}
{% set inputClass = 'w-full rounded-md border px-2 py-1 text-sm' %}

{% macro field(f, class = '') %}
    <div class="block {{ class }}">
        {{ form_label(f, null, {label_attr: {class: 'text-[11px] font-medium uppercase tracking-wide', style: 'color:var(--c-muted)'}}) }}
        {{ form_widget(f, {attr: {class: 'mt-0.5 w-full rounded-md border px-2 py-1 text-sm', style: 'border-color:var(--c-border)'}}) }}
        {{ form_help(f, {help_attr: {class: 'mt-0.5 text-[11px]', style: 'color:var(--c-muted)'}}) }}
        {{ form_errors(f) }}
    </div>
{% endmacro %}

{# Borne compacte : mode, puis un nombre (deux pour « entre », aucun pour « aucune »), cf. bound_controller.js #}
{% macro boundWidget(f) %}
    <div class="flex items-center gap-1" data-controller="bound">
        {{ form_widget(f.mode, {attr: {class: 'rounded-md border px-1.5 py-1 text-sm', style: 'border-color:var(--c-border)', 'data-bound-target': 'mode', 'data-action': 'bound#update'}}) }}
        {{ form_widget(f.value, {attr: {class: 'w-14 rounded-md border px-1.5 py-1 text-sm', style: 'border-color:var(--c-border)', 'data-bound-target': 'value'}}) }}
        <span class="text-xs" style="color:var(--c-muted)" data-bound-target="upper">–</span>
        {{ form_widget(f.upper, {attr: {class: 'w-14 rounded-md border px-1.5 py-1 text-sm', style: 'border-color:var(--c-border)', 'data-bound-target': 'upper'}}) }}
    </div>
    {{ form_errors(f) }}
{% endmacro %}

{% macro bound(f) %}
    {% import _self as m %}
    <div class="block">
        {{ form_label(f, null, {label_attr: {class: 'text-[11px] font-medium uppercase tracking-wide', style: 'color:var(--c-muted)'}}) }}
        <div class="mt-0.5">{{ m.boundWidget(f) }}</div>
    </div>
{% endmacro %}

{% macro controls() %}
    {% set btn = 'inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-100' %}
    <div class="flex shrink-0 items-center gap-0.5">
        <button type="button" data-action="collection#up" class="{{ btn }}" title="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}">{{ ux_icon('ph:arrow-up', {class: 'icon'}) }}</button>
        <button type="button" data-action="collection#down" class="{{ btn }}" title="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}">{{ ux_icon('ph:arrow-down', {class: 'icon'}) }}</button>
        <button type="button" data-action="collection#remove" class="{{ btn }}" style="color:#dc2626" title="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
    </div>
{% endmacro %}

{# Grille d'une ligne de niveau, partagée avec l'en-tête du tableau (structure.html.twig). #}
{% macro levelGrid() %}grid grid-cols-[minmax(10rem,1.4fr)_repeat(3,minmax(11rem,1fr))_4.5rem_auto] items-center gap-3{% endmacro %}

{#
 Bloc d'un niveau : sa ligne de bornes, puis les éléments imposés qui doivent exister DANS chacun de ses
 nœuds (ils sont du type du niveau suivant). Le dernier niveau n'en a pas. Cf. levels_controller.js.
 `child` : libellé du niveau suivant (null pour le dernier) ; `grandchild` : vrai si les éléments imposés
 ont eux-mêmes des enfants (surcharge du nombre d'enfants proposée).
#}
{% macro level(f, imposedRows = [], child = null, grandchild = false) %}
    {% import _self as m %}
    {% set btn = 'inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-100' %}
    <div data-level-block class="rounded-md border" style="border-color:var(--c-border)">
        <div data-level-row class="{{ m.levelGrid() }} px-3 py-2">
            {{ form_widget(f.position) }}
            <div>
                {{ form_widget(f.typeKey, {attr: {class: 'w-full rounded-md border px-2 py-1 text-sm', style: 'border-color:var(--c-border)', 'aria-label': f.typeKey.vars.label|trans({}, 'diplome'), 'data-level-type': '', 'data-action': 'levels#syncType'}}) }}
                {{ form_errors(f.typeKey) }}
            </div>
            {{ m.boundWidget(f.count) }}
            {{ m.boundWidget(f.ects) }}
            {{ m.boundWidget(f.ectsSum) }}
            <div>
                {{ form_widget(f.startAt, {attr: {class: 'w-full rounded-md border px-2 py-1 text-sm', style: 'border-color:var(--c-border)', 'aria-label': f.startAt.vars.label|trans({}, 'diplome')}}) }}
                {{ form_errors(f.startAt) }}
            </div>
            <div class="flex shrink-0 items-center gap-0.5">
                <button type="button" data-action="levels#toggleImposed" data-imposed-toggle {{ child is null and imposedRows is empty ? 'hidden' }} class="inline-flex h-7 items-center gap-1 rounded px-1.5 text-xs hover:bg-gray-100" title="{{ 'diplome.wizard.structure.imposed_toggle'|trans({}, 'diplome') }}">{{ ux_icon('ph:push-pin', {class: 'icon'}) }}<span data-imposed-count>{{ imposedRows|length }}</span></button>
                <button type="button" data-action="levels#up" class="{{ btn }}" title="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}">{{ ux_icon('ph:arrow-up', {class: 'icon'}) }}</button>
                <button type="button" data-action="levels#down" class="{{ btn }}" title="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}">{{ ux_icon('ph:arrow-down', {class: 'icon'}) }}</button>
                <button type="button" data-action="levels#removeLevel" class="{{ btn }}" style="color:#dc2626" title="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
            </div>
        </div>
        {# toujours rendu (masqué) : un déplacement peut donner un niveau suivant au dernier #}
        <div data-imposed-panel class="border-t px-3 py-2 space-y-2" style="border-color:var(--c-border);background:#f8f9fb" {{ imposedRows is empty ? 'hidden' }}>
            <div class="text-[11px] font-medium uppercase tracking-wide" style="color:var(--c-muted)">{{ 'diplome.wizard.structure.imposed_in_level'|trans({}, 'diplome') }} <span data-imposed-child-label class="normal-case">{{ child }}</span></div>
            <div data-imposed-list class="space-y-2">
                {% for r in imposedRows %}{{ m.imposed(r, grandchild) }}{% endfor %}
            </div>
            <button type="button" data-action="levels#addImposed" class="inline-flex items-center gap-1 rounded-md border bg-white px-2.5 py-1 text-xs hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'diplome.wizard.structure.add_imposed'|trans({}, 'diplome') }}</button>
        </div>
    </div>
{% endmacro %}

{# Élément imposé : son type est celui du niveau suivant celui qui le contient (champ caché, recopié par levels_controller.js) #}
{% macro imposed(f, grandchild = true) %}
    {% import _self as m %}
    <div data-imposed-row class="rounded-md border bg-white px-3 py-2" style="border-color:var(--c-border)">
        {{ form_widget(f.uid) }}
        <input type="hidden" name="{{ f.typeKey.vars.full_name }}" value="{{ f.typeKey.vars.value }}" data-imposed-type>
        {% do f.typeKey.setRendered %}
        <div class="flex items-start gap-3">
            <div class="flex-1 grid grid-cols-2 gap-x-3 gap-y-2 md:grid-cols-[1.6fr_9rem_8rem_auto]">
                {{ m.field(f.label) }}
                {{ m.field(f.position) }}
                {{ m.field(f.nature) }}
                <div data-imposed-children {{ not grandchild ? 'hidden' }}>{{ m.bound(f.countOverride) }}</div>
                <div class="col-span-2 md:col-span-4">
                    {{ form_label(f.locked, null, {label_attr: {class: 'text-[11px] font-medium uppercase tracking-wide', style: 'color:var(--c-muted)'}}) }}
                    <div class="mt-1 text-sm [&_input]:mr-1 [&_label]:mr-4 [&_label]:inline-flex">{{ form_widget(f.locked) }}</div>
                </div>
            </div>
            {{ form_errors(f.typeKey) }}
            <button type="button" data-action="levels#removeImposed" class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded hover:bg-gray-100" style="color:#dc2626" title="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
        </div>
    </div>
{% endmacro %}

{% macro rule(f) %}
    {% import _self as m %}
    <div data-collection-row data-rule-row data-controller="rule-params" class="rounded-md border px-3 py-2" style="border-color:var(--c-border)">
        {{ form_widget(f.uid) }}
        <div class="flex items-start gap-3">
            <div class="flex-1 space-y-2">
                <div class="grid grid-cols-[1.6fr_1fr_1fr] gap-3">
                    {{ m.field(f.template) }}
                    {{ m.field(f.scopeLevel) }}
                    {{ m.field(f.severity) }}
                </div>
                {% for group in f %}{% if group.vars.name starts with 'params_' %}
                    <div data-rule-params-target="group" data-template="{{ group.vars.name|slice(7) }}" class="grid grid-cols-2 gap-3 md:grid-cols-4">
                        {% for param in group %}
                            {{ m.field(param) }}
                        {% endfor %}
                    </div>
                {% endif %}{% endfor %}
            </div>
            {{ m.controls() }}
        </div>
    </div>
{% endmacro %}
