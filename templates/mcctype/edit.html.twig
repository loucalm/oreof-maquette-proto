{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'mcctype.edit.new_title'|trans({}, 'mcctype') : type.label }}{% endblock %}

{% block body %}
<div class="max-w-3xl">
    <div class="text-xs" style="color:var(--c-muted)">
        <a href="{{ path('admin_mcctypes') }}" class="hover:underline">{{ 'mcctype.index.heading'|trans({}, 'mcctype') }}</a> › {{ isNew ? 'mcctype.edit.breadcrumb_new'|trans({}, 'mcctype') : type.label }}
    </div>
    <h1 class="text-xl font-bold mt-1 mb-5">{{ isNew ? 'mcctype.edit.new_heading'|trans({}, 'mcctype') : 'mcctype.edit.edit_heading'|trans({'%label%': type.label}, 'mcctype') }}</h1>

    <form method="post" class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="grid grid-cols-3 gap-3">
            <label class="block">
                <span class="text-xs font-medium">{{ 'mcctype.edit.short_label_field'|trans({}, 'mcctype') }}</span>
                <input name="shortLabel" required value="{{ type.shortLabel ?? '' }}" placeholder="CCI" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'mcctype.edit.label_field'|trans({}, 'mcctype') }}</span>
                <input name="label" required value="{{ type.label ?? '' }}" placeholder="Contrôle continu intégral" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <label class="block">
                <span class="text-xs font-medium">{{ 'mcctype.edit.key_field'|trans({}, 'mcctype') }}</span>
                <input name="key" value="{{ type.key ?? '' }}" placeholder="{{ 'mcctype.edit.key_placeholder'|trans({}, 'mcctype') }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'mcctype.edit.description_field'|trans({}, 'mcctype') }}</span>
                <input name="description" value="{{ type.description ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <div class="rounded-lg border p-3" style="border-color:var(--c-border)">
            <label class="flex items-center gap-2 text-sm font-medium">
                <input type="checkbox" name="hasEvaluations" value="1" {{ (type.hasEvaluations ?? false) ? 'checked' }}>
                {{ 'mcctype.edit.has_evaluations_label'|trans({}, 'mcctype') }}
            </label>
            <label class="block mt-2">
                <span class="text-xs font-medium">{{ 'mcctype.edit.evaluations_label_field'|trans({}, 'mcctype') }}</span>
                <input name="evaluationsLabel" value="{{ type.evaluationsLabel ?? 'Épreuves' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <label class="block max-w-[140px]">
            <span class="text-xs font-medium">{{ 'mcctype.edit.order_field'|trans({}, 'mcctype') }}</span>
            <input type="number" name="position" value="{{ type.position ?? 100 }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
        </label>

        <div class="flex gap-2 pt-1">
            <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <a href="{{ path('admin_mcctypes') }}" class="rounded-md border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</a>
        </div>
    </form>

    {% if not isNew %}
        <div class="rounded-xl border bg-white p-5 mt-4" style="border-color:var(--c-border)">
            <div class="flex items-start justify-between mb-3">
                <div>
                    <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'mcctype.edit.profiles_title'|trans({}, 'mcctype') }}</div>
                    <p class="text-xs mt-1" style="color:var(--c-muted)">{{ 'mcctype.edit.profiles_description'|trans({}, 'mcctype') }}</p>
                </div>
            </div>

            {% if type.profiles is empty %}
                <p class="text-sm mb-3" style="color:var(--c-muted)">{{ 'mcctype.edit.profiles_empty'|trans({}, 'mcctype') }}</p>
            {% else %}
                <div class="space-y-3 mb-4">
                    {% for profile in type.profiles %}
                        <div class="rounded-lg border p-3" style="border-color:var(--c-border)">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <span class="font-semibold text-sm">{{ profile.label }}</span>
                                    {% if profile.description %}<div class="fld-help mt-0.5">{{ profile.description }}</div>{% endif %}
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <form method="post" action="{{ path('mcctype_profile_duplicate', {id: type.id, profileKey: profile.key}) }}">
                                        <button class="text-xs hover:underline" style="color:var(--c-muted)">{{ 'mcctype.edit.duplicate_profile_button'|trans({}, 'mcctype') }}</button>
                                    </form>
                                    <form method="post" action="{{ path('mcctype_profile_delete', {id: type.id, profileKey: profile.key}) }}"
                                          data-controller="confirm" data-confirm-message-value="{{ 'mcctype.edit.delete_profile_confirm'|trans({'%label%': profile.label}, 'mcctype') }}">
                                        <button class="text-xs text-red-600 hover:underline">{{ 'common.delete'|trans({}, 'common') }}</button>
                                    </form>
                                </div>
                            </div>

                            {% set cs = clauseStates[profile.key] %}
                            <form method="post" action="{{ path('mcctype_profile_clauses', {id: type.id, profileKey: profile.key}) }}" class="rounded-lg border p-3 space-y-3 mt-3" style="border-color:var(--c-border);background:#f8f9fb">
                                <label class="flex flex-wrap items-center gap-2 text-sm">
                                    <input type="checkbox" name="count_on" value="1" {{ cs.count.on ? 'checked' }}>
                                    <span class="font-medium">{{ 'mcctype.edit.clause_count_label'|trans({}, 'mcctype') }}</span>
                                    <select name="count_op" class="rounded-md border px-2 py-1 text-xs" style="border-color:var(--c-border)">
                                        {% for k, l in ruleOps %}<option value="{{ k }}" {{ cs.count.op == k ? 'selected' }}>{{ l }}</option>{% endfor %}
                                    </select>
                                    <input type="number" step="1" min="0" name="count_value" value="{{ cs.count.value }}" class="w-20 rounded-md border px-2 py-1 text-xs" style="border-color:var(--c-border)">
                                </label>

                                <label class="flex flex-wrap items-center gap-2 text-sm">
                                    <input type="checkbox" name="ponderation_on" value="1" {{ cs.ponderation.on ? 'checked' }}>
                                    <span class="font-medium">{{ 'mcctype.edit.clause_ponderation_label'|trans({}, 'mcctype') }}</span>
                                    <span class="text-xs" style="color:var(--c-muted)">{{ 'mcctype.edit.clause_ponderation_sum_note'|trans({}, 'mcctype') }}</span>
                                </label>
                                <label class="ml-6 flex flex-wrap items-center gap-2 text-sm">
                                    <input type="checkbox" name="ponderation_egale" value="1" {{ cs.ponderation.egale ? 'checked' }}>
                                    <span>{{ 'mcctype.edit.clause_ponderation_egale_label'|trans({}, 'mcctype') }}</span>
                                    <input type="number" step="0.1" min="0" name="ponderation_max" value="{{ cs.ponderation.max }}" class="w-20 rounded-md border px-2 py-1 text-xs" style="border-color:var(--c-border)">
                                    <span class="text-xs" style="color:var(--c-muted)">%</span>
                                </label>

                                <label class="flex items-center gap-2 text-sm">
                                    <input type="checkbox" name="duree_on" value="1" {{ cs.duree.on ? 'checked' }}>
                                    <span class="font-medium">{{ 'mcctype.edit.clause_duree_label'|trans({}, 'mcctype') }}</span>
                                </label>

                                <label class="flex items-center gap-2 text-sm">
                                    <input type="checkbox" name="rattrapage_on" value="1" {{ cs.rattrapage ? 'checked' }}>
                                    <span class="font-medium">{{ 'mcctype.edit.clause_rattrapage_label'|trans({}, 'mcctype') }}</span>
                                </label>
                                <p class="text-[11px]" style="color:var(--c-muted)">{{ 'mcctype.edit.clause_rattrapage_help'|trans({}, 'mcctype') }}</p>

                                <button class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.save'|trans({}, 'common') }}</button>
                            </form>

                            {% if profile.rules is not empty %}
                                <div class="flex flex-wrap gap-1.5 mt-2">
                                    {% for r in profile.rules %}<span class="rounded-md border px-2 py-0.5 text-xs" style="border-color:var(--c-border)">{{ r.label }}</span>{% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="post" action="{{ path('mcctype_profile_add', {id: type.id}) }}" class="rounded-lg border border-dashed p-3 flex flex-wrap items-end gap-2" style="border-color:var(--c-border)">
                <label class="block flex-1 min-w-[160px]">
                    <span class="text-xs">{{ 'mcctype.edit.profile_label_field'|trans({}, 'mcctype') }}</span>
                    <input name="label" required placeholder="Licence" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                </label>
                <label class="block flex-1 min-w-[200px]">
                    <span class="text-xs">{{ 'mcctype.edit.profile_description_field'|trans({}, 'mcctype') }}</span>
                    <input name="description" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                </label>
                <button class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'mcctype.edit.add_profile_button'|trans({}, 'mcctype') }}</button>
            </form>
            <p class="text-xs mt-2" style="color:var(--c-muted)">
                {{ 'mcctype.edit.rules_help'|trans({}, 'mcctype') }}
            </p>
        </div>
    {% endif %}
</div>
{% endblock %}
