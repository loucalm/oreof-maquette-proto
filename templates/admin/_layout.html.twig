{# Coquille commune de l'administration : en-tête de page v2 + onglets de navigation.
   Chaque page d'admin fait {% set adminSection = '<clé>' %} puis remplit
   {% block admin_body %}. #}
{% extends 'base.html.twig' %}

{% set _sections = constant('App\\Controller\\AdminController::SECTIONS') %}
{% set adminSection = adminSection ?? 'overview' %}
{% set header_title = 'admin.layout.title'|trans({}, 'admin') %}
{% set header_description = 'admin.layout.description'|trans({}, 'admin') %}
{% set header_breadcrumb = adminSection == 'overview'
    ? [{label: 'admin.layout.kicker'|trans({}, 'admin')}]
    : [{label: 'admin.layout.kicker'|trans({}, 'admin'), url: path('admin_index')}, {label: _sections[adminSection].label}] %}

{% block body %}
<nav class="app-tabs-list mb-6" aria-label="{{ 'admin.layout.kicker'|trans({}, 'admin') }}">
    {% for key, s in _sections %}
        {% set active = key == adminSection %}
        <a href="{{ path(s.route) }}" class="app-tab {{ active ? 'app-tab-active' }}" {{ active ? 'aria-current="page"' }}>
            {{ ux_icon(s.icon, {class: 'h-4 w-4'}) }} {{ s.label }}
            {% if key == 'derogations' and pending_derogations() > 0 %}<span class="count-badge" title="{{ 'derogation.index.pending_badge_title'|trans({}, 'derogation') }}">{{ pending_derogations() }}</span>{% endif %}
        </a>
    {% endfor %}
</nav>

{# Les petites actions in-place (renommer/déplacer/verrouiller/supprimer une ligne…) restent dans ce
   cadre : pas de rechargement de page, la position de scroll est conservée. Une vraie navigation vers
   une autre page (retour à la liste, nouvelle fiche…) doit porter data-turbo-frame="_top" pour en sortir. #}
<turbo-frame id="admin-content">
<section class="{{ adminSection != 'overview' ? 'rounded-xl border border-secondary-200 bg-surface p-6 shadow-sm' }}">
{% block admin_body %}{% endblock %}
</section>
</turbo-frame>
{% endblock %}
