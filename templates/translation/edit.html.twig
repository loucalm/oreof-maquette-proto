{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'traductions' %}
{% block title %}Traductions — {{ filename }}{% endblock %}

{% block admin_body %}
<div class="-mx-6 -mt-6 mb-6 flex items-start justify-between gap-4 border-b border-secondary-200 px-6 py-4">
    <div>
        <h2 class="flex items-center gap-2 text-lg font-semibold text-text">{{ ux_icon('ph:translate', {class: 'h-5 w-5 text-primary'}) }} Fichier : {{ filename }}</h2>
        <p class="mt-1 text-sm text-secondary">
            Cliquez sur « Modifier » sur une ligne pour éditer sa valeur, « Enregistrer » sauvegarde
            immédiatement sans recharger la page.
        </p>
    </div>
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" label="Tous les fichiers" :href="path('admin_traductions')"/>
</div>

<div class="rounded-xl border bg-white overflow-hidden border-secondary-200"
     data-controller="translation"
     data-translation-save-url-value="{{ path('admin_traductions_save_one', {filename: filename}) }}"
     data-translation-delete-url-value="{{ path('admin_traductions_delete_one', {filename: filename}) }}">
    <div class="flex justify-end px-4 py-3 border-b border-secondary-200">
        <button type="button" data-action="translation#addRow" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ ux_icon('ph:plus', {class: 'icon'}) }} Ajouter une clé</button>
    </div>
    <table class="w-full text-sm">
        <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600">
            <tr class="border-b border-secondary-200">
                <th class="text-left px-4 py-2.5 w-2/5">Clé</th>
                <th class="text-left px-4 py-2.5">Valeur</th>
                <th class="px-4 py-2.5 w-40"></th>
            </tr>
        </thead>
        <tbody data-translation-target="tbody">
        {% for key, value in translations %}
            <tr class="border-b border-secondary-200 last:border-0 hover:bg-secondary-50/50"
                data-translation-key="{{ key }}" data-original-value="{{ value|e('html_attr') }}" data-is-new="false">
                <td class="px-4 py-2.5 align-top">
                    <span data-role="key-display" class="font-mono text-xs select-all text-secondary-500">{{ key }}</span>
                </td>
                <td class="px-4 py-2.5 align-top">
                    <span data-role="value-display" class="text-sm whitespace-pre-wrap">{{ value }}</span>
                    <input data-role="value-input" type="text" value="{{ value|e('html_attr') }}" hidden class="fld text-sm" aria-label="Valeur pour la clé {{ key }}" />
                    <p data-role="error" hidden class="text-xs text-danger-600 mt-1"></p>
                </td>
                <td class="px-4 py-2.5 align-top text-right whitespace-nowrap">
                    <div data-role="view-actions">
                        <button type="button" data-action="translation#edit" class="text-xs hover:underline">Modifier</button>
                        <button type="button" data-action="translation#remove" class="text-xs text-danger-600 hover:underline ml-2">Suppr.</button>
                    </div>
                    <div data-role="edit-actions" hidden>
                        <button type="button" data-role="save-btn" data-action="translation#save" class="text-xs text-success-700 hover:underline">Enregistrer</button>
                        <button type="button" data-action="translation#cancel" class="text-xs hover:underline ml-2 text-secondary-500">Annuler</button>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="px-4 py-8 text-center text-sm text-secondary-500">Aucune traduction dans ce fichier.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
