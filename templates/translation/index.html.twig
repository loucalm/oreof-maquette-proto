{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'traductions' %}
{% block title %}Traductions{% endblock %}

{% block admin_body %}
<div class="-mx-6 -mt-6 mb-6 border-b border-secondary-200 px-6 py-4">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-text">{{ ux_icon(_sections[adminSection].icon, {class: 'h-5 w-5 text-primary'}) }} Traductions</h2>
    <p class="mt-1 text-sm text-secondary">
        Chaque texte affiché dans l'application est associé à une clé de traduction, modifiable ici sans
        toucher au code. Un fichier par domaine (formation, nœud, administration…).
    </p>
</div>

<div class="rounded-xl border bg-white p-4 mb-6 border-secondary-200"
     data-controller="translation-recherche"
     data-translation-recherche-url-value="{{ path('admin_traductions_recherche') }}">
    <label class="fld-label">Rechercher une clé ou un texte</label>
    <input type="text" placeholder="Au moins 3 caractères…" class="fld mt-1"
           data-translation-recherche-target="search"
           data-action="input->translation-recherche#recherche" />
    <div class="mt-3" data-translation-recherche-target="resultats"></div>
</div>

<div class="rounded-xl border bg-white overflow-hidden border-secondary-200">
    <table class="w-full text-sm">
        <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600">
            <tr class="border-b border-secondary-200">
                <th class="text-left px-4 py-2.5">Domaine</th>
                <th class="text-left px-4 py-2.5">Fichier</th>
                <th class="px-4 py-2.5"></th>
            </tr>
        </thead>
        <tbody>
        {% for file in files %}
            <tr class="border-b border-secondary-200 last:border-0 hover:bg-secondary-50/50">
                <td class="px-4 py-2.5 font-medium">{{ file.filename|split('.')|first }}</td>
                <td class="px-4 py-2.5 text-secondary-500">{{ file.filename }}</td>
                <td class="px-4 py-2.5 text-right">
                    <a href="{{ path('admin_traductions_edit', {filename: file.filename}) }}" class="text-xs hover:underline">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="px-4 py-8 text-center text-sm text-secondary-500">Aucun fichier de traduction dans `translations/`.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
