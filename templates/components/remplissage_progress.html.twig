{# Barre de remplissage (reprise d'ORéOF v2) : <twig:remplissage_progress label="Progression" percent="45" tone="info" /> #}
{% props label = '', percent = 0, tone = 'info' %}
<div {{ attributes.defaults({class: 'app-progress'}) }}>
    <div class="app-progress-header">
        <span class="app-progress-label">{{ label }}</span>
        <span class="app-progress-value">{{ percent }}%</span>
    </div>
    <div class="app-progress-track app-progress-track--{{ tone }}" role="progressbar" aria-label="{{ label }}"
         aria-valuenow="{{ percent }}" aria-valuemin="0" aria-valuemax="100">
        <span class="app-progress-bar app-progress-bar--{{ tone }}" style="width: {{ percent }}%;"></span>
    </div>
</div>
