{% extends wizard_layout|default('diplome/wizard/_layout.html.twig') %}

{% macro tree(nodes) %}
    <ul class="tree-list">
        {% for n in nodes %}
            <li data-node-type="{{ n.typeKey }}">
                <div class="tree-row"><span class="text-sm">{{ n.displayLabel }}</span> <span class="text-xs" style="color:var(--c-muted)">({{ n.typeKey }})</span></div>
                {% if n.children %}<div class="tree-children">{{ _self.tree(n.children) }}</div>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block step_content %}
{% import 'diplome/wizard/_structure_rows.html.twig' as rows %}
<p class="text-sm mb-4" style="color:var(--c-muted)">{{ 'diplome.wizard.structure.help'|trans({}, 'diplome') }}</p>
{{ form_start(form, {attr: {id: 'wizard-form', class: 'space-y-6'}}) }}
    {{ form_errors(form) }}

    {% set card = 'rounded-lg border p-4' %}
    <fieldset class="{{ card }} grid gap-4 md:grid-cols-[auto_auto_1fr] md:items-end" style="border-color:var(--c-border)">
        {{ rows.field(form.duration.levelKey) }}
        {{ rows.bound(form.duration.bound) }}
        <label class="flex items-center gap-2 text-sm md:pb-1.5">{{ form_widget(form.parcoursAllowed) }} {{ form_label(form.parcoursAllowed) }}</label>
        {{ rows.field(form.natures) }}
    </fieldset>

    {# Niveaux de la chaîne, chacun avec ses éléments imposés #}
    {% set imposedIndex = form.imposed|keys|reduce((max, k) => k >= max ? k + 1 : max, 0) %}
    <section class="{{ card }}" style="border-color:var(--c-border)" data-section="level" data-controller="levels"
             data-levels-level-prototype-value="{{ rows.level(form.levels.vars.prototype)|e('html_attr') }}"
             data-levels-level-index-value="{{ form.levels|keys|reduce((max, k) => k >= max ? k + 1 : max, 0) }}"
             data-levels-imposed-prototype-value="{{ rows.imposed(form.imposed.vars.prototype)|e('html_attr') }}"
             data-levels-imposed-index-value="{{ imposedIndex }}">
        <div class="mb-3 flex items-start justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold">{{ form_label(form.levels) }}</h3>
                <p class="text-xs" style="color:var(--c-muted)">{{ 'diplome.wizard.structure.level_section_help'|trans({}, 'diplome') }}</p>
            </div>
            <button type="button" data-action="levels#addLevel" class="inline-flex shrink-0 items-center gap-1 rounded-md border px-3 py-1.5 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'diplome.wizard.structure.add_level'|trans({}, 'diplome') }}</button>
        </div>
        {{ form_errors(form.levels) }}
        {{ form_errors(form.imposed) }}
        <div class="{{ rows.levelGrid() }} px-3 pb-1 text-[11px] font-medium uppercase tracking-wide" style="color:var(--c-muted)">
            <span>{{ 'diplome.wizard.structure.level_type'|trans({}, 'diplome') }}</span>
            <span>{{ 'diplome.wizard.structure.level_count'|trans({}, 'diplome') }}</span>
            <span>{{ 'diplome.wizard.structure.level_ects'|trans({}, 'diplome') }}</span>
            <span>{{ 'diplome.wizard.structure.level_ects_sum'|trans({}, 'diplome') }}</span>
            <span title="{{ 'diplome.wizard.structure.level_start_at'|trans({}, 'diplome') }}">{{ 'diplome.wizard.structure.level_start_at_short'|trans({}, 'diplome') }}</span>
            <span title="{{ 'diplome.wizard.structure.imposed_pin'|trans({}, 'diplome') }}">{{ ux_icon('ph:push-pin', {class: 'icon'}) }}</span>
        </div>
        {# la punaise d'un niveau rend ce niveau imposé : ses éléments imposés sont sous sa ligne #}
        {% set levelViews = form.levels.children|filter(l => true)|merge([]) %}
        {% set levelTypes = levelViews|map(l => l.typeKey.vars.value) %}
        <div data-levels-target="list" class="space-y-2">
            {% for lv in levelViews %}
                {% set prev = loop.index0 > 0 ? levelViews[loop.index0 - 1] : null %}
                {% set parentLabel = null %}
                {% if prev %}{% for c in prev.typeKey.vars.choices %}{% if c.value == prev.typeKey.vars.value %}{% set parentLabel = c.label %}{% endif %}{% endfor %}{% endif %}
                {{ rows.level(lv, form.imposed.children|filter(r => r.typeKey.vars.value == lv.typeKey.vars.value), parentLabel, (levelViews[loop.index] ?? null) is not null) }}
            {% endfor %}
        </div>
        {# éléments imposés dont le type n'a pas de niveau parent dans la chaîne : à rattacher ou retirer #}
        {% set orphans = form.imposed.children|filter(r => r.typeKey.vars.value not in levelTypes|slice(1)) %}
        {% if orphans is not empty %}
            <div data-level-block class="mt-3 rounded-md border p-3 space-y-2" style="border-color:#fcd34d;background:#fffbeb">
                <div class="text-xs" style="color:#92400e">{{ 'diplome.wizard.structure.imposed_orphans'|trans({}, 'diplome') }}</div>
                <div data-imposed-list class="space-y-2">{% for r in orphans %}{{ rows.imposed(r) }}{% endfor %}</div>
            </div>
        {% endif %}
        {% do form.imposed.setRendered %}
    </section>

    {% set proto = rows.rule(form.rules.vars.prototype) %}
    <section class="{{ card }}" style="border-color:var(--c-border)" data-controller="collection" data-collection-prototype-value="{{ proto|e('html_attr') }}" data-collection-index-value="{{ form.rules|keys|reduce((max, k) => k >= max ? k + 1 : max, 0) }}" data-section="rule">
        <div class="mb-3 flex items-start justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold">{{ form_label(form.rules) }}</h3>
                <p class="text-xs" style="color:var(--c-muted)">{{ 'diplome.wizard.structure.rule_section_help'|trans({}, 'diplome') }}</p>
            </div>
            <button type="button" data-action="collection#add" class="inline-flex shrink-0 items-center gap-1 rounded-md border px-3 py-1.5 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'diplome.wizard.structure.add_rule'|trans({}, 'diplome') }}</button>
        </div>
        {{ form_errors(form.rules) }}
        <div data-collection-target="list" class="space-y-2">
            {% for row in form.rules %}{{ rows.rule(row) }}{% endfor %}
        </div>
    </section>
    {{ form_rest(form) }}
{{ form_end(form, {render_rest: false}) }}

<section data-preview class="mt-6 rounded-lg border p-4" style="border-color:var(--c-border);background:#f8f9fb">
    <h3 class="text-sm font-semibold mb-1">{{ 'diplome.wizard.structure.preview'|trans({}, 'diplome') }}</h3>
    <p class="text-xs mb-3" style="color:var(--c-muted)">{{ 'diplome.wizard.structure.preview_help'|trans({}, 'diplome') }}</p>
    {% if previewError %}
        <p class="text-sm" style="color:var(--c-danger, #b91c1c)" data-preview-error>{{ previewError }}</p>
    {% else %}
        {{ _self.tree(preview) }}
    {% endif %}
</section>
{% endblock %}
{% block step_next %}
    <button form="wizard-form" class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</button>
{% endblock %}
