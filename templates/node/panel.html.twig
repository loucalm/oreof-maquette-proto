{# Panneau d'édition d'un nœud — façon maquette Figma. Rendu dans <turbo-frame id="node-panel">. #}
{% import _self as ui %}
{% set caps = node.effectiveCapabilities() %}
{% set formation = node.formation %}
{% set childTypes = types_allowed_for(node) %}
{% set T = node.type.label %}

{% set hasHours = caps.hours ?? false %}
{% set hasMccc = caps.mccc ?? false %}

<turbo-frame id="node-panel">
<div class="panel-body" data-controller="tabs modal" data-panel-active="node:{{ node.id }}">

    <div class="panel-head">
        <h2 class="text-xl font-bold">Gestion de la structure</h2>
        <div class="text-sm text-gray-400">{{ T }}</div>
        <div class="text-sm text-gray-400 mt-1">
            {{ formation.name }}
            {%- for p in node_path(node) %} › {{ p.label ?: p.type.label }}{% endfor -%}
        </div>
    </div>

    <div class="panel-scroll">
    <div class="panel-card space-y-5">

    {# onglets présents sur ce nœud (déduits des champs actifs) #}
    {% set nodeTabs = ['props'] %}
    {% for key, def in catalog %}
        {% if (caps[key] ?? false) and def.domain not in nodeTabs %}
            {% set nodeTabs = nodeTabs|merge([def.domain]) %}
        {% endif %}
    {% endfor %}
    <div class="flex flex-wrap gap-2">
        {% for tk in nodeTabs %}
            <button type="button" data-tabs-target="tab" data-tab="{{ tk }}" class="tab-pill">
                <span class="status-dot" data-status="{{ node_tab_status(node, tk) }}"></span>
                {{ domains[tk] ?? tk }}
            </button>
        {% endfor %}
    </div>

    {# tuiles + actions #}
    <div class="flex flex-wrap items-stretch gap-2">
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="text-gray-500">Total heures :</span> <span class="font-semibold">{{ view.totalHours|round }}</span>
        </div>
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="font-semibold">{{ view.totalEcts|round }}</span>
            <span class="text-gray-500">{% if view.ectsTarget %}/ {{ view.ectsTarget }} {% endif %}ECTS</span>
        </div>
        <div class="ml-auto flex flex-wrap gap-2">
            {% if caps.mutualisable ?? false %}
            <form method="post" action="{{ path('node_mutualize', {id: node.id}) }}" data-turbo-frame="_top">
                <button class="rounded-lg border px-3 py-2 text-sm" style="border-color:#fcd34d;color:#b45309">
                    ⬆ {{ node.mutualized ? 'Ne plus mutualiser' : 'Mutualiser' }} [{{ T }}]
                </button>
            </form>
            {% endif %}
            {% if childTypes is not empty %}
            <a href="{{ path('node_attach_index', {id: node.id}) }}" data-turbo-frame="node-panel"
               class="rounded-lg border px-3 py-2 text-sm text-green-700" style="border-color:#bbf7d0">↳ Raccrocher</a>
            {% endif %}
            <button type="button" data-action="modal#open" class="rounded-lg border px-3 py-2 text-sm text-gray-600" style="border-color:var(--c-border)">⚙ Paramètre du nœud [{{ T }}]</button>
        </div>
    </div>

    {# ── formulaire ── #}
    <form method="post" action="{{ path('node_save', {id: node.id}) }}" data-turbo-frame="_top" class="space-y-5">

        {% for tk in nodeTabs %}
        <div data-tabs-target="panel" data-tab="{{ tk }}" class="space-y-5" {{ not loop.first ? 'hidden' }}>

            {# séparateur : nom de l'onglet actif #}
            <div class="flex items-center gap-3 text-gray-300 text-xs uppercase tracking-widest">
                <div class="h-px flex-1 bg-gray-200"></div>{{ domains[tk] ?? tk }}<div class="h-px flex-1 bg-gray-200"></div>
            </div>

            {% if tk == 'props' %}
                {% set parents = valid_parents(node) %}
                {{ ui.label("Nœud parent", true, "Emplacement autorisé par le squelette de la formation") }}
                <select name="parentId" class="fld">
                    {% if can_be_root(node) %}<option value="">— Racine de la formation —</option>{% endif %}
                    {% for cand in parents %}
                        <option value="{{ cand.id }}" {{ node.parent and node.parent.id == cand.id ? 'selected' }}>
                            [{{ cand.type.label }}] {{ cand.label ?: '—' }}
                        </option>
                    {% endfor %}
                </select>
                {% if parents is empty and not can_be_root(node) %}
                    <div class="fld-help text-amber-600">Aucun emplacement : le squelette ne prévoit pas ce type sous un autre nœud.</div>
                {% endif %}

                {{ ui.label("Libellé", true, "Max 200 caractères") }}
                <input name="label" value="{{ node.label }}" maxlength="200" class="fld">

                {% if caps.code ?? false %}
                    {% set isEc = node.type.key == 'ec' %}
                    {{ ui.label(isEc ? "Précisez le code de l'EC" : 'Code', isEc, isEc ? "Code de l'EC" : "Code du nœud (ex. code de l'EC)") }}
                    <input name="code" value="{{ node.code }}" class="fld">
                {% endif %}
            {% endif %}

            {# champs du catalogue pour cet onglet, groupés par catégorie #}
            {% set curCat = '__init__' %}
            {% for key, def in catalog %}
                {% if def.domain == tk and (caps[key] ?? false) %}
                    {% if (def.category ?? null) != curCat %}
                        {% set curCat = def.category ?? null %}
                        {% if curCat %}<div class="fld-cat">{{ curCat }}</div>{% endif %}
                    {% endif %}
                    {{ ui.field(key, def, node) }}
                {% endif %}
            {% endfor %}

            {% if tk == 'props' and node.isParcours %}
                {% set pcands = parcours_candidates(node) %}
                {% set unit = period_unit(formation) %}
                <div class="rounded-lg border p-3 space-y-3" style="border-color:var(--c-border);background:#f8f9fb">
                    <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Arborescence des parcours · axe : {{ unit|lower }}</div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            {{ ui.label(unit ~ " de début", false) }}
                            <input type="number" min="1" name="attr_periodeDebut" value="{{ node.getAttribute('periodeDebut') }}" placeholder="{{ node.periodeDebut }}" class="fld">
                        </div>
                        <div>
                            {{ ui.label(unit ~ " de fin", false) }}
                            <input type="number" min="1" name="attr_periodeFin" value="{{ node.getAttribute('periodeFin') }}" placeholder="{{ node.periodeFin }}" class="fld">
                        </div>
                    </div>
                    {{ ui.label("Parcours parent", false, "Une spécialisation qui se sépare d’un autre parcours : elle commence après lui et se prolonge au moins jusqu’à sa fin.") }}
                    <select name="parcoursParentId" class="fld">
                        <option value="">— Aucun (parcours racine) —</option>
                        {% for cand in pcands %}
                            <option value="{{ cand.id }}" {{ node.parcoursParent and node.parcoursParent.id == cand.id ? 'selected' }}>{{ cand.label ?: '—' }} · {{ unit|lower }}s {{ cand.periodeDebut }}–{{ cand.periodeFin }}</option>
                        {% endfor %}
                    </select>
                    {% if pcands is empty %}
                        <p class="fld-help">Aucun parcours antérieur compatible. Renseignez les {{ unit|lower }}s ci-dessus puis enregistrez : les parcours qui se terminent avant deviendront sélectionnables.</p>
                    {% endif %}
                    <a href="{{ path('formation_parcours_graph', {id: formation.id}) }}" data-turbo-frame="node-panel"
                       class="inline-block text-xs font-medium hover:underline" style="color:var(--c-primary)">🗺 Voir l'arborescence des parcours</a>
                </div>
            {% endif %}
        </div>
        {% endfor %}

        <div class="flex items-center gap-2 pt-2 border-t" style="border-color:var(--c-border)">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">Enregistrer</button>
            <span class="text-xs text-gray-400">Dupliquer / supprimer : bas de l'arborescence</span>
        </div>
    </form>

    {# ── modale « Paramètre du nœud » ── #}
    <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
            class="rounded-2xl border-0 p-0 w-[min(600px,94vw)] backdrop:bg-black/40">
        <turbo-frame id="node-params-frame" src="{{ path('node_params_form', {id: node.id}) }}" loading="lazy" class="block">
            <div class="p-10 text-center text-sm text-gray-400">Chargement…</div>
        </turbo-frame>
    </dialog>

    {# ── ajouter un enfant ── #}
    {% if childTypes is not empty %}
    <form method="post" action="{{ path('node_add', {id: formation.id}) }}" data-turbo-frame="_top"
          class="rounded-xl border p-3 flex flex-wrap items-end gap-2" style="border-color:var(--c-border)">
        <input type="hidden" name="parentId" value="{{ node.id }}">
        <div class="flex-1 min-w-[180px]">
            <div class="fld-label">Ajouter un enfant</div>
            <select name="typeKey" class="fld mt-1">
                {% for t in childTypes %}<option value="{{ t.key }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
            </select>
        </div>
        <input name="label" placeholder="Libellé" class="fld w-40">
        <button class="rounded-lg border px-4 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">＋ Ajouter</button>
    </form>
    {% endif %}

    </div>
    </div>

</div>
</turbo-frame>

{# ─────────────── macros ─────────────── #}
{% macro label(text, required, help) %}
    <div>
        <div class="flex items-center justify-between">
            <span class="fld-label">{{ text }}</span>
            {% if required %}<span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide">Champs requis</span>{% endif %}
        </div>
        {% if help %}<div class="fld-help">ℹ {{ help }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro field(key, def, node) %}
    {% import _self as ui %}
    {% set val = node.getAttribute(key) %}
    {% if def.field not in ['hours', 'mccc'] %}
        {% set ectsTyped = key == 'ects' and node.type.key in ['ue', 'ec'] %}
        {% set flabel = ectsTyped ? "ECTS de l'" ~ node.type.label : def.label %}
        {% set fhelp = ectsTyped ? "ECTS associés à l'" ~ node.type.label ~ '.' : (def.help ?? null) %}
        {{ ui.label(flabel, def.required ?? false, fhelp) }}
    {% endif %}
    {% if def.field == 'number' %}
        <input type="number" step="0.5" name="attr_{{ key }}" value="{{ val }}" class="fld w-44">
    {% elseif def.field == 'textarea' %}
        <textarea name="attr_{{ key }}" rows="3" class="fld">{{ val }}</textarea>
    {% elseif def.field == 'choice' %}
        {% set ph = key == 'ueType' ? "Choisir un type d'UE" : (key == 'ecType' ? "Choisir un type d'EC" : '— Choisir —') %}
        <select name="attr_{{ key }}" class="fld">
            <option value="">{{ ph }}</option>
            {% for ov, ol in def.options %}<option value="{{ ov }}" {{ val == ov ? 'selected' }}>{{ ol }}</option>{% endfor %}
        </select>
    {% elseif def.field == 'radio' %}
        <div class="mt-1 flex flex-wrap gap-x-6 gap-y-2">
            {% for ov, ol in def.options %}
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="radio" name="attr_{{ key }}" value="{{ ov }}" {{ val == ov ? 'checked' }}>{{ ol }}
                </label>
            {% endfor %}
        </div>
    {% elseif def.field == 'competencies' %}
        {% set groups = bcc_competences(node) %}
        {% set cur = val ?? [] %}
        {% if groups is empty %}
            <p class="fld-help">Aucune compétence dans le référentiel (BCC). Ajoutez-en dans « Référentiel de compétences (BCC) ».</p>
        {% else %}
            <div data-controller="cbxfilter" class="mt-1">
                <div class="rounded-lg border overflow-hidden" style="border-color:var(--c-border)">
                    <div class="border-b bg-gray-50 px-2 py-1.5" style="border-color:var(--c-border)">
                        <input type="search" placeholder="Filtrer les compétences…" data-cbxfilter-target="input"
                               data-action="input->cbxfilter#filter"
                               class="w-full rounded-md border px-2 py-1 text-sm" style="border-color:var(--c-border)">
                    </div>
                    <div class="max-h-64 overflow-y-auto p-2 space-y-3">
                        {% for g in groups %}
                            <div data-cbxfilter-target="group">
                                <div class="text-[11px] font-semibold uppercase tracking-wide {{ g.transversal ? 'text-teal-700' : 'text-gray-400' }}">{{ g.bloc }}</div>
                                <div class="mt-1 space-y-0.5">
                                    {% for c in g.items %}
                                        <label class="flex items-center gap-2 text-sm cursor-pointer rounded px-1 py-1 hover:bg-gray-50"
                                               data-cbxfilter-target="row"
                                               data-text="{{ (c.label ~ ' ' ~ c.code ~ ' ' ~ c.description ~ ' ' ~ g.bloc)|lower }}">
                                            <input type="checkbox" name="attr_competencies[]" value="{{ c.label }}" {{ c.label in cur ? 'checked' }}>
                                            <span class="font-medium shrink-0">{{ c.label }}</span>
                                            {% if c.code %}<span class="text-xs text-gray-400 shrink-0">{{ c.code }}</span>{% endif %}
                                            {% if c.description %}<span class="min-w-0 truncate text-xs text-gray-400">· {{ c.description }}</span>{% endif %}
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                        <p data-cbxfilter-target="empty" hidden class="px-1 py-3 text-center text-sm text-gray-400">Aucune compétence ne correspond.</p>
                    </div>
                </div>
                <div class="mt-1 flex items-center justify-between">
                    <span class="text-xs text-gray-400" data-cbxfilter-target="count"></span>
                    <span class="text-xs text-gray-400 cursor-default">＋ Ajouter une compétence</span>
                </div>
            </div>
        {% endif %}
    {% elseif key == 'ficheMatiere' %}
        {% set fiches = ['Fiche — Algorithmique', 'Fiche — Programmation', 'Fiche — Bases de données', 'Fiche — Mathématiques'] %}
        <select name="attr_ficheMatiere" class="fld">
            <option value="">Choisir dans la liste ou « ＋ Créer une nouvelle »…</option>
            {% for f in fiches %}<option value="{{ f }}" {{ val == f ? 'selected' }}>{{ f }}</option>{% endfor %}
            {% if val and val not in fiches %}<option value="{{ val }}" selected>{{ val }}</option>{% endif %}
        </select>
        <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">＋ Créer une nouvelle fiche</span></div>
    {% elseif def.field == 'hours' %}
        {% set mods = {'cm': 'CM', 'td': 'TD', 'tp': 'TP'} %}
        <div data-controller="hours" class="space-y-4">
            <label class="flex items-center gap-3 text-sm">
                <input type="checkbox" class="switch" name="attr_hours[none]" value="1" {{ (val.none ?? false) ? 'checked' }}
                       data-hours-target="none" data-action="change->hours#sync">
                <span class="font-medium">EC sans volume horaire</span>
            </label>

            <div data-hours-target="fields" class="space-y-4">
                {% for place, plabel in {'pres': 'présentiel', 'dist': 'distanciel'} %}
                    <div class="rounded-xl border p-4" style="border-color:var(--c-border)">
                        <div class="flex items-center justify-between gap-2">
                            <div class="fld-label">Volume horaire en {{ plabel }}</div>
                            <span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide shrink-0">Champs requis</span>
                        </div>
                        <div class="mt-2 grid gap-3 sm:grid-cols-3">
                            {% for m, mlabel in mods %}
                                <div class="relative">
                                    <input type="number" min="0" step="0.5" placeholder="0"
                                           name="attr_hours[{{ place }}][{{ m }}]" value="{{ val[place][m] ?? '' }}"
                                           data-hours-target="input" class="fld pr-24">
                                    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-gray-400">Heure(s) {{ mlabel }}</span>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="fld-help">ℹ Précisez le volume horaire en {{ plabel }}</div>
                    </div>
                {% endfor %}

                <div class="rounded-xl border p-4" style="border-color:var(--c-border)">
                    <div class="flex items-center justify-between gap-2">
                        <div class="fld-label">Volume horaire de travail étudiant (TE)</div>
                        <span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide shrink-0">Champs requis</span>
                    </div>
                    <div class="relative mt-2">
                        <input type="number" min="0" step="0.5" placeholder="0"
                               name="attr_hours[te]" value="{{ val.te ?? '' }}"
                               data-hours-target="input" class="fld pr-24">
                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-gray-400">Heure(s) TE</span>
                    </div>
                    <div class="fld-help">ℹ Précisez le volume horaire en TE (stage, projet, autonomie, …)</div>
                </div>
            </div>
        </div>
    {% elseif def.field == 'mccc' %}
        {% set mtypes = constant('App\\Maquette\\AttributeCatalog::MCCC_TYPES') %}
        <div class="flex items-center gap-2">
            <span class="fld-label">Type de MCCC</span>
            <span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide">Champs requis</span>
        </div>
        <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            {% for mk, mv in mtypes %}
                {% set on = (val.type ?? '') == mk %}
                <label class="flex items-start gap-2.5 text-sm cursor-pointer rounded-lg border px-3 py-2.5 hover:bg-gray-50"
                       style="border-color:{{ on ? 'var(--c-primary)' : 'var(--c-border)' }};background:{{ on ? 'var(--c-primary-soft)' : '#fff' }}">
                    <input type="radio" name="attr_mccc[type]" value="{{ mk }}" {{ on ? 'checked' }} class="mt-0.5">
                    <span><span class="font-semibold">{{ mv.short }}</span>
                        <span class="block text-xs text-gray-400">{{ mv.label }}</span></span>
                </label>
            {% endfor %}
        </div>
        <button type="button" disabled title="Fonctionnalité à venir"
                class="mt-4 inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold text-white opacity-60 cursor-not-allowed"
                style="background:#134e4a">＋ Ajouter une épreuve pour la 1ère session</button>
    {% else %}
        <input name="attr_{{ key }}" value="{{ val }}" class="fld">
    {% endif %}
{% endmacro %}
