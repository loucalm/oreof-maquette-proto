{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'validations' %}
{% block title %}{{ 'admin.validations.title'|trans({}, 'admin') }}{% endblock %}

{% block admin_body %}
<div class="-mx-6 -mt-6 mb-6 border-b border-secondary-200 px-6 py-4">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-text">{{ ux_icon(_sections[adminSection].icon, {class: 'h-5 w-5 text-primary'}) }} {{ 'admin.validations.heading'|trans({}, 'admin') }}</h2>
    <p class="mt-1 text-sm text-secondary">{{ 'admin.validations.description'|trans({}, 'admin') }}</p>
</div>

<div class="space-y-4">
    {% for row in rows %}
        <div class="rounded-xl border bg-white p-5 space-y-3 border-secondary-200">
            <div class="flex items-start justify-between gap-3">
                <div class="font-semibold">{{ ux_icon(row.type.icon ?: 'ph:puzzle-piece', {class: 'icon'}) }} {{ row.type.label }} <code class="text-xs font-normal text-secondary-500">{{ row.type.key }}</code></div>
                <a href="{{ path('node_type_edit', {id: row.type.id}) }}" data-turbo-frame="_top" class="shrink-0 inline-flex items-center gap-1 rounded-md border border-warning-500 px-2 py-1 text-xs font-medium text-warning-700 transition-colors hover:bg-warning-500 hover:text-secondary-900">{{ ux_icon('ph:pencil-simple', {class: 'h-3.5 w-3.5'}) }} {{ 'common.edit'|trans({}, 'common') }}</a>
            </div>
            {% for r in row.rules %}
                <div class="flex items-start gap-2 text-sm">
                    <span class="pill shrink-0">{{ r.tab }}</span>
                    <span>{{ r.text }}</span>
                </div>
            {% endfor %}
            {% if row.bounded is not empty %}
                <div class="text-xs text-secondary-500">
                    {{ 'admin.validations.bounds_label'|trans({}, 'admin') }}
                    {% for f in row.bounded %}
                        <span class="pill">{{ f.label }} : {{ f.min is not null ? 'min ' ~ f.min }}{{ f.min is not null and f.max is not null ? ' · ' }}{{ f.max is not null ? 'max ' ~ f.max }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="rounded-xl border border-dashed p-8 text-center text-sm text-secondary-500 border-secondary-200">
            {{ 'admin.validations.empty'|trans({}, 'admin') }}
        </div>
    {% endfor %}
</div>
{% endblock %}
