{% extends 'base.html.twig' %}
{% block title %}{{ formation.name }} · éditeur{% endblock %}

{% block body %}
<div class="flex items-start justify-between gap-6 mb-5">
    <div>
        <div class="text-xs" style="color:var(--c-muted)">
            <a href="{{ path('formation_index') }}" class="hover:underline">Formations</a> › {{ formation.name }}
        </div>
        <h1 class="text-xl font-bold mt-1">{{ formation.name }}</h1>
        <p class="text-sm" style="color:var(--c-muted)">
            {{ formation.diplome ?: '—' }} · {{ formation.composante ?: '—' }} ·
            {{ formation.multiParcours ? 'multi-parcours' : 'mono-parcours' }}
        </p>
    </div>
    <div class="text-right">
        <div class="text-xs" style="color:var(--c-muted)">Progression globale</div>
        <div class="text-2xl font-bold" style="color:var(--c-primary)">{{ progress }}%</div>
    </div>
</div>

{# ─── barre d'outils structure ─── #}
<div class="rounded-xl border bg-white p-3 mb-5 flex flex-wrap items-center gap-2" style="border-color:var(--c-border)">
    <details class="relative">
        <summary class="list-none cursor-pointer rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">
            ＋ Ajouter un nœud racine
        </summary>
        <form method="post" action="{{ path('node_add', {id: formation.id}) }}"
              class="absolute z-10 mt-2 w-72 rounded-lg border bg-white p-3 shadow-lg space-y-2" style="border-color:var(--c-border)">
            <select name="typeKey" class="w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                {% for t in types %}<option value="{{ t.key }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
            </select>
            <input name="label" placeholder="Libellé (optionnel)" class="w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
            <button class="w-full rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">Ajouter</button>
        </form>
    </details>

    <details class="relative">
        <summary class="list-none cursor-pointer rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">
            ⬇ Charger un template
        </summary>
        <form method="post" action="{{ path('formation_apply_template', {id: formation.id}) }}"
              data-controller="confirm" data-confirm-message-value="⚠️ Charger ce template ÉCRASE la structure actuelle. Continuer ?"
              class="absolute z-10 mt-2 w-80 rounded-lg border bg-white p-3 shadow-lg space-y-2" style="border-color:var(--c-border)">
            <select name="template" class="w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                {% for tpl in templates %}<option value="{{ tpl.key }}">{{ tpl.label }}</option>{% endfor %}
            </select>
            <p class="text-xs" style="color:var(--c-muted)">La structure reste modifiable après chargement.</p>
            <button class="w-full rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">Charger</button>
        </form>
    </details>

    <details class="relative">
        <summary class="list-none cursor-pointer rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">
            💾 Enregistrer comme template
        </summary>
        <form method="post" action="{{ path('template_from_formation', {id: formation.id}) }}"
              class="absolute z-10 mt-2 w-72 rounded-lg border bg-white p-3 shadow-lg space-y-2" style="border-color:var(--c-border)">
            <input name="label" placeholder="Nom du template" required class="w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
            <button class="w-full rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">Créer le template</button>
        </form>
    </details>

    <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" class="flex items-center gap-2 ml-auto">
        <label class="flex items-center gap-1.5 text-sm">
            <input type="checkbox" name="multiParcours" value="1" {{ formation.multiParcours ? 'checked' }} onchange="this.form.requestSubmit()">
            multi-parcours
        </label>
        <input type="hidden" name="name" value="{{ formation.name }}">
        <input type="hidden" name="diplome" value="{{ formation.diplome }}">
        <input type="hidden" name="composante" value="{{ formation.composante }}">
    </form>

    <form method="post" action="{{ path('formation_reset', {id: formation.id}) }}"
          data-controller="confirm" data-confirm-message-value="Vider toute la structure ?">
        <button class="rounded-md border px-3 py-1.5 text-sm text-red-600 hover:bg-red-50" style="border-color:var(--c-border)">Vider</button>
    </form>
</div>

<div class="grid gap-5 lg:grid-cols-[360px_1fr] items-start">
    {# ─── arbre ─── #}
    <div class="rounded-xl border bg-white p-3" style="border-color:var(--c-border)"
         data-controller="tree"
         data-tree-move-url-value="{{ path('node_move', {id: '__ID__'}) }}">
        <div class="text-xs font-semibold uppercase tracking-wide mb-2" style="color:var(--c-muted)">Structure de la formation</div>
        {% if roots is empty %}
            <p class="text-sm px-2 py-6 text-center" style="color:var(--c-muted)">
                Aucun nœud. Ajoutez-en un, ou chargez un template.
            </p>
        {% else %}
            {{ include('formation/_tree.html.twig', {views: roots, formation: formation, parentId: null}) }}
        {% endif %}
    </div>

    {# ─── panneau d'édition du nœud ─── #}
    <turbo-frame id="node-panel" class="block rounded-xl border bg-white p-5 min-h-[300px]" style="border-color:var(--c-border)"
                 {% if app.request.query.get('focus') %}src="{{ path('node_panel', {id: app.request.query.getInt('focus')}) }}"{% endif %}>
        {% if not app.request.query.get('focus') %}
            <p class="text-sm py-16 text-center" style="color:var(--c-muted)">
                Sélectionnez un nœud dans l'arbre pour le modifier.
            </p>
        {% endif %}
    </turbo-frame>
</div>
{% endblock %}
