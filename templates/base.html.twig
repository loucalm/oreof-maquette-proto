<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Après une action qui redirige vers la même page : rafraîchissement par morphing, défilement conservé. #}
        <meta name="turbo-refresh-method" content="morph">
        <meta name="turbo-refresh-scroll" content="preserve">
        <title>{% block title %}{{ 'layout.default_title'|trans({}, 'layout') }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.1em%22 font-size=%22104%22>🧩</text></svg>">
        {# Tailwind au runtime (prototype). Le build standalone ne scannait pas les templates dans ce conteneur. #}
        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen flex flex-col">

        {# ─────────── header ORéOF (fictif, non fonctionnel) ─────────── #}
        <header class="bg-white border-b" style="border-color:var(--c-border)">
            <div class="mx-auto max-w-[1600px] px-6 h-16 flex items-center gap-7">
                <a href="{{ path('formation_index') }}" class="font-extrabold tracking-tight">
                    <span style="color:var(--c-primary)">ORéOF</span><span class="text-gray-400">/ Adm.</span>
                </a>
                {% set _route = app.request.attributes.get('_route') ?? '' %}
                <nav class="hidden lg:flex items-center gap-6 text-sm text-gray-600">
                    <span class="fake-link cursor-default" aria-disabled="true" title="{{ 'common.coming_soon'|trans({}, 'common') }}">{{ 'layout.nav.dashboard'|trans({}, 'layout') }}</span>
                    <a href="{{ path('formation_index') }}"
                       class="hover:text-gray-900 {{ _route matches '/^(formation_|node_|bcc_|parcours_)/' ? 'font-semibold text-gray-900' }}">{{ 'layout.nav.offer'|trans({}, 'layout') }}</a>
                    <span class="fake-link cursor-default" aria-disabled="true" title="{{ 'common.coming_soon'|trans({}, 'common') }}">{{ 'layout.nav.steering'|trans({}, 'layout') }} {{ ux_icon('ph:caret-down', {class: 'icon text-gray-300'}) }}</span>
                    <span class="fake-link cursor-default" aria-disabled="true" title="{{ 'common.coming_soon'|trans({}, 'common') }}">{{ 'layout.nav.councils'|trans({}, 'layout') }} {{ ux_icon('ph:caret-down', {class: 'icon text-gray-300'}) }}</span>
                    <span class="fake-link cursor-default" aria-disabled="true" title="{{ 'common.coming_soon'|trans({}, 'common') }}">{{ 'layout.nav.users_rights'|trans({}, 'layout') }} {{ ux_icon('ph:caret-down', {class: 'icon text-gray-300'}) }}</span>
                    {% if is_admin() %}
                        <a href="{{ path('diplome_index') }}"
                           class="hover:text-gray-900 {{ _route matches '/^diplome_/' ? 'font-semibold text-gray-900' }}">{{ 'layout.nav.diplomes'|trans({}, 'layout') }}</a>
                        <a href="{{ path('admin_index') }}"
                           class="hover:text-gray-900 {{ _route matches '/^(admin_|node_type_|field_|template_)/' ? 'font-semibold text-gray-900' }}">{{ 'layout.nav.administration'|trans({}, 'layout') }}</a>
                    {% endif %}
                </nav>
                <div class="ml-auto flex items-center gap-3 text-gray-400">
                    {# bascule de rôle (proto — pas d'auth réelle) #}
                    <div class="relative" data-controller="menu">
                        <button type="button" data-action="menu#toggle"
                                class="rounded-lg border px-2.5 py-1 text-xs font-medium text-gray-600 hover:bg-gray-50" style="border-color:var(--c-border)">
                            {{ ux_icon('ph:eye', {class: 'icon'}) }} {{ role_labels()[current_role()] }} {{ ux_icon('ph:caret-down', {class: 'icon text-gray-300'}) }}
                        </button>
                        <div data-menu-target="menu" hidden class="absolute right-0 z-40 mt-1 w-60 rounded-xl border bg-white py-1 text-sm shadow-lg" style="border-color:var(--c-border)">
                            <div class="px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ 'layout.role_switch.title'|trans({}, 'layout') }}</div>
                            {% for r, label in role_labels() %}
                                <form method="post" action="{{ path('role_switch', {role: r}) }}">
                                    <button class="flex w-full items-center gap-2 px-3 py-2 text-left hover:bg-gray-50 {{ current_role() == r ? 'font-semibold' }}">
                                        {{ current_role() == r ? ux_icon('ph:check-circle-fill', {class: 'icon', style: 'color:var(--c-primary)'}) : ux_icon('ph:circle', {class: 'icon text-gray-300'}) }} {{ label }}
                                    </button>
                                </form>
                            {% endfor %}
                            <div class="border-t px-3 py-1.5 text-[11px] text-gray-400" style="border-color:var(--c-border)">{{ 'layout.role_switch.help'|trans({}, 'layout') }}</div>
                        </div>
                    </div>
                    <span>{{ ux_icon('ph:magnifying-glass', {class: 'icon'}) }}</span><span>{{ ux_icon('ph:chat-circle', {class: 'icon'}) }}</span><span>{{ ux_icon('ph:globe', {class: 'icon'}) }}</span><span>{{ ux_icon('ph:bell', {class: 'icon'}) }}</span>
                    <span class="rounded-lg px-3 py-1 text-xs font-medium" style="background:var(--c-primary-soft);color:var(--c-primary)">2026-2027 {{ ux_icon('ph:caret-down', {class: 'icon'}) }}</span>
                    <span class="grid h-8 w-8 place-items-center rounded-full text-xs font-bold text-white" style="background:var(--c-primary)">{{ is_admin() ? 'DA' : 'RF' }}</span>
                </div>
            </div>
        </header>

        {# messages flash — toasts détachés, fixés en haut de l'écran (hors du flux,
           retirés du cache Turbo pour ne pas réapparaître lors d'une navigation) #}
        {% set _flashes = app.flashes %}
        {# « undo » : id de la formation dont la dernière modification peut être annulée depuis le toast #}
        {% set _undo = _flashes.undo ?? [] %}
        {# « derogation_link » : lien de demande de dérogation attaché au toast d'un refus hors bornes #}
        {% set _derog = _flashes.derogation_link ?? [] %}
        {% if _flashes|filter((m, l) => l not in ['undo', 'derogation_link']) is not empty %}
            <div class="flash-stack" role="status" aria-live="polite" data-turbo-temporary>
                {% for label, messages in _flashes|filter((m, l) => l not in ['undo', 'derogation_link']) %}
                    {% for message in messages %}
                        <div class="flash flash--{{ label ?: 'info' }}" data-controller="flash">
                            <span class="flash-msg">{{ message }}</span>
                            {% if _derog is not empty and label == 'warning' and loop.first %}
                                <a href="{{ _derog|first }}" class="flash-undo" data-turbo-frame="_top">{{ ux_icon('ph:flag', {class: 'icon'}) }} {{ 'diplome.guard.request_derogation'|trans({}, 'diplome') }}</a>
                            {% endif %}
                            {% if _undo is not empty and label in ['success', 'info'] and loop.first %}
                                <form method="post" action="{{ path('formation_undo', {id: _undo|first}) }}" data-turbo-frame="_top">
                                    <button class="flash-undo">{{ ux_icon('ph:arrow-counter-clockwise', {class: 'icon'}) }} {{ 'layout.undo'|trans({}, 'layout') }}</button>
                                </form>
                            {% endif %}
                            <button type="button" class="flash-x" data-action="flash#dismiss" aria-label="{{ 'layout.close'|trans({}, 'layout') }}">{{ ux_icon('ph:x', {class: 'icon'}) }}</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <main class="flex-1 mx-auto w-full max-w-[1600px] px-6 py-6">
            {% block body %}{% endblock %}
        </main>

        {# ─────────── footer ORéOF (fictif) ─────────── #}
        <footer class="border-t bg-white text-xs text-gray-500" style="border-color:var(--c-border)">
            <div class="mx-auto max-w-[1600px] px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-2">
                <div>
                    <span class="font-semibold text-gray-700">ORéOF</span> ·
                    {{ 'layout.footer.tagline'|trans({}, 'layout') }}
                    {% if is_admin() %} · <a href="{{ path('admin_index') }}" class="hover:underline">{{ 'layout.nav.administration'|trans({}, 'layout') }}</a>{% endif %}
                </div>
                <div class="ml-auto flex items-center gap-3 text-gray-400">
                    {% for item in ['layout.footer.documents', 'layout.footer.help', 'layout.footer.faq', 'layout.footer.contact', 'layout.footer.github'] %}<span class="fake-link cursor-default" aria-disabled="true" title="{{ 'common.coming_soon'|trans({}, 'common') }}">{{ item|trans({}, 'layout') }}</span>{% endfor %}
                </div>
            </div>
        </footer>

        {# aide contextuelle de l'écran (textes : translations/help.fr.yaml, éditables par l'admin) #}
        {% set _help = page_help() %}
        {% if _help.route and (_help.body or is_admin()) %}
        <div data-controller="modal">
            <button type="button" data-action="modal#open" aria-haspopup="dialog"
                    class="help-fab" style="background:var(--c-primary)" title="{{ 'layout.help_button'|trans({}, 'layout') }}" aria-label="{{ 'layout.help_button'|trans({}, 'layout') }}">?</button>
            <dialog data-modal-target="dialog" data-action="click->modal#clickOutside" class="help-drawer" aria-labelledby="help-title">
                <div class="p-6 space-y-4">
                    <div class="flex items-start justify-between gap-3">
                        <h2 id="help-title" class="text-lg font-bold">{{ ux_icon('ph:question', {class: 'icon'}) }} {{ _help.title ?? 'layout.help_button'|trans({}, 'layout') }}</h2>
                        <button type="button" data-action="modal#close" class="icon-btn" aria-label="{{ 'layout.close'|trans({}, 'layout') }}">{{ ux_icon('ph:x', {class: 'icon'}) }}</button>
                    </div>
                    {% if _help.body %}
                        <div class="help-body text-sm text-gray-700">{{ _help.body|nl2br }}</div>
                    {% else %}
                        <p class="text-sm text-gray-400">{{ 'layout.help_empty'|trans({}, 'layout') }}</p>
                    {% endif %}
                    {% if is_admin() %}
                        <details class="move-box">
                            <summary class="fld-label cursor-pointer">{{ ux_icon('ph:pencil-simple', {class: 'icon'}) }} {{ 'layout.help_edit'|trans({}, 'layout') }}</summary>
                            <form method="post" action="{{ path('admin_help_save', {route: _help.route}) }}" data-turbo-frame="_top" class="mt-2 space-y-2">
                                <input type="hidden" name="back" value="{{ app.request.requestUri }}">
                                <input name="title" value="{{ _help.title }}" class="fld" aria-label="{{ 'layout.help_title_label'|trans({}, 'layout') }}" placeholder="{{ 'layout.help_title_label'|trans({}, 'layout') }}">
                                <textarea name="body" rows="8" class="fld" aria-label="{{ 'layout.help_body_label'|trans({}, 'layout') }}">{{ _help.body }}</textarea>
                                <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
                            </form>
                        </details>
                    {% endif %}
                </div>
            </dialog>
        </div>
        {% endif %}

        {# ─────────── modale de confirmation globale (remplace window.confirm) ─────────── #}
        <dialog data-controller="confirm-dialog" data-confirm-dialog-target="dialog"
                data-action="click->confirm-dialog#clickOutside"
                class="w-[min(480px,92vw)] rounded-3xl border-0 p-0 shadow-2xl backdrop:bg-black/50">
            <div class="p-8 sm:p-10">
                <h2 class="text-3xl font-extrabold tracking-tight text-red-600">{{ 'layout.confirm_dialog.title'|trans({}, 'layout') }}</h2>
                <p data-confirm-dialog-target="message" class="mt-4 text-base leading-relaxed" style="color:var(--c-muted)"></p>
                <div class="mt-7 h-px" style="background:var(--c-border)"></div>
                <div class="mt-6 flex gap-3">
                    <button type="button" data-action="confirm-dialog#confirm"
                            class="flex-1 rounded-2xl border px-5 py-3.5 text-base font-medium hover:bg-red-100"
                            style="background:#fef2f2;color:#b91c1c;border-color:#fecaca">{{ 'layout.confirm_dialog.continue'|trans({}, 'layout') }}</button>
                    <button type="button" data-action="confirm-dialog#cancel" data-confirm-dialog-target="cancelBtn"
                            class="flex-1 rounded-2xl border px-5 py-3.5 text-base font-medium hover:bg-indigo-100"
                            style="background:var(--c-primary-soft);color:var(--c-primary);border-color:#c7d2fe">{{ 'common.cancel'|trans({}, 'common') }}</button>
                </div>
            </div>
        </dialog>
    </body>
</html>
