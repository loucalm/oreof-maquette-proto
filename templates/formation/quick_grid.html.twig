{% extends 'base.html.twig' %}
{% block title %}{{ 'formation.quick_grid.title'|trans({}, 'formation') }} · {{ formation.name }}{% endblock %}

{% set places = columns.places %}
{% set mods = columns.mods %}
{% set colCount = 2 + places|length * mods|length + 3 %}

{% set header_title = 'formation.quick_grid.title'|trans({}, 'formation') %}
{% set header_description = 'formation.quick_grid.subtitle'|trans({}, 'formation') %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: 'formation.index.heading'|trans({}, 'formation'), url: path('formation_index')},
    {label: formation.name, url: path('formation_editor', {id: formation.id})},
    {label: header_title},
] %}

{% block bouton_header %}
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'formation.quick_grid.back'|trans({}, 'formation')" :href="path('formation_editor', {id: formation.id})"/>
{% endblock %}

{% block body %}
{% if parcoursList is not empty %}
        <nav class="app-tabs-list mb-4" aria-label="{{ 'formation.quick_grid.parcours_nav'|trans({}, 'formation') }}">
            {% for p in parcoursList %}
                <a href="{{ path('formation_quick_grid', {id: formation.id, parcours: p.id}) }}"
                   class="app-tab {{ p.id == parcoursNid ? 'app-tab-active' }}" {{ p.id == parcoursNid ? 'aria-current="page"' }}>{{ p.displayLabel }}</a>
            {% endfor %}
        </nav>
    {% endif %}

{% set readonly = formation.phase.value == 'consolidation' %}
{% if readonly %}
    <p class="issues-box mb-4">{{ ux_icon('ph:hourglass-medium', {class: 'icon'}) }} {{ 'formation.editor.consolidation_readonly'|trans({}, 'formation') }}</p>
{% endif %}
<div class="rounded-2xl border bg-white overflow-auto border-secondary-200">
    {% if rows is empty %}
        <p class="p-10 text-center text-sm text-secondary-400">{{ 'formation.quick_grid.empty'|trans({}, 'formation') }}</p>
    {% else %}
    <table class="qg-table" data-controller="quick-grid">
        <caption class="sr-only">{{ 'formation.quick_grid.caption'|trans({}, 'formation') }}</caption>
        <thead>
            <tr>
                <th rowspan="2" class="qg-name">{{ 'formation.quick_grid.col_element'|trans({}, 'formation') }}</th>
                <th rowspan="2">ECTS</th>
                {% for pk, pl in places %}<th colspan="{{ mods|length }}" class="qg-place">{{ pl }}</th>{% endfor %}
                <th rowspan="2">TE</th>
                <th rowspan="2">{{ 'formation.quick_grid.col_total'|trans({}, 'formation') }}</th>
                <th rowspan="2"><span class="sr-only">{{ 'formation.quick_grid.col_status'|trans({}, 'formation') }}</span></th>
            </tr>
            <tr>
                {% for pk, pl in places %}{% for mk, ml in mods %}<th class="qg-mod">{{ ml }}</th>{% endfor %}{% endfor %}
            </tr>
        </thead>
        <tbody>
        {% for r in rows %}
            {% set v = r.view %}
            {% set n = v.node %}
            {% set label = n.type.temporel ? node_display_label(n, v.ref) : (n.label ?: '—') %}
            {% if r.kind == 'group' %}
                <tr class="qg-group qg-depth-{{ min(r.depth, 3) }}">
                    <th scope="rowgroup" class="qg-name" style="padding-left: {{ 12 + r.depth * 16 }}px">
                        <span class="status-dot" data-total="status:{{ n.id }}" data-status="{{ v.status }}"></span>
                        <span class="type-badge">[{{ n.type.label }}]</span>
                        {% if v.ref and not n.type.temporel %}<span class="tree-ref">{{ v.ref }}</span>{% endif %}
                        {{ label }}
                    </th>
                    <td class="qg-total" data-total="ects:{{ n.id }}" data-state="{{ v.ectsTarget ? (v.ectsReached ? 'ok' : 'gap') }}">{{ v.totalEcts|round(1) }}{{ v.ectsTarget ? ' / ' ~ v.ectsTarget }}</td>
                    <td colspan="{{ places|length * mods|length + 1 }}"></td>
                    <td class="qg-total" data-total="hours:{{ n.id }}">{{ v.totalHours|round(1) }} h</td>
                    <td></td>
                </tr>
            {% else %}
                {% set caps = n.effectiveCapabilities() %}
                {% set rEcts = ec_value(n, 'ects') %}
                {% set rHours = ec_value(n, 'hours') %}
                {% set h = rHours.value ?? {} %}
                {% set ectsEditable = (caps.ects ?? false) and rEcts.source == 'ec' and not rEcts.locked and not readonly %}
                {% set hoursEditable = (caps.hours ?? false) and rHours.source == 'ec' and not rHours.locked and not readonly %}
                <tr data-quick-grid-target="row" data-url="{{ path('formation_quick_grid_save', {fid: formation.id, nid: n.id}) }}">
                    <th scope="row" class="qg-name" style="padding-left: {{ 12 + r.depth * 16 }}px">
                        <span class="status-dot" data-total="status:{{ n.id }}" data-status="{{ v.status }}"></span>
                        <span class="type-badge">[{{ n.type.label }}]</span>
                        {% if v.ref %}<span class="tree-ref">{{ v.ref }}</span>{% endif %}
                        <a href="{{ path('node_open', {fid: formation.id, nid: n.id}) }}" class="hover:underline">{{ label }}</a>
                    </th>
                    <td>
                        {% if caps.ects ?? false %}
                            <input type="number" min="0" step="0.5" name="ects" value="{{ rEcts.value }}" data-col="ects"
                                   data-source="{{ rEcts.source }}" data-quick-grid-target="input" class="qg-input"
                                   {{ not ectsEditable ? 'readonly="readonly"' }} aria-label="ECTS — {{ label }}">
                        {% else %}<span class="qg-na">—</span>{% endif %}
                    </td>
                    {% for pk, pl in places %}
                        {% for mk, ml in mods %}
                            <td>
                                {% if caps.hours ?? false %}
                                    <input type="number" min="0" step="0.5" name="hours[{{ pk }}][{{ mk }}]" value="{{ h[pk][mk] ?? '' }}"
                                           data-col="{{ pk }}_{{ mk }}" data-source="{{ rHours.source }}" data-quick-grid-target="input" class="qg-input"
                                           {{ not hoursEditable ? 'readonly="readonly"' }}
                                           aria-label="{{ ml }} {{ pl|lower }} — {{ label }}">
                                {% else %}<span class="qg-na">—</span>{% endif %}
                            </td>
                        {% endfor %}
                    {% endfor %}
                    <td>
                        {% if caps.hours ?? false %}
                            <input type="number" min="0" step="0.5" name="hours[te]" value="{{ h.te ?? '' }}" data-col="te"
                                   data-source="{{ rHours.source }}" data-quick-grid-target="input" class="qg-input"
                                   {{ not hoursEditable ? 'readonly="readonly"' }} aria-label="TE — {{ label }}">
                        {% else %}<span class="qg-na">—</span>{% endif %}
                    </td>
                    <td class="qg-total" data-total="hours">{{ v.totalHours|round(1) }} h</td>
                    <td><span class="qg-status" data-quick-grid-target="status" role="status" aria-live="polite"></span></td>
                </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>
<p class="mt-3 text-xs text-secondary-400">{{ 'formation.quick_grid.keyboard_help'|trans({}, 'formation') }}</p>
{% endblock %}
