{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'traductions' %}
{% block title %}Traductions{% endblock %}

{% block admin_body %}
<div class="mb-5">
    <h2 class="text-lg font-bold">Traductions</h2>
    <p class="text-sm" style="color:var(--c-muted)">
        Chaque texte affiché dans l'application est associé à une clé de traduction, modifiable ici sans
        toucher au code. Un fichier par domaine (formation, nœud, administration…).
    </p>
</div>

<div class="rounded-xl border bg-white p-4 mb-6" style="border-color:var(--c-border)"
     data-controller="translation-recherche"
     data-translation-recherche-url-value="{{ path('admin_traductions_recherche') }}">
    <label class="text-xs font-medium uppercase tracking-wide" style="color:var(--c-muted)">Rechercher une clé ou un texte</label>
    <input type="text" placeholder="Au moins 3 caractères…" class="fld mt-1"
           data-translation-recherche-target="search"
           data-action="input->translation-recherche#recherche" />
    <div class="mt-3" data-translation-recherche-target="resultats"></div>
</div>

<div class="rounded-xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
    <table class="w-full text-sm">
        <thead class="text-xs uppercase tracking-wide" style="color:var(--c-muted)">
            <tr class="border-b" style="border-color:var(--c-border)">
                <th class="text-left px-4 py-2.5">Domaine</th>
                <th class="text-left px-4 py-2.5">Fichier</th>
                <th class="px-4 py-2.5"></th>
            </tr>
        </thead>
        <tbody>
        {% for file in files %}
            <tr class="border-b last:border-0" style="border-color:var(--c-border)">
                <td class="px-4 py-2.5 font-medium">{{ file.filename|split('.')|first }}</td>
                <td class="px-4 py-2.5" style="color:var(--c-muted)">{{ file.filename }}</td>
                <td class="px-4 py-2.5 text-right">
                    <a href="{{ path('admin_traductions_edit', {filename: file.filename}) }}" class="text-xs hover:underline">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="px-4 py-8 text-center text-sm" style="color:var(--c-muted)">Aucun fichier de traduction dans `translations/`.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
