{# Mini-formulaire d'ajout au référentiel ; le formulaire cible (id qa-<clé>) est posé hors du formulaire principal. #}
<div class="mt-1.5 flex items-center gap-2">
    <input type="text" name="value" form="qa-{{ key }}" aria-label="{{ 'node.panel.quick_add_placeholder'|trans({}, 'node') }}" placeholder="{{ 'node.panel.quick_add_placeholder'|trans({}, 'node') }}" class="fld flex-1 text-xs">
    <button form="qa-{{ key }}" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }}</button>
</div>
