{# Panneau d'édition d'un nœud — façon maquette Figma. Rendu dans <turbo-frame id="node-panel">. #}
{% import _self as ui %}
{% set caps = node.effectiveCapabilities() %}
{% set formation = node.formation %}
{% set childTypes = types_allowed_for(node) %}
{% set T = node.type.label %}

{% set hasHours = caps.hours ?? false %}
{% set hasMccc = caps.mccc ?? false %}

<turbo-frame id="node-panel">
<div class="p-6 space-y-5" data-controller="tabs" data-panel-active="node:{{ node.id }}">

    <div>
        <h2 class="text-xl font-bold">Gestion de la structure</h2>
        <div class="text-sm text-gray-400">{{ T }}</div>
    </div>

    {# breadcrumb #}
    <div class="text-sm text-gray-400">
        {{ formation.name }}
        {%- for p in node_path(node) %} › {{ p.label ?: p.type.label }}{% endfor -%}
    </div>

    {# onglets (pills) #}
    <div class="flex flex-wrap gap-2">
        <button type="button" data-tabs-target="tab" data-tab="props" class="tab-pill">
            <span class="status-dot" data-status="{{ view.missingCount > 0 ? 'incomplete' : 'ok' }}"></span> Propriétés
        </button>
        {% if hasHours %}
        <button type="button" data-tabs-target="tab" data-tab="volume_horaire" class="tab-pill">
            <span class="status-dot" data-status="{{ view.totalHours > 0 ? 'ok' : 'empty' }}"></span> Volume horaire
        </button>
        {% endif %}
        {% if hasMccc %}
        <button type="button" data-tabs-target="tab" data-tab="mccc" class="tab-pill">
            <span class="status-dot" data-status="{{ node.getAttribute('mccc') ? 'ok' : 'empty' }}"></span> MCCC
        </button>
        {% endif %}
    </div>

    {# tuiles + actions #}
    <div class="flex flex-wrap items-stretch gap-2">
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="text-gray-500">Total heures :</span> <span class="font-semibold">{{ view.totalHours|round }}</span>
        </div>
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="font-semibold">{{ view.totalEcts|round }}</span>
            <span class="text-gray-500">{% if view.ectsTarget %}/ {{ view.ectsTarget }} {% endif %}ECTS</span>
        </div>
        <div class="ml-auto flex flex-wrap gap-2">
            {% if caps.mutualisable ?? false %}
            <form method="post" action="{{ path('node_mutualize', {id: node.id}) }}" data-turbo-frame="_top">
                <button class="rounded-lg border px-3 py-2 text-sm" style="border-color:#fcd34d;color:#b45309">
                    ⬆ {{ node.mutualized ? 'Ne plus mutualiser' : 'Mutualiser' }} [{{ T }}]
                </button>
            </form>
            {% endif %}
            {% if childTypes is not empty %}
            <a href="{{ path('node_attach_index', {id: node.id}) }}" data-turbo-frame="node-panel"
               class="rounded-lg border px-3 py-2 text-sm text-green-700" style="border-color:#bbf7d0">↳ Raccrocher</a>
            {% endif %}
            <button type="button" data-action="tabs#toParams" class="rounded-lg border px-3 py-2 text-sm text-gray-600" style="border-color:var(--c-border)">⚙ Paramètre du nœud [{{ T }}]</button>
        </div>
    </div>

    {# séparateur type #}
    <div class="flex items-center gap-3 text-gray-300 text-xs uppercase tracking-widest">
        <div class="h-px flex-1 bg-gray-200"></div>{{ T }}<div class="h-px flex-1 bg-gray-200"></div>
    </div>

    {# ── Paramètre du nœud : quels champs apparaissent sur ce nœud (masqué par défaut) ── #}
    {% set labels = capability_labels() %}
    {% set typeCaps = node.type.capabilities %}
    <div data-tabs-target="panel" data-tab="__params" hidden class="rounded-xl border p-4 space-y-4" style="border-color:var(--c-border);background:#fafafb">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="font-semibold text-sm">⚙ Paramètre du nœud</div>
                <p class="text-xs text-gray-400">
                    Cochez les champs à afficher sur ce nœud. Les champs <span class="pill">🔒 admin</span>
                    sont imposés par l'administrateur du type.
                </p>
            </div>
            <button type="button" data-action="tabs#toProps" class="text-xs hover:underline shrink-0" style="color:var(--c-muted)">✕ Fermer</button>
        </div>

        <form method="post" action="{{ path('node_params', {id: node.id}) }}" data-turbo-frame="_top" class="space-y-4">

            {# type de nœud (modifiable) #}
            <div>
                <div class="fld-label">Type de nœud</div>
                <select name="typeKey" class="fld mt-1">
                    {% for t in all_node_types() %}
                        <option value="{{ t.key }}" {{ t.key == node.type.key ? 'selected' }}>{{ t.icon }} {{ t.label }}</option>
                    {% endfor %}
                </select>
                <div class="fld-help">Changer le type réinitialise les champs de ce nœud sur les valeurs du nouveau type.</div>
            </div>

            <div class="flex items-center gap-3 text-gray-300 text-[11px] uppercase tracking-widest">
                <div class="h-px flex-1 bg-gray-200"></div>Configuration du nœud<div class="h-px flex-1 bg-gray-200"></div>
            </div>

            {# flag mutualisable (si le type le porte) #}
            {% if typeCaps.mutualisable is defined %}
                {% set mutLocked = node.type.isCapabilityLocked('mutualisable') %}
                <label class="flex items-center gap-3 text-sm">
                    <input type="checkbox" name="capabilities[]" value="mutualisable"
                           {{ (caps.mutualisable ?? false) ? 'checked' }} {{ mutLocked ? 'disabled' }}>
                    <span class="font-medium uppercase text-xs tracking-wide text-gray-500">Nœud mutualisable / accrochable</span>
                    {% if mutLocked %}<span class="pill">🔒 admin</span>{% endif %}
                </label>
            {% endif %}

            {# champs toujours présents (cœur du nœud) — indicatif #}
            <div class="space-y-1.5 opacity-70">
                {% for coreLabel in ['Nœud parent', 'Libellé', 'Code'] %}
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" checked disabled>
                        <span class="uppercase text-xs tracking-wide text-gray-500">{{ coreLabel }}</span>
                        <span class="pill">🔒 cœur</span>
                    </label>
                {% endfor %}
            </div>

            {# capacités « champ » que le type expose #}
            <div class="space-y-1.5">
                {% for key, defaultOn in typeCaps|filter((v, k) => k != 'mutualisable') %}
                    {% set locked = node.type.isCapabilityLocked(key) %}
                    <label class="flex items-center gap-2 text-sm">
                        <input type="checkbox" name="capabilities[]" value="{{ key }}"
                               {{ (caps[key] ?? false) ? 'checked' }} {{ locked ? 'disabled' }}>
                        <span class="uppercase text-xs tracking-wide text-gray-500">{{ labels[key] ?? key }}</span>
                        {% if locked %}<span class="pill">🔒 admin</span>{% endif %}
                    </label>
                {% endfor %}
            </div>

            <div class="flex items-center gap-2 pt-2 border-t" style="border-color:var(--c-border)">
                <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">Enregistrer</button>
                <a href="{{ path('node_type_edit', {id: node.type.id}) }}" target="_blank"
                   class="text-xs hover:underline" style="color:var(--c-muted)">Gérer le type « {{ T }} » (admin) ↗</a>
            </div>
        </form>
    </div>

    {# ── formulaire ── #}
    <form method="post" action="{{ path('node_save', {id: node.id}) }}" data-turbo-frame="_top" class="space-y-5">

        {# --- onglet Propriétés --- #}
        <div data-tabs-target="panel" data-tab="props" class="space-y-5">
            {% set parents = valid_parents(node) %}
            {{ ui.label("Nœud parent", true, "Emplacement autorisé par le squelette de la formation") }}
            <select name="parentId" class="fld">
                {% if can_be_root(node) %}<option value="">— Racine de la formation —</option>{% endif %}
                {% for cand in parents %}
                    <option value="{{ cand.id }}" {{ node.parent and node.parent.id == cand.id ? 'selected' }}>
                        [{{ cand.type.label }}] {{ cand.label ?: '—' }}
                    </option>
                {% endfor %}
            </select>
            {% if parents is empty and not can_be_root(node) %}
                <div class="fld-help text-amber-600">Aucun emplacement : le squelette ne prévoit pas ce type sous un autre nœud.</div>
            {% endif %}

            {{ ui.label("Libellé", true, "Max 200 caractères") }}
            <input name="label" value="{{ node.label }}" maxlength="200" class="fld">

            {{ ui.label("Code", false, "Code du nœud (ex. code de l'EC)") }}
            <input name="code" value="{{ node.code }}" class="fld">

            {% for key, def in catalog %}
                {% if (caps[key] ?? false) and def.domain == 'props' %}
                    {{ ui.field(key, def, node) }}
                {% endif %}
            {% endfor %}

            {% if node.isParcours %}
                {% set pcands = parcours_candidates(node) %}
                <div class="rounded-lg border p-3 space-y-3" style="border-color:var(--c-border);background:#f8f9fb">
                    <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Arborescence des parcours</div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            {{ ui.label("Année de début", false) }}
                            <input type="number" min="1" name="attr_anneeDebut" value="{{ node.getAttribute('anneeDebut') }}" placeholder="{{ node.anneeDebut }}" class="fld">
                        </div>
                        <div>
                            {{ ui.label("Année de fin", false) }}
                            <input type="number" min="1" name="attr_anneeFin" value="{{ node.getAttribute('anneeFin') }}" placeholder="{{ node.anneeFin }}" class="fld">
                        </div>
                    </div>
                    {{ ui.label("Parcours parent", false, "Une spécialisation qui se sépare d’un autre parcours : elle commence après lui et se prolonge au moins jusqu’à sa fin.") }}
                    <select name="parcoursParentId" class="fld">
                        <option value="">— Aucun (parcours racine) —</option>
                        {% for cand in pcands %}
                            <option value="{{ cand.id }}" {{ node.parcoursParent and node.parcoursParent.id == cand.id ? 'selected' }}>{{ cand.label ?: '—' }} · années {{ cand.anneeDebut }}–{{ cand.anneeFin }}</option>
                        {% endfor %}
                    </select>
                    {% if pcands is empty %}
                        <p class="fld-help">Aucun parcours antérieur compatible. Renseignez les années ci-dessus puis enregistrez : les parcours qui se terminent avant deviendront sélectionnables.</p>
                    {% endif %}
                    <a href="{{ path('formation_parcours_graph', {id: formation.id}) }}" data-turbo-frame="node-panel"
                       class="inline-block text-xs font-medium hover:underline" style="color:var(--c-primary)">🗺 Voir l'arborescence des parcours</a>
                </div>
            {% endif %}
        </div>

        {# --- onglet Volume horaire --- #}
        {% if hasHours %}
        <div data-tabs-target="panel" data-tab="volume_horaire" class="space-y-3" hidden>
            {{ ui.field('hours', catalog.hours, node) }}
        </div>
        {% endif %}

        {# --- onglet MCCC --- #}
        {% if hasMccc %}
        <div data-tabs-target="panel" data-tab="mccc" class="space-y-3" hidden>
            {{ ui.field('mccc', catalog.mccc, node) }}
        </div>
        {% endif %}

        <div class="flex items-center gap-2 pt-2 border-t" style="border-color:var(--c-border)">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">Enregistrer</button>
            <span class="text-xs text-gray-400">Dupliquer / supprimer : bas de l'arborescence</span>
        </div>
    </form>

    {# ── ajouter un enfant ── #}
    {% if childTypes is not empty %}
    <form method="post" action="{{ path('node_add', {id: formation.id}) }}" data-turbo-frame="_top"
          class="rounded-xl border p-3 flex flex-wrap items-end gap-2" style="border-color:var(--c-border)">
        <input type="hidden" name="parentId" value="{{ node.id }}">
        <div class="flex-1 min-w-[180px]">
            <div class="fld-label">Ajouter un enfant</div>
            <select name="typeKey" class="fld mt-1">
                {% for t in childTypes %}<option value="{{ t.key }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
            </select>
        </div>
        <input name="label" placeholder="Libellé" class="fld w-40">
        <button class="rounded-lg border px-4 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">＋ Ajouter</button>
    </form>
    {% endif %}

</div>
</turbo-frame>

{# ─────────────── macros ─────────────── #}
{% macro label(text, required, help) %}
    <div>
        <div class="flex items-center justify-between">
            <span class="fld-label">{{ text }}</span>
            {% if required %}<span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide">Champs requis</span>{% endif %}
        </div>
        {% if help %}<div class="fld-help">ℹ {{ help }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro field(key, def, node) %}
    {% import _self as ui %}
    {% set val = node.getAttribute(key) %}
    {{ ui.label(def.label, def.required ?? false, def.help ?? null) }}
    {% if def.field == 'number' %}
        <input type="number" step="0.5" name="attr_{{ key }}" value="{{ val }}" class="fld w-44">
    {% elseif def.field == 'choice' %}
        <select name="attr_{{ key }}" class="fld">
            <option value="">— Choisir —</option>
            {% for ov, ol in def.options %}<option value="{{ ov }}" {{ val == ov ? 'selected' }}>{{ ol }}</option>{% endfor %}
        </select>
    {% elseif def.field == 'competencies' %}
        <input name="attr_competencies" value="{{ val ? val|join(', ') : '' }}" placeholder="Compétence 1, Compétence 2…" class="fld">
    {% elseif def.field == 'hours' %}
        <table class="text-sm">
            <thead><tr><th></th>{% for p, pl in constant('App\\Maquette\\AttributeCatalog::HOUR_PLACES') %}<th class="px-2 text-xs font-medium text-gray-500">{{ pl }}</th>{% endfor %}</tr></thead>
            <tbody>
            {% for m, ml in constant('App\\Maquette\\AttributeCatalog::HOUR_MODALITIES') %}
                <tr><td class="pr-3 text-xs font-semibold text-gray-500">{{ ml }}</td>
                    {% for p, pl in constant('App\\Maquette\\AttributeCatalog::HOUR_PLACES') %}
                        <td class="py-0.5"><input type="number" min="0" step="0.5" name="attr_hours_{{ m }}_{{ p }}" value="{{ val[m][p] ?? '' }}" class="w-16 rounded-md border px-2 py-1" style="border-color:var(--c-border)"></td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% elseif def.field == 'mccc' %}
        <div class="space-y-2">
            <input name="attr_mccc[type]" value="{{ val.type ?? '' }}" placeholder="Type d'épreuve (CC, examen terminal…)" class="fld">
            <input name="attr_mccc[note]" value="{{ val.note ?? '' }}" placeholder="Précision (pondération, session…)" class="fld">
        </div>
    {% else %}
        <input name="attr_{{ key }}" value="{{ val }}" class="fld">
    {% endif %}
{% endmacro %}
