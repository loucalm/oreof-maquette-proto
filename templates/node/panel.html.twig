{# Panneau d'édition d'un nœud — façon maquette Figma. Rendu dans <turbo-frame id="node-panel">. #}
{% import _self as ui %}
{% set caps = node.effectiveCapabilities() %}
{% set formation = node.formation %}
{% set childTypes = types_allowed_for(node) %}
{% set T = node.type.label %}

{% set consolidation = node.formation.phase.value == 'consolidation' %}
{% set hasHours = caps.hours ?? false %}
{% set hasMccc = caps.mccc ?? false %}

<turbo-frame id="node-panel">
<div class="panel-body" data-controller="tabs modal" data-tabs-key-value="{{ formation.id }}:{{ node.id }}" data-panel-active="node:{{ node.id }}">

    <div class="panel-head">
        <div class="panel-head-top">
            <h2 class="text-xl font-bold">{{ 'node.panel.title'|trans({}, 'node') }}</h2>
            {# déplacer l'élément parmi ses frères (alternative au glisser-déposer, accessible au clavier) puis
               copier / coller ses données. Dupliquer et supprimer sont dans la barre de l'arbre. #}
            {% set clipboard = node_clipboard(node) %}
            <div class="panel-tools">
                <div class="panel-move" role="group" aria-label="{{ 'node.panel.actions_aria'|trans({}, 'node') }}">
                    {% for dir in ['up', 'down'] %}
                        <form method="post" action="{{ path('node_shift', {fid: formation.id, nid: node.id, dir: dir}) }}" data-turbo-frame="_top">
                            <button class="panel-move-btn" title="{{ ('node.panel.shift_' ~ dir)|trans({}, 'node') }}" aria-label="{{ ('node.panel.shift_' ~ dir)|trans({}, 'node') }}">{{ ux_icon(dir == 'up' ? 'ph:arrow-up' : 'ph:arrow-down', {class: 'icon'}) }}</button>
                        </form>
                    {% endfor %}
                </div>
                <div class="panel-move" role="group" aria-label="{{ 'node.panel.clipboard_aria'|trans({}, 'node') }}">
                    <form method="post" action="{{ node_url(node, 'node_copy') }}" data-turbo-frame="_top">
                        <button class="panel-move-btn" title="{{ 'node.panel.copy_title'|trans({'%type%': T}, 'node') }}" aria-label="{{ 'node.panel.copy_title'|trans({'%type%': T}, 'node') }}">{{ ux_icon('ph:copy', {class: 'icon'}) }}</button>
                    </form>
                    {% set blocked = clipboard.blocked %}
                    <form method="post" action="{{ node_url(node, 'node_paste') }}" data-turbo-frame="_top">
                        {% set pasteTitle = blocked
                            ? ('node.panel.paste_blocked_' ~ blocked)|trans({'%type%': clipboard.clip.typeLabel ?? '', '%current%': T}, 'node')
                            : 'node.panel.paste_title'|trans({'%label%': clipboard.clip.label ?? '', '%count%': (clipboard.clip.attributes ?? [])|length}, 'node') %}
                        <button class="panel-move-btn {{ blocked ? '' : 'panel-move-btn--ready' }}" {{ blocked ? 'disabled' }} title="{{ pasteTitle }}" aria-label="{{ pasteTitle }}">{{ ux_icon('ph:clipboard-text', {class: 'icon'}) }}</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="text-sm text-gray-400">
            {{ T }}{% if view.ref %} <span class="font-bold" style="color:var(--c-primary)">{{ view.ref }}</span>{% endif %}
            {%- if node.isLocked('delete') %} <span class="imposed-badge" title="{{ 'node.panel.locked_title'|trans({}, 'node') }}">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }} {{ 'node.panel.imposed_badge'|trans({}, 'node') }}</span>{% endif -%}
        </div>
        <div class="text-sm text-gray-400 mt-1">
            {{ formation.name }}
            {%- for p in node_path(node) %} › {{ p.label ?: p.type.label }}{% endfor -%}
        </div>
        {% set src = mutualization_source(node) %}
        {% if src %}
            <div class="mt-2 rounded-lg px-3 py-2 text-xs" style="background:{{ src.changed ? '#fffbeb' : '#f1f5f9' }};color:{{ src.changed ? '#92400e' : '#475569' }}">
                {{ ux_icon('ph:share-network', {class: 'icon'}) }}
                {% if src.node %}
                    {{ 'node.panel.copied_from'|trans({'%formation%': src.formation.name, '%node%': src.node.displayLabel}, 'node') }}
                    {% if src.changed %}
                        <strong>{{ 'node.panel.source_changed'|trans({}, 'node') }}</strong>
                        <form method="post" action="{{ node_url(node, 'node_attach_refresh') }}" data-turbo-frame="_top" class="inline"
                              data-controller="confirm" data-confirm-message-value="{{ 'node.panel.refresh_confirm'|trans({}, 'node') }}">
                            <button class="ml-1 underline font-semibold">{{ 'node.panel.refresh_from_source'|trans({}, 'node') }}</button>
                        </form>
                    {% endif %}
                {% else %}
                    {{ 'node.panel.source_missing'|trans({}, 'node') }}
                {% endif %}
            </div>
        {% endif %}
        {% for d in node_derogations(formation, node.id) %}
            <div class="mt-1 text-xs" style="color:{{ d.isPending ? '#b45309' : (d.status.value == 'approved' ? '#15803d' : '#b91c1c') }}">
                {{ ux_icon('ph:flag', {class: 'icon'}) }} {{ 'derogation.tracking.node_status'|trans({'%status%': d.status.label|lower, '%date%': (d.resolvedAt ?? d.createdAt)|date('d/m/Y')}, 'derogation') }}{% if d.adminNote %} — {{ d.adminNote }}{% endif %}
            </div>
        {% endfor %}
    </div>

    <div class="panel-scroll">
    <div class="panel-card space-y-5">

    {# onglets présents sur ce nœud (déduits des champs actifs) #}
    {% set nodeTabs = ['props'] %}
    {% for key, def in (consolidation ? {} : catalog) %}
        {% if (caps[key] ?? false) and def.domain not in nodeTabs %}
            {% set nodeTabs = nodeTabs|merge([def.domain]) %}
        {% endif %}
    {% endfor %}
    <div class="flex flex-wrap gap-2" role="tablist">
        {% for tk in nodeTabs %}
            <button type="button" role="tab" data-tabs-target="tab" data-tab="{{ tk }}" class="tab-pill">
                <span class="status-dot" data-status="{{ node_tab_status(node, tk) }}"></span>
                {{ domains[tk] ?? tk }}
            </button>
        {% endfor %}
    </div>

    {# champs requis manquants / non conformes : un clic ouvre l'onglet et place le curseur dans le champ #}
    {% set missing = node_missing(node) %}
    {% if missing is not empty %}
        <div class="issues-box" role="status">
            <span class="font-semibold">{{ 'node.panel.missing_title'|trans({'%count%': missing|length}, 'node') }}</span>
            {% for m in missing %}
                <button type="button" class="issue-chip" data-action="tabs#focusField"
                        data-tabs-tab-param="{{ m.tab }}" data-tabs-field-param="{{ m.key }}"
                        {% if m.detail is defined %}title="{{ m.detail }}"{% endif %}>{{ m.label }}</button>
            {% endfor %}
        </div>
    {% endif %}

    {# tuiles + actions #}
    <div class="flex flex-wrap items-stretch gap-2">
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="text-gray-500">{{ 'node.panel.total_hours_label'|trans({}, 'node') }}</span> <span class="font-semibold">{{ view.totalHours|round }}</span>
        </div>
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="font-semibold">{{ view.totalEcts|round }}</span>
            <span class="text-gray-500">{% if view.ectsTarget %}{{ 'node.panel.ects_target'|trans({'%target%': view.ectsTarget}, 'node') }} {% endif %}{{ 'node.panel.ects_unit'|trans({}, 'node') }}</span>
        </div>
        <div class="ml-auto flex flex-wrap gap-2">
            {% if not node.isChoiceBloc() and node.getParent() and node.type.choiceTransformable %}
            <form method="post" action="{{ path('node_convert_choice', {fid: formation.id, nid: node.id}) }}" data-turbo-frame="_top"
                  data-controller="confirm"
                  data-confirm-message-value="{{ 'node.panel.convert_choice_confirm'|trans({'%label%': node.getDisplayLabel()}, 'node') }}">
                <button class="rounded-lg border px-3 py-2 text-sm" style="border-color:#e9d5ff;background:#faf5ff;color:#9333ea"
                        title="{{ 'node.panel.convert_choice_title'|trans({}, 'node') }}">
                    {{ ux_icon('ph:shuffle', {class: 'icon'}) }} {{ 'node.panel.convert_choice_button'|trans({}, 'node') }}
                </button>
            </form>
            {% endif %}
            {% if caps.mutualisable ?? false %}
            <form method="post" action="{{ node_url(node, 'node_mutualize') }}" data-turbo-frame="_top">
                <button class="rounded-lg border px-3 py-2 text-sm" style="border-color:#fcd34d;color:#b45309">
                    {{ ux_icon('ph:share-network', {class: 'icon'}) }} {{ node.mutualized ? 'node.panel.unmutualize'|trans({}, 'node') : 'node.panel.mutualize'|trans({}, 'node') }} [{{ T }}]
                </button>
            </form>
            {% endif %}
            {% if childTypes is not empty %}
            <a href="{{ node_url(node, 'node_attach_index') }}" data-turbo-frame="node-panel"
               class="rounded-lg border px-3 py-2 text-sm text-green-700" style="border-color:#bbf7d0">{{ ux_icon('ph:arrow-bend-down-right', {class: 'icon'}) }} {{ 'node.panel.reattach_button'|trans({}, 'node') }}</a>
            {% endif %}
            {% if is_admin() %}
            <button type="button" data-action="modal#open" class="rounded-lg border px-3 py-2 text-sm text-gray-600" style="border-color:var(--c-border)">{{ ux_icon('ph:gear', {class: 'icon'}) }} {{ 'node.panel.node_params_button'|trans({'%type%': T}, 'node') }}</button>
            {% endif %}
        </div>
    </div>

    {# ── formulaire ── #}
    <form method="post" action="{{ node_url(node, 'node_save') }}" data-turbo-frame="_top" class="space-y-5"
          id="node-form" data-controller="dirty-form">

        {% for tk in nodeTabs %}
        <div data-tabs-target="panel" data-tab="{{ tk }}" class="space-y-5" {{ not loop.first ? 'hidden' }}>

            {# séparateur : nom de l'onglet actif #}
            <div class="flex items-center gap-3 text-gray-300 text-xs uppercase tracking-widest">
                <div class="h-px flex-1 bg-gray-200"></div>{{ domains[tk] ?? tk }}<div class="h-px flex-1 bg-gray-200"></div>
            </div>

            {% if tk == 'props' %}
                {% if node.type.temporel %}
                    {{ ui.label('node.panel.label_field'|trans({}, 'node'), false, 'node.panel.temporel_label_help'|trans({}, 'node')) }}
                    <div class="fld flex items-center" style="background:#f8f9fb;color:var(--c-muted)">{{ node_display_label(node, view.ref) }}</div>
                {% else %}
                    {{ ui.label('node.panel.label_field'|trans({}, 'node'), true, 'node.panel.label_help'|trans({}, 'node')) }}
                    <input name="label" value="{{ node.label }}" maxlength="200" class="fld">
                {% endif %}

                {% if caps.code ?? false %}
                    {% set codeRequired = node.type.codeRequired %}
                    {{ ui.label(codeRequired ? 'node.panel.ec_code_label'|trans({}, 'node') : 'node.panel.code_label'|trans({}, 'node'), codeRequired, codeRequired ? 'node.panel.ec_code_help'|trans({}, 'node') : 'node.panel.code_help'|trans({}, 'node')) }}
                    <input name="code" value="{{ node.code }}" class="fld">
                {% endif %}
            {% endif %}

            {% if consolidation and tk == 'props' %}
                <p class="issues-box">{{ ux_icon('ph:hourglass-medium', {class: 'icon'}) }} {{ 'formation.editor.consolidation_readonly'|trans({}, 'formation') }}</p>
            {% endif %}
            {# champs (et séparateurs) du catalogue pour cet onglet, dans l'ordre #}
            {% for key, def in (consolidation ? {} : catalog) %}
                {% if def.domain == tk and (caps[key] ?? false) %}
                    {{ ui.field(key, def, node) }}
                {% endif %}
            {% endfor %}

            {% if tk == 'props' %}
                {% set parents = valid_parents(node) %}
                {% set lockedMove = node.isLocked('move') %}
                <details class="move-box">
                <summary class="fld-label cursor-pointer">{{ ux_icon('ph:arrows-out-cardinal', {class: 'icon'}) }} {{ 'node.panel.move_summary'|trans({}, 'node') }}</summary>
                <div class="mt-2 space-y-1">
                <div class="fld-help">{{ ux_icon('ph:info', {class: 'icon'}) }} {{ 'node.panel.parent_help'|trans({}, 'node') }}</div>
                <select name="parentId" class="fld" {{ lockedMove ? 'disabled' }}>
                    {% if can_be_root(node) %}<option value="">{{ 'node.panel.root_option'|trans({}, 'node') }}</option>{% endif %}
                    {% for cand in parents %}
                        <option value="{{ cand.id }}" {{ node.parent and node.parent.id == cand.id ? 'selected' }}>
                            [{{ cand.type.label }}] {{ cand.label ?: '—' }}
                        </option>
                    {% endfor %}
                </select>
                {% if lockedMove %}
                    <div class="fld-help">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }} {{ 'node.panel.parent_locked_help'|trans({}, 'node') }}</div>
                {% elseif parents is empty and not can_be_root(node) %}
                    <div class="fld-help text-amber-600">{{ 'node.panel.no_location_help'|trans({}, 'node') }}</div>
                {% endif %}
                </div>
                </details>
            {% endif %}

            {% if tk == 'props' and node.isParcours %}
                {% set unit = period_unit(formation) %}
                <div class="rounded-lg border p-3 space-y-3" style="border-color:var(--c-border);background:#f8f9fb">
                    <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">{{ 'node.panel.ramification_title'|trans({}, 'node') }}</div>
                    <p class="fld-help">
                        {{ ux_icon('ph:info', {class: 'icon'}) }} {{ 'node.panel.ramification_note'|trans({'%unit%': unit|lower}, 'node') }}
                    </p>
                    <div class="grid grid-cols-2 gap-2 text-sm">
                        <div>
                            <div class="text-[11px] uppercase tracking-wide text-gray-400">{{ 'node.panel.period_start'|trans({'%unit%': unit}, 'node') }}</div>
                            <div class="font-medium mt-0.5">{{ node.periodeDebut }}</div>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase tracking-wide text-gray-400">{{ 'node.panel.period_end'|trans({'%unit%': unit}, 'node') }}</div>
                            <div class="font-medium mt-0.5">{{ node.periodeFin }}</div>
                        </div>
                    </div>
                    <div class="text-sm">
                        <div class="text-[11px] uppercase tracking-wide text-gray-400">{{ 'node.panel.parcours_parent_label'|trans({}, 'node') }}</div>
                        <div class="font-medium mt-0.5">{{ node.parcoursParent ? node.parcoursParent.displayLabel : 'node.panel.parcours_parent_none'|trans({}, 'node') }}</div>
                    </div>
                    <a href="{{ path('formation_parcours_graph', {id: formation.id, current: node.id}) }}" data-turbo-frame="node-panel"
                       class="inline-block text-xs font-medium hover:underline" style="color:var(--c-primary)">{{ ux_icon('ph:map-trifold', {class: 'icon'}) }} {{ 'node.panel.view_ramification_link'|trans({}, 'node') }}</a>
                </div>
            {% endif %}
        </div>
        {% endfor %}

        <div class="panel-savebar">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <span class="text-xs font-medium text-amber-700" data-dirty-form-target="indicator" hidden>{{ ux_icon('ph:circle-fill', {class: 'icon'}) }} {{ 'node.panel.unsaved'|trans({}, 'node') }}</span>
            <span class="ml-auto text-xs text-gray-400"><span class="text-red-500">*</span> {{ 'common.required_legend'|trans({}, 'common') }}</span>
        </div>
    </form>

    {# formulaires « ajout rapide au référentiel » : HORS du formulaire principal (pas de formulaire imbriqué),
       leurs champs y sont rattachés par l'attribut form="…" #}
    {% for key, def in catalog %}
        {% if (caps[key] ?? false) and def.quickAdd and def.referentielKey %}
            <form id="qa-{{ key }}" method="post" action="{{ path('referentiel_quick_add', {key: def.referentielKey}) }}" data-turbo-frame="node-panel" hidden>
                <input type="hidden" name="fid" value="{{ formation.id }}">
                <input type="hidden" name="nid" value="{{ node.id }}">
            </form>
        {% endif %}
    {% endfor %}

    {# ── modale « Paramètre du nœud » ── #}
    <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
            class="rounded-2xl border-0 p-0 w-[min(600px,94vw)] backdrop:bg-black/40">
        <turbo-frame id="node-params-frame" src="{{ node_url(node, 'node_params_form') }}" loading="lazy" class="block">
            <div class="p-10 text-center text-sm text-gray-400">{{ 'common.loading'|trans({}, 'common') }}</div>
        </turbo-frame>
    </dialog>

    {# ── ajouter un enfant (ou, sur une feuille, un élément du même type juste après) ── #}
    {% if childTypes is empty and node.getParent() is not null and not node.isLocked('add') %}
    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
          class="rounded-xl border p-3 flex flex-wrap items-end gap-2" style="border-color:var(--c-border)">
        <input type="hidden" name="parentId" value="{{ node.getParent().id }}">
        <input type="hidden" name="typeKey" value="{{ node.type.key }}">
        <input type="hidden" name="afterId" value="{{ node.id }}">
        <div class="flex-1 min-w-[180px]">
            <label class="fld-label" for="add-sibling-label">{{ 'node.panel.add_sibling_label'|trans({'%type%': T}, 'node') }}</label>
            <input id="add-sibling-label" name="label" placeholder="{{ 'node.panel.label_field'|trans({}, 'node') }}" class="fld mt-1">
        </div>
        <button class="rounded-lg border px-4 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }}</button>
    </form>
    {% endif %}
    {% if childTypes is not empty %}
    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
          class="rounded-xl border p-3 flex flex-wrap items-end gap-2" style="border-color:var(--c-border)">
        <input type="hidden" name="parentId" value="{{ node.id }}">
        <div class="flex-1 min-w-[180px]">
            <div class="fld-label">{{ 'node.panel.add_child_label'|trans({}, 'node') }}</div>
            <select name="typeKey" class="fld mt-1">
                {% for t in childTypes %}<option value="{{ t.key }}">{{ t.label }}</option>{% endfor %}
            </select>
        </div>
        <input name="label" placeholder="{{ 'node.panel.label_field'|trans({}, 'node') }}" class="fld w-40">
        <button class="rounded-lg border px-4 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }}</button>
    </form>
    {% endif %}

    </div>
    </div>

</div>
</turbo-frame>

{# ─────────────── macros ─────────────── #}
{% macro label(text, required, help) %}
    <div>
        <div class="flex items-center justify-between">
            <span class="fld-label">{{ text }}{% if required %} <span class="text-red-500" aria-hidden="true">*</span><span class="sr-only">{{ 'common.required_badge'|trans({}, 'common') }}</span>{% endif %}</span>
        </div>
        {% if help %}<div class="fld-help">{{ ux_icon('ph:info', {class: 'icon'}) }} {{ help }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro field(key, def, node) %}
    {% import _self as ui %}
    {# un champ « système » (heures, MCCC) porte son propre libellé dans son gabarit ; un séparateur n'a rien à saisir #}
    {% set ftype = field_type(def) %}
    {% if ftype.input and not ftype.system %}
        {% set tl = node.type.label %}
        {{ ui.label(def.label|replace({'%type%': tl}), def.required ?? false, def.help ? def.help|replace({'%type%': tl}) : null) }}
    {% endif %}
    {{ field_widget(def, key, node.getAttribute(key), 'attr_' ~ key, node) }}
{% endmacro %}
