{% extends 'base.html.twig' %}
{% block title %}{{ 'diplome.edit.title'|trans({'%label%': type.label}, 'diplome') }}{% endblock %}

{% set header_title = 'diplome.edit.heading'|trans({'%label%': type.label, '%year%': version.anneeUniversitaire}, 'diplome') %}
{% set header_breadcrumb = [
    {label: 'layout.nav.diplomes'|trans({}, 'layout'), url: path('diplome_index')},
    {label: type.label},
] %}

{% block bouton_header %}
    <form method="post" action="{{ path('diplome_version_new', {id: type.id}) }}">
        {% include 'diplome/_csrf.html.twig' %}
        <twig:Button type="submit" variant="primary" icon="ph:calendar-plus" :label="'diplome.edit.new_version'|trans({}, 'diplome')" data-action="new-version"/>
    </form>
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'diplome.edit.back'|trans({}, 'diplome')" :href="path('diplome_index')"/>
{% endblock %}

{% block body %}
<nav class="mb-4 flex flex-wrap items-center gap-2 text-xs" aria-label="{{ 'diplome.edit.versions'|trans({}, 'diplome') }}">
            <span class="app-meta-label mb-0 mr-1">{{ 'diplome.edit.versions'|trans({}, 'diplome') }}</span>
            {% for v in versions %}
                <a href="{{ path('diplome_edit', {id: type.id, versionId: v.id, step: step}) }}" data-version="{{ v.anneeUniversitaire }}"
                   class="inline-flex items-center rounded-full border px-2.5 py-0.5 font-semibold transition {{ v.id == version.id ? 'border-primary-600 bg-primary-600 text-white' : 'border-primary-300 bg-primary-50 text-primary-700 hover:bg-primary-100' }}" {{ v.id == version.id ? 'aria-current="true"' }}>{{ v.anneeUniversitaire }}</a>
            {% endfor %}
        </nav>


{% if formations is not empty %}
<section class="mb-5 rounded-2xl border border-warning-200 bg-warning-50 p-4 text-sm text-warning-800" data-impact>
    <p class="font-semibold">{{ 'diplome.edit.impact_title'|trans({'%count%': formations|length}, 'diplome') }}</p>
    <ul class="mt-2 list-disc pl-5">
        {% for f in formations %}
            <li><a href="{{ path('formation_editor', {id: f.id}) }}" class="hover:underline">{{ f.name }}</a></li>
        {% endfor %}
    </ul>
</section>
{% endif %}

<nav class="app-tabs-list mb-4" aria-label="{{ 'diplome.edit.tabs'|trans({}, 'diplome') }}">
        {% for s in steps %}
            <a href="{{ path('diplome_edit', {id: type.id, versionId: version.id, step: s}) }}" data-step="{{ s }}" {{ s == step ? 'aria-current="page"' }}
               class="app-tab {{ s == step ? 'app-tab-active' }}">{{ ('diplome.wizard.steps.' ~ s)|trans({}, 'diplome') }}</a>
        {% endfor %}
</nav>
<div class="rounded-xl border border-secondary-200 bg-surface shadow-sm">
    <section class="p-6">
        {% block step_content %}{% endblock %}
        <div class="mt-6 flex items-center justify-end gap-4 border-t border-secondary-200 pt-4">
            {% if formations is not empty %}
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="confirmImpact" value="1" form="wizard-form" data-confirm-impact>
                    {{ 'diplome.edit.confirm_impact'|trans({'%count%': formations|length}, 'diplome') }}
                </label>
            {% endif %}
            <button form="wizard-form" class="inline-flex h-10 items-center gap-1.5 rounded-md bg-success-600 px-4 text-sm font-medium text-white transition-colors hover:bg-success-700">{{ ux_icon('ph:floppy-disk', {class: 'h-4 w-4'}) }} {{ 'diplome.edit.save'|trans({}, 'diplome') }}</button>
        </div>
    </section>
</div>
{% endblock %}
