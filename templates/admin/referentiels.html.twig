{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'referentiels' %}
{% block title %}{{ 'admin.referentiels.title'|trans({}, 'admin') }}{% endblock %}

{# rangée : valeurs = liste de libellés, ou map {clé: libellé} #}
{% macro row(title, help, values) %}
    <div>
        <div class="fld-label">{{ title }}</div>
        {% if help %}<div class="fld-help mb-1.5">{{ help }}</div>{% else %}<div class="mb-1.5"></div>{% endif %}
        <div class="flex flex-wrap gap-1.5">
            {% for k, label in values %}
                <span class="rounded-md border px-2 py-0.5 text-xs" style="border-color:var(--c-border);background:#fff">
                    {{ label }}{% if k is not same as(loop.index0) and k != label %}<span class="text-gray-400"> · {{ k }}</span>{% endif %}
                </span>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% block admin_body %}
{% import _self as ui %}

<div class="mb-5">
    <h2 class="text-lg font-bold">{{ 'admin.referentiels.heading'|trans({}, 'admin') }}</h2>
    <p class="text-sm text-gray-500">
        {{ 'admin.referentiels.description'|trans({}, 'admin') }}
    </p>
</div>

<div class="space-y-4">

    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'admin.referentiels.metamodel_title'|trans({}, 'admin') }}</div>
        {% set famMap = {} %}
        {% for f in families %}{% set famMap = famMap|merge({(f.value): f.label}) %}{% endfor %}
        {{ ui.row('admin.referentiels.families_row_title'|trans({}, 'admin'), 'admin.referentiels.families_row_help'|trans({}, 'admin'), famMap) }}
        {{ ui.row('admin.referentiels.field_types_row_title'|trans({}, 'admin'), 'admin.referentiels.field_types_row_help'|trans({}, 'admin'), fieldTypes) }}
    </div>

    {% if choiceFields %}
        <div class="rounded-xl border bg-white p-5 space-y-3" style="border-color:var(--c-border)">
            <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">
                {{ 'admin.referentiels.choice_fields_title'|trans({}, 'admin') }}
                <a href="{{ path('field_index') }}" class="ml-2 font-normal normal-case text-gray-400 underline">{{ 'admin.referentiels.choice_fields_link'|trans({}, 'admin') }}</a>
            </div>
            {% for f in choiceFields %}
                {{ ui.row(f.label ~ '  (' ~ f.key ~ ')', null, f.options) }}
            {% endfor %}
        </div>
    {% endif %}

    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'admin.referentiels.hours_title'|trans({}, 'admin') }}</div>
        {{ ui.row('admin.referentiels.hour_modalities_row_title'|trans({}, 'admin'), null, hourModalities) }}
        {{ ui.row('admin.referentiels.hour_places_row_title'|trans({}, 'admin'), 'admin.referentiels.hour_places_row_help'|trans({}, 'admin'), hourPlaces) }}
        <p class="text-xs" style="color:var(--c-muted)">
            {{ 'admin.referentiels.mcc_note'|trans({'%link_open%': '<a href="' ~ path('admin_mcctypes') ~ '" class="underline">', '%link_close%': '</a>'}, 'admin')|raw }}
        </p>
    </div>

    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="flex items-start justify-between">
            <div>
                <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'admin.referentiels.nomenclatures_title'|trans({}, 'admin') }}</div>
                <p class="text-xs mt-1" style="color:var(--c-muted)">{{ 'admin.referentiels.nomenclatures_description'|trans({}, 'admin') }}</p>
            </div>
            <a href="{{ path('referentiel_new') }}" class="shrink-0 rounded-md px-3 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'admin.referentiels.new_button'|trans({}, 'admin') }}</a>
        </div>
        {% for ref in referentiels %}
            <div class="rounded-lg border p-3" style="border-color:var(--c-border)">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <span class="font-medium text-sm">{{ ref.label }}</span>
                        <code class="text-xs ml-1" style="color:var(--c-muted)">{{ ref.key }}</code>
                        {% if ref.system %}<span class="pill ml-1">{{ 'common.badge_socle'|trans({}, 'common') }}</span>{% endif %}
                        {% if ref.description %}<div class="fld-help mt-0.5">{{ ref.description }}</div>{% endif %}
                    </div>
                    <div class="shrink-0 whitespace-nowrap text-right">
                        <a href="{{ path('referentiel_edit', {id: ref.id}) }}" class="text-xs hover:underline">{{ 'common.edit'|trans({}, 'common') }}</a>
                        {% if not ref.system %}
                            <form method="post" action="{{ path('referentiel_delete', {id: ref.id}) }}" class="inline"
                                  data-controller="confirm" data-confirm-message-value="{{ 'admin.referentiels.delete_confirm'|trans({'%label%': ref.label}, 'admin') }}">
                                <button class="text-xs text-red-600 hover:underline ml-2">{{ 'common.delete'|trans({}, 'common') }}</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                <div class="flex flex-wrap gap-1.5 mt-2">
                    {% for k, label in ref.values %}
                        <span class="rounded-md border px-2 py-0.5 text-xs" style="border-color:var(--c-border);background:#fff">
                            {{ label }}{% if k is not same as(loop.index0) and k != label %}<span class="text-gray-400"> · {{ k }}</span>{% endif %}
                        </span>
                    {% else %}
                        <span class="text-xs" style="color:var(--c-muted)">{{ 'admin.referentiels.no_value'|trans({}, 'admin') }}</span>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
