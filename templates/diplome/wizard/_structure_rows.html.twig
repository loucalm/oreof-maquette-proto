{# Morceaux de l'étape Structure : borne compacte et ligne de règle (aussi utilisée pour le prototype d'ajout). #}

{% macro field(f, class = '') %}
    <div class="block {{ class }}">
        {{ form_label(f, null, {label_attr: {class: 'fld-label'}}) }}
        {{ form_widget(f, {attr: {class: 'fld fld-sm mt-0.5 w-full'}}) }}
        {{ form_help(f, {help_attr: {class: 'mt-0.5 text-[11px]', style: 'color:var(--c-muted)'}}) }}
        {{ form_errors(f) }}
    </div>
{% endmacro %}

{# Borne compacte : mode, puis un nombre (deux pour « entre », aucun pour « aucune »), cf. bound_controller.js #}
{% macro boundWidget(f) %}
    <div class="flex items-center gap-1" data-controller="bound">
        {{ form_widget(f.mode, {attr: {class: 'fld fld-sm', 'data-bound-target': 'mode', 'data-action': 'bound#update'}}) }}
        {{ form_widget(f.value, {attr: {class: 'fld fld-sm w-14', 'data-bound-target': 'value'}}) }}
        <span class="text-xs text-secondary-500" data-bound-target="upper">–</span>
        {{ form_widget(f.upper, {attr: {class: 'fld fld-sm w-14', 'data-bound-target': 'upper'}}) }}
    </div>
    {{ form_errors(f) }}
{% endmacro %}

{% macro controls() %}
    {% set btn = 'inline-flex h-7 w-7 items-center justify-center rounded hover:bg-secondary-100' %}
    <div class="flex shrink-0 items-center gap-0.5">
        <button type="button" data-action="collection#up" class="{{ btn }}" title="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}">{{ ux_icon('ph:arrow-up', {class: 'icon'}) }}</button>
        <button type="button" data-action="collection#down" class="{{ btn }}" title="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}">{{ ux_icon('ph:arrow-down', {class: 'icon'}) }}</button>
        <button type="button" data-action="collection#remove" class="{{ btn }} text-danger-600" title="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
    </div>
{% endmacro %}

{#
    Ligne de règle : une phrase (sévérité, règle, portée) et, repliés derrière « Modifier », les champs du gabarit.
    Le formulaire est ouvert d'office pour une règle neuve (sans gabarit) ou en erreur. Phrase : rule_params_controller.js.
#}
{% macro rule(f) %}
    {% import _self as m %}
    {% set open = not f.template.vars.value or not f.vars.valid %}
    <div data-collection-row data-rule-row data-controller="rule-params" data-action="change->rule-params#sync input->rule-params#summarize"
         class="rounded-lg border border-secondary-200 bg-white">
        {{ form_widget(f.uid) }}
        <div class="flex items-center gap-3 px-3 py-2">
            <span data-rule-params-target="severity"
                  class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold bg-danger-50 text-danger-700 data-[severity=warning]:bg-warning-50 data-[severity=warning]:text-warning-700"></span>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-secondary-900" data-rule-params-target="sentence"></p>
                <p class="text-xs text-secondary-500" data-rule-params-target="scope" hidden></p>
            </div>
            <button type="button" data-action="rule-params#toggle" data-rule-params-target="toggle" aria-expanded="{{ open ? 'true' : 'false' }}"
                    class="shrink-0 rounded-md border border-secondary-300 px-2 py-1 text-xs font-medium text-secondary-600 hover:bg-secondary-50">{{ 'common.edit'|trans({}, 'common') }}</button>
            {{ m.controls() }}
        </div>
        <div data-rule-params-target="body" class="space-y-2 border-t border-secondary-200 px-3 py-3" {{ open ? '' : 'hidden' }}>
            <div class="grid grid-cols-2 gap-3 xl:grid-cols-[1.6fr_1fr_1fr_1fr]">
                {{ m.field(f.template) }}
                {{ m.field(f.scopeLevel) }}
                {{ m.field(f.scopePosition) }}
                {{ m.field(f.severity) }}
            </div>
            {% for group in f %}{% if group.vars.name starts with 'params_' %}
                <div data-rule-params-target="group" data-template="{{ group.vars.name|slice(7) }}" class="grid grid-cols-2 gap-3 xl:grid-cols-4">
                    {% for param in group %}
                        {{ m.field(param) }}
                    {% endfor %}
                </div>
            {% endif %}{% endfor %}
        </div>
    </div>
{% endmacro %}
