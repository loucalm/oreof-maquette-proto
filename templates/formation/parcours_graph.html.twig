{# Arborescence des parcours (ramification).
   - dans l'éditeur : fragment <turbo-frame id="node-panel"> (standalone = false)
   - ouvert directement : page complète avec en-tête + Tailwind (standalone = true) #}
{% extends standalone ? 'base.html.twig' : '_frame.html.twig' %}
{% block title %}{{ formation.name }} · {{ 'formation.graph.title_suffix'|trans({}, 'formation') }}{% endblock %}

{% if standalone %}
    {% set header_title = 'formation.graph.heading'|trans({}, 'formation') %}
    {% set header_description = formation.name ~ ' · ' ~ 'formation.index.parcours_count'|trans({'%count%': graph.parcours|length}, 'formation') %}
    {% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: 'formation.index.heading'|trans({}, 'formation'), url: path('formation_index')},
    {label: formation.name, url: path('formation_view', {id: formation.id})},
        {label: header_title},
    ] %}
{% endif %}

{% block bouton_header %}
    {% if standalone %}
        <twig:Button variant="secondary" icon="ph:arrow-left" :label="'formation.editor.structure_config_link'|trans({}, 'formation')" :href="path('formation_editor', {id: formation.id, param: 'structure'})"/>
    {% endif %}
{% endblock %}

{% block body %}
{% set g = graph %}
{% if standalone %}
    {{ _self.timeline(g, formation, parcoursViews, parcoursProgress, current) }}
{% else %}
{# candidats de parenté calculés une fois par parcours, réutilisés par la boîte SVG (data-candidates) et par le <select> du tableau #}
{% set candidatesByNode = {} %}
{% if not standalone %}
    {% for r in g.rows %}
        {% set candidatesByNode = candidatesByNode|merge({(r.node.id): parcours_candidates(r.node)}) %}
    {% endfor %}
{% endif %}

<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="parcours">
    <div class="panel-head">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h2 class="text-xl font-bold">{{ 'formation.graph.heading'|trans({}, 'formation') }}</h2>
                <div class="text-sm text-secondary-400">{{ formation.name }} · {{ 'formation.index.parcours_count'|trans({'%count%': g.parcours|length}, 'formation') }}</div>
            </div>
            <a href="{{ path('formation_editor', {id: formation.id, param: 'structure'}) }}" data-turbo-frame="node-panel"
               class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} {{ 'formation.editor.structure_config_link'|trans({}, 'formation') }}</a>
        </div>
        <p class="text-xs text-secondary-400 mt-1">
            {{ 'formation.graph.axis_note'|trans({'%unit%': g.unit|lower}, 'formation')|raw }}
            {% if standalone %}
                {{ 'formation.graph.standalone_note'|trans({'%unit%': g.unit|lower}, 'formation') }}
            {% else %}
                {{ 'formation.graph.editable_note'|trans({}, 'formation') }}
            {% endif %}
        </p>
    </div>

    <div class="panel-scroll">
    {% if g.parcours is empty %}
        <div class="rounded-xl border border-dashed p-8 text-center text-sm text-secondary-500 border-secondary-200">
            {{ 'formation.graph.empty'|trans({}, 'formation') }}
        </div>
    {% else %}
        <div {{ not standalone ? 'data-controller=ramification' }}>
        <div class="overflow-auto rounded-xl border bg-white border-secondary-200">
            <svg viewBox="0 0 {{ g.width }} {{ g.height }}" width="{{ g.width }}" height="{{ g.height }}" class="block" style="min-width:100%"
                 {{ not standalone ? 'data-ramification-target=svg' }}>
                <defs>
                    <marker id="pg-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M0 0 L10 5 L0 10 z" fill="#6366f1"/>
                    </marker>
                </defs>

                {# colonnes de périodes (grille de fond, discrète) #}
                {% for a in 1..g.cols %}
                    {% set cx = g.pad + (a - 1) * g.colW %}
                    {% if a > 1 %}<line x1="{{ cx }}" y1="{{ g.headerH - 6 }}" x2="{{ cx }}" y2="{{ g.height - 8 }}" stroke="#eef1f4" stroke-dasharray="2 5"/>{% endif %}
                    <text x="{{ cx + 12 }}" y="{{ g.headerH - 16 }}" font-size="13" font-weight="600" fill="#374151">
                        {%- if g.unit|lower == 'année' %}{{ 'formation.graph.year_ordinal'|trans({'%n%': a, '%suffix%': a == 1 ? 'ère' : 'ème'}, 'formation') }}{% else %}{{ g.unit }} {{ a }}{% endif -%}
                    </text>
                {% endfor %}
                <line x1="{{ g.pad }}" y1="{{ g.headerH - 4 }}" x2="{{ g.width - g.pad }}" y2="{{ g.headerH - 4 }}" stroke="#e5e7eb"/>

                {# liens parent → enfant (tracé pré-calculé côté PHP) :
                   halo blanc d'abord (toutes les arêtes), puis le trait coloré,
                   pour que les connecteurs restent lisibles sur la grille et entre eux #}
                {% for e in g.edges %}
                    <path d="{{ e.path }}" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                {% endfor %}
                {% for e in g.edges %}
                    <path d="{{ e.path }}" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" marker-end="url(#pg-arrow)"/>
                {% endfor %}
                {% if not standalone %}
                    {# survol/clic élargi (invisible) sur chaque connecteur, pour le retirer #}
                    {% for e in g.edges %}
                        <path d="{{ e.path }}" fill="none" stroke="transparent" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"
                              data-ramification-target="edge" data-child="{{ e.to }}" data-action="click->ramification#clearEdge" style="cursor:pointer">
                            <title>{{ 'formation.graph.remove_link_title'|trans({}, 'formation') }}</title>
                        </path>
                    {% endfor %}
                {% endif %}

                {# boîtes parcours — lien SVG en xlink:href (Turbo ne sait pas lire
                   le href des <a> SVG) : navigation pleine page vers l'éditeur du parcours,
                   sauf si un glisser vient d'avoir lieu (ramification_controller#suppressIfDragged) #}
                {% for r in g.rows %}
                    {% set b = g.boxes[r.node.id] %}
                    {% set isCurrent = current and r.node.id == current %}
                    <a xlink:href="{{ path('parcours_editor', {fid: formation.id, nid: r.node.id}) }}" style="cursor:pointer"
                       {% if not standalone %}
                           data-ramification-target="box" data-nid="{{ r.node.id }}"
                           data-candidates="{{ candidatesByNode[r.node.id]|map(c => c.id)|join(' ') }}"
                           data-action="pointerdown->ramification#startDrag click->ramification#suppressIfDragged"
                       {% endif %}>
                        {% if isCurrent %}
                            <text x="{{ b.cx }}" y="{{ b.y - 7 }}" text-anchor="middle" font-size="10" font-weight="700" fill="#4f46e5" letter-spacing="0.3">{{ 'formation.graph.you_are_here_badge'|trans({}, 'formation') }}</text>
                        {% endif %}
                        <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ g.boxH }}" rx="10"
                              fill="{{ isCurrent ? '#c7d2fe' : '#eef2ff' }}" stroke="{{ isCurrent ? '#4f46e5' : '#c7d2fe' }}" stroke-width="{{ isCurrent ? 2.5 : 1.5 }}"/>
                        {% set pv = parcoursViews[r.node.id] ?? null %}
                        {# libellé ramené à la largeur de la boîte (≈ 7,5 px par caractère), nom complet au survol #}
                        {% set boxLabel = r.node.label ?: 'formation.graph.parcours_fallback'|trans({}, 'formation') %}
                        {% set maxChars = max(8, (b.w / 7.5)|round(0, 'floor')) %}
                        <text x="{{ b.x + b.w / 2 }}" y="{{ b.cy - (pv ? 3 : -4) }}" text-anchor="middle" font-size="13" font-weight="{{ isCurrent ? 700 : 600 }}" fill="#3730a3"><title>{{ boxLabel }}</title>{{ boxLabel|length > maxChars ? boxLabel|slice(0, maxChars - 1)|trim ~ '…' : boxLabel }}</text>
                        {% if pv %}
                            {% set pct = parcoursProgress[r.node.id] ?? 0 %}
                            <text x="{{ b.x + b.w / 2 }}" y="{{ b.cy + 14 }}" text-anchor="middle" font-size="11" fill="{{ pct == 100 ? '#15803d' : '#6b7280' }}">{% set target = pv.node.getAttribute('ects') %}{{ (target ? 'formation.graph.box_stats' : 'formation.graph.box_stats_no_target')|trans({'%pct%': pct, '%ects%': pv.totalEcts|round(1), '%target%': target}, 'formation') }}</text>
                        {% endif %}
                    </a>
                {% endfor %}

                {% if not standalone %}
                    <line data-ramification-target="dragLine" x1="0" y1="0" x2="0" y2="0" stroke="#4f46e5" stroke-width="2.5" stroke-dasharray="6 4"
                          marker-end="url(#pg-arrow)" pointer-events="none" hidden/>
                {% endif %}
            </svg>
        </div>

        {% if standalone %}
            <ul class="mt-4 space-y-1 text-sm">
                {% for r in g.rows %}
                    {% set isCurrent = current and r.node.id == current %}
                    <li class="flex flex-wrap items-center gap-2 rounded-lg px-2 py-1 -mx-2"
                        style="{{ isCurrent ? 'background:var(--c-primary-soft)' : '' }}">
                        <span class="type-badge">{{ ux_icon('ph:compass', {class: 'icon'}) }} {{ 'formation.graph.parcours_fallback'|trans({}, 'formation') }}</span>
                        <a href="{{ path('parcours_editor', {fid: formation.id, nid: r.node.id}) }}" class="font-medium hover:underline">{{ r.node.label ?: '—' }}</a>
                        <span class="text-xs text-secondary-400">{{ 'formation.graph.period_range'|trans({'%unit%': g.unit|lower, '%start%': r.colStart, '%end%': r.colEnd}, 'formation') }}</span>
                        {% if r.node.parcoursParent %}<span class="text-xs text-secondary-400">{{ 'formation.graph.child_of'|trans({'%parent%': r.node.parcoursParent.label ?: '—'}, 'formation') }}</span>{% endif %}
                        {% if isCurrent %}<span class="pill bg-primary-600 hover:bg-primary-700 text-white">{{ ux_icon('ph:map-pin', {class: 'icon'}) }} {{ 'formation.graph.you_are_here_pill'|trans({}, 'formation') }}</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <form method="post" action="{{ path('node_ramification_save', {fid: formation.id}) }}" data-turbo-frame="node-panel" class="mt-4">
                <div class="overflow-auto rounded-xl border border-secondary-200">
                    <table class="w-full text-sm">
                        <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600">
                            <tr>
                                <th class="text-left px-4 py-2.5">{{ 'formation.graph.parcours_fallback'|trans({}, 'formation') }}</th>
                                <th class="text-left px-4 py-2.5">{{ 'node.panel.period_start'|trans({'%unit%': g.unit}, 'node') }}</th>
                                <th class="text-left px-4 py-2.5">{{ 'node.panel.period_end'|trans({'%unit%': g.unit}, 'node') }}</th>
                                <th class="text-left px-4 py-2.5">{{ 'node.panel.parcours_parent_label'|trans({}, 'node') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for r in g.rows %}
                            {% set isCurrent = current and r.node.id == current %}
                            <tr class="border-t" style="border-color:var(--c-border);{{ isCurrent ? 'background:var(--c-primary-soft)' }}">
                                <td class="px-4 py-2.5">
                                    <span class="type-badge">{{ ux_icon('ph:compass', {class: 'icon'}) }} {{ 'formation.graph.parcours_fallback'|trans({}, 'formation') }}</span>
                                    <a href="{{ path('parcours_editor', {fid: formation.id, nid: r.node.id}) }}" class="font-medium hover:underline ml-1">{{ r.node.label ?: '—' }}</a>
                                    {% if isCurrent %}<span class="pill ml-1 bg-primary-600 hover:bg-primary-700 text-white">{{ ux_icon('ph:map-pin', {class: 'icon'}) }} {{ 'formation.graph.you_are_here_pill'|trans({}, 'formation') }}</span>{% endif %}
                                </td>
                                <td class="px-4 py-2.5"><input type="number" min="1" name="periodeDebut[{{ r.node.id }}]" value="{{ r.node.periodeDebut }}" class="fld w-24"></td>
                                <td class="px-4 py-2.5"><input type="number" min="1" name="periodeFin[{{ r.node.id }}]" value="{{ r.node.periodeFin }}" class="fld w-24"></td>
                                <td class="px-4 py-2.5">
                                    <select name="parentId[{{ r.node.id }}]" class="fld" data-ramification-target="parentSelect" data-nid="{{ r.node.id }}">
                                        <option value="">{{ 'node.panel.parcours_parent_none'|trans({}, 'node') }}</option>
                                        {% for cand in candidatesByNode[r.node.id] %}
                                            <option value="{{ cand.id }}" {{ r.node.parcoursParent and r.node.parcoursParent.id == cand.id ? 'selected' }}>{{ 'formation.graph.candidate_option'|trans({'%label%': cand.label ?: '—', '%unit%': g.unit|lower, '%start%': cand.periodeDebut, '%end%': cand.periodeFin}, 'formation') }}</option>
                                        {% endfor %}
                                    </select>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <button class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm mt-3">{{ ux_icon('ph:floppy-disk', {class: 'icon'}) }} {{ 'formation.graph.save_button'|trans({}, 'formation') }}</button>
            </form>
        {% endif %}
        </div>
    {% endif %}
    </div>
</div>
</turbo-frame>
{% endif %}
{% endblock %}

{#
    Page autonome : frise des parcours sur toute la largeur. À gauche le nom (sur deux lignes au plus, en retrait sous
    son parcours parent), à droite une barre sur les périodes couvertes, remplie selon l'avancement de la saisie.
#}
{% macro timeline(g, formation, parcoursViews, parcoursProgress, current) %}
    {% if g.parcours is empty %}
        <div class="rounded-xl border border-dashed border-secondary-200 bg-white p-8 text-center text-sm text-secondary-500">
            {{ 'formation.graph.empty'|trans({}, 'formation') }}
        </div>
    {% else %}
        <section class="rounded-2xl border border-secondary-200 bg-white shadow-sm">
            <p class="border-b border-secondary-200 px-5 py-3 text-xs text-secondary-500">
                {{ 'formation.graph.axis_note'|trans({'%unit%': g.unit|lower}, 'formation')|raw }}
                {{ 'formation.graph.standalone_note'|trans({'%unit%': g.unit|lower}, 'formation') }}
            </p>
            <div class="overflow-x-auto">
                <div class="relative grid min-w-[720px]" style="grid-template-columns: minmax(220px, 30%) repeat({{ g.cols }}, minmax(0, 1fr));" data-parcours-timeline data-controller="parcours-timeline">
                    {# branches parent → enfant, tracées par parcours_timeline_controller.js #}
                    <svg data-parcours-timeline-target="svg" class="pointer-events-none absolute inset-0 z-20 h-full w-full" aria-hidden="true">
                        <defs><marker id="pt-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#6366f1"/></marker></defs>
                    </svg>
                    {# en-tête : périodes #}
                    <div class="border-b border-secondary-200 bg-secondary-50 px-5 py-2.5 text-[11px] font-black uppercase tracking-wider text-secondary-500">{{ 'formation.graph.parcours_fallback'|trans({}, 'formation') }}</div>
                    {% for a in 1..g.cols %}
                        <div class="border-b border-l border-secondary-200 bg-secondary-50 px-3 py-2.5 text-center text-[11px] font-black uppercase tracking-wider text-secondary-500">
                            {%- if g.unit|lower == 'année' %}{{ 'formation.graph.year_ordinal'|trans({'%n%': a, '%suffix%': a == 1 ? 'ère' : 'ème'}, 'formation') }}{% else %}{{ g.unit }} {{ a }}{% endif -%}
                        </div>
                    {% endfor %}

                    {% for r in g.rows %}
                        {% set node = r.node %}
                        {% set isCurrent = current and node.id == current %}
                        {% set pv = parcoursViews[node.id] ?? null %}
                        {% set pct = parcoursProgress[node.id] ?? 0 %}
                        {% set tone = pct >= 100 ? 'success' : (pct < 30 ? 'danger' : 'info') %}
                        {% set url = path('parcours_editor', {fid: formation.id, nid: node.id}) %}
                        {% set label = node.label ?: 'formation.graph.parcours_fallback'|trans({}, 'formation') %}
                        {% set rowBorder = loop.last ? '' : 'border-b border-secondary-100' %}

                        {# nom du parcours #}
                        <div class="{{ rowBorder }} flex min-w-0 items-start gap-2 px-5 py-3 {{ isCurrent ? 'bg-primary-50' }}" style="padding-left: {{ 1.25 + r.depth * 1.25 }}rem" data-parcours-row="{{ node.id }}">
                            {% if r.depth > 0 %}<span class="mt-0.5 shrink-0 text-secondary-400" title="{{ 'formation.graph.child_of'|trans({'%parent%': node.parcoursParent.label ?: '—'}, 'formation') }}">{{ ux_icon('ph:arrow-bend-down-right', {class: 'h-4 w-4'}) }}</span>{% endif %}
                            <div class="min-w-0">
                                <a href="{{ url }}" class="line-clamp-2 font-semibold text-secondary-900 hover:text-primary-700 hover:underline" title="{{ label }}">{{ label }}</a>
                                <div class="mt-0.5 text-xs text-secondary-500">
                                    {{ 'formation.graph.period_range'|trans({'%unit%': g.unit|lower, '%start%': r.colStart, '%end%': r.colEnd}, 'formation') }}
                                    {% if isCurrent %}<span class="ml-1 font-semibold text-primary-700">· {{ 'formation.graph.you_are_here_pill'|trans({}, 'formation') }}</span>{% endif %}
                                </div>
                            </div>
                        </div>

                        {# frise : cellules vides de la grille, puis la barre sur ses périodes #}
                        {% for a in 1..g.cols %}
                            <div class="{{ rowBorder }} border-l border-secondary-100 {{ isCurrent ? 'bg-primary-50' }}" style="grid-row: {{ loop.parent.loop.index + 1 }}; grid-column: {{ a + 1 }}"></div>
                        {% endfor %}
                        <a href="{{ url }}" class="group relative z-10 mx-5 my-2.5 flex min-w-0 flex-col justify-center overflow-hidden rounded-lg border px-3 py-1.5 transition-shadow hover:shadow-md
                                  {{ isCurrent ? 'border-primary-500 ring-2 ring-primary-200' : 'border-' ~ tone ~ '-200' }} bg-{{ tone }}-50"
                           style="grid-row: {{ loop.index + 1 }}; grid-column: {{ r.colStart + 1 }} / {{ r.colEnd + 2 }}"
                           data-parcours-timeline-target="bar" data-nid="{{ node.id }}" {% if node.parcoursParent %}data-parent="{{ node.parcoursParent.id }}"{% endif %}
                           aria-label="{{ label }} — {{ 'formation.graph.period_range'|trans({'%unit%': g.unit|lower, '%start%': r.colStart, '%end%': r.colEnd}, 'formation') }}">
                            <span class="absolute inset-y-0 left-0 bg-{{ tone }}-100 transition-[width]" style="width: {{ min(100, pct) }}%" aria-hidden="true"></span>
                            <span class="relative flex items-center justify-between gap-2 text-xs">
                                <span class="font-bold text-{{ tone }}-700">{{ 'formation.graph.progress'|trans({'%pct%': pct}, 'formation') }}</span>
                                {% if pv %}
                                    {% set target = node.getAttribute('ects') %}
                                    <span class="whitespace-nowrap text-secondary-600">{{ target ? (pv.totalEcts|round(1) ~ ' / ' ~ target) : pv.totalEcts|round(1) }} ECTS</span>
                                {% endif %}
                            </span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}
{% endmacro %}
