{% extends 'base.html.twig' %}
{% block title %}{{ 'formation.check.title_prefix'|trans({}, 'formation') }} · {{ formation.name }}{% endblock %}

{% set header_title = 'formation.check.title_prefix'|trans({}, 'formation') %}
{% set header_description = 'formation.check.subtitle'|trans({'%name%': formation.name, '%progress%': progress}, 'formation') %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: 'formation.index.heading'|trans({}, 'formation'), url: path('formation_index')},
    {label: formation.name, url: path('formation_editor', {id: formation.id})},
    {label: header_title},
] %}

{% block bouton_header %}
    <twig:Button variant="warning" :soft="false" :outline="true" icon="ph:pencil-simple" :label="'formation.check.edit_structure_button'|trans({}, 'formation')" :href="path('formation_editor', {id: formation.id})"/>
{% endblock %}

{% block body %}

<div class="space-y-6 rounded-xl border border-secondary-200 bg-white p-6 shadow-sm">
    {% if groups is empty and sections is empty and violations is empty and incompleteFiches is empty %}
        <div class="rounded-xl border p-6 text-sm" style="border-color:#bbf7d0;background:#f0fdf4">
            <span class="font-semibold text-success-800">{{ ux_icon('ph:check-bold', {class: 'icon'}) }} {{ 'formation.check.no_issue_title'|trans({}, 'formation') }}</span>
            <p class="text-success-700 mt-1">{{ 'formation.check.no_issue_text'|trans({}, 'formation') }}</p>
        </div>
    {% endif %}

    {% if sections is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-secondary-500 mb-2">{{ 'formation.check.sections_title'|trans({}, 'formation') }}</h2>
            <ul class="space-y-2">
                {% for sec in sections %}
                    <li class="flex items-center justify-between gap-4 rounded-lg border p-3 border-secondary-200">
                        <div class="flex items-center gap-2 text-sm">
                            <span class="status-dot" data-status="{{ sec.status }}"></span>
                            <span class="font-medium">{{ sec.label }}</span>
                            {% if sec.context %}<span class="text-secondary-400">· {{ sec.context }}</span>{% endif %}
                        </div>
                        <a href="{{ sec.url }}" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if incompleteFiches is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-secondary-500 mb-2">{{ 'formation.check.fiches_title'|trans({}, 'formation') }}</h2>
            <ul class="space-y-2">
                {% for row in incompleteFiches %}
                    <li class="flex items-center justify-between gap-4 rounded-lg border p-3 border-secondary-200">
                        <div class="flex items-center gap-2 text-sm">
                            <span class="status-dot" data-status="{{ row.status }}"></span>
                            <span class="font-medium">{{ row.fiche.libelle }}</span>
                        </div>
                        <a href="{{ row.url }}" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if violations is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-secondary-500 mb-2">{{ 'formation.check.structure_title'|trans({'%count%': violations|length}, 'formation') }}</h2>
            <ul class="space-y-2">
                {% for item in violations %}
                    {% set v = item.violation %}
                    {% set n = item.node %}
                    <li class="flex items-start justify-between gap-4 rounded-lg border p-3 border-secondary-200">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="status-dot" data-status="{{ v.blocking ? 'error' : 'incomplete' }}"></span>
                                <span class="text-sm font-medium">{{ n ? n.displayLabel : formation.name }}</span>
                            </div>
                            <p class="ml-6 mt-1 text-xs {{ v.blocking ? 'text-danger-600' : 'text-secondary-600' }}">{{ v.message }}{% if v.actual is not null and v.expected is not null %} ({{ 'formation.check.structure_actual'|trans({'%actual%': v.actual, '%expected%': v.expected}, 'formation') }}){% endif %}</p>
                        </div>
                        {% if n %}
                            <a href="{{ path('node_open', {fid: formation.id, nid: n.id}) }}"
                               class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if groups is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-secondary-500 mb-2">{{ 'formation.check.issues_count'|trans({'%count%': issueCount}, 'formation') }}</h2>
            {% for context, issues in groups %}
                <h3 class="mt-4 mb-2 text-xs font-semibold text-secondary-400">{{ context }}</h3>
                <ul class="space-y-2">
                    {% for issue in issues %}
                        {% set n = issue.node %}
                        <li class="flex items-start justify-between gap-4 rounded-lg border p-3 border-secondary-200">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="status-dot" data-status="incomplete"></span>
                                    <span class="type-badge">{{ ux_icon(n.type.icon, {class: 'icon'}) }} [{{ n.type.label }}]</span>
                                    {% if issue.ref %}<span class="tree-ref">{{ issue.ref }}</span>{% endif %}
                                    <span class="text-sm font-medium">{{ n.type.temporel ? node_display_label(n, issue.ref) : (n.label ?: 'formation.check.no_label'|trans({}, 'formation')) }}</span>
                                </div>
                                <ul class="ml-6 mt-1 space-y-0.5 text-xs text-danger-600">
                                    {% for m in issue.missing %}<li>{{ m }}</li>{% endfor %}
                                </ul>
                            </div>
                            <a href="{{ path('node_open', {fid: formation.id, nid: n.id}) }}"
                               class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </section>
    {% endif %}
</div>
{% endblock %}
