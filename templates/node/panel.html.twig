{# Panneau d'édition d'un nœud — façon maquette Figma. Rendu dans <turbo-frame id="node-panel">. #}
{% import _self as ui %}
{% set caps = node.effectiveCapabilities() %}
{% set formation = node.formation %}
{% set childTypes = types_allowed_for(node) %}
{% set T = node.type.label %}

{% set hasHours = caps.hours ?? false %}
{% set hasMccc = caps.mccc ?? false %}

<turbo-frame id="node-panel">
<div class="panel-body" data-controller="tabs modal" data-panel-active="node:{{ node.id }}">

    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ 'node.panel.title'|trans({}, 'node') }}</h2>
        <div class="text-sm text-gray-400">
            {{ T }}{% if view.ref %} <span class="font-bold" style="color:var(--c-primary)">{{ view.ref }}</span>{% endif %}
            {%- if node.isLocked('delete') %} · <span title="{{ 'node.panel.locked_title'|trans({}, 'node') }}">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }} {{ 'node.panel.locked_badge'|trans({}, 'node') }}</span>{% endif -%}
        </div>
        <div class="text-sm text-gray-400 mt-1">
            {{ formation.name }}
            {%- for p in node_path(node) %} › {{ p.label ?: p.type.label }}{% endfor -%}
        </div>
    </div>

    <div class="panel-scroll">
    <div class="panel-card space-y-5">

    {# onglets présents sur ce nœud (déduits des champs actifs) #}
    {% set nodeTabs = ['props'] %}
    {% for key, def in catalog %}
        {% if (caps[key] ?? false) and def.domain not in nodeTabs %}
            {% set nodeTabs = nodeTabs|merge([def.domain]) %}
        {% endif %}
    {% endfor %}
    <div class="flex flex-wrap gap-2">
        {% for tk in nodeTabs %}
            <button type="button" data-tabs-target="tab" data-tab="{{ tk }}" class="tab-pill">
                <span class="status-dot" data-status="{{ node_tab_status(node, tk) }}"></span>
                {{ domains[tk] ?? tk }}
            </button>
        {% endfor %}
    </div>

    {# tuiles + actions #}
    <div class="flex flex-wrap items-stretch gap-2">
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="text-gray-500">{{ 'node.panel.total_hours_label'|trans({}, 'node') }}</span> <span class="font-semibold">{{ view.totalHours|round }}</span>
        </div>
        <div class="rounded-xl border px-4 py-2.5 text-sm" style="border-color:#fcd34d;background:#fffbeb">
            <span class="font-semibold">{{ view.totalEcts|round }}</span>
            <span class="text-gray-500">{% if view.ectsTarget %}{{ 'node.panel.ects_target'|trans({'%target%': view.ectsTarget}, 'node') }} {% endif %}{{ 'node.panel.ects_unit'|trans({}, 'node') }}</span>
        </div>
        <div class="ml-auto flex flex-wrap gap-2">
            {% if not node.isChoiceBloc() and node.getParent() and node.type.choiceTransformable %}
            <form method="post" action="{{ path('node_convert_choice', {fid: formation.id, nid: node.id}) }}" data-turbo-frame="_top"
                  data-controller="confirm"
                  data-confirm-message-value="{{ 'node.panel.convert_choice_confirm'|trans({'%label%': node.getDisplayLabel()}, 'node') }}">
                <button class="rounded-lg border px-3 py-2 text-sm" style="border-color:#e9d5ff;background:#faf5ff;color:#9333ea"
                        title="{{ 'node.panel.convert_choice_title'|trans({}, 'node') }}">
                    {{ ux_icon('ph:shuffle', {class: 'icon'}) }} {{ 'node.panel.convert_choice_button'|trans({}, 'node') }}
                </button>
            </form>
            {% endif %}
            {% if caps.mutualisable ?? false %}
            <form method="post" action="{{ node_url(node, 'node_mutualize') }}" data-turbo-frame="_top">
                <button class="rounded-lg border px-3 py-2 text-sm" style="border-color:#fcd34d;color:#b45309">
                    {{ ux_icon('ph:share-network', {class: 'icon'}) }} {{ node.mutualized ? 'node.panel.unmutualize'|trans({}, 'node') : 'node.panel.mutualize'|trans({}, 'node') }} [{{ T }}]
                </button>
            </form>
            {% endif %}
            {% if childTypes is not empty %}
            <a href="{{ node_url(node, 'node_attach_index') }}" data-turbo-frame="node-panel"
               class="rounded-lg border px-3 py-2 text-sm text-green-700" style="border-color:#bbf7d0">{{ ux_icon('ph:arrow-bend-down-right', {class: 'icon'}) }} {{ 'node.panel.reattach_button'|trans({}, 'node') }}</a>
            {% endif %}
            {% if is_admin() %}
            <button type="button" data-action="modal#open" class="rounded-lg border px-3 py-2 text-sm text-gray-600" style="border-color:var(--c-border)">{{ ux_icon('ph:gear', {class: 'icon'}) }} {{ 'node.panel.node_params_button'|trans({'%type%': T}, 'node') }}</button>
            {% endif %}
        </div>
    </div>

    {# ── formulaire ── #}
    <form method="post" action="{{ node_url(node, 'node_save') }}" data-turbo-frame="_top" class="space-y-5">

        {% for tk in nodeTabs %}
        <div data-tabs-target="panel" data-tab="{{ tk }}" class="space-y-5" {{ not loop.first ? 'hidden' }}>

            {# séparateur : nom de l'onglet actif #}
            <div class="flex items-center gap-3 text-gray-300 text-xs uppercase tracking-widest">
                <div class="h-px flex-1 bg-gray-200"></div>{{ domains[tk] ?? tk }}<div class="h-px flex-1 bg-gray-200"></div>
            </div>

            {% if tk == 'props' %}
                {% set parents = valid_parents(node) %}
                {% set lockedMove = node.isLocked('move') %}
                {{ ui.label('node.panel.parent_label'|trans({}, 'node'), true, 'node.panel.parent_help'|trans({}, 'node')) }}
                <select name="parentId" class="fld" {{ lockedMove ? 'disabled' }}>
                    {% if can_be_root(node) %}<option value="">{{ 'node.panel.root_option'|trans({}, 'node') }}</option>{% endif %}
                    {% for cand in parents %}
                        <option value="{{ cand.id }}" {{ node.parent and node.parent.id == cand.id ? 'selected' }}>
                            [{{ cand.type.label }}] {{ cand.label ?: '—' }}
                        </option>
                    {% endfor %}
                </select>
                {% if lockedMove %}
                    <div class="fld-help">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }} {{ 'node.panel.parent_locked_help'|trans({}, 'node') }}</div>
                {% elseif parents is empty and not can_be_root(node) %}
                    <div class="fld-help text-amber-600">{{ 'node.panel.no_location_help'|trans({}, 'node') }}</div>
                {% endif %}

                {% if node.type.temporel %}
                    {{ ui.label('node.panel.label_field'|trans({}, 'node'), false, 'node.panel.temporel_label_help'|trans({}, 'node')) }}
                    <div class="fld flex items-center" style="background:#f8f9fb;color:var(--c-muted)">{{ node_display_label(node, view.ref) }}</div>
                {% else %}
                    {{ ui.label('node.panel.label_field'|trans({}, 'node'), true, 'node.panel.label_help'|trans({}, 'node')) }}
                    <input name="label" value="{{ node.label }}" maxlength="200" class="fld">
                {% endif %}

                {% if caps.code ?? false %}
                    {% set isEc = node.type.key == 'ec' %}
                    {{ ui.label(isEc ? 'node.panel.ec_code_label'|trans({}, 'node') : 'node.panel.code_label'|trans({}, 'node'), isEc, isEc ? 'node.panel.ec_code_help'|trans({}, 'node') : 'node.panel.code_help'|trans({}, 'node')) }}
                    <input name="code" value="{{ node.code }}" class="fld">
                {% endif %}
            {% endif %}

            {# champs du catalogue pour cet onglet, groupés par catégorie #}
            {% set curCat = '__init__' %}
            {% for key, def in catalog %}
                {% if def.domain == tk and (caps[key] ?? false) %}
                    {% if (def.category ?? null) != curCat %}
                        {% set curCat = def.category ?? null %}
                        {% if curCat %}<div class="fld-cat">{{ curCat }}</div>{% endif %}
                    {% endif %}
                    {{ ui.field(key, def, node) }}
                {% endif %}
            {% endfor %}

            {% if tk == 'props' and node.isParcours %}
                {% set unit = period_unit(formation) %}
                <div class="rounded-lg border p-3 space-y-3" style="border-color:var(--c-border);background:#f8f9fb">
                    <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">{{ 'node.panel.ramification_title'|trans({}, 'node') }}</div>
                    <p class="fld-help">
                        {{ ux_icon('ph:info', {class: 'icon'}) }} {{ 'node.panel.ramification_note'|trans({'%unit%': unit|lower}, 'node') }}
                    </p>
                    <div class="grid grid-cols-2 gap-2 text-sm">
                        <div>
                            <div class="text-[11px] uppercase tracking-wide text-gray-400">{{ 'node.panel.period_start'|trans({'%unit%': unit}, 'node') }}</div>
                            <div class="font-medium mt-0.5">{{ node.periodeDebut }}</div>
                        </div>
                        <div>
                            <div class="text-[11px] uppercase tracking-wide text-gray-400">{{ 'node.panel.period_end'|trans({'%unit%': unit}, 'node') }}</div>
                            <div class="font-medium mt-0.5">{{ node.periodeFin }}</div>
                        </div>
                    </div>
                    <div class="text-sm">
                        <div class="text-[11px] uppercase tracking-wide text-gray-400">{{ 'node.panel.parcours_parent_label'|trans({}, 'node') }}</div>
                        <div class="font-medium mt-0.5">{{ node.parcoursParent ? node.parcoursParent.displayLabel : 'node.panel.parcours_parent_none'|trans({}, 'node') }}</div>
                    </div>
                    <a href="{{ path('formation_parcours_graph', {id: formation.id, current: node.id}) }}" data-turbo-frame="node-panel"
                       class="inline-block text-xs font-medium hover:underline" style="color:var(--c-primary)">{{ ux_icon('ph:map-trifold', {class: 'icon'}) }} {{ 'node.panel.view_ramification_link'|trans({}, 'node') }}</a>
                </div>
            {% endif %}
        </div>
        {% endfor %}

        <div class="flex items-center gap-2 pt-2 border-t" style="border-color:var(--c-border)">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <span class="text-xs text-gray-400">{{ 'node.panel.duplicate_delete_hint'|trans({}, 'node') }}</span>
        </div>
    </form>

    {# ── modale « Paramètre du nœud » ── #}
    <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
            class="rounded-2xl border-0 p-0 w-[min(600px,94vw)] backdrop:bg-black/40">
        <turbo-frame id="node-params-frame" src="{{ node_url(node, 'node_params_form') }}" loading="lazy" class="block">
            <div class="p-10 text-center text-sm text-gray-400">{{ 'common.loading'|trans({}, 'common') }}</div>
        </turbo-frame>
    </dialog>

    {# ── ajouter un enfant ── #}
    {% if childTypes is not empty %}
    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
          class="rounded-xl border p-3 flex flex-wrap items-end gap-2" style="border-color:var(--c-border)">
        <input type="hidden" name="parentId" value="{{ node.id }}">
        <div class="flex-1 min-w-[180px]">
            <div class="fld-label">{{ 'node.panel.add_child_label'|trans({}, 'node') }}</div>
            <select name="typeKey" class="fld mt-1">
                {% for t in childTypes %}<option value="{{ t.key }}">{{ t.label }}</option>{% endfor %}
            </select>
        </div>
        <input name="label" placeholder="{{ 'node.panel.label_field'|trans({}, 'node') }}" class="fld w-40">
        <button class="rounded-lg border px-4 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }}</button>
    </form>
    {% endif %}

    </div>
    </div>

</div>
</turbo-frame>

{# ─────────────── macros ─────────────── #}
{% macro label(text, required, help) %}
    <div>
        <div class="flex items-center justify-between">
            <span class="fld-label">{{ text }}</span>
            {% if required %}<span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide">{{ 'common.required_badge'|trans({}, 'common') }}</span>{% endif %}
        </div>
        {% if help %}<div class="fld-help">{{ ux_icon('ph:info', {class: 'icon'}) }} {{ help }}</div>{% endif %}
    </div>
{% endmacro %}

{% macro field(key, def, node) %}
    {% import _self as ui %}
    {% set val = node.getAttribute(key) %}
    {% if def.field not in ['hours', 'mccc'] %}
        {% set ectsTyped = key == 'ects' and node.type.key in ['ue', 'ec'] %}
        {% set flabel = ectsTyped ? 'node.panel.ects_label'|trans({'%type%': node.type.label}, 'node') : def.label %}
        {% set fhelp = ectsTyped ? 'node.panel.ects_help'|trans({'%type%': node.type.label}, 'node') : (def.help ?? null) %}
        {{ ui.label(flabel, def.required ?? false, fhelp) }}
    {% endif %}
    {% set opts = def.referentielKey ? referentiel(def.referentielKey) : def.options %}
    {% if def.field == 'number' %}
        <input type="number" step="0.5" name="attr_{{ key }}" value="{{ val }}"
               {% if def.min is not null %}min="{{ def.min }}"{% endif %}
               {% if def.max is not null %}max="{{ def.max }}"{% endif %}
               class="fld w-44">
    {% elseif def.field == 'textarea' %}
        <textarea name="attr_{{ key }}" rows="3" class="fld">{{ val }}</textarea>
    {% elseif def.field == 'choice' %}
        {% set ph = key == 'ueType' ? 'node.panel.choice_ue_type'|trans({}, 'node') : (key == 'ecType' ? 'node.panel.choice_ec_type'|trans({}, 'node') : 'node.panel.choice_default'|trans({}, 'node')) %}
        <select name="attr_{{ key }}" class="fld">
            <option value="">{{ ph }}</option>
            {% for ov, ol in opts %}<option value="{{ ov }}" {{ val == ov ? 'selected' }}>{{ ol }}</option>{% endfor %}
        </select>
        {% if def.allowExtra %}
            <div class="mt-1.5 flex items-center gap-2">
                <span class="text-xs shrink-0" style="color:var(--c-muted)">{{ 'node.panel.or_free_value'|trans({}, 'node') }}</span>
                <input type="text" name="attr_{{ key }}_autre" value="{{ (val and val not in opts|keys) ? val : '' }}" class="fld flex-1" placeholder="{{ 'node.panel.other_placeholder'|trans({}, 'node') }}">
            </div>
        {% endif %}
        {% if def.quickAdd and def.referentielKey %}{{ ui.quickAdd(def.referentielKey, node.formation, node) }}{% endif %}
    {% elseif def.field == 'checkbox' %}
        {% set cur = val is iterable ? val : [] %}
        <div class="mt-1 flex flex-wrap gap-x-6 gap-y-2">
            {% for ov, ol in opts %}
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="checkbox" name="attr_{{ key }}[]" value="{{ ov }}" {{ ov in cur ? 'checked' }}>{{ ol }}
                </label>
            {% endfor %}
        </div>
        {% if def.quickAdd and def.referentielKey %}{{ ui.quickAdd(def.referentielKey, node.formation, node) }}{% endif %}
    {% elseif def.field == 'radio' %}
        <div class="mt-1 flex flex-wrap gap-x-6 gap-y-2">
            {% for ov, ol in opts %}
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="radio" name="attr_{{ key }}" value="{{ ov }}" {{ val == ov ? 'checked' }}>{{ ol }}
                </label>
            {% endfor %}
        </div>
        {% if key == 'nature' and not node.isChoiceBloc() and node.getParent() %}
            <p class="mt-2 text-xs" style="color:#9333ea">
                {{ ux_icon('ph:info', {class: 'icon'}) }} {{ 'node.panel.nature_choice_note'|trans({}, 'node') }}
            </p>
        {% endif %}
    {% elseif def.field == 'competencies' %}
        {% set groups = bcc_competences(node) %}
        {% set cur = val ?? [] %}
        {% if groups is empty %}
            <p class="fld-help">{{ 'node.panel.no_competencies'|trans({}, 'node') }}</p>
        {% else %}
            <div data-controller="cbxfilter" class="mt-1">
                <div class="rounded-lg border overflow-hidden" style="border-color:var(--c-border)">
                    <div class="border-b bg-gray-50 px-2 py-1.5" style="border-color:var(--c-border)">
                        <input type="search" placeholder="{{ 'node.panel.filter_competencies_placeholder'|trans({}, 'node') }}" data-cbxfilter-target="input"
                               data-action="input->cbxfilter#filter"
                               class="w-full rounded-md border px-2 py-1 text-sm" style="border-color:var(--c-border)">
                    </div>
                    <div class="max-h-64 overflow-y-auto p-2 space-y-3">
                        {% for g in groups %}
                            <div data-cbxfilter-target="group">
                                <div class="text-[11px] font-semibold uppercase tracking-wide {{ g.transversal ? 'text-teal-700' : 'text-gray-400' }}">{{ g.bloc }}</div>
                                <div class="mt-1 space-y-0.5">
                                    {% for c in g.items %}
                                        <label class="flex items-center gap-2 text-sm cursor-pointer rounded px-1 py-1 hover:bg-gray-50"
                                               data-cbxfilter-target="row"
                                               data-text="{{ (c.label ~ ' ' ~ c.code ~ ' ' ~ c.description ~ ' ' ~ g.bloc)|lower }}">
                                            <input type="checkbox" name="attr_competencies[]" value="{{ c.label }}" {{ c.label in cur ? 'checked' }}>
                                            <span class="font-medium shrink-0">{{ c.label }}</span>
                                            {% if c.code %}<span class="text-xs text-gray-400 shrink-0">{{ c.code }}</span>{% endif %}
                                            {% if c.description %}<span class="min-w-0 truncate text-xs text-gray-400">· {{ c.description }}</span>{% endif %}
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                        <p data-cbxfilter-target="empty" hidden class="px-1 py-3 text-center text-sm text-gray-400">{{ 'node.panel.no_competency_match'|trans({}, 'node') }}</p>
                    </div>
                </div>
                <div class="mt-1 flex items-center justify-between">
                    <span class="text-xs text-gray-400" data-cbxfilter-target="count"></span>
                    <span class="text-xs text-gray-400 cursor-default">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'node.panel.add_competency_fake'|trans({}, 'node') }}</span>
                </div>
            </div>
        {% endif %}
    {% elseif key == 'ficheMatiere' %}
        {% set fiches = referentiel('fiches_matiere') %}
        <select name="attr_ficheMatiere" class="fld">
            <option value="">{{ 'node.panel.fiche_choice_placeholder'|trans({}, 'node') }}</option>
            {% for f in fiches %}<option value="{{ f }}" {{ val == f ? 'selected' }}>{{ f }}</option>{% endfor %}
            {% if val and val not in fiches %}<option value="{{ val }}" selected>{{ val }}</option>{% endif %}
        </select>
        <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'node.panel.create_fiche_fake'|trans({}, 'node') }}</span></div>
    {% elseif def.field == 'hours' %}
        {% set mods = referentiel('modalites_heure')|filter((l, k) => k != 'te') %}
        <div data-controller="hours" class="space-y-4">
            <label class="flex items-center gap-3 text-sm">
                <input type="checkbox" class="switch" name="attr_hours[none]" value="1" {{ (val.none ?? false) ? 'checked' }}
                       data-hours-target="none" data-action="change->hours#sync">
                <span class="font-medium">{{ 'node.panel.hours_none_label'|trans({}, 'node') }}</span>
            </label>

            <div data-hours-target="fields" class="space-y-4">
                {% set places = referentiel('lieux_enseignement') %}
                {% for place, plabel in places %}
                    <div class="rounded-xl border p-4" style="border-color:var(--c-border)">
                        <div class="flex items-center justify-between gap-2">
                            <div class="fld-label">{{ 'node.panel.hours_volume_label'|trans({'%place%': plabel}, 'node') }}</div>
                            <span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide shrink-0">{{ 'common.required_badge'|trans({}, 'common') }}</span>
                        </div>
                        <div class="mt-2 grid gap-3 sm:grid-cols-3">
                            {% for m, mlabel in mods %}
                                <div class="relative">
                                    <input type="number" min="0" step="0.5" placeholder="0"
                                           name="attr_hours[{{ place }}][{{ m }}]" value="{{ val[place][m] ?? '' }}"
                                           data-hours-target="input" class="fld pr-24">
                                    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-gray-400">{{ 'node.panel.hours_unit_label'|trans({'%mod%': mlabel}, 'node') }}</span>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="fld-help">{{ ux_icon('ph:info', {class: 'icon'}) }} {{ 'node.panel.hours_place_help'|trans({'%place%': plabel}, 'node') }}</div>
                    </div>
                {% endfor %}

                <div class="rounded-xl border p-4" style="border-color:var(--c-border)">
                    <div class="flex items-center justify-between gap-2">
                        <div class="fld-label">{{ 'node.panel.hours_te_label'|trans({}, 'node') }}</div>
                        <span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide shrink-0">{{ 'common.required_badge'|trans({}, 'common') }}</span>
                    </div>
                    <div class="relative mt-2">
                        <input type="number" min="0" step="0.5" placeholder="0"
                               name="attr_hours[te]" value="{{ val.te ?? '' }}"
                               data-hours-target="input" class="fld pr-24">
                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-xs text-gray-400">{{ 'node.panel.hours_unit_label'|trans({'%mod%': 'TE'}, 'node') }}</span>
                    </div>
                    <div class="fld-help">{{ ux_icon('ph:info', {class: 'icon'}) }} {{ 'node.panel.hours_te_help'|trans({}, 'node') }}</div>
                </div>
            </div>
        </div>
    {% elseif def.field == 'mccc' %}
        {% set mtypes = mccc_types_for(node.formation) %}
        {% set selectedType = val.type ?? '' %}
        {% set selectedMt = mtypes|filter(t => t.key == selectedType)|first %}
        {% set evals = val.evaluations ?? [] %}
        <div data-controller="mccc">
            <div class="flex items-center gap-2">
                <span class="fld-label">{{ 'node.panel.mccc_type_label'|trans({}, 'node') }}</span>
                <span class="text-[11px] font-semibold text-red-500 uppercase tracking-wide">{{ 'common.required_badge'|trans({}, 'common') }}</span>
            </div>
            {% if mtypes is empty %}
                <p class="fld-help mt-1">{{ 'node.panel.no_mccc_types'|trans({}, 'node') }}</p>
            {% endif %}
            <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                {% for mt in mtypes %}
                    {% set on = selectedType == mt.key %}
                    <label class="flex items-start gap-2.5 text-sm cursor-pointer rounded-lg border px-3 py-2.5 hover:bg-gray-50"
                           style="border-color:{{ on ? 'var(--c-primary)' : 'var(--c-border)' }};background:{{ on ? 'var(--c-primary-soft)' : '#fff' }}">
                        <input type="radio" name="attr_mccc[type]" value="{{ mt.key }}" {{ on ? 'checked' }} class="mt-0.5"
                               data-mccc-target="typeRadio" data-action="change->mccc#sync"
                               data-has-evaluations="{{ mt.hasEvaluations ? '1' : '0' }}" data-evaluations-label="{{ mt.evaluationsLabel }}">
                        <span><span class="font-semibold">{{ mt.shortLabel }}</span>
                            <span class="block text-xs text-gray-400">{{ mt.label }}</span></span>
                    </label>
                {% endfor %}
            </div>

            <div data-mccc-target="collection" {{ (selectedMt and selectedMt.hasEvaluations) ? '' : 'hidden' }}
                 class="mt-4 rounded-xl border p-4" style="border-color:var(--c-border)">
                <div class="flex items-center justify-between gap-2">
                    <div class="fld-label" data-mccc-target="collectionLabel">{{ selectedMt ? selectedMt.evaluationsLabel : 'node.panel.default_evaluations_label'|trans({}, 'node') }}</div>
                    <div class="text-sm text-gray-500">{{ 'node.panel.mccc_total_label'|trans({}, 'node') }} <span class="font-semibold" data-mccc-target="sum">0</span> %</div>
                </div>
                <div data-mccc-target="rows" class="mt-2 space-y-2">
                    {% for e in evals %}{{ ui.mcccRow(loop.index0, e.type ?? '', e.weight ?? '', e.duree ?? '') }}{% endfor %}
                </div>
                <button type="button" data-action="mccc#addRow"
                        class="mt-2 inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">
                    {{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'node.panel.add_evaluation_button'|trans({}, 'node') }}
                </button>
                <template data-mccc-target="rowTemplate">{{ ui.mcccRow('__INDEX__', '', '', '') }}</template>
            </div>
        </div>

        {% set results = mccc_results(node) %}
        {% if results is not empty %}
            <div class="mt-3 space-y-1.5">
                {% for r in results %}
                    {% set colors = r.valid ? {bg: '#f0fdf4', fg: '#166534', icon: 'ph:check-circle'}
                        : (r.severity == 'error' ? {bg: '#fef2f2', fg: '#b91c1c', icon: 'ph:x-circle'}
                        : (r.severity == 'warning' ? {bg: '#fffbeb', fg: '#b45309', icon: 'ph:warning'}
                        : {bg: '#eff6ff', fg: '#1d4ed8', icon: 'ph:info'})) %}
                    <div class="flex items-center gap-2 text-sm rounded-lg px-3 py-2" style="background:{{ colors.bg }};color:{{ colors.fg }}">
                        {{ ux_icon(colors.icon, {class: 'icon'}) }} {{ r.message }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% else %}
        <input name="attr_{{ key }}" value="{{ val }}" class="fld">
    {% endif %}
{% endmacro %}

{% macro mcccRow(index, type, weight, duree) %}
    <div class="flex items-center gap-2" data-mccc-target="row">
        <select name="attr_mccc[evaluations][{{ index }}][type]" class="fld flex-1">
            <option value="">{{ 'node.panel.evaluation_type_placeholder'|trans({}, 'node') }}</option>
            {% for k, l in referentiel('types_epreuve') %}<option value="{{ k }}" {{ type == k ? 'selected' }}>{{ l }}</option>{% endfor %}
        </select>
        <div class="relative w-24 shrink-0">
            <input type="number" step="1" min="0" name="attr_mccc[evaluations][{{ index }}][duree]" value="{{ duree }}"
                   placeholder="{{ 'node.panel.evaluation_duree_placeholder'|trans({}, 'node') }}" class="fld pr-8" title="{{ 'node.panel.evaluation_duree_title'|trans({}, 'node') }}">
            <span class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-xs text-gray-400">min</span>
        </div>
        <div class="relative w-28 shrink-0">
            <input type="number" step="0.1" min="0" name="attr_mccc[evaluations][{{ index }}][weight]" value="{{ weight }}"
                   class="fld pr-7" data-mccc-target="weightInput" data-action="input->mccc#updateSum">
            <span class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-xs text-gray-400">%</span>
        </div>
        <button type="button" data-action="mccc#removeRow"
                class="shrink-0 rounded-lg border px-2 py-2 text-gray-400 hover:bg-gray-50 hover:text-red-600" style="border-color:var(--c-border)" title="{{ 'node.panel.delete_title'|trans({}, 'node') }}">
            {{ ux_icon('ph:trash', {class: 'icon'}) }}
        </button>
    </div>
{% endmacro %}

{% macro quickAdd(referentielKey, formation, node) %}
    <form method="post" action="{{ path('referentiel_quick_add', {key: referentielKey}) }}" data-turbo-frame="node-panel" class="mt-1.5 flex items-center gap-2">
        <input type="hidden" name="fid" value="{{ formation.id }}">
        <input type="hidden" name="nid" value="{{ node.id }}">
        <input type="text" name="value" placeholder="{{ 'node.panel.quick_add_placeholder'|trans({}, 'node') }}" class="fld flex-1 text-xs">
        <button class="shrink-0 rounded-lg border px-2.5 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }}</button>
    </form>
{% endmacro %}
