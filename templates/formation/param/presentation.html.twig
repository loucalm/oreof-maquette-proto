{% import 'formation/param/_fields.html.twig' as fld %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ key }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ 'formation.param.panel_title'|trans({}, 'formation') }}</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ formation.name }} › {{ label }}</div>
    </div>

    <div class="panel-scroll">
    <form method="post" action="{{ path('formation_param_save', {id: formation.id, key: key}) }}" data-turbo-frame="_top"
          data-controller="autosave" data-autosave-key-value="{{ key }}"
          class="panel-card space-y-5">

        {% set issues = param_issues(formation, key) %}
        {% set hints = field_rule_hints('param_' ~ key ~ '_formation') %}
        {% for f in fields %}
            {% if f.type == 'separator' %}
                {{ fld.divider(f.label) }}
            {% else %}
                <div>{{ fld.field(f.key, f, data, issues[f.key] ?? [], hints[f.key] ?? null) }}</div>
            {% endif %}
        {% endfor %}

        <div class="pt-2 border-t" style="border-color:var(--c-border)">
            <button data-autosave-target="submit" class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <span data-autosave-target="status" class="text-xs" style="color:var(--c-muted)" aria-live="polite"></span>
        </div>
    </form>
    </div>
</div>
</turbo-frame>
