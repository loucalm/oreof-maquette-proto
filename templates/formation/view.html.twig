{% extends 'base.html.twig' %}
{% block title %}{{ formation.name }} · consultation{% endblock %}

{% macro branch(views, catalog) %}
    {% import _self as m %}
    <ul class="ml-4 border-l border-dashed pl-4 space-y-1" style="border-color:var(--c-border)">
        {% for view in views %}
            {% set n = view.node %}
            <li class="py-1">
                <div class="flex items-center gap-2">
                    <span class="status-dot" data-status="{{ view.status }}"></span>
                    <span class="type-badge">{{ n.type.icon }} [{{ n.type.label }}]</span>
                    <span class="text-sm font-medium">{{ n.label ?: '—' }}</span>
                    {% if n.code %}<span class="text-xs text-gray-400">{{ n.code }}</span>{% endif %}
                    {% if view.totalHours %}<span class="text-xs text-gray-400">· {{ view.totalHours|round }} h</span>{% endif %}
                    {% if view.totalEcts %}<span class="text-xs text-gray-400">· {{ view.totalEcts|round }} ECTS{% if view.ectsTarget %}/{{ view.ectsTarget }}{% endif %}</span>{% endif %}
                </div>
                {% set caps = n.effectiveCapabilities() %}
                {% set shown = [] %}
                {% for key, def in catalog %}
                    {% if (caps[key] ?? false) and n.getAttribute(key) is not null and n.getAttribute(key) is not empty %}
                        {% set shown = shown|merge(['%s : %s'|format(def.label, key == 'competencies' ? n.getAttribute(key)|join(', ') : (key in ['hours','mccc'] ? '…' : n.getAttribute(key)))]) %}
                    {% endif %}
                {% endfor %}
                {% if shown %}<div class="ml-6 text-xs text-gray-500">{{ shown|join(' · ') }}</div>{% endif %}
                {% if view.children %}{{ m.branch(view.children, catalog) }}{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block body %}
{% import _self as m %}
<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between">
        <div>
            <div class="text-xs text-gray-400">
                🏠 <span class="fake-link">Accueil</span> ›
                <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formation</a> › {{ formation.name }}
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight mt-1">{{ formation.name }}</h1>
            <p class="text-sm text-gray-500">Consultation — lecture seule</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="pill" style="background:#eef2ff;color:var(--c-primary)">Lecture seule</span>
            <a href="{{ path('formation_editor', {id: formation.id}) }}" class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">✎ Modifier</a>
            <a href="{{ path('formation_index') }}" class="rounded-lg border px-3 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">← Liste</a>
        </div>
    </div>
    <div class="mt-4 grid grid-cols-2 md:grid-cols-5 gap-4">
        {% for k, v in {'Domaine': formation.domaine ?: 'Non défini', 'Type diplôme': formation.diplome ?: '—', 'Composante': formation.composante ?: '—', 'Parcours': formation.multiParcours ? 'Multi' : 'Mono', 'Progression': progress ~ '%'} %}
            <div><div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ k }}</div><div class="text-sm mt-1">{{ v }}</div></div>
        {% endfor %}
    </div>
</div>

<div class="rounded-2xl border bg-white px-7 py-6" style="border-color:var(--c-border)">
    <h2 class="text-lg font-bold mb-3">Structure</h2>
    {% if roots is empty %}
        <p class="text-sm text-gray-400">Aucune structure définie.</p>
    {% else %}
        <div class="-ml-4">{{ m.branch(roots, catalog) }}</div>
    {% endif %}
</div>
{% endblock %}
