{% extends 'base.html.twig' %}
{% block title %}{{ formation.name }} · éditeur{% endblock %}

{% set focus = app.request.query.get('focus') %}
{% set param = app.request.query.get('param') %}
{% set bcc = app.request.query.get('bcc') %}
{% set multi = formation.multiParcours %}
{% set frameSrc = bcc ? path('bcc_editor', {fid: formation.id})
    : (param ? path('formation_param', {id: formation.id, key: param})
    : (focus ? path('node_panel', {fid: formation.id, nid: focus}) : null)) %}
{# défaut multi-parcours : le graphe de ramification #}
{% if not frameSrc and multi %}{% set frameSrc = path('formation_parcours_graph', {id: formation.id}) %}{% endif %}

{% block body %}

{# ─── bandeau titre (fictif) ─── #}
<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight">{{ formation.name }}</h1>
            <p class="text-sm text-gray-500">Page de modification de la formation</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('formation_view', {id: formation.id}) }}" class="fake-btn">{{ ux_icon('ph:eye', {class: 'icon'}) }} Voir la fiche descriptive</a>
            <a href="{{ path('formation_index') }}" class="rounded-lg border px-3 py-2 text-sm font-medium text-green-700 hover:bg-green-50" style="border-color:#bbf7d0">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} Retour à la liste des formation</a>
        </div>
    </div>
    <div class="mt-3 text-sm text-gray-400">
        {{ ux_icon('ph:house', {class: 'icon'}) }} <span class="fake-link">Accueil</span> › <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formation</a> ›
        <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">{{ formation.name }}</span>
    </div>
</div>

{# ─── méta + process (fictif) ─── #}
<div class="grid gap-4 lg:grid-cols-[1fr_360px] mb-4">
    <div class="rounded-2xl border bg-white px-7 py-5 grid grid-cols-2 md:grid-cols-5 gap-4" style="border-color:var(--c-border)">
        {% for k, v in {
            'Domaine': formation.domaine ?: 'Non défini',
            'Type diplôme': formation.diplome ?: 'Licence',
            'Composante': formation.composante ?: 'Composante exemple',
            'Mention': formation.name,
            'Parcours': multi ? parcours_nodes(formation)|length ~ ' parcours' : 'Mono-parcours'
        } %}
            <div>
                <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ k }}</div>
                <div class="text-sm mt-1">{{ v }}</div>
            </div>
        {% endfor %}
    </div>
    <div class="rounded-2xl border bg-white px-6 py-5" style="border-color:var(--c-border)">
        <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-3">Avancement du process</div>
        <div class="flex items-center justify-between">
            {% for i in 1..5 %}
                <div class="grid h-9 w-9 place-items-center rounded-full text-white text-xs
                     {{ i <= 3 ? '' : 'opacity-40' }}" style="background:{{ i == 4 ? 'var(--st-ok)' : '#94a3b8' }}">{{ ux_icon('ph:check-bold', {class: 'icon'}) }}</div>
                {% if not loop.last %}<div class="h-px flex-1 bg-gray-200 mx-1"></div>{% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{# ─── bannière + actions rapides (fictif) ─── #}
<div class="flex flex-wrap items-center gap-3 mb-6">
    <div class="rounded-xl border px-5 py-3 text-sm" style="border-color:#bbf7d0;background:#f0fdf4">
        <div class="font-semibold text-green-800">Formation ouverte</div>
        <div class="text-green-700">Vous pouvez modifiez la formation</div>
    </div>
    <div class="ml-auto flex items-center gap-2">
        <span class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mr-1">Actions rapide</span>
        <span class="fake-btn" style="color:#b45309;border-color:#fcd34d">{{ ux_icon('ph:arrows-left-right', {class: 'icon'}) }} Changer co/resp. formation</span>
        <span class="fake-btn">{{ ux_icon('ph:gear', {class: 'icon'}) }} Action complémentaire {{ ux_icon('ph:caret-down', {class: 'icon'}) }}</span>
        <form method="post" action="{{ path('formation_undo', {id: formation.id}) }}" data-turbo-frame="_top">
            <button type="submit" {{ canUndo ? '' : 'disabled' }} title="Annuler la dernière modification"
                    class="quickbar-icon-btn">{{ ux_icon('ph:arrow-counter-clockwise', {class: 'icon'}) }}</button>
        </form>
        <form method="post" action="{{ path('formation_redo', {id: formation.id}) }}" data-turbo-frame="_top">
            <button type="submit" {{ canRedo ? '' : 'disabled' }} title="Rétablir la modification annulée"
                    class="quickbar-icon-btn">{{ ux_icon('ph:arrow-clockwise', {class: 'icon'}) }}</button>
        </form>
        <a href="{{ path('formation_history', {id: formation.id}) }}"
           class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
           style="border-color:var(--c-border)">{{ ux_icon('ph:clock-counter-clockwise', {class: 'icon'}) }} Historique</a>
        <a href="{{ path('formation_export', {id: formation.id}) }}"
           class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
           style="border-color:var(--c-border)">{{ ux_icon('ph:download-simple', {class: 'icon'}) }} Export</a>
        {% if is_admin() %}
        <div class="relative" data-controller="menu">
            <button type="button" data-action="menu#toggle"
                    class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                    style="border-color:var(--c-border)">{{ ux_icon('ph:list', {class: 'icon'}) }} Gestion SES <span class="text-gray-400">{{ ux_icon('ph:caret-down', {class: 'icon'}) }}</span></button>
            <div data-menu-target="menu" hidden
                 class="absolute right-0 z-30 mt-1 w-64 rounded-xl border bg-white py-1.5 text-sm shadow-lg"
                 style="border-color:var(--c-border)">
                <div class="px-3 pb-1 pt-1 text-[11px] font-semibold uppercase tracking-wide text-gray-400">Administration</div>
                <a href="{{ path('admin_index') }}" class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50">{{ ux_icon('ph:gear', {class: 'icon'}) }} Vue d’ensemble</a>
                <a href="{{ path('node_type_index') }}" class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50">{{ ux_icon('ph:puzzle-piece', {class: 'icon'}) }} Types de nœud</a>
                <a href="{{ path('field_index') }}" class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50">{{ ux_icon('ph:note-pencil', {class: 'icon'}) }} Champs des formulaires</a>
                <a href="{{ path('template_index') }}" class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50">{{ ux_icon('ph:folders', {class: 'icon'}) }} Templates de structure</a>
                <a href="{{ path('admin_referentiels') }}" class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50">{{ ux_icon('ph:books', {class: 'icon'}) }} Référentiels</a>
                <div class="my-1 border-t" style="border-color:var(--c-border)"></div>
                <a href="{{ path('formation_editor', {id: formation.id, param: 'structure'}) }}"
                   class="flex items-center gap-2 px-3 py-2 hover:bg-gray-50">{{ ux_icon('ph:arrow-bend-down-right', {class: 'icon'}) }} Configuration de la structure de cette formation</a>
            </div>
        </div>
        {% endif %}
    </div>
</div>

{# ═══ éditeur ═══ #}
<div class="rounded-2xl border bg-white p-7" style="border-color:var(--c-border)">
    <h2 class="text-2xl font-extrabold tracking-tight">ÉDITEUR DE FORMATION</h2>
    <p class="text-sm text-gray-500 mb-5">
        {{ multi ? 'Gérez les paramètres de la formation et ouvrez chaque parcours pour construire sa structure.'
                 : 'Construisez la structure de la formation nœud par nœud.' }}
    </p>

    <div class="editor-shell grid lg:grid-cols-[380px_1fr] lg:h-[calc(100vh-9rem)] min-h-[560px]">

        {# ─── panneau gauche ─── #}
        <div class="editor-aside flex flex-col overflow-hidden"
             data-controller="tree"
             {% if not multi %}
             data-tree-move-url-value="{{ path('node_move', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-dup-url-value="{{ path('node_duplicate', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-del-url-value="{{ path('node_delete', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-chain-value="{{ formation.effectiveStructure|json_encode|e('html_attr') }}"
             data-tree-type-meta-value="{{ type_meta()|json_encode|e('html_attr') }}"
             data-tree-root-key-value="{{ formation.visibleRootTypeKey }}"
             {% endif %}>

            <div class="px-4 pt-4 pb-3 border-b shrink-0" style="border-color:var(--c-border)">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">Structure de la formation</span>
                    <span class="pill" style="background:#fef3c7;color:#b45309">{{ progress == 100 ? 'Complet' : 'Incomplet' }}</span>
                </div>
                <div class="mt-2 font-bold">{{ formation.name }}</div>
                <div class="text-xs text-gray-400">{{ formation.composante ?: 'Composante exemple' }}</div>
                <div class="mt-2">
                    <div class="flex justify-between text-[11px] text-gray-400"><span>Progression global</span><span>{{ progress }}%</span></div>
                    <div class="mt-1 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                        <div class="h-full rounded-full" style="width:{{ progress }}%;background:{{ progress < 30 ? 'var(--st-empty)' : (progress < 70 ? 'var(--st-incomplete)' : 'var(--st-ok)') }}"></div>
                    </div>
                </div>
            </div>

            <div class="flex-1 overflow-y-auto">
                <div class="px-4 py-3 border-b" style="border-color:var(--c-border)">
                    <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-1.5">Paramètre de la formation</div>
                    {% set sections = param_sections() %}
                    <a href="{{ path('formation_param', {id: formation.id, key: 'organisation'}) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ param == 'organisation' ? 'is-active' }}">
                        <span class="status-dot" data-status="{{ param_status(formation, 'organisation') }}"></span>1 | {{ sections.organisation.label }}
                    </a>
                    <a href="{{ path('formation_param', {id: formation.id, key: 'presentation'}) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ param == 'presentation' ? 'is-active' }}">
                        <span class="status-dot" data-status="{{ param_status(formation, 'presentation') }}"></span>2 | {{ sections.presentation.label }}
                    </a>
                    {% if not multi %}
                        <a href="{{ path('bcc_editor', {fid: formation.id}) }}" data-turbo-frame="node-panel"
                           class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ bcc ? 'is-active' }}">
                            <span class="status-dot" data-status="{{ bcc_status(formation) }}"></span>3 | Référentiel de compétences (BCC)
                        </a>
                    {% else %}
                        <a href="{{ path('formation_parcours_graph', {id: formation.id}) }}" data-turbo-frame="node-panel"
                           class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ (not param and not focus and not bcc) ? 'is-active' }}"
                           style="color:var(--c-primary)">3 | {{ ux_icon('ph:map-trifold', {class: 'icon'}) }} Arborescence des parcours</a>
                    {% endif %}
                    <a href="{{ path('formation_param', {id: formation.id, key: 'structure'}) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ param == 'structure' ? 'is-active' }}">
                        <span class="status-dot" data-status="{{ param_status(formation, 'structure') }}"></span>4 | {{ sections.structure.label }}
                    </a>
                </div>

                {% if multi %}
                    {# ─── liste des parcours (chaque ligne ouvre son éditeur) ─── #}
                    <div class="px-4 py-3">
                        <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-1.5">Parcours</div>
                        {% for p in parcours_nodes(formation) %}
                            <a href="{{ path('parcours_editor', {fid: formation.id, nid: p.id}) }}"
                               class="mb-2 flex items-center justify-between gap-2 rounded-xl border px-3 py-2.5 text-sm font-semibold hover:bg-gray-50"
                               style="border-color:var(--c-border)">
                                <span class="min-w-0 truncate">{{ p.displayLabel }}</span>
                                <span class="shrink-0 text-gray-300">{{ ux_icon('ph:caret-right', {class: 'icon'}) }}</span>
                            </a>
                        {% else %}
                            <p class="text-xs text-gray-400 px-1 py-2">Aucun parcours. Ajoutez-en un ci-dessous.</p>
                        {% endfor %}
                    </div>
                {% else %}
                    {% set rootType = root_type(formation) %}
                    <div class="p-2">
                        {% if roots is not empty %}
                            {{ include('formation/_tree.html.twig', {views: roots, parentId: null, focus: focus}) }}
                        {% elseif not rootType %}
                            <p class="text-sm px-2 py-8 text-center text-gray-400">
                                Définissez d'abord le squelette dans
                                <a href="{{ path('formation_param', {id: formation.id, key: 'structure'}) }}" data-turbo-frame="node-panel" class="underline">Configuration de la structure</a>.
                            </p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# ─── barre d'actions ─── #}
            <div class="px-3 py-3 border-t shrink-0 flex items-center gap-2" style="border-color:var(--c-border)">
                {% if multi %}
                    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top" class="flex-1">
                        <input type="hidden" name="parentId" value="">
                        <input type="hidden" name="typeKey" value="parcours">
                        <input type="hidden" name="label" value="Nouveau parcours">
                        <button class="tree-add-btn">{{ ux_icon('ph:plus', {class: 'icon'}) }} Ajouter {{ ux_icon('ph:compass', {class: 'icon'}) }} un parcours</button>
                    </form>
                {% elseif rootType %}
                    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
                          class="flex-1" data-tree-target="addForm">
                        <input type="hidden" name="parentId" value="" data-tree-target="addParent">
                        <input type="hidden" name="typeKey" value="{{ rootType.key }}" data-tree-target="addType">
                        <button data-tree-target="addButton" class="tree-add-btn">{{ ux_icon('ph:plus', {class: 'icon'}) }} Ajouter {{ ux_icon(rootType.icon, {class: 'icon'}) }} {{ rootType.label }}</button>
                    </form>
                {% else %}
                    <span class="flex-1 text-xs text-gray-400">Aucune structure définie</span>
                {% endif %}

                {% if not multi %}
                    <form method="post" data-turbo-frame="_top" data-tree-target="dupForm">
                        <button type="submit" data-tree-target="dupButton" disabled title="Dupliquer le nœud sélectionné"
                                class="tree-act-btn">{{ ux_icon('ph:copy', {class: 'icon'}) }}</button>
                    </form>
                    <form method="post" data-turbo-frame="_top" data-tree-target="delForm"
                          data-controller="confirm" data-confirm-message-value="Supprimer ce nœud et tout ce qu'il contient ?">
                        <button type="submit" data-tree-target="delButton" disabled title="Supprimer le nœud sélectionné"
                                class="tree-act-btn tree-act-btn-danger">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                    </form>
                {% endif %}
            </div>
        </div>

        {# ─── panneau d'édition ─── #}
        <turbo-frame id="node-panel" class="panel-frame"
                     {% if frameSrc %}src="{{ frameSrc }}"{% endif %}>
            {% if not frameSrc %}
                <div class="panel-empty">Sélectionnez une section ou un nœud pour le modifier</div>
            {% endif %}
        </turbo-frame>
    </div>
</div>
{% endblock %}
