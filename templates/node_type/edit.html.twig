{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'Nouveau type' : nodeType.label }}{% endblock %}

{% block body %}
<div class="max-w-2xl">
    <div class="text-xs" style="color:var(--c-muted)">
        <a href="{{ path('node_type_index') }}" class="hover:underline">Types de nœuds</a> › {{ isNew ? 'nouveau' : nodeType.label }}
    </div>
    <h1 class="text-xl font-bold mt-1 mb-5">{{ isNew ? 'Nouveau type de nœud' : 'Modifier « ' ~ nodeType.label ~ ' »' }}</h1>

    <form method="post" class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="text-xs font-medium">Libellé</span>
                <input name="label" required value="{{ nodeType.label ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">Icône</span>
                <input name="icon" value="{{ nodeType.icon ?? '' }}" placeholder="🧩" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>
        <div class="grid grid-cols-3 gap-3">
            <label class="block">
                <span class="text-xs font-medium">Clé</span>
                <input name="key" value="{{ nodeType.key ?? '' }}" placeholder="auto depuis le libellé" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">Famille</span>
                <select name="family" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                    {% for fam in families %}<option value="{{ fam.value }}" {{ (nodeType.family ?? null) == fam ? 'selected' }}>{{ fam.label }}</option>{% endfor %}
                </select>
            </label>
            <div class="grid grid-cols-2 gap-2">
                <label class="block">
                    <span class="text-xs font-medium">Position</span>
                    <input type="number" name="position" value="{{ nodeType.position ?? 0 }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                </label>
                <label class="block">
                    <span class="text-xs font-medium">ECTS cible</span>
                    <input type="number" name="ectsTarget" value="{{ nodeType.ectsTarget ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                </label>
            </div>
        </div>

        <p class="text-xs rounded-md px-3 py-2" style="background:var(--c-primary-soft);color:var(--c-primary)">
            La hiérarchie (quel type peut être enfant de quel type) n'est PAS définie ici : elle est propre à
            chaque formation, dans « Configuration de la structure ».
        </p>

        <fieldset>
            <legend class="text-xs font-medium mb-1">Capacités &amp; champs du type</legend>
            <p class="text-xs mb-2" style="color:var(--c-muted)">
                <strong>Incluse</strong> : le champ existe pour ce type de nœud.
                <strong>Réservée admin</strong> : imposé — le responsable de formation ne peut pas l'activer / désactiver par nœud.
            </p>
            <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wide" style="color:var(--c-muted)">
                    <tr class="border-b" style="border-color:var(--c-border)">
                        <th class="text-left py-1.5">Capacité</th>
                        <th class="w-20 text-center">Incluse</th>
                        <th class="w-28 text-center">Réservée admin</th>
                    </tr>
                </thead>
                <tbody>
                {% for key, label in capabilities %}
                    <tr class="border-b last:border-0" style="border-color:var(--c-border)">
                        <td class="py-1.5">{{ label }} <code class="text-xs" style="color:var(--c-muted)">{{ key }}</code></td>
                        <td class="text-center">
                            <input type="checkbox" name="capabilities[]" value="{{ key }}"
                                   {{ (not isNew and nodeType.hasCapability(key)) ? 'checked' }}>
                        </td>
                        <td class="text-center">
                            <input type="checkbox" name="lockedCapabilities[]" value="{{ key }}"
                                   {{ (not isNew and nodeType.isCapabilityLocked(key)) ? 'checked' }}>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </fieldset>

        <div class="flex gap-2 pt-1">
            <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">Enregistrer</button>
            <a href="{{ path('node_type_index') }}" class="rounded-md border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
