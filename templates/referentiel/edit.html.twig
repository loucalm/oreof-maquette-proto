{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'referentiel.edit.new_title'|trans({}, 'referentiel') : referentiel.label }}{% endblock %}

{% block body %}
<turbo-frame id="admin-content">
<div class="max-w-2xl mx-auto">
    <div class="text-xs" style="color:var(--c-muted)">
        <a href="{{ path('admin_referentiels') }}" data-turbo-frame="_top" class="hover:underline">{{ 'referentiel.edit.breadcrumb_root'|trans({}, 'referentiel') }}</a> › {{ isNew ? 'referentiel.edit.breadcrumb_new'|trans({}, 'referentiel') : referentiel.label }}
    </div>
    <h1 class="text-xl font-bold mt-1 mb-5">{{ isNew ? 'referentiel.edit.new_heading'|trans({}, 'referentiel') : 'referentiel.edit.edit_heading'|trans({'%label%': referentiel.label}, 'referentiel') }}</h1>

    <form method="post" data-turbo-frame="_top" class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'referentiel.edit.label_field'|trans({}, 'referentiel') }}</span>
                <input name="label" required value="{{ referentiel.label ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">{{ 'referentiel.edit.key_field'|trans({}, 'referentiel') }}</span>
                <input name="key" value="{{ referentiel.key ?? '' }}" placeholder="{{ 'referentiel.edit.key_placeholder'|trans({}, 'referentiel') }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'referentiel.edit.description_field'|trans({}, 'referentiel') }}</span>
                <input name="description" value="{{ referentiel.description ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">{{ 'referentiel.edit.order_field'|trans({}, 'referentiel') }}</span>
                <input type="number" name="position" value="{{ referentiel.position ?? 100 }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <label class="block">
                <span class="text-xs font-medium">{{ 'referentiel.edit.category_field'|trans({}, 'referentiel') }}</span>
                <select name="category" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                    {% for cat in categories %}<option value="{{ cat.value }}" {{ (referentiel.category ?? constant('App\\Enum\\RefCategory::Libre')) == cat ? 'selected' }}>{{ cat.label }}</option>{% endfor %}
                </select>
            </label>
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'referentiel.edit.entite_cible_field'|trans({}, 'referentiel') }}</span>
                <input name="entiteCible" value="{{ referentiel.entiteCible ?? '' }}" placeholder="{{ 'referentiel.edit.entite_cible_placeholder'|trans({}, 'referentiel') }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                <span class="text-[11px]" style="color:var(--c-muted)">{{ 'referentiel.edit.entite_cible_help'|trans({}, 'referentiel') }}</span>
            </label>
        </div>

        <div data-controller="values-editor" class="rounded-lg border p-3 space-y-2" style="border-color:var(--c-border)">
            <div>
                <span class="text-xs font-medium">{{ 'referentiel.edit.values_title'|trans({}, 'referentiel') }}</span>
                <p class="text-[11px]" style="color:var(--c-muted)">{{ 'referentiel.edit.values_help'|trans({}, 'referentiel') }}</p>
            </div>

            <div data-values-editor-target="list" class="space-y-2">
                {% for v, l in (referentiel.values ?? {}) %}
                    <div data-values-row class="flex items-center gap-2">
                        <span class="drag-handle shrink-0">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                        <input name="values_label[]" value="{{ l }}" placeholder="{{ 'referentiel.edit.value_label_placeholder'|trans({}, 'referentiel') }}" class="flex-1 rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                        <input name="values_code[]" value="{{ v != l ? v : '' }}" placeholder="{{ 'referentiel.edit.value_code_placeholder'|trans({}, 'referentiel') }}" class="w-36 rounded-md border px-3 py-2 text-sm font-mono" style="border-color:var(--c-border)">
                        <button type="button" data-action="values-editor#remove" title="{{ 'referentiel.edit.value_remove_title'|trans({}, 'referentiel') }}" class="icon-btn icon-btn--danger shrink-0">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                    </div>
                {% endfor %}
            </div>

            <template data-values-editor-target="template">
                <div data-values-row class="flex items-center gap-2">
                    <span class="drag-handle shrink-0">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                    <input name="values_label[]" placeholder="{{ 'referentiel.edit.value_label_placeholder'|trans({}, 'referentiel') }}" class="flex-1 rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                    <input name="values_code[]" placeholder="{{ 'referentiel.edit.value_code_placeholder'|trans({}, 'referentiel') }}" class="w-36 rounded-md border px-3 py-2 text-sm font-mono" style="border-color:var(--c-border)">
                    <button type="button" data-action="values-editor#remove" title="{{ 'referentiel.edit.value_remove_title'|trans({}, 'referentiel') }}" class="icon-btn icon-btn--danger shrink-0">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                </div>
            </template>

            <button type="button" data-action="values-editor#add" class="rounded-md border px-3 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'referentiel.edit.value_add_button'|trans({}, 'referentiel') }}</button>

            <details class="rounded-md border" style="border-color:var(--c-border)">
                <summary class="px-3 py-2 text-sm cursor-pointer">{{ 'referentiel.edit.values_bulk_summary'|trans({}, 'referentiel') }}</summary>
                <div class="p-3 space-y-2 border-t" style="border-color:var(--c-border)">
                    <p class="text-[11px]" style="color:var(--c-muted)">{{ 'referentiel.edit.values_bulk_help'|trans({}, 'referentiel') }}</p>
                    <textarea data-values-editor-target="bulk" rows="4" class="w-full rounded-md border px-3 py-2 text-sm font-mono" style="border-color:var(--c-border)"></textarea>
                    <button type="button" data-action="values-editor#importBulk" class="rounded-md border px-3 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'referentiel.edit.values_bulk_button'|trans({}, 'referentiel') }}</button>
                </div>
            </details>
        </div>

        <div class="flex gap-2 pt-1">
            <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <a href="{{ path('admin_referentiels') }}" data-turbo-frame="_top" class="rounded-md border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</a>
        </div>
    </form>
</div>
</turbo-frame>
{% endblock %}
