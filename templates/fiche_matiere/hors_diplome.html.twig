{% extends 'base.html.twig' %}
{# Fiches matière hors diplôme (utilisables par toutes les formations) — rangées dans l'offre de formation, comme ORéOF v2. #}
{% block title %}{{ 'admin.fiches_matieres.title'|trans({}, 'admin') }}{% endblock %}

{% set header_title = 'admin.fiches_matieres.heading'|trans({}, 'admin') %}
{% set header_description = 'admin.fiches_matieres.description'|trans({}, 'admin') %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: header_title},
] %}

{% block body %}

<div class="rounded-xl border bg-white p-5 space-y-5 border-secondary-200">
    <form method="post" action="{{ path('fiche_matiere_hors_diplome_create') }}" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token(constant('App\\Controller\\FicheMatiereController::CSRF_ID')) }}">
        <label class="fld-label min-w-48 flex-1">
            {{ 'admin.fiches_matieres.libelle_field'|trans({}, 'admin') }}
            <input type="text" name="libelle" required maxlength="250" class="fld mt-1">
        </label>
        <label class="fld-label">
            {{ 'admin.fiches_matieres.type_field'|trans({}, 'admin') }}
            <select name="typeDiplome" class="fld mt-1">
                <option value="">{{ 'admin.fiches_matieres.all_types'|trans({}, 'admin') }}</option>
                {% for type in types %}
                    <option value="{{ type.id }}">{{ type.label }}</option>
                {% endfor %}
            </select>
        </label>
        <button type="submit" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'admin.fiches_matieres.create'|trans({}, 'admin') }}</button>
    </form>

    <div class="space-y-2">
    {% for row in rows %}
        <div data-fiche-row data-fiche-id="{{ row.fiche.id }}" class="flex flex-wrap items-center gap-3 rounded-lg border px-3 py-2 text-sm border-secondary-200">
            <a href="{{ path('fiche_matiere_edit', {id: row.fiche.id}) }}" data-turbo-frame="_top" class="font-medium hover:underline text-primary-600">{{ row.fiche.libelle }}</a>
            <span class="text-xs text-secondary-500">{{ row.fiche.typeDiplome ? row.fiche.typeDiplome.label : 'admin.fiches_matieres.all_types'|trans({}, 'admin') }}</span>
            <span class="text-xs text-secondary-400">{{ 'admin.fiches_matieres.ec_count'|trans({'%count%': row.usages}, 'admin') }}</span>
        </div>
    {% else %}
        <p class="text-xs text-secondary-400">{{ 'admin.fiches_matieres.empty'|trans({}, 'admin') }}</p>
    {% endfor %}
    </div>
</div>
{% endblock %}
