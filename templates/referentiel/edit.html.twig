{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'referentiel.edit.new_title'|trans({}, 'referentiel') : referentiel.label }}{% endblock %}

{% set header_title = isNew ? 'referentiel.edit.new_heading'|trans({}, 'referentiel') : 'referentiel.edit.edit_heading'|trans({'%label%': referentiel.label}, 'referentiel') %}
{% set header_breadcrumb = [
    {label: 'admin.layout.kicker'|trans({}, 'admin'), url: path('admin_index')},
    {label: 'referentiel.edit.breadcrumb_root'|trans({}, 'referentiel'), url: path('admin_referentiels')},
    {label: isNew ? 'referentiel.edit.breadcrumb_new'|trans({}, 'referentiel') : referentiel.label},
] %}

{% block bouton_header %}
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'common.back_to_list'|trans({}, 'common')" :href="path('admin_referentiels')"/>
{% endblock %}

{% block body %}
<turbo-frame id="admin-content">
<div class="mx-auto max-w-4xl">
    <form method="post" data-turbo-frame="_top" class="space-y-4 rounded-xl border border-secondary-200 bg-surface p-6 shadow-sm">
        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="fld-label">{{ 'referentiel.edit.label_field'|trans({}, 'referentiel') }}</span>
                <input name="label" required value="{{ referentiel.label ?? '' }}" class="fld mt-1 w-full">
            </label>
            <label class="block">
                <span class="fld-label">{{ 'referentiel.edit.key_field'|trans({}, 'referentiel') }}</span>
                <input name="key" value="{{ referentiel.key ?? '' }}" placeholder="{{ 'referentiel.edit.key_placeholder'|trans({}, 'referentiel') }}" class="fld mt-1 w-full">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="fld-label">{{ 'referentiel.edit.description_field'|trans({}, 'referentiel') }}</span>
                <input name="description" value="{{ referentiel.description ?? '' }}" class="fld mt-1 w-full">
            </label>
            <label class="block">
                <span class="fld-label">{{ 'referentiel.edit.order_field'|trans({}, 'referentiel') }}</span>
                <input type="number" name="position" value="{{ referentiel.position ?? 100 }}" class="fld mt-1 w-full">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <label class="block">
                <span class="fld-label">{{ 'referentiel.edit.category_field'|trans({}, 'referentiel') }}</span>
                <select name="category" class="fld mt-1 w-full">
                    {% for cat in categories %}<option value="{{ cat.value }}" {{ (referentiel.category ?? constant('App\\Enum\\RefCategory::Libre')) == cat ? 'selected' }}>{{ cat.label }}</option>{% endfor %}
                </select>
            </label>
            <label class="block col-span-2">
                <span class="fld-label">{{ 'referentiel.edit.entite_cible_field'|trans({}, 'referentiel') }}</span>
                <input name="entiteCible" value="{{ referentiel.entiteCible ?? '' }}" placeholder="{{ 'referentiel.edit.entite_cible_placeholder'|trans({}, 'referentiel') }}" class="fld mt-1 w-full">
                <span class="text-[11px] text-secondary-500">{{ 'referentiel.edit.entite_cible_help'|trans({}, 'referentiel') }}</span>
            </label>
        </div>

        <div data-controller="values-editor" class="rounded-lg border p-3 space-y-2 border-secondary-200">
            <div>
                <span class="fld-label">{{ 'referentiel.edit.values_title'|trans({}, 'referentiel') }}</span>
                <p class="text-[11px] text-secondary-500">{{ 'referentiel.edit.values_help'|trans({}, 'referentiel') }}</p>
            </div>

            <div data-values-editor-target="list" class="space-y-2">
                {% for v, l in (referentiel.values ?? {}) %}
                    <div data-values-row class="flex items-center gap-2">
                        <span class="drag-handle shrink-0">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                        <input name="values_label[]" value="{{ l }}" placeholder="{{ 'referentiel.edit.value_label_placeholder'|trans({}, 'referentiel') }}" class="fld flex-1">
                        <input name="values_code[]" value="{{ v != l ? v : '' }}" placeholder="{{ 'referentiel.edit.value_code_placeholder'|trans({}, 'referentiel') }}" class="fld w-36 font-mono">
                        <button type="button" data-action="values-editor#remove" title="{{ 'referentiel.edit.value_remove_title'|trans({}, 'referentiel') }}" class="icon-btn icon-btn--danger shrink-0">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                    </div>
                {% endfor %}
            </div>

            <template data-values-editor-target="template">
                <div data-values-row class="flex items-center gap-2">
                    <span class="drag-handle shrink-0">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                    <input name="values_label[]" placeholder="{{ 'referentiel.edit.value_label_placeholder'|trans({}, 'referentiel') }}" class="fld flex-1">
                    <input name="values_code[]" placeholder="{{ 'referentiel.edit.value_code_placeholder'|trans({}, 'referentiel') }}" class="fld w-36 font-mono">
                    <button type="button" data-action="values-editor#remove" title="{{ 'referentiel.edit.value_remove_title'|trans({}, 'referentiel') }}" class="icon-btn icon-btn--danger shrink-0">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                </div>
            </template>

            <button type="button" data-action="values-editor#add" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm">{{ 'referentiel.edit.value_add_button'|trans({}, 'referentiel') }}</button>

            <details class="rounded-md border border-secondary-200">
                <summary class="px-3 py-2 text-sm cursor-pointer">{{ 'referentiel.edit.values_bulk_summary'|trans({}, 'referentiel') }}</summary>
                <div class="p-3 space-y-2 border-t border-secondary-200">
                    <p class="text-[11px] text-secondary-500">{{ 'referentiel.edit.values_bulk_help'|trans({}, 'referentiel') }}</p>
                    <textarea data-values-editor-target="bulk" rows="4" class="fld w-full font-mono"></textarea>
                    <button type="button" data-action="values-editor#importBulk" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm">{{ 'referentiel.edit.values_bulk_button'|trans({}, 'referentiel') }}</button>
                </div>
            </details>
        </div>

        <div class="flex gap-2 pt-1">
            <button class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'common.save'|trans({}, 'common') }}</button>
            <a href="{{ path('admin_referentiels') }}" data-turbo-frame="_top" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm">{{ 'common.cancel'|trans({}, 'common') }}</a>
        </div>
    </form>
</div>
</turbo-frame>
{% endblock %}
