{% extends 'base.html.twig' %}
{% block title %}{{ parcours.displayLabel }} · {{ 'formation.parcours_editor.title_suffix'|trans({}, 'formation') }}{% endblock %}

{% set focus = app.request.query.get('focus') %}
{% set param = app.request.query.get('param') %}
{% set bcc = app.request.query.get('bcc') %}
{% set frameSrc = bcc ? path('bcc_parcours_editor', {fid: formation.id, nid: parcours.id})
    : (param ? path('parcours_param', {fid: formation.id, nid: parcours.id, key: param})
    : (focus ? path('node_panel', {fid: formation.id, nid: focus}) : null)) %}
{% set typeMeta = type_meta() %}
{% set bodyRoot = typeMeta[formation.getChildTypeKey('parcours')] ?? null %}

{% block body %}

{# ─── bandeau titre ─── #}
<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight">{{ parcours.displayLabel }}</h1>
            <p class="text-sm text-gray-500">{{ 'formation.parcours_editor.page_subtitle'|trans({}, 'formation') }}</p>
        </div>
        <div class="flex items-center gap-2">
            <form method="post" action="{{ path('formation_undo', {id: formation.id}) }}" data-turbo-frame="_top">
                <button type="submit" {{ canUndo ? '' : 'disabled' }} title="{{ 'formation.editor.undo_title'|trans({}, 'formation') }}" class="quickbar-icon-btn">{{ ux_icon('ph:arrow-counter-clockwise', {class: 'icon'}) }}</button>
            </form>
            <form method="post" action="{{ path('formation_redo', {id: formation.id}) }}" data-turbo-frame="_top">
                <button type="submit" {{ canRedo ? '' : 'disabled' }} title="{{ 'formation.editor.redo_title'|trans({}, 'formation') }}" class="quickbar-icon-btn">{{ ux_icon('ph:arrow-clockwise', {class: 'icon'}) }}</button>
            </form>
            <a href="{{ path('formation_view', {id: formation.id}) }}" class="fake-btn">{{ ux_icon('ph:eye', {class: 'icon'}) }} {{ 'formation.editor.view_sheet'|trans({}, 'formation') }}</a>
            <a href="{{ path('formation_index') }}" class="rounded-lg border px-3 py-2 text-sm font-medium text-green-700 hover:bg-green-50" style="border-color:#bbf7d0">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} {{ 'formation.editor.back_to_list'|trans({}, 'formation') }}</a>
        </div>
    </div>
    <div class="mt-3 text-sm text-gray-400">
        {{ ux_icon('ph:house', {class: 'icon'}) }} <span class="fake-link">{{ 'formation.index.breadcrumb_home'|trans({}, 'formation') }}</span> ›
        <a href="{{ path('formation_index') }}" class="hover:underline">{{ 'formation.editor.breadcrumb_list'|trans({}, 'formation') }}</a> ›
        <a href="{{ path('formation_editor', {id: formation.id}) }}" class="hover:underline">{{ formation.name }}</a> ›
        <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">{{ parcours.displayLabel }}</span>
    </div>
</div>

{# ─── méta (fictif) ─── #}
<div class="rounded-2xl border bg-white px-7 py-5 grid grid-cols-2 md:grid-cols-5 gap-4 mb-4" style="border-color:var(--c-border)">
    {% for k, v in {
        (('formation.parcours_editor.meta_formation'|trans({}, 'formation'))): formation.name,
        (('formation.editor.meta_diplome'|trans({}, 'formation'))): formation.diplome ?: 'Licence',
        (('formation.editor.meta_composante'|trans({}, 'formation'))): formation.composante ?: 'formation.editor.meta_composante_default'|trans({}, 'formation'),
        (('formation.parcours_editor.meta_periods'|trans({}, 'formation'))): period_unit(formation)|lower ~ 's ' ~ parcours.periodeDebut ~ '–' ~ parcours.periodeFin,
        (('formation.parcours_editor.meta_parent'|trans({}, 'formation'))): parcours.parcoursParent ? parcours.parcoursParent.displayLabel : '—'
    } %}
        <div>
            <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ k }}</div>
            <div class="text-sm mt-1">{{ v }}</div>
        </div>
    {% endfor %}
</div>

{# ═══ éditeur ═══ #}
<div class="rounded-2xl border bg-white p-7" style="border-color:var(--c-border)">
    <h2 class="text-2xl font-extrabold tracking-tight">{{ 'formation.parcours_editor.heading'|trans({}, 'formation')|upper }}</h2>
    <p class="text-sm text-gray-500 mb-5">{{ 'formation.parcours_editor.description'|trans({}, 'formation') }}</p>

    <div class="editor-shell grid lg:grid-cols-[380px_1fr] lg:h-[calc(100vh-9rem)] min-h-[560px]">

        {# ─── panneau structure ─── #}
        <div class="editor-aside flex flex-col overflow-hidden"
             data-controller="tree modal"
             data-tree-move-url-value="{{ path('node_move', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-dup-url-value="{{ path('node_duplicate', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-del-url-value="{{ path('node_delete', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-chain-value="{{ formation.effectiveStructure|json_encode|e('html_attr') }}"
             data-tree-type-meta-value="{{ typeMeta|json_encode|e('html_attr') }}"
             data-tree-root-key-value="{{ formation.getChildTypeKey('parcours') }}"
             data-tree-base-parent-value="{{ parcours.id }}">

            <div class="px-4 pt-4 pb-3 border-b shrink-0" style="border-color:var(--c-border)">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'formation.parcours_editor.structure_label'|trans({}, 'formation') }}</span>
                    <span class="pill" style="background:#fef3c7;color:#b45309">{{ progress == 100 ? 'formation.index.bcc_complete'|trans({}, 'formation') : 'formation.index.bcc_incomplete'|trans({}, 'formation') }}</span>
                </div>
                <div class="mt-2 font-bold">{{ parcours.displayLabel }}</div>
                <div class="text-xs text-gray-400">{{ formation.name }}</div>
                <div class="mt-2">
                    <div class="flex justify-between text-[11px] text-gray-400"><span>{{ 'formation.index.global_progress'|trans({}, 'formation') }}</span><span>{{ progress }}%</span></div>
                    <div class="mt-1 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                        <div class="h-full rounded-full" style="width:{{ progress }}%;background:{{ progress < 30 ? 'var(--st-empty)' : (progress < 70 ? 'var(--st-incomplete)' : 'var(--st-ok)') }}"></div>
                    </div>
                </div>
            </div>

            <div class="flex-1 overflow-y-auto">
                <div class="px-4 py-3 border-b" style="border-color:var(--c-border)">
                    <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-1.5">{{ 'formation.parcours_editor.param_section_label'|trans({}, 'formation') }}</div>
                    {% set psections = parcours_param_sections() %}
                    <a href="{{ path('parcours_param', {fid: formation.id, nid: parcours.id, key: 'organisation'}) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ param == 'organisation' ? 'is-active' }}">
                        <span class="status-dot" data-status="{{ parcours_param_status(parcours, 'organisation') }}"></span>1 | {{ psections.organisation }}
                    </a>
                    <a href="{{ path('parcours_param', {fid: formation.id, nid: parcours.id, key: 'presentation'}) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ param == 'presentation' ? 'is-active' }}">
                        <span class="status-dot" data-status="{{ parcours_param_status(parcours, 'presentation') }}"></span>2 | {{ psections.presentation }}
                    </a>
                    <a href="{{ path('bcc_parcours_editor', {fid: formation.id, nid: parcours.id}) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ bcc ? 'is-active' }}">
                        <span class="status-dot" data-status="{{ bcc_status(parcours) }}"></span>3 | {{ 'formation.editor.bcc_section_label'|trans({}, 'formation') }}
                    </a>
                    <a href="{{ node_url(parcours) }}" data-turbo-frame="node-panel"
                       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ focus == parcours.id ~ '' ? 'is-active' }}">
                        <span class="status-dot" data-status="ok"></span>4 | {{ 'formation.parcours_editor.ramification_section_label'|trans({}, 'formation') }}
                    </a>
                </div>

                <a href="{{ path('formation_editor', {id: formation.id}) }}"
                   class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-white" style="background:var(--c-primary)">
                    {{ ux_icon('ph:arrow-left', {class: 'icon'}) }} {{ 'formation.parcours_editor.back_to_formation'|trans({}, 'formation') }}
                </a>

                <div class="p-2">
                    {% if roots is not empty %}
                        {{ include('formation/_tree.html.twig', {views: roots, parentId: parcours.id, focus: focus, parentIsChoice: false, parentChoiceLabel: null}) }}
                    {% else %}
                        <p class="text-sm px-2 py-8 text-center text-gray-400">
                            {{ 'formation.parcours_editor.no_root_note'|trans({'%type%': bodyRoot ? bodyRoot.label|lower : 'formation.parcours_editor.generic_level'|trans({}, 'formation')}, 'formation') }}
                        </p>
                    {% endif %}
                </div>
            </div>

            {# ─── barre d'actions ─── #}
            <div class="px-3 py-3 border-t shrink-0 flex items-center gap-2" style="border-color:var(--c-border)">
                <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
                      class="flex-1" data-tree-target="addForm">
                    <input type="hidden" name="parentId" value="{{ parcours.id }}" data-tree-target="addParent">
                    <input type="hidden" name="typeKey" value="{{ formation.getChildTypeKey('parcours') }}" data-tree-target="addType">
                    <button data-tree-target="addButton" class="tree-add-btn">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }} {{ bodyRoot ? ux_icon(bodyRoot.icon, {class: 'icon'}) }} {{ bodyRoot ? bodyRoot.label }}</button>
                </form>

                <button type="button" data-tree-target="addChoiceButton" data-action="tree#addChoiceBloc" hidden
                        class="tree-act-btn tree-act-btn--choice"
                        title="{{ 'formation.editor.add_choice_title'|trans({}, 'formation') }}">{{ ux_icon('ph:shuffle', {class: 'icon'}) }}</button>

                <form method="post" data-turbo-frame="_top" data-tree-target="dupForm">
                    <button type="submit" data-tree-target="dupButton" disabled title="{{ 'formation.editor.duplicate_title'|trans({}, 'formation') }}"
                            class="tree-act-btn">{{ ux_icon('ph:copy', {class: 'icon'}) }}</button>
                </form>
                <form method="post" data-turbo-frame="_top" data-tree-target="delForm"
                      data-controller="confirm" data-confirm-message-value="{{ 'formation.editor.delete_node_confirm'|trans({}, 'formation') }}">
                    <button type="submit" data-tree-target="delButton" disabled title="{{ 'formation.editor.delete_title'|trans({}, 'formation') }}"
                            class="tree-act-btn tree-act-btn-danger">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                </form>
                <button type="button" data-action="modal#open"
                        class="tree-act-btn" title="{{ 'formation.editor.request_derogation_title'|trans({}, 'formation') }}" style="border-color:#fde68a;background:#fffbeb;color:#b45309">
                    {{ ux_icon('ph:flag', {class: 'icon'}) }}
                </button>
            </div>

            {# ─── modale : demander une dérogation ─── #}
            <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
                    class="rounded-2xl border-0 p-0 w-[min(480px,92vw)] backdrop:bg-black/40">
                <form method="post" action="{{ path('formation_derogation_create', {fid: formation.id}) }}" data-turbo-frame="_top" class="p-6 space-y-4">
                    <h3 class="text-lg font-bold">{{ ux_icon('ph:flag', {class: 'icon'}) }} {{ 'formation.editor.derogation_modal_title'|trans({}, 'formation') }}</h3>
                    <p class="text-sm text-gray-500" data-tree-target="derogContext">{{ 'formation.editor.derogation_modal_default_context'|trans({}, 'formation') }}</p>
                    <input type="hidden" name="nodeId" data-tree-target="derogNodeId" value="">
                    <div>
                        <label class="text-xs font-medium">{{ 'formation.editor.derogation_message_label'|trans({}, 'formation') }}</label>
                        <textarea name="message" rows="4" required class="fld mt-1" placeholder="{{ 'formation.editor.derogation_message_placeholder'|trans({}, 'formation') }}"></textarea>
                    </div>
                    <div class="flex items-center justify-end gap-2 pt-1">
                        <button type="button" data-action="modal#close" class="rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</button>
                        <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'formation.editor.derogation_submit_button'|trans({}, 'formation') }}</button>
                    </div>
                </form>
            </dialog>
        </div>

        {# ─── panneau d'édition ─── #}
        <turbo-frame id="node-panel" class="panel-frame"
                     {% if frameSrc %}src="{{ frameSrc }}"{% endif %}>
            {% if not frameSrc %}
                <div class="panel-empty">{{ 'formation.editor.select_prompt'|trans({}, 'formation') }}</div>
            {% endif %}
        </turbo-frame>
    </div>
</div>
{% endblock %}
