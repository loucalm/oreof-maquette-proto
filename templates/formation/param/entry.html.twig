{# Gabarit générique d'une entrée de fiche (formation, parcours ou parcours par défaut) : un seul formulaire.
   `items` : chaque champ avec la fiche qui le porte ; une formation sans parcours y réunit, sans séparation
   ni doublon, les champs de même entrée de sa fiche et de son parcours par défaut (EntryCompletion::mergedFields).
   Les champs adossés à l'entité sont inclus depuis templates/formation/param/bound/<fiche>/. #}
{% import 'formation/param/_fields.html.twig' as fld %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ statusKey|default(entryKey) }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ title }}</h2>
        <div class="text-sm text-secondary-400">{{ label }}</div>
        <div class="text-sm text-secondary-400 mt-1">{{ breadcrumb|join(' › ') }}</div>
    </div>

    <div class="panel-scroll">
    <form method="post" action="{{ saveUrl }}" data-fiche="{{ fiche.fiche }}" data-turbo-frame="_top"
          data-controller="autosave" data-autosave-key-value="{{ statusKey|default(entryKey) }}"
          class="panel-card space-y-5">

        <fieldset {{ preview_active(formation) ? 'disabled' }} class="space-y-5">
        {% for item in items %}
            {% set f = item.field %}
            {% if f.type == 'separator' %}
                {{ fld.divider(f.label) }}
            {% elseif f.key in item.fiche.bound|keys %}
                <div>{% include 'formation/param/bound/' ~ item.fiche.fiche ~ '/' ~ f.key ~ '.html.twig' with {f: f, value: item.fiche.bound[f.key]} only %}</div>
            {% else %}
                <div>{{ fld.field(f.key, f, data, issues[f.key] ?? [], hints[f.key] ?? null) }}</div>
            {% endif %}
        {% endfor %}
        </fieldset>

        <div class="pt-2 border-t border-secondary-200">
            <button data-autosave-target="submit" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'common.save'|trans({}, 'common') }}</button>
            <span data-autosave-target="status" class="text-xs text-secondary-500" aria-live="polite"></span>
        </div>
    </form>
    </div>
</div>
</turbo-frame>
