{% import 'formation/param/_fields.html.twig' as fld %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ key }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ 'formation.param.panel_title'|trans({}, 'formation') }}</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ formation.name }} › {{ label }}</div>
    </div>

    <div class="panel-scroll">
    <form method="post" action="{{ path('formation_param_save', {id: formation.id, key: key}) }}" data-turbo-frame="_top"
          class="panel-card space-y-5">

        {{ fld.divider('formation.param.presentation.divider_info'|trans({}, 'formation')) }}

        <div>
            {{ fld.label('formation.view.plabel.objectif'|trans({}, 'formation'), true) }}
            {{ fld.textarea('objectif', data.objectif ?? '', 'formation.param.presentation.objectif_help'|trans({}, 'formation')) }}
        </div>
        <div>
            {{ fld.label('formation.view.plabel.resultats'|trans({}, 'formation'), true) }}
            {{ fld.textarea('resultats', data.resultats ?? '', 'formation.param.presentation.resultats_help'|trans({}, 'formation')) }}
        </div>
        <div>
            {{ fld.label('formation.view.plabel.contenu'|trans({}, 'formation'), true) }}
            {{ fld.textarea('contenu', data.contenu ?? '', 'formation.param.presentation.contenu_help'|trans({}, 'formation')) }}
        </div>

        {{ fld.divider('formation.param.presentation.divider_rythme'|trans({}, 'formation')) }}

        <div>
            {{ fld.label('formation.view.plabel.rythme'|trans({}, 'formation'), false, 'formation.param.presentation.rythme_help'|trans({}, 'formation')) }}
            {{ fld.select('rythme', data.rythme ?? '', referentiel('rythmes')) }}
        </div>
        <div>
            {{ fld.label('formation.param.presentation.rythme_precision_label'|trans({}, 'formation'), false) }}
            {{ fld.textarea('rythmePrecision', data.rythmePrecision ?? '') }}
        </div>

        <div class="pt-2 border-t" style="border-color:var(--c-border)">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
        </div>
    </form>
    </div>
</div>
</turbo-frame>
