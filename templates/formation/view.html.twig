{% extends 'base.html.twig' %}
{% block title %}{{ formation.name }} · consultation{% endblock %}

{# ─────────── macros ─────────── #}

{% macro fieldval(key, def, n) %}
    {%- set v = n.getAttribute(key) -%}
    {%- if def.field == 'choice' -%}{{ def.options[v] ?? v }}
    {%- elseif def.field == 'competencies' -%}
        <span class="inline-flex flex-wrap gap-1">{% for c in v %}<span class="pill">{{ c }}</span>{% endfor %}</span>
    {%- elseif def.field == 'textarea' -%}<span class="whitespace-pre-line">{{ v }}</span>
    {%- else -%}{{ v }}
    {%- endif -%}
{% endmacro %}

{# contenu organisé d'un nœud (onglets → catégories) #}
{% macro nodefields(n, catalog, domains) %}
    {% import _self as m %}
    {% set caps = n.effectiveCapabilities() %}
    {% set HM = constant('App\\Maquette\\AttributeCatalog::HOUR_MODALITIES') %}
    {% set HP = constant('App\\Maquette\\AttributeCatalog::HOUR_PLACES') %}

    {% set tabs = [] %}
    {% for key, def in catalog %}
        {% if (caps[key] ?? false) and def.domain not in tabs %}{% set tabs = tabs|merge([def.domain]) %}{% endif %}
    {% endfor %}

    {% set hasContent = false %}
    <div class="space-y-4">
        {% for tab in tabs %}
            {% if tab == 'volume_horaire' and n.getAttribute('hours') %}
                {% set hasContent = true %}
                {% set hours = n.getAttribute('hours') %}
                <div>
                    <div class="fld-cat">{{ domains[tab] ?? tab }}</div>
                    <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-600 mt-2">
                        {% for hm, ml in HM %}{% for hp, pl in HP %}
                            {% if hours[hm][hp] is defined and hours[hm][hp] %}
                                <span>{{ ml }} {{ pl|lower }} : <strong>{{ hours[hm][hp] }} h</strong></span>
                            {% endif %}
                        {% endfor %}{% endfor %}
                    </div>
                </div>
            {% elseif tab == 'mccc' and n.getAttribute('mccc') %}
                {% set hasContent = true %}
                {% set mccc = n.getAttribute('mccc') %}
                <div>
                    <div class="fld-cat">{{ domains[tab] ?? tab }}</div>
                    <div class="text-sm text-gray-600 mt-2">{{ mccc.type ?? '—' }}{% if mccc.note ?? null %} — {{ mccc.note }}{% endif %}</div>
                </div>
            {% else %}
                {% set curCat = '__init__' %}
                {% set tabHasFields = false %}
                {% for key, def in catalog %}
                    {% if def.domain == tab and (caps[key] ?? false) and def.field not in ['hours','mccc']
                          and n.getAttribute(key) is not null and n.getAttribute(key) is not empty %}
                        {% set hasContent = true %}
                        {% if not tabHasFields %}
                            {% set tabHasFields = true %}
                            {% if tab != 'props' %}<div class="fld-cat">{{ domains[tab] ?? tab }}</div>{% endif %}
                        {% endif %}
                        {% if (def.category ?? null) != curCat %}
                            {% set curCat = def.category ?? null %}
                            {% if curCat %}<div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mt-2">{{ curCat }}</div>{% endif %}
                        {% endif %}
                        <div class="flex flex-wrap gap-x-2 text-sm py-0.5">
                            <span class="text-gray-400">{{ def.label }} :</span>
                            <span class="text-gray-800">{{ m.fieldval(key, def, n) }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}

        {% if n.isParcours %}
            {% set hasContent = true %}
            {% set unit = period_unit(n.formation)|lower %}
            <div class="text-sm text-gray-500">
                {{ unit }}s <strong>{{ n.periodeDebut }}–{{ n.periodeFin }}</strong>
                {%- if n.parcoursParent %} · spécialisation de « {{ n.parcoursParent.label ?: '—' }} »{% endif -%}
            </div>
        {% endif %}

        {% if not hasContent %}<div class="text-sm text-gray-400 italic">Aucun champ renseigné pour ce nœud.</div>{% endif %}
    </div>
{% endmacro %}

{# arbre gauche (repliable, cliquable) — reprend le style de l'éditeur #}
{% macro rotree(views) %}
    {% import _self as m %}
    <ul class="tree-list {{ views.0.node.parent ? 'tree-children' }}">
        {% for view in views %}
            {% set n = view.node %}
            <li data-node-id="{{ n.id }}">
                <div class="tree-row" data-action="click->rotree#select" data-rotree-id-param="{{ n.id }}">
                    <span class="status-dot" data-status="{{ view.status }}" title="{{ view.status }}"></span>
                    <span class="type-badge"><span class="opacity-70">{{ n.type.icon }}</span> [{{ n.type.label }}]</span>
                    <span class="tree-label">{{ n.label ?: '—' }}</span>
                    {% if view.ectsTarget %}<span class="tree-ects {{ view.ectsReached ? 'text-green-600' : 'text-gray-400' }}">{{ view.totalEcts|round }}/{{ view.ectsTarget }}</span>{% endif %}
                    {% if view.children %}
                        <button type="button" class="tree-chevron" data-action="rotree#toggle" aria-label="Plier/déplier">›</button>
                    {% else %}<span class="tree-chevron-spacer"></span>{% endif %}
                </div>
                {% if view.children %}{{ m.rotree(view.children) }}{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{# panneaux de détail (un par nœud, masqués, montrés au clic) #}
{% macro details(views, catalog, domains) %}
    {% import _self as m %}
    {% for view in views %}
        {% set n = view.node %}
        <div data-rotree-target="detail" data-node="{{ n.id }}" hidden class="space-y-4">
            <div class="text-sm text-gray-400">
                {%- for p in node_path(n) %}{% if not loop.first %} › {% endif %}{{ p.label ?: p.type.label }}{% endfor -%}
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="status-dot" data-status="{{ view.status }}"></span>
                <span class="type-badge">{{ n.type.icon }} [{{ n.type.label }}]</span>
                <h3 class="text-lg font-bold">{{ n.label ?: '—' }}</h3>
                {% if n.code %}<code class="text-xs text-gray-400">{{ n.code }}</code>{% endif %}
            </div>
            <div class="flex flex-wrap gap-2">
                {% if view.totalHours %}<span class="rounded-lg border px-3 py-1.5 text-xs" style="border-color:#fcd34d;background:#fffbeb">Total heures : <strong>{{ view.totalHours|round }}</strong></span>{% endif %}
                <span class="rounded-lg border px-3 py-1.5 text-xs" style="border-color:#fcd34d;background:#fffbeb"><strong>{{ view.totalEcts|round }}</strong>{% if view.ectsTarget %} / {{ view.ectsTarget }}{% endif %} ECTS</span>
                {% if n.mutualized %}<span class="pill" style="background:#fef3c7;color:#b45309">mutualisé</span>{% endif %}
            </div>
            <div class="border-t pt-3" style="border-color:var(--c-border)">
                {{ m.nodefields(n, catalog, domains) }}
            </div>
        </div>
        {% if view.children %}{{ m.details(view.children, catalog, domains) }}{% endif %}
    {% endfor %}
{% endmacro %}

{# ligne clé / valeur d'un paramètre #}
{% macro prow(label, value) %}
    <div class="grid gap-1 py-2 sm:grid-cols-[240px_1fr]">
        <dt class="text-sm text-gray-400">{{ label }}</dt>
        <dd class="text-sm text-gray-800">{{ value }}</dd>
    </div>
{% endmacro %}

{# panneaux de détail des sections « Paramètre de la formation » #}
{% macro paramdetails(formation) %}
    {% import _self as m %}
    {% for key, section in param_sections() %}
        {% set data = formation.getParametre(key) %}
        <div data-rotree-target="detail" data-node="param:{{ key }}" hidden class="space-y-4">
            <div class="text-sm text-gray-400">{{ formation.name }} › Paramètres de la formation</div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="status-dot" data-status="{{ param_status(formation, key) }}"></span>
                <h3 class="text-lg font-bold">{{ section.label }}</h3>
            </div>

            {% if key == 'structure' %}
                <dl class="divide-y" style="border-color:var(--c-border)">
                    {{ m.prow('Organisation en parcours', formation.multiParcours ? 'Multi-parcours' : 'Mono-parcours') }}
                    {{ m.prow('Dimension temporelle',
                        formation.calendarSpan
                            ? formation.calendarSpan ~ ' ' ~ period_unit(formation)|lower ~ (formation.calendarSpan > 1 ? 's' : '')
                            : 'déduite de la structure (' ~ period_unit(formation)|lower ~ ')') }}
                    {% if formation.ectsTotal %}{{ m.prow('ECTS total visé', formation.ectsTotal) }}{% endif %}
                    <div class="grid gap-1 py-2 sm:grid-cols-[240px_1fr]">
                        <dt class="text-sm text-gray-400">Hiérarchie des niveaux</dt>
                        <dd class="flex flex-wrap items-center gap-1.5 text-sm text-gray-800">
                            {% for tk in formation.effectiveStructure %}
                                {% set tm = type_meta()[tk] ?? null %}
                                {% if not loop.first %}<span class="text-gray-300">›</span>{% endif %}
                                <span class="type-badge">{{ tm ? tm.icon }} [{{ tm ? tm.label : tk }}]</span>
                                {%- if tk == 'parcours' and formation.isMono %}<span class="text-xs text-gray-400">implicite</span>{% endif -%}
                            {% endfor %}
                        </dd>
                    </div>
                    {% set regimes = data.regimes ?? [] %}
                    {% if regimes %}{{ m.prow("Régimes d'inscription", regimes|join(', ')) }}{% endif %}
                </dl>
            {% else %}
                {% set present = param_fields(key)|filter(f => ((f.entity ?? false) ? attribute(formation, f.key) : (data[f.key] ?? null)) is not empty) %}
                {% if present is empty %}
                    <p class="text-sm text-gray-400 italic">Section non renseignée.</p>
                {% else %}
                    <dl class="divide-y" style="border-color:var(--c-border)">
                        {% for f in present %}
                            {% set val = (f.entity ?? false) ? attribute(formation, f.key) : data[f.key] %}
                            {% if f.key == 'rncp' %}{% set val = val|capitalize %}{% endif %}
                            <div class="grid gap-1 py-2 sm:grid-cols-[240px_1fr]">
                                <dt class="text-sm text-gray-400">{{ f.label }}</dt>
                                <dd class="text-sm text-gray-800 {{ f.long ?? false ? 'whitespace-pre-line' }}">{{ val }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                {% endif %}
            {% endif %}

            <a href="{{ path('formation_editor', {id: formation.id, param: key}) }}"
               class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">✎ Modifier cette section</a>
        </div>
    {% endfor %}
{% endmacro %}

{# panneau lecture seule du référentiel de compétences (BCC) #}
{% macro bccdetail(formation) %}
    <div data-rotree-target="detail" data-node="bcc" hidden class="space-y-4">
        <div class="text-sm text-gray-400">{{ formation.name }} › Référentiel de compétences</div>
        <div class="flex flex-wrap items-center gap-2">
            <span class="status-dot" data-status="{{ bcc_status(formation) }}"></span>
            <h3 class="text-lg font-bold">Référentiel de compétences (BCC)</h3>
        </div>
        {% set blocs = formation.competenceBlocs %}
        {% if blocs is empty %}
            <p class="text-sm text-gray-400 italic">Aucun bloc de compétences défini.</p>
        {% else %}
            <div class="space-y-3">
                {% for bloc in blocs %}
                    <div class="bcc-bloc {{ bloc.transversalBloc ? 'bcc-bloc--transversal' }}">
                        <div class="bcc-bloc-head">
                            <div class="min-w-0 flex-1">
                                <div class="font-semibold">{% if bloc.transversalBloc %}🎓 {% endif %}{{ bloc.label }}{% if bloc.code %} <span class="text-xs font-normal opacity-70">{{ bloc.code }}</span>{% endif %}</div>
                                {% if bloc.description %}<div class="text-xs opacity-80">{{ bloc.description }}</div>{% endif %}
                            </div>
                        </div>
                        <ul class="bcc-comp-list">
                            {% for c in bloc.children|filter(c => c.type.key == 'competence') %}
                                <li class="bcc-comp"><div class="bcc-comp-row">
                                    <div class="min-w-0 flex-1">
                                        <div class="font-medium">{{ c.label }}{% if c.code %} <span class="text-xs font-normal text-gray-400">{{ c.code }}</span>{% endif %}</div>
                                        {% if c.description %}<div class="text-xs text-gray-500">{{ c.description }}</div>{% endif %}
                                    </div>
                                </div></li>
                            {% else %}
                                <li class="px-4 py-2 text-xs text-gray-400 italic">Aucune compétence.</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        <a href="{{ path('formation_editor', {id: formation.id}) }}?bcc=1"
           class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">✎ Modifier le référentiel</a>
    </div>
{% endmacro %}

{% block body %}
{% import _self as m %}

<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between gap-4">
        <div>
            <div class="text-xs text-gray-400">
                🏠 <span class="fake-link">Accueil</span> ›
                <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formation</a> › {{ formation.name }}
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight mt-1">{{ formation.name }}</h1>
            <p class="text-sm text-gray-500">Consultation — lecture seule</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <span class="pill" style="background:#eef2ff;color:var(--c-primary)">Lecture seule</span>
            <a href="{{ path('formation_editor', {id: formation.id}) }}" class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">✎ Modifier</a>
            <a href="{{ path('formation_index') }}" class="rounded-lg border px-3 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">← Liste</a>
        </div>
    </div>
    <div class="mt-4 grid grid-cols-2 md:grid-cols-6 gap-4">
        {% for k, v in {
            'Domaine': formation.domaine ?: 'Non défini',
            'Type diplôme': formation.diplome ?: '—',
            'Composante': formation.composante ?: '—',
            'Parcours': formation.multiParcours ? 'Multi' : 'Mono',
            'Durée': (formation.calendarSpan ? formation.calendarSpan ~ ' ' ~ period_unit(formation)|lower ~ (formation.calendarSpan > 1 ? 's' : '') : '—'),
            'Progression': progress ~ '%'
        } %}
            <div><div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ k }}</div><div class="text-sm mt-1">{{ v }}</div></div>
        {% endfor %}
    </div>
    {% if formation.isMono and (formation.getParametre('structure').regimes ?? []) %}
        <div class="mt-3 pt-3 border-t text-xs text-gray-500" style="border-color:var(--c-border)">
            Régimes d'inscription : <strong class="text-gray-700">{{ formation.getParametre('structure').regimes|join(', ') }}</strong>
        </div>
    {% endif %}
</div>

<div class="rounded-2xl border bg-white overflow-hidden" style="border-color:var(--c-border)" data-controller="rotree">
    <div class="grid lg:grid-cols-[360px_1fr] lg:h-[calc(100vh-15rem)] min-h-[480px]">
        {# colonne gauche : paramètres de la formation + arbre de structure #}
        <div class="border-b lg:border-b-0 lg:border-r overflow-y-auto p-3" style="border-color:var(--c-border)">
            <div class="px-2 pb-2 text-[11px] font-bold uppercase tracking-wide" style="color:var(--c-primary)">Paramètres de la formation</div>
            <div class="mb-4 space-y-0.5">
                {% for key, section in param_sections() %}
                    <div class="tree-row" data-action="click->rotree#select" data-rotree-id-param="param:{{ key }}">
                        <span class="status-dot" data-status="{{ param_status(formation, key) }}"></span>
                        <span class="tree-label">{{ section.label }}</span>
                    </div>
                {% endfor %}
                <div class="tree-row" data-action="click->rotree#select" data-rotree-id-param="bcc">
                    <span class="status-dot" data-status="{{ bcc_status(formation) }}"></span>
                    <span class="tree-label">Référentiel de compétences (BCC)</span>
                </div>
                {% if formation.multiParcours %}
                    <a href="{{ path('formation_parcours_graph', {id: formation.id}) }}" class="block rounded-md px-2 py-1.5 text-sm hover:bg-gray-50" style="color:var(--c-primary)">🗺 Arborescence des parcours</a>
                {% endif %}
            </div>

            <div class="px-2 pb-2 text-[11px] font-bold uppercase tracking-wide" style="color:var(--c-primary)">Structure</div>
            {% if roots is empty %}
                <p class="px-2 py-6 text-sm text-gray-400 italic">Aucune structure définie.</p>
            {% else %}
                {{ m.rotree(roots) }}
            {% endif %}
        </div>

        {# colonne droite : détail du nœud ou de la section sélectionnée #}
        <div class="overflow-y-auto p-7">
            <div data-rotree-target="empty" class="grid h-full place-items-center text-sm text-gray-400">
                ← Choisissez une section ou un nœud pour voir son contenu
            </div>
            {{ m.paramdetails(formation) }}
            {{ m.bccdetail(formation) }}
            {{ m.details(roots, catalog, domains) }}
        </div>
    </div>
</div>
{% endblock %}
