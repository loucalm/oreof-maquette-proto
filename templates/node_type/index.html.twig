{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'types' %}
{% block title %}{{ 'node_type.index.title'|trans({}, 'node_type') }}{% endblock %}

{% macro table(types, showNew, showDelete) %}
    <div class="rounded-xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
        <table class="w-full text-sm">
            <thead class="text-xs uppercase tracking-wide" style="color:var(--c-muted)">
                <tr class="border-b" style="border-color:var(--c-border)">
                    <th class="text-left px-4 py-3">{{ 'node_type.index.col_label'|trans({}, 'node_type') }}</th>
                    <th class="text-left px-4 py-3">{{ 'node_type.index.col_type'|trans({}, 'node_type') }}</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody>
            {% for t in types %}
                <tr class="border-b last:border-0" style="border-color:var(--c-border)">
                    <td class="px-4 py-3">
                        <div class="font-medium">{{ ux_icon(t.icon, {class: 'icon'}) }} {{ t.label }}
                            {% if t.system %}<span class="pill ml-1">{{ 'common.badge_socle'|trans({}, 'common') }}</span>{% endif %}</div>
                        <code class="text-xs" style="color:var(--c-muted)">{{ t.key }}</code>
                    </td>
                    <td class="px-4 py-3" style="color:var(--c-muted)">{{ t.kind.label }}</td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                        <a href="{{ path('node_type_edit', {id: t.id}) }}" data-turbo-frame="_top" class="text-xs hover:underline">{{ 'common.edit'|trans({}, 'common') }}</a>
                        {% if showDelete and not t.system %}
                            <form method="post" action="{{ path('node_type_delete', {id: t.id}) }}" class="inline"
                                  data-controller="confirm" data-confirm-message-value="{{ 'node_type.index.delete_confirm'|trans({'%label%': t.label}, 'node_type') }}">
                                <button class="text-xs text-red-600 hover:underline ml-2">{{ 'common.delete'|trans({}, 'common') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}

{# Bibliothèque des formulaires de fiche : un formulaire de départ puis ses variantes, en retrait. #}
{% macro libraryTable(items) %}
    <div class="rounded-xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
        <table class="w-full text-sm">
            <thead class="text-xs uppercase tracking-wide" style="color:var(--c-muted)">
                <tr class="border-b" style="border-color:var(--c-border)">
                    <th class="text-left px-4 py-3">{{ 'node_type.index.col_label'|trans({}, 'node_type') }}</th>
                    <th class="text-left px-4 py-3">{{ 'node_type.index.col_usage'|trans({}, 'node_type') }}</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr class="border-b last:border-0" style="border-color:var(--c-border)" data-form-key="{{ item.type.key }}" data-depth="{{ item.depth }}">
                    <td class="px-4 py-3">
                        <div class="font-medium" style="padding-left: {{ 16 * item.depth }}px">
                            {% if item.depth > 0 %}<span style="color:var(--c-muted)">↳</span> {% endif %}
                            {% if item.type.icon %}{{ ux_icon(item.type.icon, {class: 'icon'}) }} {% endif %}{{ item.type.label }}
                            {% if item.type.system %}<span class="pill ml-1">{{ 'common.badge_socle'|trans({}, 'common') }}</span>{% endif %}
                            {% if item.type.parent %}<span class="pill ml-1">{{ 'node_type.index.variant_badge'|trans({}, 'node_type') }}</span>{% endif %}
                        </div>
                        <code class="text-xs" style="color:var(--c-muted)">{{ item.type.key }}</code>
                    </td>
                    <td class="px-4 py-3"><span data-usage title="{{ 'node_type.index.usage_title'|trans({}, 'node_type') }}">{{ item.usage }}</span></td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                        <a href="{{ path('node_type_edit', {id: item.type.id}) }}" data-turbo-frame="_top" class="text-xs hover:underline">{{ 'common.edit'|trans({}, 'common') }}</a>
                        <form method="post" action="{{ path('node_type_variant_new', {id: item.type.id}) }}" class="inline-flex items-center gap-1 ml-2">
                            <input name="label" placeholder="{{ 'node_type.index.variant_label_placeholder'|trans({}, 'node_type') }}" class="rounded border px-2 py-1 text-xs" style="border-color:var(--c-border)">
                            <button class="text-xs hover:underline">{{ 'node_type.index.new_variant'|trans({}, 'node_type') }}</button>
                        </form>
                        {% if not item.type.system %}
                            <form method="post" action="{{ path('node_type_delete', {id: item.type.id}) }}" class="inline"
                                  data-controller="confirm" data-confirm-message-value="{{ 'node_type.index.delete_confirm'|trans({'%label%': item.type.label}, 'node_type') }}">
                                <button class="text-xs text-red-600 hover:underline ml-2">{{ 'common.delete'|trans({}, 'common') }}</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}

{% block admin_body %}
{% import _self as ui %}

<div class="mb-5">
    <h2 class="text-lg font-bold">{{ 'node_type.index.heading'|trans({}, 'node_type') }}</h2>
    <p class="text-sm" style="color:var(--c-muted)">{{ 'node_type.index.description'|trans({}, 'node_type') }}</p>
</div>

<div class="space-y-6">
    <div>
        <div class="text-xs font-bold uppercase tracking-wide mb-2" style="color:var(--c-primary)">{{ 'node_type.index.param_title'|trans({}, 'node_type') }}</div>
        <p class="text-xs mb-2" style="color:var(--c-muted)">{{ 'node_type.index.library_help'|trans({}, 'node_type') }}</p>
        {{ ui.libraryTable(library) }}
    </div>

    <div>
        <div class="flex items-center justify-between mb-2">
            <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'node_type.index.elp_title'|trans({}, 'node_type') }}</div>
            <a href="{{ path('node_type_new') }}" data-turbo-frame="_top" class="rounded-md px-3 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'node_type.index.new_button'|trans({}, 'node_type') }}</a>
        </div>
        {{ ui.table(elpTypes, true, true) }}
    </div>

    <div class="rounded-xl border px-4 py-3 text-xs" style="border-color:var(--c-border);background:#f8f9fb;color:var(--c-muted)">
        <div class="font-semibold mb-1" style="color:var(--c-muted)">{{ 'node_type.index.internal_title'|trans({}, 'node_type') }}</div>
        <p>{{ 'node_type.index.internal_help'|trans({}, 'node_type') }}</p>
    </div>
</div>
{% endblock %}
