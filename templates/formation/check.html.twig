{% extends 'base.html.twig' %}
{% block title %}{{ 'formation.check.title_prefix'|trans({}, 'formation') }} · {{ formation.name }}{% endblock %}

{% block body %}
<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between">
        <div>
            <div class="text-xs text-gray-400">
                <a href="{{ path('formation_index') }}" class="hover:underline">{{ 'formation.editor.breadcrumb_list'|trans({}, 'formation') }}</a> › {{ formation.name }} › {{ 'formation.check.title_prefix'|trans({}, 'formation') }}
            </div>
            <h1 class="text-2xl font-extrabold tracking-tight mt-1">{{ 'formation.check.title_prefix'|trans({}, 'formation') }}</h1>
            <p class="text-sm text-gray-500">{{ 'formation.check.subtitle'|trans({'%name%': formation.name, '%progress%': progress}, 'formation') }}</p>
        </div>
        <a href="{{ path('formation_editor', {id: formation.id}) }}" class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ ux_icon('ph:pencil-simple', {class: 'icon'}) }} {{ 'formation.check.edit_structure_button'|trans({}, 'formation') }}</a>
    </div>
</div>

<div class="rounded-2xl border bg-white px-7 py-6 space-y-6" style="border-color:var(--c-border)">
    {% if groups is empty and sections is empty and violations is empty %}
        <div class="rounded-xl border p-6 text-sm" style="border-color:#bbf7d0;background:#f0fdf4">
            <span class="font-semibold text-green-800">{{ ux_icon('ph:check-bold', {class: 'icon'}) }} {{ 'formation.check.no_issue_title'|trans({}, 'formation') }}</span>
            <p class="text-green-700 mt-1">{{ 'formation.check.no_issue_text'|trans({}, 'formation') }}</p>
        </div>
    {% endif %}

    {% if sections is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-500 mb-2">{{ 'formation.check.sections_title'|trans({}, 'formation') }}</h2>
            <ul class="space-y-2">
                {% for sec in sections %}
                    <li class="flex items-center justify-between gap-4 rounded-lg border p-3" style="border-color:var(--c-border)">
                        <div class="flex items-center gap-2 text-sm">
                            <span class="status-dot" data-status="{{ sec.status }}"></span>
                            <span class="font-medium">{{ sec.label }}</span>
                            {% if sec.context %}<span class="text-gray-400">· {{ sec.context }}</span>{% endif %}
                        </div>
                        <a href="{{ sec.url }}" class="rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50 shrink-0" style="border-color:var(--c-border)">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if violations is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-500 mb-2">{{ 'formation.check.structure_title'|trans({'%count%': violations|length}, 'formation') }}</h2>
            <ul class="space-y-2">
                {% for item in violations %}
                    {% set v = item.violation %}
                    {% set n = item.node %}
                    <li class="flex items-start justify-between gap-4 rounded-lg border p-3" style="border-color:var(--c-border)">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="status-dot" data-status="{{ v.blocking ? 'error' : 'incomplete' }}"></span>
                                <span class="text-sm font-medium">{{ n ? n.displayLabel : formation.name }}</span>
                            </div>
                            <p class="ml-6 mt-1 text-xs {{ v.blocking ? 'text-red-600' : 'text-gray-600' }}">{{ v.message }}{% if v.actual is not null and v.expected is not null %} ({{ 'formation.check.structure_actual'|trans({'%actual%': v.actual, '%expected%': v.expected}, 'formation') }}){% endif %}</p>
                        </div>
                        {% if n %}
                            <a href="{{ path('node_open', {fid: formation.id, nid: n.id}) }}"
                               class="rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50 shrink-0" style="border-color:var(--c-border)">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if groups is not empty %}
        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-500 mb-2">{{ 'formation.check.issues_count'|trans({'%count%': issueCount}, 'formation') }}</h2>
            {% for context, issues in groups %}
                <h3 class="mt-4 mb-2 text-xs font-semibold text-gray-400">{{ context }}</h3>
                <ul class="space-y-2">
                    {% for issue in issues %}
                        {% set n = issue.node %}
                        <li class="flex items-start justify-between gap-4 rounded-lg border p-3" style="border-color:var(--c-border)">
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="status-dot" data-status="incomplete"></span>
                                    <span class="type-badge">{{ ux_icon(n.type.icon, {class: 'icon'}) }} [{{ n.type.label }}]</span>
                                    {% if issue.ref %}<span class="tree-ref">{{ issue.ref }}</span>{% endif %}
                                    <span class="text-sm font-medium">{{ n.type.temporel ? node_display_label(n, issue.ref) : (n.label ?: 'formation.check.no_label'|trans({}, 'formation')) }}</span>
                                </div>
                                <ul class="ml-6 mt-1 space-y-0.5 text-xs text-red-600">
                                    {% for m in issue.missing %}<li>{{ m }}</li>{% endfor %}
                                </ul>
                            </div>
                            <a href="{{ path('node_open', {fid: formation.id, nid: n.id}) }}"
                               class="rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50 shrink-0" style="border-color:var(--c-border)">{{ 'formation.check.fix_button'|trans({}, 'formation') }} {{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        </section>
    {% endif %}
</div>
{% endblock %}
