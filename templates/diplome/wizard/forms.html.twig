{% extends wizard_layout|default('diplome/wizard/_layout.html.twig') %}

{# Une ligne du canevas : une entrée de fiche, formulaire de la bibliothèque ou écran intégré. #}
{% macro row(r, fiche, builtins, formLabels, formIds = {}) %}
    {% set builtin = r.builtin.vars.value %}
    {% set screen = builtin ? builtins[fiche][builtin]|default({}) : {} %}
    {% set defaultLabel = builtin ? screen.label|default('') : formLabels[r.form.vars.value]|default('') %}
    <div data-canvas-row data-entry="{{ r.key.vars.value }}" class="rounded-md border p-3 flex gap-3 items-center {{ r.hidden.vars.checked ? 'opacity-60' : '' }} border-secondary-200">
        {{ form_widget(r.key) }}
        {{ form_widget(r.builtin) }}
        {{ form_widget(r.position) }}
        <div class="flex gap-1 shrink-0 text-xs">
            <button type="button" data-action="canvas#up" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm" title="{{ 'diplome.wizard.formulaires.up'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.formulaires.up'|trans({}, 'diplome') }}">↑</button>
            <button type="button" data-action="canvas#down" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm" title="{{ 'diplome.wizard.formulaires.down'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.formulaires.down'|trans({}, 'diplome') }}">↓</button>
        </div>
        <div class="flex-1 min-w-0">
            {{ form_widget(r.label, {attr: {placeholder: defaultLabel, 'aria-label': 'diplome.wizard.formulaires.label'|trans({}, 'diplome'), class: 'w-full rounded-md border px-2 py-1.5 text-sm'}}) }}
            {{ form_errors(r.label) }}
        </div>
        {% if builtin %}
            <div class="w-56 shrink-0">
                <span class="inline-block text-xs px-2 py-1 rounded bg-primary-50">{{ 'diplome.wizard.formulaires.builtin'|trans({}, 'diplome') }}</span>
                {{ form_errors(r.form) }}
            </div>
            {% do r.form.setRendered %}
            {% if screen.hideable|default(false) %}
                <div class="flex items-center gap-2 text-sm whitespace-nowrap">
                    {{ form_widget(r.hidden) }}
                    {{ form_label(r.hidden) }}
                </div>
            {% else %}
                {% do r.hidden.setRendered %}
            {% endif %}
        {% else %}
            <div class="w-56 shrink-0">
                {{ form_widget(r.form, {attr: {class: 'fld w-full'}}) }}
                {{ form_errors(r.form) }}
            </div>
            <div class="flex items-center gap-2 text-sm whitespace-nowrap">
                {{ form_widget(r.hidden) }}
                {{ form_label(r.hidden) }}
            </div>
            {% set formKey = r.form.vars.value %}
            {% if r.key.vars.value and formKey and formIds[formKey] is defined %}
                <div class="flex gap-1 shrink-0 text-xs">
                    <button type="submit" form="adapt-{{ fiche }}-{{ r.key.vars.value }}" formnovalidate class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm" title="{{ 'diplome.wizard.formulaires.adapt_help'|trans({}, 'diplome') }}">{{ 'diplome.wizard.formulaires.adapt'|trans({}, 'diplome') }}</button>
                    <a href="{{ path('node_type_edit', {id: formIds[formKey], retour: app.request.pathInfo}) }}" data-turbo-frame="_top" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm">{{ 'diplome.wizard.formulaires.modify'|trans({}, 'diplome') }}</a>
                </div>
            {% endif %}
            <button type="button" data-action="canvas#remove" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-2 py-1 text-xs shrink-0">{{ 'diplome.wizard.formulaires.remove'|trans({}, 'diplome') }}</button>
            {% if not r.key.vars.value %}
                <span class="shrink-0 text-xs px-1.5 py-0.5 rounded bg-primary-50">{{ 'diplome.wizard.formulaires.added'|trans({}, 'diplome') }}</span>
            {% endif %}
        {% endif %}
    </div>
{% endmacro %}

{% block step_content %}
<p class="text-sm mb-4 text-secondary-500">{{ 'diplome.wizard.formulaires.help'|trans({}, 'diplome') }}</p>
{{ form_start(form, {attr: {id: 'wizard-form', class: 'space-y-6', 'data-controller': 'dirty-form'}}) }}
    {{ form_errors(form) }}

    <div class="grid gap-6 lg:grid-cols-[1fr_280px] items-start">
        <div class="space-y-6">
            {% for fiche in ['formation', 'parcours'] %}
                {% set proto = _self.row(form[fiche].vars.prototype, fiche, builtins, formLabels) %}
                <section class="rounded-lg border p-4 border-secondary-200" data-fiche="{{ fiche }}" data-controller="canvas" data-canvas-prototype-value="{{ proto|e('html_attr') }}" data-canvas-index-value="{{ form[fiche]|keys|reduce((max, k) => k >= max ? k + 1 : max, 0) }}">
                    <h3 class="text-sm font-semibold">{{ ('diplome.wizard.formulaires.fiche.' ~ fiche)|trans({}, 'diplome') }}</h3>
                    <p class="text-xs mt-1 mb-3 text-secondary-500">{{ ('diplome.wizard.formulaires.fiche_help.' ~ fiche)|trans({}, 'diplome') }}</p>
                    {{ form_errors(form[fiche]) }}
                    <div data-canvas-target="list" class="space-y-2">
                        {% for r in form[fiche] %}
                            {{ _self.row(r, fiche, builtins, formLabels, formIds) }}
                        {% endfor %}
                    </div>
                    {% set previewUrl = version is defined ? path('diplome_canvas_preview', {id: type.id, versionId: version.id}) : path('diplome_wizard_canvas_preview') %}
                    <button type="submit" name="fiche" value="{{ fiche }}" formaction="{{ previewUrl }}" formtarget="_blank" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm mt-3 mr-2" title="{{ 'diplome.wizard.formulaires.preview_help'|trans({}, 'diplome') }}">{{ ux_icon('ph:eye', {class: 'icon'}) }} {{ 'diplome.wizard.formulaires.preview'|trans({}, 'diplome') }} ↗</button>
                    <button type="button" data-action="canvas#add" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm mt-3">{{ 'diplome.wizard.formulaires.add'|trans({}, 'diplome') }}</button>
                </section>
            {% endfor %}

            {# Fiche matière : une seule entrée, dont seul le formulaire se choisit (ni ajout, ni masquage, ni ordre) #}
            <section class="rounded-lg border p-4 border-secondary-200" data-fiche="fiche_matiere">
                <h3 class="text-sm font-semibold">{{ 'diplome.wizard.formulaires.fiche.fiche_matiere'|trans({}, 'diplome') }}</h3>
                <p class="text-xs mt-1 mb-3 text-secondary-500">{{ 'diplome.wizard.formulaires.fiche_help.fiche_matiere'|trans({}, 'diplome') }}</p>
                {{ form_errors(form.fiche_matiere) }}
                {% for r in form.fiche_matiere %}
                    {% set formKey = r.form.vars.value %}
                    <div data-entry="{{ r.key.vars.value }}" class="rounded-md border p-3 flex gap-3 items-center border-secondary-200">
                        {{ form_widget(r.key) }}
                        {{ form_widget(r.builtin) }}
                        {{ form_widget(r.position) }}
                        <div class="flex-1 min-w-0">
                            {{ form_label(r.form, null, {label_attr: {class: 'sr-only'}}) }}
                            {{ form_widget(r.form, {attr: {class: 'fld w-full'}}) }}
                            {{ form_errors(r.form) }}
                        </div>
                        {% if r.key.vars.value and formKey and formIds[formKey] is defined %}
                            <div class="flex gap-1 shrink-0 text-xs">
                                <button type="submit" form="adapt-fiche_matiere-{{ r.key.vars.value }}" formnovalidate class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm" title="{{ 'diplome.wizard.formulaires.adapt_help'|trans({}, 'diplome') }}">{{ 'diplome.wizard.formulaires.adapt'|trans({}, 'diplome') }}</button>
                                <a href="{{ path('node_type_edit', {id: formIds[formKey], retour: app.request.pathInfo}) }}" data-turbo-frame="_top" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm">{{ 'diplome.wizard.formulaires.modify'|trans({}, 'diplome') }}</a>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </section>
        </div>

        <aside class="rounded-lg border p-4 border-secondary-200">
            <h3 class="text-sm font-semibold">{{ 'diplome.wizard.formulaires.library_title'|trans({}, 'diplome') }}</h3>
            <p class="text-xs mt-1 text-secondary-500">{{ 'diplome.wizard.formulaires.library_help'|trans({}, 'diplome') }}</p>
            <div class="space-y-1 pt-3">
                {% for item in library %}
                    <div class="text-sm leading-tight" style="padding-left: {{ 12 * item.depth }}px">
                        {% if item.depth > 0 %}<span class="text-secondary-500">↳</span> {% endif %}
                        <span>{{ item.form.label }}</span>
                        <span class="text-xs text-secondary-500">({{ item.form.key }})</span>
                        {% if item.form.parent %}<span class="text-xs px-1 py-0.5 rounded bg-primary-50">{{ 'diplome.wizard.formulaires.variant'|trans({}, 'diplome') }}</span>{% endif %}
                        <span class="text-xs text-secondary-500">{{ item.form.scope.value }}</span>
                    </div>
                {% endfor %}
            </div>
        </aside>
    </div>
    {{ form_rest(form) }}
{{ form_end(form, {render_rest: false}) }}

{# « Adapter » : un petit formulaire par entrée, hors du formulaire de l'étape (pas de formulaires imbriqués) #}
{% set adaptUrl = version is defined ? path('diplome_canvas_adapt', {id: type.id, versionId: version.id}) : path('diplome_wizard_canvas_adapt') %}
{% for fiche in ['formation', 'parcours', 'fiche_matiere'] %}
    {% for r in form[fiche] %}
        {% if r.key.vars.value and not r.builtin.vars.value %}
            <form id="adapt-{{ fiche }}-{{ r.key.vars.value }}" method="post" action="{{ adaptUrl }}" hidden>
                <input type="hidden" name="fiche" value="{{ fiche }}">
                <input type="hidden" name="entry" value="{{ r.key.vars.value }}">
                {% include 'diplome/_csrf.html.twig' %}
            </form>
        {% endif %}
    {% endfor %}
{% endfor %}
{% endblock %}
{% block step_next %}
    <button form="wizard-form" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</button>
{% endblock %}
