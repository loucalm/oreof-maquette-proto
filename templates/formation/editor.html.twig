{% extends 'base.html.twig' %}
{% block title %}{{ formation.name }} · éditeur{% endblock %}

{% set focus = app.request.query.get('focus') %}

{% block body %}

{# ─── bandeau titre (fictif) ─── #}
<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight">{{ formation.name }}</h1>
            <p class="text-sm text-gray-500">Page de modification de la formation</p>
        </div>
        <div class="flex items-center gap-2">
            <span class="fake-btn">👁 Voir la fiche descriptive</span>
            <a href="{{ path('formation_index') }}" class="rounded-lg border px-3 py-2 text-sm font-medium text-green-700 hover:bg-green-50" style="border-color:#bbf7d0">← Retour à la liste des formation</a>
        </div>
    </div>
    <div class="mt-3 text-sm text-gray-400">
        🏠 <span class="fake-link">Accueil</span> › <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formation</a> ›
        <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">{{ formation.name }}</span>
    </div>
</div>

{# ─── méta + process (fictif) ─── #}
<div class="grid gap-4 lg:grid-cols-[1fr_360px] mb-4">
    <div class="rounded-2xl border bg-white px-7 py-5 grid grid-cols-2 md:grid-cols-5 gap-4" style="border-color:var(--c-border)">
        {% for k, v in {
            'Domaine': formation.domaine ?: 'Non défini',
            'Type diplôme': formation.diplome ?: 'Licence',
            'Composante': formation.composante ?: 'Composante exemple',
            'Mention': formation.name,
            'Resp. mention': 'Non défini'
        } %}
            <div>
                <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">{{ k }}</div>
                <div class="text-sm mt-1">{{ v }}</div>
            </div>
        {% endfor %}
    </div>
    <div class="rounded-2xl border bg-white px-6 py-5" style="border-color:var(--c-border)">
        <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-3">Avancement du process</div>
        <div class="flex items-center justify-between">
            {% for i in 1..5 %}
                <div class="grid h-9 w-9 place-items-center rounded-full text-white text-xs
                     {{ i <= 3 ? '' : 'opacity-40' }}" style="background:{{ i == 4 ? 'var(--st-ok)' : '#94a3b8' }}">●</div>
                {% if not loop.last %}<div class="h-px flex-1 bg-gray-200 mx-1"></div>{% endif %}
            {% endfor %}
        </div>
    </div>
</div>

{# ─── bannière + actions rapides (fictif) ─── #}
<div class="flex flex-wrap items-center gap-3 mb-6">
    <div class="rounded-xl border px-5 py-3 text-sm" style="border-color:#bbf7d0;background:#f0fdf4">
        <div class="font-semibold text-green-800">Formation ouverte</div>
        <div class="text-green-700">Vous pouvez modifier la formation</div>
    </div>
    <div class="ml-auto flex items-center gap-2">
        <span class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mr-1">Actions rapide</span>
        <span class="fake-btn" style="color:#b45309;border-color:#fcd34d">⇄ Changer co/resp. formation</span>
        <span class="fake-btn">⚙ Action complémentaire ⌄</span>
        <span class="fake-btn">⬇ Export</span>
        <span class="fake-btn">≣ Gestion SES ⌄</span>
    </div>
</div>

{# ═══ éditeur ═══ #}
<div class="rounded-2xl border bg-white p-7" style="border-color:var(--c-border)">
    <h2 class="text-2xl font-extrabold tracking-tight">ÉDITEUR DE FORMATION</h2>
    <p class="text-sm text-gray-500 mb-5">Construisez la structure de la formation nœud par nœud.</p>

    <div class="grid gap-5 lg:grid-cols-[380px_1fr] items-start">

        {# ─── panneau structure ─── #}
        <div class="rounded-xl border" style="border-color:var(--c-border)"
             data-controller="tree" data-tree-move-url-value="{{ path('node_move', {id: '__ID__'}) }}">

            <div class="px-4 pt-4 pb-3 border-b" style="border-color:var(--c-border)">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">Structure de la formation</span>
                    <span class="pill" style="background:#fef3c7;color:#b45309">{{ progress == 100 ? 'Complet' : 'Incomplet' }}</span>
                </div>
                <div class="mt-2 font-bold">{{ formation.name }}</div>
                <div class="text-xs text-gray-400">{{ formation.composante ?: 'Composante exemple' }}</div>
                <div class="mt-2">
                    <div class="flex justify-between text-[11px] text-gray-400"><span>Progression globale</span><span>{{ progress }}%</span></div>
                    <div class="mt-1 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                        <div class="h-full rounded-full" style="width:{{ progress }}%;background:{{ progress < 30 ? 'var(--st-empty)' : (progress < 70 ? 'var(--st-incomplete)' : 'var(--st-ok)') }}"></div>
                    </div>
                </div>
            </div>

            {# paramètre de la formation (fictif) #}
            <div class="px-4 py-3 border-b" style="border-color:var(--c-border)">
                <div class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-1.5">Paramètre de la formation</div>
                {% for k, s in param_sections() %}
                    <a href="{{ path('formation_param', {id: formation.id, key: k}) }}" data-turbo-frame="node-panel"
                       class="flex items-center gap-2 py-1 text-sm hover:underline">
                        <span class="status-dot" data-status="{{ s.status }}"></span>{{ s.label }}
                    </a>
                {% endfor %}
            </div>

            {# arbre draggable #}
            <div class="p-2">
                {% if roots is empty %}
                    <p class="text-sm px-2 py-8 text-center text-gray-400">Aucun nœud. Ajoutez-en un ou chargez un template ci-dessous.</p>
                {% else %}
                    {{ include('formation/_tree.html.twig', {views: roots, parentId: null, focus: focus}) }}
                {% endif %}
            </div>

            {# barre d'ajout / templates #}
            <div class="px-3 pb-3 pt-1 border-t space-y-2" style="border-color:var(--c-border)">
                <details class="group">
                    <summary class="list-none cursor-pointer rounded-lg border px-3 py-2 text-sm font-medium hover:bg-gray-50 flex items-center justify-between" style="border-color:var(--c-border)">
                        <span>＋ Ajouter un nœud racine</span><span class="text-gray-400 group-open:rotate-180 transition">⌄</span>
                    </summary>
                    <form method="post" action="{{ path('node_add', {id: formation.id}) }}" class="mt-2 flex gap-2">
                        <select name="typeKey" class="flex-1 rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                            {% for t in types %}<option value="{{ t.key }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
                        </select>
                        <input name="label" placeholder="Libellé" class="w-28 rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                        <button class="rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">OK</button>
                    </form>
                </details>
                <div class="flex gap-2">
                    <details class="group flex-1">
                        <summary class="list-none cursor-pointer rounded-lg border px-3 py-2 text-sm hover:bg-gray-50 text-center" style="border-color:var(--c-border)">⬇ Template</summary>
                        <form method="post" action="{{ path('formation_apply_template', {id: formation.id}) }}"
                              data-controller="confirm" data-confirm-message-value="⚠️ Charger ce template ÉCRASE la structure actuelle. Continuer ?"
                              class="mt-2 space-y-2">
                            <select name="template" class="w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                                {% for tpl in templates %}<option value="{{ tpl.key }}">{{ tpl.label }}</option>{% endfor %}
                            </select>
                            <button class="w-full rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">Charger (écrase)</button>
                        </form>
                    </details>
                    <details class="group flex-1">
                        <summary class="list-none cursor-pointer rounded-lg border px-3 py-2 text-sm hover:bg-gray-50 text-center" style="border-color:var(--c-border)">💾 Sauver</summary>
                        <form method="post" action="{{ path('template_from_formation', {id: formation.id}) }}" class="mt-2 space-y-2">
                            <input name="label" placeholder="Nom du template" required class="w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                            <button class="w-full rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">Créer le template</button>
                        </form>
                    </details>
                    <form method="post" action="{{ path('formation_reset', {id: formation.id}) }}"
                          data-controller="confirm" data-confirm-message-value="Vider toute la structure ?">
                        <button class="rounded-lg border px-3 py-2 text-sm text-red-600 hover:bg-red-50" style="border-color:var(--c-border)" title="Vider">🗑</button>
                    </form>
                </div>
            </div>
        </div>

        {# ─── panneau d'édition ─── #}
        <turbo-frame id="node-panel" class="block rounded-xl border bg-white min-h-[420px]" style="border-color:var(--c-border)"
                     {% if focus %}src="{{ path('node_panel', {id: focus}) }}"{% endif %}>
            {% if not focus %}
                <div class="grid h-full place-items-center p-16 text-sm text-gray-400">
                    Sélectionnez une section ou un nœud pour le modifier
                </div>
            {% endif %}
        </turbo-frame>
    </div>
</div>
{% endblock %}
