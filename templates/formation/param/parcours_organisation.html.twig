{# « Organisation et localisation » d'un parcours (formation avec parcours).
   data = Node.parametres['organisation'] ; le nom + l'ECTS + le parent de
   ramification sont portés par le nœud parcours lui-même. #}
{% import 'formation/param/_fields.html.twig' as fld %}
{% set unit = period_unit(formation) %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ key }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ 'formation.param.parcours_panel_title'|trans({}, 'formation') }}</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ formation.name }} › {{ parcours.displayLabel }} › {{ label }}</div>
    </div>

    <div class="panel-scroll">
    <form method="post" action="{{ saveUrl }}" data-turbo-frame="_top" class="panel-card space-y-5">

        {{ fld.divider('formation.param.organisation.divider_global'|trans({}, 'formation')) }}

        <div>
            {{ fld.label('formation.param.parcours_organisation.nom_label'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.nom_help'|trans({}, 'formation')) }}
            <input name="nom" value="{{ parcours.label }}" class="fld mt-1">
        </div>
        <div>
            {{ fld.label('formation.param.parcours_organisation.ects_label'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.ects_help'|trans({}, 'formation')) }}
            <input type="number" name="ects" value="{{ parcours.getAttribute('ects') }}" class="fld mt-1">
        </div>
        <div>
            {{ fld.label('formation.param.parcours_organisation.modalites_enseignement_label'|trans({}, 'formation'), true) }}
            {{ fld.select('modalitesEnseignement', data.modalitesEnseignement ?? '', referentiel('modalites_enseignement')) }}
        </div>
        <div>
            {{ fld.label('formation.view.plabel.composante_inscription'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.composante_help'|trans({}, 'formation')) }}
            {{ fld.selectAdd('composante', data.composante ?? '', [formation.composante ?: 'formation.editor.meta_composante_default'|trans({}, 'formation'), 'formation.param.parcours_organisation.other_composante'|trans({}, 'formation')], 'formation.param.parcours_organisation.add_composante_fake'|trans({}, 'formation')) }}
        </div>
        <div>
            {{ fld.label('formation.view.plabel.regimes'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.multi_choice'|trans({}, 'formation')) }}
            {{ fld.checkgroup('regimes', data.regimes ?? [], referentiel('regimes_inscription')) }}
        </div>
        <div>
            {{ fld.label('formation.param.parcours_organisation.modalites_alternance_label'|trans({}, 'formation'), true) }}
            {{ fld.textarea('modalitesAlternance', data.modalitesAlternance ?? '', 'formation.param.parcours_organisation.modalites_alternance_help'|trans({}, 'formation')) }}
        </div>

        <div>
            {{ fld.label('formation.param.organisation.code_apogee_label'|trans({}, 'formation'), false, 'formation.param.organisation.code_apogee_help'|trans({}, 'formation')) }}
            {{ fld.text('codeApogee', data.codeApogee ?? '', 'formation.param.organisation.code_apogee_placeholder'|trans({}, 'formation')) }}
        </div>

        {{ fld.divider('formation.param.organisation.divider_responsables'|trans({}, 'formation')) }}

        <div class="grid gap-5 md:grid-cols-2">
            <div>
                {{ fld.label('formation.param.parcours_organisation.resp_label'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.resp_help'|trans({}, 'formation')) }}
                {{ fld.selectAdd('respParcours', data.respParcours ?? '', referentiel('responsables'), 'formation.param.organisation.create_new_fake'|trans({}, 'formation'), 'formation.param.parcours_organisation.resp_select_placeholder'|trans({}, 'formation')) }}
            </div>
            <div>
                {{ fld.label('formation.param.parcours_organisation.co_resp_label'|trans({}, 'formation'), false, 'formation.param.parcours_organisation.co_resp_help'|trans({}, 'formation')) }}
                {{ fld.selectAdd('coRespParcours', data.coRespParcours ?? '', referentiel('responsables'), 'formation.param.organisation.create_new_fake'|trans({}, 'formation'), 'formation.param.parcours_organisation.resp_select_placeholder'|trans({}, 'formation')) }}
            </div>
        </div>

        {{ fld.divider('formation.param.parcours_organisation.divider_relations'|trans({}, 'formation')) }}

        {# Récapitulatif en lecture seule — la durée, le positionnement et le
           parent de ramification s'éditent dans « Positionnement & ramification »
           (validation des périodes + graphe). #}
        {% set span = parcours.periodeFin - parcours.periodeDebut + 1 %}
        {% set pchildren = parcours_nodes(formation)|filter(p => p.parcoursParent and p.parcoursParent.id == parcours.id) %}
        <div class="rounded-lg border p-4 space-y-2 text-sm" style="border-color:var(--c-border);background:#f8f9fb">
            <div class="flex flex-wrap justify-between gap-x-3">
                <span class="text-gray-400">{{ 'formation.param.parcours_organisation.duree_label'|trans({}, 'formation') }}</span>
                <span class="font-medium">{{ span }} {{ unit|lower }}{{ span > 1 ? 's' }}</span>
            </div>
            <div class="flex flex-wrap justify-between gap-x-3">
                <span class="text-gray-400">{{ 'formation.param.parcours_organisation.positionnement_label'|trans({}, 'formation') }}</span>
                <span class="font-medium">{{ unit|lower }}s {{ parcours.periodeDebut }}–{{ parcours.periodeFin }}</span>
            </div>
            <div class="flex flex-wrap justify-between gap-x-3">
                <span class="text-gray-400">{{ 'node.panel.parcours_parent_label'|trans({}, 'node') }}</span>
                <span class="font-medium">{{ parcours.parcoursParent ? parcours.parcoursParent.displayLabel : '—' }}</span>
            </div>
            <div class="flex flex-wrap justify-between gap-x-3">
                <span class="text-gray-400">{{ 'formation.param.parcours_organisation.specialisations_label'|trans({}, 'formation') }}</span>
                <span class="font-medium text-right">
                    {%- for ch in pchildren %}{{ ch.displayLabel }}{{ not loop.last ? ', ' }}{% else %}—{% endfor -%}
                </span>
            </div>
            <a href="{{ node_url(parcours) }}" data-turbo-frame="node-panel"
               class="inline-block pt-1 text-xs font-medium hover:underline" style="color:var(--c-primary)">{{ ux_icon('ph:pencil-simple', {class: 'icon'}) }} {{ 'formation.param.parcours_organisation.edit_in_ramification'|trans({}, 'formation') }}</a>
        </div>

        <div class="pt-2 border-t" style="border-color:var(--c-border)">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
        </div>
    </form>
    </div>
</div>
</turbo-frame>
