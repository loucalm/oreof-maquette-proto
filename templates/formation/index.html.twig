{% extends 'base.html.twig' %}
{% block title %}Détails des mentions/spécialités · Prototype maquette{% endblock %}

{% block body %}
<div data-controller="modal">

    {# ─── bandeau titre (fictif) ─── #}
    <div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight">Détails des mentions/spécialités</h1>
                <p class="text-sm text-gray-500">Ici vous pouvez voir l'ensemble de vos formations créées</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="fake-btn" style="color:#15803d;border-color:#bbf7d0">✔ Vérifier Export LHEO</span>
                <button type="button" data-action="modal#open"
                        class="rounded-lg border px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-50" style="border-color:#bbf7d0">
                    ＋ Ajouter une formation
                </button>
            </div>
        </div>
        <div class="mt-3 text-sm text-gray-400">
            🏠 <span class="fake-link">Accueil</span> › <span class="fake-link">Offre de formation</span> ›
            <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">Détails des mentions/spécialités</span>
        </div>
    </div>

    {# ─── table ─── #}
    <div class="rounded-2xl border bg-white px-7 py-6" style="border-color:var(--c-border)">
        <h2 class="text-2xl font-extrabold tracking-tight">DÉTAILS DES MENTIONS/SPÉCIALITÉS</h2>
        <p class="text-sm text-gray-500 mb-5">Consultez et administrez rapidement les mentions et spécialités de l'offre de formation.</p>

        <div class="rounded-xl border" style="border-color:var(--c-border)">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
                        <th class="text-left px-4 py-3">Formation</th>
                        <th class="text-left px-4 py-3">Composante</th>
                        <th class="text-center px-4 py-3">État</th>
                        <th class="text-left px-4 py-3 w-64">Remplissage</th>
                        <th class="text-right px-4 py-3">Actions</th>
                    </tr>
                </thead>
                {% for row in rows %}
                {% set f = row.formation %}
                <tbody {{ row.parcours ? 'data-controller=disclosure' }}>
                    <tr class="border-t" style="border-color:var(--c-border)">
                        <td class="px-4 py-4 align-top">
                            <div class="font-medium">{{ f.name }}</div>
                            <div class="text-xs text-gray-400">
                                {{ f.diplome ?: '—' }} · {{ f.multiParcours ? row.parcours|length ~ ' parcours' : 'mono-parcours' }}
                            </div>
                            {% if row.parcours %}
                                <button type="button" data-action="disclosure#toggle"
                                        class="mt-1.5 inline-flex items-center gap-1 whitespace-nowrap rounded-md border px-2 py-1 text-[11px] font-medium hover:bg-gray-50"
                                        style="border-color:var(--c-border);color:var(--c-primary)">
                                    › <span data-disclosure-target="label">Voir</span>&nbsp;les parcours
                                </button>
                            {% endif %}
                        </td>
                        <td class="px-4 py-4 align-top text-gray-600">{{ f.composante ?: '—' }}</td>
                        <td class="px-4 py-4 align-top">
                            {# état = process fictif #}
                            <div class="flex items-center justify-center gap-1.5">
                                {% for i in 1..5 %}
                                    <span class="grid h-7 w-7 place-items-center rounded-full text-white text-[11px]"
                                          style="background:{{ i <= 4 ? '#64748b' : '#cbd5e1' }}">●</span>
                                {% endfor %}
                            </div>
                        </td>
                        <td class="px-4 py-4 align-top">
                            <div class="flex justify-between text-[11px] text-gray-400"><span>Progression globale</span><span>{{ row.progress }}%</span></div>
                            <div class="mt-1 h-2 rounded-full bg-gray-100 overflow-hidden">
                                <div class="h-full rounded-full" style="width:{{ row.progress }}%;background:{{ row.progress < 30 ? 'var(--st-empty)' : (row.progress < 70 ? 'var(--st-incomplete)' : 'var(--st-ok)') }}"></div>
                            </div>
                        </td>
                        <td class="px-4 py-4 align-top">
                            <div class="flex items-center justify-end gap-2">
                                <a href="{{ path('formation_view', {id: f.id}) }}"
                                   class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">ⓘ Voir</a>

                                <div class="relative" data-controller="menu">
                                    <button type="button" data-action="menu#toggle"
                                            class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">••• Actions</button>
                                    <div data-menu-target="menu" hidden
                                         class="absolute right-0 top-full z-30 mt-1.5 w-56 overflow-hidden rounded-xl border bg-white py-1.5 shadow-xl" style="border-color:var(--c-border)">
                                        <a href="{{ path('formation_check', {id: f.id}) }}"
                                           class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-green-700 hover:bg-green-50">✔ Vérifier la saisie</a>
                                        <a href="{{ path('formation_editor', {id: f.id}) }}"
                                           class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-amber-700 hover:bg-amber-50">✎ Modifier</a>
                                        <form method="post" action="{{ path('formation_delete', {id: f.id}) }}"
                                              data-controller="confirm" data-confirm-message-value="Supprimer définitivement la formation « {{ f.name }} » ? Cette action est irréversible.">
                                            <button class="flex w-full items-center gap-2.5 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50">🗑 Supprimer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% if row.parcours %}
                        <tr data-disclosure-target="panel" hidden>
                            <td colspan="5" class="px-4 pb-5 pt-0" style="background:#fafafb">
                                <div class="rounded-xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
                                    <div class="flex items-center justify-between px-4 py-2.5 border-b" style="border-color:var(--c-border)">
                                        <span class="text-sm font-semibold">Parcours de <span style="color:var(--c-primary)">{{ f.name }}</span></span>
                                        <span class="text-xs text-gray-400">{{ row.parcours|length }} parcours</span>
                                    </div>
                                    <table class="w-full text-sm">
                                        <thead class="text-[11px] uppercase tracking-wide text-gray-400">
                                            <tr class="border-b" style="border-color:var(--c-border)">
                                                <th class="text-left px-4 py-2">Parcours</th>
                                                <th class="text-left px-4 py-2">Périodes</th>
                                                <th class="text-left px-4 py-2">BCC</th>
                                                <th class="text-left px-4 py-2 w-48">Remplissage</th>
                                                <th class="text-right px-4 py-2">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for p in row.parcours %}
                                            {% set pn = p.node %}
                                            <tr class="border-b last:border-0" style="border-color:var(--c-border)">
                                                <td class="px-4 py-2.5">
                                                    <div class="font-medium">{{ pn.displayLabel }}</div>
                                                    {% if pn.parcoursParent %}<div class="text-[11px] text-gray-400">spécialisation de « {{ pn.parcoursParent.displayLabel }} »</div>{% endif %}
                                                </td>
                                                <td class="px-4 py-2.5 text-gray-500">{{ period_unit(f)|lower }}s {{ pn.periodeDebut }}–{{ pn.periodeFin }}</td>
                                                <td class="px-4 py-2.5">
                                                    {% set bs = bcc_status(pn) %}
                                                    <span class="pill" style="background:{{ bs == 'ok' ? '#dcfce7' : (bs == 'incomplete' ? '#fef3c7' : '#fee2e2') }};color:{{ bs == 'ok' ? '#15803d' : (bs == 'incomplete' ? '#b45309' : '#b91c1c') }}">
                                                        {{ bs == 'ok' ? 'Complet' : (bs == 'incomplete' ? 'Incomplet' : 'Vide') }}
                                                    </span>
                                                </td>
                                                <td class="px-4 py-2.5">
                                                    <div class="flex justify-between text-[11px] text-gray-400"><span></span><span>{{ p.progress }}%</span></div>
                                                    <div class="mt-0.5 h-1.5 rounded-full bg-gray-100 overflow-hidden">
                                                        <div class="h-full rounded-full" style="width:{{ p.progress }}%;background:{{ p.progress < 30 ? 'var(--st-empty)' : (p.progress < 70 ? 'var(--st-incomplete)' : 'var(--st-ok)') }}"></div>
                                                    </div>
                                                </td>
                                                <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                                    <a href="{{ path('formation_view', {id: f.id}) }}" class="text-xs hover:underline">ⓘ Voir</a>
                                                    <a href="{{ path('parcours_editor', {id: pn.id}) }}" class="ml-2 text-xs font-medium text-amber-700 hover:underline">✎ Modifier</a>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
                {% else %}
                <tbody>
                    <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">
                        Aucune formation. Cliquez sur « Ajouter une formation ».
                    </td></tr>
                </tbody>
                {% endfor %}
            </table>
        </div>
    </div>

    {# ─── modale : ajouter une formation ─── #}
    <dialog data-modal-target="dialog" class="w-[min(920px,92vw)] rounded-2xl border p-0 backdrop:bg-black/40" style="border-color:var(--c-border)">
        <form method="post" action="{{ path('formation_create') }}">
            <div class="flex items-start justify-between border-b px-7 py-5" style="border-color:var(--c-border)">
                <div>
                    <h3 class="text-xl font-bold">Ajouter une nouvelle formation</h3>
                    <p class="text-sm text-gray-500">Ajouter votre formation</p>
                </div>
                <button type="button" data-action="modal#close" class="rounded-lg border px-2.5 py-1.5 text-gray-500 hover:bg-gray-50" style="border-color:var(--c-border)">✕</button>
            </div>

            <div class="px-7 py-6 space-y-6">
                <div>
                    <div class="flex items-center justify-between">
                        <span class="fld-label">Nom de la formation</span>
                        <span class="text-[11px] font-semibold text-red-500 uppercase">Champs requis</span>
                    </div>
                    <input name="name" required placeholder="Formation exemple" class="fld mt-1">
                    <div class="fld-help">ℹ Nommer votre formation</div>
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="fld-label">Type de diplôme</span>
                            <span class="text-[11px] font-semibold text-red-500 uppercase">Champs requis</span>
                        </div>
                        <select name="diplome" class="fld mt-1">
                            {% for d in ['Licence', 'Licence professionnelle', 'BUT', 'Master', 'DU', 'Ingénieur', 'DAEU'] %}
                                <option value="{{ d }}">{{ d }}</option>
                            {% endfor %}
                        </select>
                        <div class="fld-help">ℹ La sélection de certains diplômes nécessite une demande</div>
                    </div>
                    <div>
                        <div class="flex items-center justify-between">
                            <span class="fld-label">Domaine de formation</span>
                            <span class="text-[11px] font-semibold text-red-500 uppercase">Champs requis</span>
                        </div>
                        <select name="domaine" class="fld mt-1">
                            <option value="">— Choisir —</option>
                            {% for d in ['Sciences, technologies, santé', 'Droit, économie, gestion', 'Sciences humaines et sociales', 'Arts, lettres, langues'] %}
                                <option value="{{ d }}">{{ d }}</option>
                            {% endfor %}
                        </select>
                        <div class="fld-help">ℹ Domaine auquel appartient votre formation</div>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between">
                        <span class="fld-label">Composante porteuse de la formation</span>
                        <span class="text-[11px] font-semibold text-red-500 uppercase">Champs requis</span>
                    </div>
                    <input name="composante" placeholder="Composante exemple" class="fld mt-1">
                    <div class="fld-help">ℹ Indiquer la composante porteuse du projet, qui aura en charge le dépôt de la demande</div>
                </div>

                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="multiParcours" value="1"> La formation contient des parcours (multi-parcours)
                </label>
            </div>

            <div class="flex items-center justify-end gap-2 border-t px-7 py-4" style="border-color:var(--c-border)">
                <button type="button" data-action="modal#close" class="rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">Annuler</button>
                <button class="rounded-lg px-5 py-2 text-sm font-semibold text-white" style="background:var(--st-ok)">Créer</button>
            </div>
        </form>
    </dialog>
</div>
{% endblock %}
