{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'overview' %}
{% block title %}{{ 'admin.index.title'|trans({}, 'admin') }}{% endblock %}

{% block admin_body %}
{% set sections = constant('App\\Controller\\AdminController::SECTIONS') %}

<div class="grid gap-4 md:grid-cols-2">
    {% for card in cards %}
        {% set s = sections[card.section] %}
        <a href="{{ path(s.route) }}" data-turbo-frame="_top"
           class="group flex flex-col rounded-xl border border-secondary-200 bg-surface p-5 shadow-sm transition hover:border-primary-300 hover:shadow-md">
            <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2">
                    <twig:IconBox :icon="s.icon" variant="primary"/>
                    <div>
                        <div class="font-bold text-secondary-900">{{ s.label }}</div>
                        <div class="text-xs text-secondary-400">{{ card.count }} · {{ card.sub }}</div>
                    </div>
                </div>
                <span class="text-secondary-300 transition group-hover:text-primary">{{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</span>
            </div>
            <p class="mt-3 text-sm text-secondary-500">{{ card.text }}</p>
        </a>
    {% endfor %}
</div>

<twig:Alerte type="info" class="mt-6">
    <div class="font-semibold">{{ 'admin.index.where_title'|trans({}, 'admin') }}</div>
    <ul class="mt-1.5 space-y-1">
        <li>• {{ 'admin.index.where_hierarchy'|trans({}, 'admin')|raw }}</li>
        <li>• {{ 'admin.index.where_params'|trans({}, 'admin')|raw }}</li>
        <li>• {{ 'admin.index.where_common'|trans({}, 'admin')|raw }}</li>
    </ul>
</twig:Alerte>
{% endblock %}
