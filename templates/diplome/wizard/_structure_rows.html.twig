{# Lignes des collections de l'étape Structure (aussi utilisées pour le prototype d'ajout). #}
{% macro field(f, class = '') %}
    <div class="block {{ class }}">
        {{ form_label(f, null, {label_attr: {class: 'text-xs font-medium'}}) }}
        {{ form_widget(f, {attr: {class: 'mt-1 w-full rounded-md border px-2 py-1.5 text-sm', style: 'border-color:var(--c-border)'}}) }}
        {{ form_errors(f) }}
    </div>
{% endmacro %}

{% macro bound(f) %}
    <div class="block">
        {{ form_label(f, null, {label_attr: {class: 'text-xs font-medium'}}) }}
        {{ form_widget(f, {attr: {class: 'mt-1 flex gap-1 items-center'}}) }}
        {{ form_errors(f) }}
    </div>
{% endmacro %}

{% macro controls() %}
    <div class="flex gap-1 shrink-0 text-xs">
        <button type="button" data-action="collection#up" class="rounded border px-2 py-1 hover:bg-gray-50" style="border-color:var(--c-border)" title="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.up'|trans({}, 'diplome') }}">↑</button>
        <button type="button" data-action="collection#down" class="rounded border px-2 py-1 hover:bg-gray-50" style="border-color:var(--c-border)" title="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.wizard.structure.down'|trans({}, 'diplome') }}">↓</button>
        <button type="button" data-action="collection#remove" class="rounded border px-2 py-1 hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'diplome.wizard.structure.remove'|trans({}, 'diplome') }}</button>
    </div>
{% endmacro %}

{% macro level(f) %}
    {% import _self as m %}
    <div data-collection-row data-level-row class="rounded-md border p-3 flex gap-3 items-start" style="border-color:var(--c-border)">
        <div class="flex-1 grid grid-cols-5 gap-3">
            {{ m.field(f.typeKey, 'col-span-2') }}
            {{ m.bound(f.count) }}
            {{ m.bound(f.ects) }}
            {{ m.bound(f.ectsSum) }}
            {{ m.field(f.startAt) }}
        </div>
        {{ m.controls() }}
    </div>
{% endmacro %}

{% macro imposed(f) %}
    {% import _self as m %}
    <div data-collection-row data-imposed-row class="rounded-md border p-3 flex gap-3 items-start" style="border-color:var(--c-border)">
        {{ form_widget(f.uid) }}
        <div class="flex-1 grid grid-cols-4 gap-3">
            {{ m.field(f.typeKey) }}
            {{ m.field(f.label, 'col-span-2') }}
            {{ m.field(f.position) }}
            {{ m.field(f.nature) }}
            {{ m.bound(f.countOverride) }}
            <div class="col-span-2">
                {{ form_label(f.locked, null, {label_attr: {class: 'text-xs font-medium'}}) }}
                <div class="mt-1 flex gap-3 text-sm">{{ form_widget(f.locked) }}</div>
            </div>
        </div>
        {{ m.controls() }}
    </div>
{% endmacro %}

{% macro rule(f) %}
    {% import _self as m %}
    <div data-collection-row data-rule-row data-controller="rule-params" class="rounded-md border p-3 flex gap-3 items-start" style="border-color:var(--c-border)">
        {{ form_widget(f.uid) }}
        <div class="flex-1 space-y-3">
            <div class="grid grid-cols-3 gap-3">
                {{ m.field(f.template) }}
                {{ m.field(f.scopeLevel) }}
                {{ m.field(f.severity) }}
            </div>
            {% for group in f %}{% if group.vars.name starts with 'params_' %}
                <div data-rule-params-target="group" data-template="{{ group.vars.name|slice(7) }}" class="grid grid-cols-4 gap-3">
                    {% for param in group %}
                        {{ m.field(param) }}
                    {% endfor %}
                </div>
            {% endif %}{% endfor %}
        </div>
        {{ m.controls() }}
    </div>
{% endmacro %}
