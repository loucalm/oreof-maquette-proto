{% extends 'base.html.twig' %}
{# Liste des formations — reprise de la page v2 « Détails des formations » (formation/index + _liste). #}

{% set header_title = 'formation.index.heading'|trans({}, 'formation') %}
{% set header_description = 'formation.index.subheading'|trans({}, 'formation') %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: header_title},
] %}

{% block root_attrs %}data-controller="modal"{% endblock %}

{% block bouton_header %}
    <twig:Button variant="success" icon="ph:check" :label="'formation.index.check_lheo'|trans({}, 'formation')" :disabled="true" :tooltip="'common.coming_soon'|trans({}, 'common')"/>
    {% if is_admin() %}
        <twig:Button variant="success" icon="ph:plus" :label="'formation.index.add_button'|trans({}, 'formation')" dataAction="modal#open"/>
    {% endif %}
{% endblock %}

{% block body %}
<section class="space-y-4 rounded-2xl border border-secondary-200 bg-white p-4 shadow-sm sm:p-6">
    {% include 'formation/_tabs.html.twig' with {active: 'all'} %}

    <div class="inline-flex items-center gap-1.5 rounded-xl border border-secondary-200 bg-secondary-50 px-3 py-2 text-sm text-secondary-600">
        <strong class="text-secondary-900">{{ rows|length }}</strong> {{ 'formation.index.found_count'|trans({'%count%': rows|length}, 'formation') }}
        <span class="text-secondary-300">·</span>
        <strong class="text-secondary-900">{{ rows|reduce((c, r) => c + r.parcours|length, 0) }}</strong> {{ 'formation.index.col_parcours'|trans({}, 'formation')|lower }}
    </div>

    <div class="rounded-2xl border border-secondary-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-secondary-700">
                <thead class="bg-secondary-50 text-left text-xs font-black uppercase tracking-wider text-secondary-500">
                    <tr>
                        <th class="w-1/3 px-4 py-3">{{ 'formation.index.col_formation'|trans({}, 'formation') }}</th>
                        <th class="w-1/5 px-4 py-3">{{ 'formation.index.col_composante'|trans({}, 'formation') }}</th>
                        <th class="w-1/6 px-4 py-3 text-center">{{ 'formation.index.col_state'|trans({}, 'formation') }}</th>
                        <th class="w-1/5 px-4 py-3">{{ 'formation.index.col_progress'|trans({}, 'formation') }}</th>
                        <th class="w-1/6 px-4 py-3 text-right">{{ 'formation.index.col_actions'|trans({}, 'formation') }}</th>
                    </tr>
                </thead>
                {% for row in rows %}
                {% set f = row.formation %}
                <tbody class="divide-y divide-secondary-200 border-t border-secondary-200" {{ row.parcours ? 'data-controller=disclosure' }}>
                    <tr class="align-top hover:bg-secondary-50/70">
                        <td class="px-4 py-3">
                            <div class="space-y-1">
                                <div class="font-semibold text-secondary-900">{{ f.name }}</div>
                                <div class="text-xs text-secondary-500">
                                    {% if f.diplome %}<twig:Badge variant="info" :label="f.diplome"/>{% endif %}
                                    <span class="ml-1">{{ f.avecParcours ? 'formation.index.parcours_count'|trans({'%count%': row.parcours|length}, 'formation') : 'formation.index.mono_parcours'|trans({}, 'formation') }}</span>
                                </div>
                                {% if row.parcours %}
                                    <button type="button" data-action="disclosure#toggle"
                                            class="inline-flex items-center gap-1 rounded-md border border-primary-200 bg-primary-50 px-2 py-1 text-xs font-medium text-primary-700 shadow-sm transition-colors hover:border-primary-300 hover:bg-primary-100 hover:text-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-300">
                                        {{ ux_icon('ph:caret-right', {class: 'h-3.5 w-3.5'}) }} <span data-disclosure-target="label">{{ 'formation.index.toggle_show'|trans({}, 'formation') }}</span>&nbsp;{{ 'formation.index.toggle_parcours_suffix'|trans({}, 'formation') }}
                                    </button>
                                {% endif %}
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            {% if f.composante %}
                                <div class="text-sm">{{ f.composante }}</div>
                            {% else %}
                                <twig:Badge variant="danger" :label="'formation.index.undefined'|trans({}, 'formation')"/>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-center">
                            {% if f.phase.value == 'consolidation' %}
                                <twig:Badge variant="warning" icon="ph:hourglass-medium" :label="'formation.index.phase_consolidation'|trans({}, 'formation') ~ (f.anneeUniversitaire ? ' · ' ~ f.anneeUniversitaire)"/>
                            {% else %}
                                <twig:Badge variant="success" icon="ph:check-bold" :label="'formation.index.phase_construction'|trans({}, 'formation')"/>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3">
                            <twig:remplissage_progress :label="'formation.index.global_progress'|trans({}, 'formation')" :percent="row.progress"
                                                       :tone="row.progress >= 100 ? 'success' : (row.progress < 30 ? 'danger' : 'info')"/>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <twig:Button variant="info" :soft="false" :outline="true" icon="ph:info" :label="'formation.index.view_button'|trans({}, 'formation')" :href="path('formation_view', {id: f.id})"/>
                                <twig:DropdownActions :label="'formation.index.actions_button'|trans({}, 'formation')">
                                    <a href="{{ path('formation_check', {id: f.id}) }}" class="app-menu-item app-menu-item--success">{{ ux_icon('ph:check', {class: 'h-4 w-4'}) }} {{ 'formation.index.check_input_action'|trans({}, 'formation') }}</a>
                                    <a href="{{ path('formation_editor', {id: f.id}) }}" class="app-menu-item app-menu-item--warning">{{ ux_icon('ph:pencil-simple', {class: 'h-4 w-4'}) }} {{ 'common.edit'|trans({}, 'common') }}</a>
                                    <form method="post" action="{{ path('formation_delete', {id: f.id}) }}"
                                          data-controller="confirm" data-confirm-message-value="{{ 'formation.index.delete_confirm'|trans({'%name%': f.name}, 'formation') }}">
                                        <button class="app-menu-item app-menu-item--danger">{{ ux_icon('ph:trash', {class: 'h-4 w-4'}) }} {{ 'common.delete_full'|trans({}, 'common') }}</button>
                                    </form>
                                </twig:DropdownActions>
                            </div>
                        </td>
                    </tr>
                    {% if row.parcours %}
                        <tr data-disclosure-target="panel" hidden>
                            <td colspan="5" class="bg-secondary-50/60 px-4 pb-5 pt-2">
                                <div class="overflow-hidden rounded-xl border border-secondary-200 bg-white shadow-sm">
                                    <div class="flex items-center justify-between border-b border-secondary-200 px-4 py-2.5">
                                        <span class="text-sm font-semibold text-secondary-800">{{ 'formation.index.parcours_of'|trans({}, 'formation') }} <span class="text-primary">{{ f.name }}</span></span>
                                        <twig:Badge variant="secondary" :label="'formation.index.parcours_count'|trans({'%count%': row.parcours|length}, 'formation')"/>
                                    </div>
                                    <table class="min-w-full text-sm">
                                        <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600">
                                            <tr>
                                                <th class="px-4 py-2">{{ 'formation.index.col_parcours'|trans({}, 'formation') }}</th>
                                                <th class="px-4 py-2">{{ 'formation.index.col_periods'|trans({}, 'formation') }}</th>
                                                <th class="px-4 py-2">{{ 'formation.index.col_bcc'|trans({}, 'formation') }}</th>
                                                <th class="w-48 px-4 py-2">{{ 'formation.index.col_progress'|trans({}, 'formation') }}</th>
                                                <th class="px-4 py-2 text-right">{{ 'formation.index.col_actions'|trans({}, 'formation') }}</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-secondary-200">
                                        {% for p in row.parcours %}
                                            <tr class="hover:bg-secondary-50/50">
                                                <td class="px-4 py-2.5">
                                                    <div class="font-medium text-text">{{ p.label }}</div>
                                                    {% if p.parent %}<div class="text-xs text-secondary">{{ 'formation.index.parcours_specialization_of'|trans({'%parent%': p.parent}, 'formation') }}</div>{% endif %}
                                                </td>
                                                <td class="px-4 py-2.5 text-secondary-600">{{ 'formation.index.periods_range'|trans({'%unit%': period_unit(f)|lower, '%start%': p.debut, '%end%': p.fin}, 'formation') }}</td>
                                                <td class="px-4 py-2.5">
                                                    {% set bs = p.bcc ?? 'empty' %}
                                                    <twig:Badge :variant="bs == 'ok' ? 'success' : (bs == 'incomplete' ? 'warning' : 'danger')"
                                                                :label="bs == 'ok' ? 'formation.index.bcc_complete'|trans({}, 'formation') : (bs == 'incomplete' ? 'formation.index.bcc_incomplete'|trans({}, 'formation') : 'formation.index.bcc_empty'|trans({}, 'formation'))"/>
                                                </td>
                                                <td class="px-4 py-2.5">
                                                    <twig:remplissage_progress label="" :percent="p.progress" :tone="p.progress >= 100 ? 'success' : (p.progress < 30 ? 'danger' : 'info')"/>
                                                </td>
                                                <td class="whitespace-nowrap px-4 py-2.5 text-right">
                                                    <div class="flex items-center justify-end gap-2">
                                                        <twig:Button variant="info" :soft="false" :outline="true" size="xs" icon="ph:info" :label="'formation.index.view_button'|trans({}, 'formation')" :href="path('formation_view', {id: f.id})"/>
                                                        <twig:Button variant="warning" :soft="false" :outline="true" size="xs" icon="ph:pencil-simple" :label="'common.edit'|trans({}, 'common')" :href="path('parcours_editor', {fid: f.id, nid: p.nid})"/>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
                {% else %}
                <tbody>
                    <tr><td colspan="5" class="px-4 py-10 text-center text-secondary-400">
                        {{ 'formation.index.empty'|trans({}, 'formation') }}
                    </td></tr>
                </tbody>
                {% endfor %}
            </table>
        </div>
    </div>
</section>

{# ─── modale : ajouter une formation (admin) ─── #}
{% include 'formation/_create_modal.html.twig' %}
{% endblock %}
