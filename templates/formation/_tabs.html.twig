{# Onglets de la liste des formations (onglets applicatifs v2) : `active` = 'all' ou 'offre'. #}
<div class="app-tabs-list" role="tablist">
    {% for tab in [
        {key: 'all', url: path('formation_index'), label: 'formation.index.tab_all'|trans({}, 'formation'), icon: 'ph:list-bullets'},
        {key: 'offre', url: path('offre_index'), label: 'formation.index.tab_consolidation'|trans({}, 'formation'), icon: 'ph:hourglass-medium'},
    ] %}
        {% set on = tab.key == active %}
        <a href="{{ tab.url }}" data-tab-link="{{ tab.key }}" role="tab" {{ on ? 'aria-current="page" aria-selected="true"' }}
           class="app-tab {{ on ? 'app-tab-active' }}">
            {% if tab.icon %}{{ ux_icon(tab.icon, {class: 'h-4 w-4'}) }}{% endif %}{{ tab.label }}
        </a>
    {% endfor %}
</div>
