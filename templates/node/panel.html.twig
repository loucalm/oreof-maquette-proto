{# Panneau d'édition d'un nœud — rendu dans <turbo-frame id="node-panel">. #}
{% import _self as ui %}
{% set caps = node.effectiveCapabilities() %}
{% set formation = node.formation %}
{% set childTypes = types_allowed_for(node) %}

<turbo-frame id="node-panel">
<div class="space-y-4">

    {# breadcrumb #}
    <div class="text-xs" style="color:var(--c-muted)">
        {% set path = node_path(node) %}
        {% for p in path %}{{ p.displayLabel }}{% if not loop.last %} › {% endif %}{% endfor %}
    </div>

    <div class="flex items-start justify-between gap-3">
        <div>
            <h2 class="text-lg font-bold">{{ node.type.icon }} {{ node.displayLabel }}</h2>
            <span class="type-badge">{{ node.type.label }}</span>
            {% if node.mutualized %}<span class="pill" style="background:#dcfce7;color:#166534">mutualisé</span>{% endif %}
            {% if node.mutualizedFrom %}<span class="pill">raccroché</span>{% endif %}
        </div>
        <div class="flex items-center gap-1.5">
            <form method="post" action="{{ path('node_duplicate', {id: node.id}) }}" data-turbo-frame="_top">
                <button class="rounded-md border px-2.5 py-1.5 text-xs hover:bg-gray-50" style="border-color:var(--c-border)" title="Dupliquer">Dupliquer</button>
            </form>
            <form method="post" action="{{ path('node_delete', {id: node.id}) }}" data-turbo-frame="_top"
                  data-controller="confirm" data-confirm-message-value="Supprimer « {{ node.displayLabel }} » et ses enfants ?">
                <button class="rounded-md border px-2.5 py-1.5 text-xs text-red-600 hover:bg-red-50" style="border-color:var(--c-border)">Supprimer</button>
            </form>
        </div>
    </div>

    {# stat tiles #}
    <div class="grid grid-cols-2 gap-2">
        <div class="rounded-lg border px-3 py-2" style="border-color:var(--c-border)">
            <div class="text-xs" style="color:var(--c-muted)">Total heures</div>
            <div class="font-semibold">{{ view.totalHours|round }} h</div>
        </div>
        <div class="rounded-lg border px-3 py-2" style="border-color:var(--c-border)">
            <div class="text-xs" style="color:var(--c-muted)">ECTS</div>
            <div class="font-semibold">
                {{ view.totalEcts|round }}{% if view.ectsTarget %} / {{ view.ectsTarget }}{% endif %}
            </div>
        </div>
    </div>

    {# ── formulaire principal ── #}
    <form method="post" action="{{ path('node_save', {id: node.id}) }}" data-turbo-frame="_top"
          data-controller="tabs" class="space-y-4">

        <div class="grid grid-cols-[1fr_140px] gap-2">
            <label class="block">
                <span class="text-xs font-medium">Libellé</span>
                <input name="label" value="{{ node.label }}" maxlength="200"
                       class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">Code</span>
                <input name="code" value="{{ node.code }}"
                       class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        {# domaines actifs = ceux qui ont ≥1 capacité active sur ce nœud #}
        {% set activeDomains = {} %}
        {% for key, def in catalog %}
            {% if caps[key] ?? false %}{% set activeDomains = activeDomains|merge({(def.domain): true}) %}{% endif %}
        {% endfor %}

        {% if activeDomains|length > 0 %}
        <div>
            <div class="flex gap-1 border-b mb-3" style="border-color:var(--c-border)">
                {% for dom, domLabel in domains %}
                    {% if activeDomains[dom] is defined %}
                        <button type="button" data-tabs-target="tab" data-tab="{{ dom }}"
                                class="tab-btn px-3 py-1.5 text-sm border-b-2 border-transparent -mb-px">
                            {{ domLabel }}
                        </button>
                    {% endif %}
                {% endfor %}
            </div>

            {% for dom, domLabel in domains %}
                {% if activeDomains[dom] is defined %}
                <div data-tabs-target="panel" data-tab="{{ dom }}" class="space-y-3">
                    {% for key, def in catalog %}
                        {% if (caps[key] ?? false) and def.domain == dom %}
                            {{ ui.field(key, def, node) }}
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            {% endfor %}
        </div>
        {% endif %}

        <div class="flex items-center gap-2 pt-1">
            <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">Enregistrer</button>
            {% if caps.mutualisable ?? false %}
            <button formaction="{{ path('node_params', {id: node.id}) }}" name="mutualized" value="{{ node.mutualized ? '' : '1' }}"
                    class="rounded-md border px-3 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">
                {{ node.mutualized ? 'Retirer de la mutualisation' : 'Mutualiser (mettre à disposition)' }}
            </button>
            {% endif %}
        </div>
    </form>

    {# ── ajouter un enfant ── #}
    {% if childTypes is not empty %}
    <form method="post" action="{{ path('node_add', {id: formation.id}) }}" data-turbo-frame="_top"
          class="rounded-lg border p-3 flex items-end gap-2" style="border-color:var(--c-border)">
        <input type="hidden" name="parentId" value="{{ node.id }}">
        <label class="block flex-1">
            <span class="text-xs font-medium">Ajouter un enfant</span>
            <select name="typeKey" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                {% for t in childTypes %}<option value="{{ t.key }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
            </select>
        </label>
        <input name="label" placeholder="Libellé" class="rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
        <button class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">＋</button>
    </form>
    {% endif %}

    {# ── paramètre du nœud : quelles capacités sont actives sur CE nœud ── #}
    <details class="rounded-lg border p-3" style="border-color:var(--c-border)">
        <summary class="cursor-pointer text-sm font-medium">⚙️ Paramètre du nœud (capacités)</summary>
        <form method="post" action="{{ path('node_params', {id: node.id}) }}" data-turbo-frame="_top" class="mt-3 space-y-2">
            <p class="text-xs" style="color:var(--c-muted)">
                Coché = le nœud porte cet attribut. Par défaut hérité du type « {{ node.type.label }} ».
            </p>
            {% for key, label in capability_labels() %}
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="capabilities[]" value="{{ key }}" {{ (caps[key] ?? false) ? 'checked' }}>
                    {{ label }}
                </label>
            {% endfor %}
            <input type="hidden" name="mutualized" value="{{ node.mutualized ? '1' : '' }}">
            <button class="mt-2 rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">Appliquer</button>
        </form>
    </details>
</div>
</turbo-frame>

{# ── macro champ ── #}
{% macro field(key, def, node) %}
    {% set val = node.getAttribute(key) %}
    <div>
        <label class="block text-xs font-medium mb-1">
            {{ def.label }}{% if def.required ?? false %} <span class="text-red-500">*</span>{% endif %}
        </label>
        {% if def.field == 'number' %}
            <input type="number" step="0.5" name="attr_{{ key }}" value="{{ val }}"
                   class="w-40 rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
        {% elseif def.field == 'choice' %}
            <select name="attr_{{ key }}" class="w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                <option value="">— Choisir —</option>
                {% for ov, ol in def.options %}<option value="{{ ov }}" {{ val == ov ? 'selected' }}>{{ ol }}</option>{% endfor %}
            </select>
        {% elseif def.field == 'competencies' %}
            <input name="attr_competencies" value="{{ val ? val|join(', ') : '' }}" placeholder="Comp. 1, Comp. 2…"
                   class="w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
        {% elseif def.field == 'hours' %}
            <table class="text-sm">
                <thead><tr><th></th>{% for p, pl in constant('App\\Maquette\\AttributeCatalog::HOUR_PLACES') %}<th class="px-2 text-xs font-medium">{{ pl }}</th>{% endfor %}</tr></thead>
                <tbody>
                {% for m, ml in constant('App\\Maquette\\AttributeCatalog::HOUR_MODALITIES') %}
                    <tr>
                        <td class="pr-2 text-xs font-medium">{{ ml }}</td>
                        {% for p, pl in constant('App\\Maquette\\AttributeCatalog::HOUR_PLACES') %}
                            <td class="py-0.5"><input type="number" min="0" step="0.5" name="attr_hours_{{ m }}_{{ p }}"
                                value="{{ val[m][p] ?? '' }}" class="w-16 rounded-md border px-2 py-1" style="border-color:var(--c-border)"></td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% elseif def.field == 'mccc' %}
            <div class="space-y-1">
                <input name="attr_mccc[type]" value="{{ val.type ?? '' }}" placeholder="Type (CC, examen…)"
                       class="w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                <input name="attr_mccc[note]" value="{{ val.note ?? '' }}" placeholder="Précision"
                       class="w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </div>
        {% else %}
            <input name="attr_{{ key }}" value="{{ val }}"
                   class="w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
        {% endif %}
        {% if def.help ?? false %}<p class="text-xs mt-1" style="color:var(--c-muted)">{{ def.help }}</p>{% endif %}
    </div>
{% endmacro %}
