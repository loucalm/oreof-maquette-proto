{% extends wizard_layout|default('diplome/wizard/_layout.html.twig') %}
{% block step_content %}
<p class="text-sm mb-4 text-secondary-500">{{ 'diplome.wizard.admission.help'|trans({}, 'diplome') }}</p>
{{ form_start(form, {attr: {id: 'wizard-form', class: 'space-y-5'}}) }}
    {{ form_errors(form) }}
    <fieldset class="rounded-lg border p-4 border-secondary-200">
        <legend class="px-2 text-sm font-semibold">{{ 'diplome.wizard.admission.plateformes'|trans({}, 'diplome') }}</legend>
        {% if form.plateformes|length == 0 %}
            <p class="text-sm text-secondary-500" data-no-plateformes>{{ 'diplome.wizard.admission.none'|trans({}, 'diplome') }}</p>
        {% endif %}
        <div class="divide-y">
            {% for entry in form.plateformes %}
                <div class="flex flex-wrap items-center gap-3 py-2 text-sm" data-plateforme="{{ entry.vars.value.key }}">
                    {{ form_widget(entry.key) }}
                    <label class="flex flex-1 items-center gap-2 min-w-[12rem]">{{ form_widget(entry.enabled) }} {{ entry.vars.value.label }}</label>
                    <label class="flex items-center gap-2 text-xs text-secondary-500">
                        {{ 'diplome.wizard.admission.annees'|trans({}, 'diplome') }}
                        {{ form_widget(entry.annees, {attr: {class: 'fld w-28', placeholder: '1'}}) }}
                    </label>
                    {{ form_errors(entry.annees) }}
                </div>
            {% endfor %}
        </div>
    </fieldset>
{{ form_end(form) }}
{% endblock %}
{% block step_next %}
    <button form="wizard-form" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</button>
{% endblock %}
