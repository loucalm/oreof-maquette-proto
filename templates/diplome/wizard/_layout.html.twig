{% extends 'base.html.twig' %}
{% block title %}{{ 'diplome.wizard.title'|trans({}, 'diplome') }}{% endblock %}

{% set header_title = 'diplome.wizard.heading'|trans({}, 'diplome') %}
{% set header_description = 'diplome.wizard.header_description'|trans({}, 'diplome') %}
{% set header_breadcrumb = [
    {label: 'layout.nav.diplomes'|trans({}, 'layout'), url: path('diplome_index')},
    {label: header_title},
] %}

{% block bouton_header %}
    <twig:Button variant="warning" :soft="false" :outline="true" icon="ph:arrow-counter-clockwise" :label="'diplome.wizard.restart'|trans({}, 'diplome')" :href="path('diplome_wizard_start', {nouveau: 1})" data-action="restart"/>
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'diplome.wizard.back_to_list'|trans({}, 'diplome')" :href="path('diplome_index')"/>
{% endblock %}

{% block body %}
{# étape avec formulaire : la navigation soumet l'étape courante (champ `goto`) pour ne pas perdre la saisie #}
{% set _submits = form is defined and form %}

<div class="flex flex-col items-start gap-6 lg:flex-row">
    {% if _submits %}
        {# bouton par défaut (touche Entrée) : premier bouton du formulaire dans l'ordre du document, donc avant les liens d'étapes ; il mène à l'étape suivante #}
        <button type="submit" form="wizard-form" class="sr-only" tabindex="-1" aria-hidden="true">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</button>
    {% endif %}
    <nav class="w-full shrink-0 space-y-1 rounded-md border border-secondary-200 bg-surface p-3 shadow-md lg:sticky lg:top-[calc(var(--topbar-height)+1rem)] lg:w-72" aria-label="{{ 'diplome.wizard.heading'|trans({}, 'diplome') }}">
        <p class="mb-3 px-3 text-[10px] font-black uppercase tracking-widest text-secondary-400">{{ 'diplome.wizard.steps_title'|trans({}, 'diplome') }}</p>
        <ol class="space-y-1 text-sm">
        {% for s in steps %}
            {% set current = s == step %}
            <li>
                {% if s == 'informations' or unlocked %}
                    {% if _submits %}
                        <button type="submit" form="wizard-form" name="goto" value="{{ s }}" formnovalidate data-step="{{ s }}" {{ current ? 'aria-current="step"' }}
                                class="app-config-link {{ current ? 'is-active' }}">
                            <span class="flex items-center gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-[11px] {{ current ? 'bg-primary-600 text-white' : 'bg-secondary-100 text-secondary-500' }}">{{ loop.index }}</span>{{ ('diplome.wizard.steps.' ~ s)|trans({}, 'diplome') }}</span>
                        </button>
                    {% else %}
                    <a href="{{ path('diplome_wizard_step', {step: s}) }}" data-step="{{ s }}" {{ current ? 'aria-current="step"' }}
                       class="app-config-link {{ current ? 'is-active' }}">
                        <span class="flex items-center gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full text-[11px] {{ current ? 'bg-primary-600 text-white' : 'bg-secondary-100 text-secondary-500' }}">{{ loop.index }}</span>{{ ('diplome.wizard.steps.' ~ s)|trans({}, 'diplome') }}</span>
                    </a>
                    {% endif %}
                {% else %}
                    <span data-step="{{ s }}" class="app-config-link cursor-not-allowed opacity-50 hover:bg-transparent"><span class="flex items-center gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-secondary-100 text-[11px] text-secondary-400">{{ loop.index }}</span>{{ ('diplome.wizard.steps.' ~ s)|trans({}, 'diplome') }}</span>{{ ux_icon('ph:lock-simple', {class: 'h-4 w-4'}) }}</span>
                {% endif %}
            </li>
        {% endfor %}
        </ol>
    </nav>

    <section data-wizard-step="{{ step }}" class="w-full min-w-0 flex-1 rounded-xl border border-secondary-200 bg-surface p-6 shadow-sm">
        <div class="mb-6 border-b border-secondary-200 pb-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-secondary-400">{{ 'diplome.wizard.step_counter'|trans({'%index%': steps|keys|filter(k => steps[k] == step)|first + 1, '%count%': steps|length}, 'diplome') }}</p>
            <h2 class="mt-1 text-xl font-bold text-secondary-900">{{ ('diplome.wizard.steps.' ~ step)|trans({}, 'diplome') }}</h2>
        </div>
        {% block step_content %}{% endblock %}
        {% block step_nav %}
        <div class="mt-6 flex justify-between border-t border-secondary-200 pt-4">
            <div>
                {% if previous and _submits %}
                    <button type="submit" form="wizard-form" name="goto" value="{{ previous }}" formnovalidate data-action="previous" class="inline-flex h-10 items-center gap-1.5 rounded-md border border-secondary-400 px-4 text-sm font-medium text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white">{{ 'diplome.wizard.previous'|trans({}, 'diplome') }}</button>
                {% elseif previous %}
                    <a href="{{ path('diplome_wizard_step', {step: previous}) }}" data-action="previous" class="inline-flex h-10 items-center gap-1.5 rounded-md border border-secondary-400 px-4 text-sm font-medium text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white">{{ 'diplome.wizard.previous'|trans({}, 'diplome') }}</a>
                {% else %}
                    <a href="{{ path('diplome_index') }}" class="inline-flex h-10 items-center gap-1.5 rounded-md border border-secondary-400 px-4 text-sm font-medium text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white">{{ 'common.cancel'|trans({}, 'common') }}</a>
                {% endif %}
            </div>
            <div>
                {% block step_next %}
                    {% if next %}
                        {% if form is defined and form %}
                            <button class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</button>
                        {% else %}
                            <a href="{{ path('diplome_wizard_step', {step: next}) }}" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'diplome.wizard.next'|trans({}, 'diplome') }}</a>
                        {% endif %}
                    {% endif %}
                {% endblock %}
            </div>
        </div>
        {% endblock %}
    </section>
</div>
{% endblock %}
