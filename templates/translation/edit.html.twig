{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'traductions' %}
{% block title %}Traductions — {{ filename }}{% endblock %}

{% block admin_body %}
<div class="flex items-start justify-between mb-5">
    <div>
        <h2 class="text-lg font-bold">Fichier : {{ filename }}</h2>
        <p class="text-sm" style="color:var(--c-muted)">
            Cliquez sur « Modifier » sur une ligne pour éditer sa valeur, « Enregistrer » sauvegarde
            immédiatement sans recharger la page.
        </p>
    </div>
    <a href="{{ path('admin_traductions') }}" class="text-sm hover:underline">← Tous les fichiers</a>
</div>

<div class="rounded-xl border bg-white overflow-hidden" style="border-color:var(--c-border)"
     data-controller="translation"
     data-translation-save-url-value="{{ path('admin_traductions_save_one', {filename: filename}) }}"
     data-translation-delete-url-value="{{ path('admin_traductions_delete_one', {filename: filename}) }}">
    <div class="flex justify-end px-4 py-3 border-b" style="border-color:var(--c-border)">
        <button type="button" data-action="translation#addRow" class="rounded-md px-3 py-1.5 text-sm font-medium text-white" style="background:var(--c-primary)">{{ ux_icon('ph:plus', {class: 'icon'}) }} Ajouter une clé</button>
    </div>
    <table class="w-full text-sm">
        <thead class="text-xs uppercase tracking-wide" style="color:var(--c-muted)">
            <tr class="border-b" style="border-color:var(--c-border)">
                <th class="text-left px-4 py-2.5 w-2/5">Clé</th>
                <th class="text-left px-4 py-2.5">Valeur</th>
                <th class="px-4 py-2.5 w-40"></th>
            </tr>
        </thead>
        <tbody data-translation-target="tbody">
        {% for key, value in translations %}
            <tr class="border-b last:border-0" style="border-color:var(--c-border)"
                data-translation-key="{{ key }}" data-original-value="{{ value|e('html_attr') }}" data-is-new="false">
                <td class="px-4 py-2.5 align-top">
                    <span data-role="key-display" class="font-mono text-xs select-all" style="color:var(--c-muted)">{{ key }}</span>
                </td>
                <td class="px-4 py-2.5 align-top">
                    <span data-role="value-display" class="text-sm whitespace-pre-wrap">{{ value }}</span>
                    <input data-role="value-input" type="text" value="{{ value|e('html_attr') }}" hidden class="fld text-sm" aria-label="Valeur pour la clé {{ key }}" />
                    <p data-role="error" hidden class="text-xs text-red-600 mt-1"></p>
                </td>
                <td class="px-4 py-2.5 align-top text-right whitespace-nowrap">
                    <div data-role="view-actions">
                        <button type="button" data-action="translation#edit" class="text-xs hover:underline">Modifier</button>
                        <button type="button" data-action="translation#remove" class="text-xs text-red-600 hover:underline ml-2">Suppr.</button>
                    </div>
                    <div data-role="edit-actions" hidden>
                        <button type="button" data-role="save-btn" data-action="translation#save" class="text-xs text-green-700 hover:underline">Enregistrer</button>
                        <button type="button" data-action="translation#cancel" class="text-xs hover:underline ml-2" style="color:var(--c-muted)">Annuler</button>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="px-4 py-8 text-center text-sm" style="color:var(--c-muted)">Aucune traduction dans ce fichier.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
