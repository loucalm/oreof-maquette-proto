{% import 'formation/param/_fields.html.twig' as fld %}
{% set regimeChoices = referentiel('regimes_inscription') %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ key }}" data-controller="modal">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ 'formation.param.panel_title'|trans({}, 'formation') }}</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ formation.name }} › {{ label }}</div>
    </div>

    <div class="panel-scroll">
    <div class="panel-card space-y-6">

        {# ── Nombre de parcours ── #}
        {{ fld.divider('formation.param.structure.divider_parcours_count'|trans({}, 'formation')) }}
        {% set hasTemplate = formation.diplome and template_for_diplome(formation.diplome) %}
        {% if not is_admin() and hasTemplate %}
            <p class="text-xs text-gray-500 -mt-2">
                {{ 'formation.param.structure.locked_by_template_note'|trans({}, 'formation') }}
            </p>
            <p class="text-sm font-medium">{{ formation.multiParcours ? 'formation.param.structure.yes_options'|trans({}, 'formation') : 'formation.param.structure.no_mono'|trans({}, 'formation') }}</p>
        {% else %}
        <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" data-turbo-frame="_top" data-controller="confirm">
            <input type="hidden" name="name" value="{{ formation.name }}">
            <input type="hidden" name="diplome" value="{{ formation.diplome }}">
            <input type="hidden" name="domaine" value="{{ formation.domaine }}">
            <input type="hidden" name="composante" value="{{ formation.composante }}">
            {{ fld.label('formation.param.structure.has_parcours_label'|trans({}, 'formation'), true, 'formation.param.structure.has_parcours_help'|trans({}, 'formation')) }}
            <p class="fld-help">{{ ux_icon('ph:warning', {class: 'icon'}) }} {{ 'formation.param.structure.important_change_note'|trans({}, 'formation') }}</p>
            <div class="flex flex-wrap gap-8 mt-2 text-sm">
                <label class="flex items-center gap-2">
                    <input type="radio" name="multiParcours" value="1" {{ formation.multiParcours ? 'checked' }}
                           data-confirm-target="restore" data-confirm-checked="{{ formation.multiParcours ? '1' : '0' }}"
                           data-action="change->confirm#confirmChange"
                           data-confirm-message-param="{{ 'formation.param.structure.to_multi_confirm'|trans({}, 'formation') }}">
                    {{ 'formation.param.structure.yes_options'|trans({}, 'formation') }}
                </label>
                <label class="flex items-center gap-2">
                    <input type="radio" name="multiParcours" value="0" {{ not formation.multiParcours ? 'checked' }}
                           data-confirm-target="restore" data-confirm-checked="{{ not formation.multiParcours ? '1' : '0' }}"
                           data-action="change->confirm#confirmChange"
                           data-confirm-message-param="{{ 'formation.param.structure.to_mono_confirm'|trans({}, 'formation') }}">
                    {{ 'formation.param.structure.no_mono'|trans({}, 'formation') }}
                </label>
            </div>
        </form>
        {% endif %}

        {# ── Dimension temporelle ── #}
        {{ fld.divider('formation.param.structure.divider_temporal'|trans({}, 'formation')) }}
        {% set unit = period_unit(formation) %}
        {% if not is_admin() and hasTemplate %}
            <p class="text-xs text-gray-500 -mt-2">
                {{ 'formation.param.structure.locked_by_template_note'|trans({}, 'formation') }}
            </p>
            <p class="text-sm font-medium">{{ formation.calendarSpan ?: '—' }} {{ (formation.calendarUnit ?: unit)|lower }}(s)</p>
        {% else %}
        <p class="text-xs text-gray-500 -mt-2">
            {{ 'formation.param.structure.temporal_note'|trans({'%unit%': unit}, 'formation')|raw }}
        </p>
        <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" data-turbo-frame="_top" class="grid gap-4 sm:grid-cols-2">
            <input type="hidden" name="name" value="{{ formation.name }}">
            <input type="hidden" name="diplome" value="{{ formation.diplome }}">
            <input type="hidden" name="domaine" value="{{ formation.domaine }}">
            <input type="hidden" name="composante" value="{{ formation.composante }}">
            <input type="hidden" name="multiParcours" value="{{ formation.multiParcours ? '1' : '0' }}">
            <input type="hidden" name="ectsTotal" value="{{ formation.ectsTotal }}">
            <div>
                {{ fld.label('formation.param.structure.calendar_unit_label'|trans({}, 'formation'), false, 'formation.param.structure.calendar_unit_help'|trans({'%unit%': unit}, 'formation')) }}
                <input name="calendarUnit" value="{{ formation.calendarUnit }}" placeholder="{{ unit }}" class="fld mt-1">
            </div>
            <div>
                {{ fld.label('formation.param.structure.calendar_span_label'|trans({'%unit%': unit|lower}, 'formation'), false, 'formation.param.structure.calendar_span_help'|trans({}, 'formation')) }}
                <div class="flex items-end gap-2">
                    <input type="number" min="1" name="calendarSpan" value="{{ formation.calendarSpan }}" class="fld mt-1">
                    <button class="rounded-lg px-3 py-2 text-sm font-semibold text-white shrink-0" style="background:var(--c-primary)">OK</button>
                </div>
            </div>
        </form>
        {% endif %}

        {# ── Propriétés du parcours invisible (mono-parcours) ── #}
        {% if formation.isMono %}
            {{ fld.divider('formation.param.structure.divider_mono_props'|trans({}, 'formation')) }}
            <p class="text-xs text-gray-500 -mt-2">
                {{ 'formation.param.structure.mono_props_note'|trans({'%badge%': '<span class="type-badge">' ~ ux_icon('ph:compass', {class: 'icon'}) ~ ' ' ~ 'formation.graph.parcours_fallback'|trans({}, 'formation') ~ '</span>'}, 'formation')|raw }}
            </p>
            <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" data-turbo-frame="_top" class="space-y-4">
                <input type="hidden" name="name" value="{{ formation.name }}">
                <input type="hidden" name="diplome" value="{{ formation.diplome }}">
                <input type="hidden" name="domaine" value="{{ formation.domaine }}">
                <input type="hidden" name="multiParcours" value="0">

                <div>
                    {{ fld.label('formation.param.structure.intitule_mono_label'|trans({}, 'formation'), false, 'formation.param.structure.intitule_mono_help'|trans({}, 'formation')) }}
                    {{ fld.text('intituleMono', data.intituleMono ?? '') }}
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        {{ fld.label('formation.param.structure.ects_total_label'|trans({}, 'formation'), true, 'formation.param.structure.ects_total_help'|trans({}, 'formation')) }}
                        <input type="number" name="ectsTotal" value="{{ formation.ectsTotal }}" class="fld mt-1">
                    </div>
                    <div>
                        {{ fld.label('formation.view.plabel.composante_inscription'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.composante_help'|trans({}, 'formation')) }}
                        <input name="composante" value="{{ formation.composante }}" class="fld mt-1">
                        <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'formation.param.parcours_organisation.add_composante_fake'|trans({}, 'formation') }}</span></div>
                    </div>
                </div>

                <div>
                    {{ fld.label('formation.view.plabel.regimes'|trans({}, 'formation'), true, 'formation.param.parcours_organisation.multi_choice'|trans({}, 'formation')) }}
                    <div class="grid gap-2 sm:grid-cols-2 mt-2 text-sm">
                        {% set curRegimes = data.regimes ?? [] %}
                        {% for rv, rl in regimeChoices %}
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="regimes[]" value="{{ rv }}" {{ rv in curRegimes ? 'checked' }}> {{ rl }}
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div>
                    {{ fld.label('formation.param.parcours_organisation.modalites_alternance_label'|trans({}, 'formation'), true) }}
                    {{ fld.textarea('modalitesAlternance', data.modalitesAlternance ?? '', 'formation.param.parcours_organisation.modalites_alternance_help'|trans({}, 'formation')) }}
                </div>

                <div>
                    {{ fld.label('formation.view.plabel.langue'|trans({}, 'formation'), true, 'formation.param.parcours_presentation.langue_help'|trans({}, 'formation')) }}
                    {{ fld.select('langue', data.langue ?? '', referentiel('langues')) }}
                    <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'formation.param.parcours_presentation.add_langue_fake'|trans({}, 'formation') }}</span></div>
                </div>

                {{ fld.divider('formation.param.parcours_presentation.divider_after'|trans({}, 'formation')) }}

                <div>
                    {{ fld.label('formation.view.plabel.poursuite_etudes'|trans({}, 'formation'), true) }}
                    {{ fld.textarea('poursuiteEtudes', data.poursuiteEtudes ?? '', 'formation.param.parcours_presentation.poursuite_etudes_help'|trans({}, 'formation')) }}
                </div>
                <div>
                    {{ fld.label('formation.view.plabel.debouches'|trans({}, 'formation'), true) }}
                    {{ fld.textarea('debouches', data.debouches ?? '', 'formation.param.parcours_presentation.debouches_help'|trans({}, 'formation')) }}
                </div>
                <div>
                    {{ fld.label('formation.param.parcours_presentation.codes_rome_label'|trans({}, 'formation'), true, 'formation.param.parcours_presentation.codes_rome_help'|trans({}, 'formation')) }}
                    {{ fld.select('codesRome', data.codesRome ?? '', referentiel('codes_rome')) }}
                    <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'formation.param.parcours_presentation.add_rome_fake'|trans({}, 'formation') }}</span></div>
                </div>

                <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            </form>
        {% endif %}

        {# ── Structure : la hiérarchie des TYPES de nœud ── #}
        {{ fld.divider('formation.param.structure.divider_structure'|trans({}, 'formation')) }}

        {% if not is_admin() %}
            {# vue responsable : la hiérarchie des niveaux est imposée, lecture seule #}
            <p class="text-xs text-gray-500 -mt-2">
                {{ 'formation.param.structure.readonly_note'|trans({}, 'formation') }}
            </p>
            <div class="flex flex-wrap items-center gap-1.5">
                {% for row in structure_rows(formation) %}
                    {% if not loop.first %}<span class="text-gray-300">›</span>{% endif %}
                    <span class="type-badge">{{ row.type ? ux_icon(row.type.icon, {class: 'icon'}) }} [{{ row.type ? row.type.label : row.key }}]</span>
                    {%- if row.mono %}<span class="text-[11px] text-gray-400">{{ 'formation.param.structure.mono_carried_badge'|trans({}, 'formation') }}</span>{% endif -%}
                {% endfor %}
            </div>
        {% else %}
        <p class="text-xs text-gray-500 -mt-2">
            {{ 'formation.param.structure.admin_note'|trans({}, 'formation') }}
        </p>

        {% set rows = structure_rows(formation) %}
        {% set body_keys = rows|filter(r => not r.fixed)|map(r => r.key) %}
        {% set addable = structure_addable(formation) %}

        <div class="overflow-hidden rounded-lg border" style="border-color:var(--c-border)">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
                    <tr>
                        <th class="w-8"></th>
                        <th class="text-left px-3 py-2.5">{{ 'formation.param.structure.col_order'|trans({}, 'formation') }}</th>
                        <th class="text-left px-3 py-2.5">{{ 'formation.param.structure.col_type'|trans({}, 'formation') }}</th>
                        <th class="text-right px-4 py-2.5">{{ 'formation.index.col_actions'|trans({}, 'formation') }}</th>
                    </tr>
                </thead>
                <tbody data-controller="chain" data-chain-save-url-value="{{ path('formation_structure_save', {id: formation.id}) }}">
                {% for row in rows %}
                    <tr class="border-t" style="border-color:var(--c-border)"
                        {{ not row.fixed ? 'data-chain-key=' ~ row.key }}>
                        <td class="px-2 text-center text-gray-300">
                            {% if not row.fixed %}<span class="drag-handle" title="{{ 'formation.tree.drag_title'|trans({}, 'formation') }}">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>{% endif %}
                        </td>
                        <td class="px-3 py-2.5 text-gray-400">{{ loop.index0 }}</td>
                        <td class="px-3 py-2.5">
                            <span class="type-badge">{{ row.type ? ux_icon(row.type.icon, {class: 'icon'}) : ux_icon('ph:question', {class: 'icon'}) }} [{{ row.type ? row.type.label : row.key }}]</span>
                            {% if row.mono %}<span class="pill ml-1">{{ 'formation.param.structure.invisible_mono_pill'|trans({}, 'formation') }}</span>
                            {% elseif row.fixed %}<span class="pill ml-1">{{ 'formation.param.structure.root_fixed_pill'|trans({}, 'formation') }}</span>{% endif %}
                            {% if loop.index0 > 0 %}
                                <span class="text-[11px] text-gray-400 ml-1">
                                    {{- rows[loop.index0 - 1].mono ? 'formation.param.structure.visible_root_note'|trans({}, 'formation') : 'formation.param.structure.child_of_note'|trans({'%parent%': rows[loop.index0 - 1].type ? rows[loop.index0 - 1].type.label : rows[loop.index0 - 1].key}, 'formation') -}}
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-2.5 text-right whitespace-nowrap">
                            {% if row.type and not row.mono %}
                                <a href="{{ path('node_type_edit', {id: row.type.id}) }}" target="_blank" class="text-xs hover:underline">{{ 'common.edit'|trans({}, 'common') }}</a>
                            {% endif %}
                            {% if not row.fixed %}
                                <form method="post" action="{{ path('formation_structure_save', {id: formation.id}) }}" data-turbo-frame="_top" class="inline ml-3"
                                      data-controller="confirm" data-confirm-message-value="{{ 'formation.param.structure.remove_confirm'|trans({'%label%': row.type ? row.type.label : row.key}, 'formation') }}">
                                    {% for k in body_keys|filter(k => k != row.key) %}<input type="hidden" name="chain[]" value="{{ k }}">{% endfor %}
                                    <button class="text-xs text-red-600 hover:underline">{{ 'formation.param.structure.remove_button'|trans({}, 'formation') }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="border-t" style="border-color:var(--c-border)">
                        <td colspan="4" class="px-4 py-3 text-center" style="background:#f0fdf4">
                            <button type="button" data-action="modal#open" class="text-sm font-medium text-green-700 hover:underline">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'formation.param.structure.add_elp_button'|trans({}, 'formation') }}</button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {# ── modale « Ajouter un nœud » ── #}
        <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
                class="rounded-2xl border-0 p-0 w-[min(440px,92vw)] backdrop:bg-black/40">
            <form method="post" action="{{ path('formation_structure_save', {id: formation.id}) }}" data-turbo-frame="_top" class="p-6 space-y-4">
                {% for k in body_keys %}<input type="hidden" name="chain[]" value="{{ k }}">{% endfor %}
                <h3 class="text-lg font-bold">{{ 'formation.param.structure.add_elp_button'|trans({}, 'formation') }}</h3>
                <div>
                    {{ fld.label('formation.param.structure.elp_field'|trans({}, 'formation'), true, 'formation.param.structure.elp_help'|trans({}, 'formation')) }}
                    <select name="chain[]" required class="fld mt-1">
                        <option value="">{{ 'node.panel.choice_default'|trans({}, 'node') }}</option>
                        {% for t in addable %}<option value="{{ t.key }}">{{ t.label }}</option>{% endfor %}
                    </select>
                    {% if addable is empty %}
                        <p class="fld-help">{{ 'formation.param.structure.all_types_used'|trans({'%link_open%': '<a href="' ~ path('node_type_index') ~ '" target="_blank" class="underline">', '%link_close%': '</a>'}, 'formation')|raw }}</p>
                    {% endif %}
                </div>
                <div class="flex items-center justify-end gap-2 pt-1">
                    <button type="button" data-action="modal#close" class="rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</button>
                    <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--st-ok)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }}</button>
                </div>
            </form>
        </dialog>
        <p class="text-xs text-gray-400">
            {{ 'formation.param.structure.node_count_note'|trans({'%count%': nodeCount, '%link_open%': '<a href="' ~ path('node_type_index') ~ '" target="_blank" class="underline">', '%link_close%': '</a>'}, 'formation')|raw }}
        </p>

        {# ── Charger un template ── #}
        {{ fld.divider('formation.param.structure.divider_load_template'|trans({}, 'formation')) }}
        <form method="post" action="{{ path('formation_apply_template', {id: formation.id}) }}" data-turbo-frame="_top"
              data-controller="confirm" data-confirm-message-value="{{ 'formation.param.structure.load_template_confirm'|trans({}, 'formation') }}"
              class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-[220px]">
                <select name="template" class="fld">
                    {% for tpl in templates %}<option value="{{ tpl.key }}">{{ tpl.label }}</option>{% endfor %}
                </select>
            </div>
            <button class="rounded-lg border px-4 py-2.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'formation.param.structure.load_button'|trans({}, 'formation') }}</button>
        </form>
        <p class="text-xs text-gray-400">
            {{ 'formation.param.structure.template_note'|trans({'%link_open%': '<a href="' ~ path('template_index') ~ '" target="_blank" class="underline">', '%link_close%': '</a>'}, 'formation')|raw }}
        </p>

        {# ── enregistrer / vider ── #}
        <div class="flex flex-wrap items-center gap-3 pt-2 border-t" style="border-color:var(--c-border)">
            <form method="post" action="{{ path('template_from_formation', {id: formation.id}) }}" data-turbo-frame="_top" class="flex items-end gap-2">
                <input name="label" placeholder="{{ 'formation.param.structure.template_name_placeholder'|trans({}, 'formation') }}" required class="fld w-52">
                <button class="rounded-lg border px-3 py-2.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:floppy-disk', {class: 'icon'}) }} {{ 'formation.param.structure.save_as_template_button'|trans({}, 'formation') }}</button>
            </form>
            <form method="post" action="{{ path('formation_reset', {id: formation.id}) }}" data-turbo-frame="_top" class="ml-auto"
                  data-controller="confirm" data-confirm-message-value="{{ 'formation.param.structure.reset_confirm'|trans({}, 'formation') }}">
                <button class="rounded-lg border px-3 py-2.5 text-sm text-red-600 hover:bg-red-50" style="border-color:var(--c-border)">{{ ux_icon('ph:trash', {class: 'icon'}) }} {{ 'formation.param.structure.reset_button'|trans({}, 'formation') }}</button>
            </form>
        </div>
        {% endif %}

        {# ── Demandes de dérogation ── #}
        {{ fld.divider('derogation.index.heading'|trans({}, 'derogation')) }}
        <p class="text-xs text-gray-500 -mt-2">
            {{ 'formation.param.structure.derogation_note'|trans({'%flag_icon%': ux_icon('ph:flag', {class: 'icon'})}, 'formation')|raw }}
        </p>
        {% if derogations is empty %}
            <p class="text-sm" style="color:var(--c-muted)">{{ 'formation.param.structure.no_derogation'|trans({}, 'formation') }}</p>
        {% else %}
            <div class="space-y-2">
                {% for d in derogations %}
                    <div class="rounded-lg border p-3 text-sm" style="border-color:var(--c-border)">
                        <div class="flex flex-wrap items-center gap-2">
                            {% if d.nodeLabel %}<span class="type-badge">{{ d.nodeLabel }}</span>{% endif %}
                            <span class="pill" style="{{ d.status.value == 'pending' ? 'background:#fef3c7;color:#b45309' : (d.status.value == 'approved' ? 'background:#dcfce7;color:#15803d' : 'background:#fee2e2;color:#b91c1c') }}">{{ d.status.label }}</span>
                            <span class="text-xs" style="color:var(--c-muted)">{{ d.createdAt|date('d/m/Y') }}</span>
                        </div>
                        <p class="mt-1.5 whitespace-pre-line">{{ d.message }}</p>
                        {% if not d.isPending and d.adminNote %}
                            <p class="mt-1.5 rounded-md p-2 text-xs" style="background:#f8f9fb">{{ d.adminNote }}</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    </div>
</div>
</turbo-frame>
