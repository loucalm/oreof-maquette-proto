{% extends 'base.html.twig' %}
{% block title %}{{ formation.name }} · {{ 'formation.editor.title_suffix'|trans({}, 'formation') }}{% endblock %}

{% set focus = app.request.query.get('focus') %}
{% set param = app.request.query.get('param') %}
{% set bcc = app.request.query.get('bcc') %}
{% set multi = formation.avecParcours %}
{# panneau ouvert : le lien courant de la fiche (param, bcc, ou par défaut l'écran qui le revendique), sinon le nœud ciblé #}
{% set navItems = fiche_nav(formation, null, app.request.query.all) %}
{% set currentItem = navItems|filter(i => i.current)|first %}
{% set frameSrc = focus ? path('node_panel', {fid: formation.id, nid: focus}) : (currentItem ? currentItem.url : null) %}

{% set header_title = formation.name %}
{% set header_description = 'formation.editor.page_subtitle'|trans({}, 'formation') %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: 'formation.index.heading'|trans({}, 'formation'), url: path('formation_index')},
    {label: formation.name},
] %}
{% set header_sticky = false %}

{% block bouton_header %}
    <twig:Button variant="info" :soft="false" :outline="true" icon="ph:eye" :label="'formation.editor.view_sheet'|trans({}, 'formation')" :href="path('formation_view', {id: formation.id})"/>
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'formation.editor.back_to_list'|trans({}, 'formation')" :href="path('formation_index')"/>
{% endblock %}

{% block body %}
{% include 'formation/_preview_banner.html.twig' %}

{% include 'formation/_formation_header.html.twig' with {mode: 'edit'} %}

{# ═══ éditeur ═══ #}
<div class="editor-shell grid lg:h-[calc(100vh-var(--topbar-height)-2rem)] min-h-[560px]" data-controller="resizable">
        {{ include('formation/_aside_resizer.html.twig') }}


        {# ─── panneau gauche ─── #}
        <div class="editor-aside flex flex-col overflow-hidden"
             data-controller="tree modal treefilter"
             data-modal-auto-open-value="{{ app.request.query.has('derogation') ? 'true' : 'false' }}"
             {% if not multi %}
             data-tree-move-url-value="{{ path('node_move', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-dup-url-value="{{ path('node_duplicate', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-del-url-value="{{ path('node_delete', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-chain-value="{{ formation.effectiveStructure|json_encode|e('html_attr') }}"
             data-tree-type-meta-value="{{ type_meta()|json_encode|e('html_attr') }}"
             data-tree-root-key-value="{{ formation.visibleRootTypeKey }}"
             {% endif %}>

            {% include 'formation/_aside_head.html.twig' with {title: 'formation.editor.structure_label'|trans({}, 'formation'), name: formation.name, sub: formation.composante ?: 'formation.editor.meta_composante_default'|trans({}, 'formation')} %}

            <div class="flex-1 overflow-y-auto">
                <div class="border-b border-secondary-200 px-3 py-3">
                    <p class="mb-2 px-3 text-[10px] font-black uppercase tracking-widest text-secondary-400">{{ 'formation.editor.param_section_label'|trans({}, 'formation') }}</p>
                    {% include 'formation/_fiche_nav.html.twig' with {items: navItems} %}
                </div>

                {% if multi %}
                    {# ─── liste des parcours (chaque ligne ouvre son éditeur) ─── #}
                    <div class="px-3 py-3">
                        <p class="mb-2 px-3 text-[10px] font-black uppercase tracking-widest text-secondary-400">{{ 'formation.editor.parcours_list_label'|trans({}, 'formation') }}</p>
                        {% for p in parcours_nodes(formation) %}
                            <a href="{{ path('parcours_editor', {fid: formation.id, nid: p.id}) }}"
                               class="mb-2 flex items-center justify-between gap-2 rounded-2xl border border-secondary-200 px-3 py-2.5 text-sm font-bold text-secondary-600 transition hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700">
                                <span class="min-w-0 truncate">{{ p.displayLabel }}</span>
                                <span class="shrink-0 text-secondary-300">{{ ux_icon('ph:caret-right', {class: 'icon'}) }}</span>
                            </a>
                        {% else %}
                            <p class="text-xs text-secondary-400 px-1 py-2">{{ 'formation.editor.no_parcours'|trans({}, 'formation') }}</p>
                        {% endfor %}
                    </div>
                {% else %}
                    {% set rootType = root_type(formation) %}
                    <div class="tree-search" role="search">
                        <input type="search" data-treefilter-target="input" placeholder="{{ 'formation.tree.search_placeholder'|trans({}, 'formation') }}"
                               aria-label="{{ 'formation.tree.search_aria'|trans({}, 'formation') }}" class="fld text-sm">
                        <div class="mt-1.5 flex items-center gap-1.5 text-xs">
                            <button type="button" data-treefilter-target="mode" data-mode="all" class="tf-mode">{{ 'formation.tree.filter_all'|trans({}, 'formation') }}</button>
                            <button type="button" data-treefilter-target="mode" data-mode="todo" class="tf-mode">{{ 'formation.tree.filter_todo'|trans({}, 'formation') }}</button>
                            <span class="ml-auto text-secondary-400" data-treefilter-target="count" aria-live="polite"></span>
                        </div>
                        <p data-treefilter-target="empty" hidden class="mt-2 text-xs text-secondary-400">{{ 'formation.tree.search_empty'|trans({}, 'formation') }}</p>
                    </div>
                    <div class="p-2" data-treefilter-target="tree">
                        {% if roots is not empty %}
                            {{ include('formation/_tree.html.twig', {views: roots, parentId: null, focus: focus, parentIsChoice: false, parentChoiceLabel: null}) }}
                        {% elseif not rootType %}
                            <p class="text-sm px-2 py-8 text-center text-secondary-400">
                                {{ 'formation.editor.no_skeleton_note'|trans({'%link_open%': '<a href="' ~ path('formation_param', {id: formation.id, key: 'structure'}) ~ '" data-turbo-frame="node-panel" class="underline">', '%link_close%': '</a>'}, 'formation')|raw }}
                            </p>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# ─── barre d'actions ─── #}
            <div class="flex shrink-0 items-center gap-2 border-t border-secondary-200 bg-secondary-50/60 px-3 py-3">
                {% if multi %}
                    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top" class="flex-1">
                        <input type="hidden" name="parentId" value="">
                        <input type="hidden" name="typeKey" value="parcours">
                        <input type="hidden" name="label" value="{{ 'formation.editor.new_parcours_label'|trans({}, 'formation') }}">
                        <button class="tree-add-btn">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }} {{ ux_icon('ph:compass', {class: 'icon'}) }} {{ 'formation.editor.add_parcours_suffix'|trans({}, 'formation') }}</button>
                    </form>
                {% elseif rootType %}
                    <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
                          class="flex-1" data-tree-target="addForm">
                        <input type="hidden" name="parentId" value="" data-tree-target="addParent">
                        <input type="hidden" name="typeKey" value="{{ rootType.key }}" data-tree-target="addType">
                        <input type="hidden" name="afterId" value="" data-tree-target="addAfter">
                        <button data-tree-target="addButton" class="tree-add-btn">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }} {{ ux_icon(rootType.icon, {class: 'icon'}) }} {{ rootType.label }}</button>
                    </form>
                    <button type="button" data-tree-target="addChoiceButton" data-action="tree#addChoiceBloc" hidden
                            class="tree-act-btn tree-act-btn--choice"
                            title="{{ 'formation.editor.add_choice_title'|trans({}, 'formation') }}">{{ ux_icon('ph:shuffle', {class: 'icon'}) }}</button>
                {% else %}
                    <span class="flex-1 text-xs text-secondary-400">{{ 'formation.editor.no_structure_defined'|trans({}, 'formation') }}</span>
                {% endif %}

                {% if not multi %}
                    <form method="post" data-turbo-frame="_top" data-tree-target="dupForm">
                        <button type="submit" data-tree-target="dupButton" disabled title="{{ 'formation.editor.duplicate_title'|trans({}, 'formation') }}"
                                class="tree-act-btn">{{ ux_icon('ph:copy', {class: 'icon'}) }}</button>
                    </form>
                    <form method="post" data-turbo-frame="_top" data-tree-target="delForm"
                          data-controller="confirm" data-confirm-message-value="{{ 'formation.editor.delete_node_confirm'|trans({}, 'formation') }}">
                        <button type="submit" data-tree-target="delButton" disabled title="{{ 'formation.editor.delete_title'|trans({}, 'formation') }}"
                                class="tree-act-btn tree-act-btn-danger">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                    </form>
                {% endif %}
                <button type="button" data-action="modal#open"
                        class="tree-act-btn" title="{{ 'formation.editor.request_derogation_title'|trans({}, 'formation') }}">
                    {{ ux_icon('ph:flag', {class: 'icon'}) }}
                </button>
            </div>

            {% include 'formation/_derogation_modal.html.twig' %}
        </div>

        {# ─── panneau d'édition ─── #}
        <turbo-frame id="node-panel" class="panel-frame min-w-0" refresh="morph"
                     {% if frameSrc %}src="{{ frameSrc }}"{% endif %}>
            {% if not frameSrc %}
                <div class="panel-empty">{{ 'formation.editor.select_prompt'|trans({}, 'formation') }}</div>
            {% endif %}
        </turbo-frame>
</div>
{% endblock %}
