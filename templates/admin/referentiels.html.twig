{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'referentiels' %}
{% block title %}Référentiels{% endblock %}

{# rangée : valeurs = liste de libellés, ou map {clé: libellé} #}
{% macro row(title, help, values) %}
    <div>
        <div class="fld-label">{{ title }}</div>
        {% if help %}<div class="fld-help mb-1.5">{{ help }}</div>{% else %}<div class="mb-1.5"></div>{% endif %}
        <div class="flex flex-wrap gap-1.5">
            {% for k, label in values %}
                <span class="rounded-md border px-2 py-0.5 text-xs" style="border-color:var(--c-border);background:#fff">
                    {{ label }}{% if k is not same as(loop.index0) and k != label %}<span class="text-gray-400"> · {{ k }}</span>{% endif %}
                </span>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% block admin_body %}
{% import _self as ui %}

<div class="mb-5">
    <h2 class="text-lg font-bold">Référentiels &amp; nomenclatures</h2>
    <p class="text-sm text-gray-500">
        Les listes de valeurs (select, choix) proposées dans les formulaires.
    </p>
</div>

<div class="space-y-4">

    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">Métamodèle</div>
        {% set famMap = {} %}
        {% for f in families %}{% set famMap = famMap|merge({(f.value): f.label}) %}{% endfor %}
        {{ ui.row('Familles de type d’élément pédagogique', 'Déterminent le rendu et l’emplacement d’un type.', famMap) }}
        {{ ui.row('Types de saisie d’un champ', 'Choisis à la création d’un champ.', fieldTypes) }}
    </div>

    {% if choiceFields %}
        <div class="rounded-xl border bg-white p-5 space-y-3" style="border-color:var(--c-border)">
            <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">
                Options des champs « liste » / « radio »
                <a href="{{ path('field_index') }}" class="ml-2 font-normal normal-case text-gray-400 underline">modifier dans Champs</a>
            </div>
            {% for f in choiceFields %}
                {{ ui.row(f.label ~ '  (' ~ f.key ~ ')', null, f.options) }}
            {% endfor %}
        </div>
    {% endif %}

    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">Évaluation &amp; volume horaire</div>
        {% set mccc = {} %}
        {% for k, v in mcccTypes %}{% set mccc = mccc|merge({(k): v.short ~ ' — ' ~ v.label}) %}{% endfor %}
        {{ ui.row('Types de MCCC', 'Contrôle continu intégral, mixte, terminal…', mccc) }}
        {{ ui.row('Modalités d’heures', null, hourModalities) }}
        {{ ui.row('Lieux', 'Le volume « travail étudiant (TE) » est un total global à part.', hourPlaces) }}
    </div>

    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="flex items-start justify-between">
            <div>
                <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">Nomenclatures de l’offre de formation</div>
                <p class="text-xs mt-1" style="color:var(--c-muted)">Diplômes, domaines, régimes, langues, codes ROME… Réutilisées telles quelles dans les formulaires de formation et de parcours.</p>
            </div>
            <a href="{{ path('referentiel_new') }}" class="shrink-0 rounded-md px-3 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ ux_icon('ph:plus', {class: 'icon'}) }} Nouveau référentiel</a>
        </div>
        {% for ref in referentiels %}
            <div class="rounded-lg border p-3" style="border-color:var(--c-border)">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <span class="font-medium text-sm">{{ ref.label }}</span>
                        <code class="text-xs ml-1" style="color:var(--c-muted)">{{ ref.key }}</code>
                        {% if ref.system %}<span class="pill ml-1">socle</span>{% endif %}
                        {% if ref.description %}<div class="fld-help mt-0.5">{{ ref.description }}</div>{% endif %}
                    </div>
                    <div class="shrink-0 whitespace-nowrap text-right">
                        <a href="{{ path('referentiel_edit', {id: ref.id}) }}" class="text-xs hover:underline">Modifier</a>
                        {% if not ref.system %}
                            <form method="post" action="{{ path('referentiel_delete', {id: ref.id}) }}" class="inline"
                                  data-controller="confirm" data-confirm-message-value="Supprimer le référentiel « {{ ref.label }} » ? Les valeurs déjà saisies dans les formulaires restent en base mais la liste ne sera plus proposée.">
                                <button class="text-xs text-red-600 hover:underline ml-2">Suppr.</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
                <div class="flex flex-wrap gap-1.5 mt-2">
                    {% for k, label in ref.values %}
                        <span class="rounded-md border px-2 py-0.5 text-xs" style="border-color:var(--c-border);background:#fff">
                            {{ label }}{% if k is not same as(loop.index0) and k != label %}<span class="text-gray-400"> · {{ k }}</span>{% endif %}
                        </span>
                    {% else %}
                        <span class="text-xs" style="color:var(--c-muted)">Aucune valeur.</span>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
