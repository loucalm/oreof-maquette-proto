{% extends 'base.html.twig' %}
{% block title %}{{ 'diplome.index.title'|trans({}, 'diplome') }}{% endblock %}

{% set header_title = 'diplome.index.heading'|trans({}, 'diplome') %}
{% set header_description = 'diplome.index.description'|trans({}, 'diplome') %}
{% set header_breadcrumb = [{label: 'layout.nav.diplomes'|trans({}, 'layout')}] %}

{% block bouton_header %}
    <twig:Button variant="success" icon="ph:plus" :label="'diplome.index.new'|trans({}, 'diplome')" :href="path('diplome_wizard_start')"/>
{% endblock %}

{% block body %}

{% if pending %}
    <twig:Alerte type="warning" class="mb-4" data-pending-draft>
        <p class="font-semibold">{{ 'diplome.index.pending.title'|trans({'%label%': pending.label ?: 'diplome.index.pending.untitled'|trans({}, 'diplome')}, 'diplome') }}</p>
        <p class="mt-1 text-sm">{{ 'diplome.index.pending.help'|trans({}, 'diplome') }}</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
            <twig:Button variant="warning" :soft="false" icon="ph:arrow-right" :label="'diplome.index.pending.resume'|trans({}, 'diplome')" :href="path('diplome_wizard_start')"/>
            <form method="post" action="{{ path('diplome_wizard_discard') }}"
                  data-controller="confirm" data-confirm-message-value="{{ 'diplome.index.pending.discard_confirm'|trans({}, 'diplome') }}">
                {% include 'diplome/_csrf.html.twig' %}
                <twig:Button type="submit" variant="danger" :soft="false" :outline="true" size="sm" icon="ph:trash" :label="'diplome.index.pending.discard'|trans({}, 'diplome')"/>
            </form>
        </div>
    </twig:Alerte>
{% endif %}

<section class="rounded-xl border border-secondary-200 bg-surface shadow-sm">
    <div class="border-b border-secondary-200 p-4">
        <h2 class="flex items-center gap-2 text-lg font-semibold text-text">{{ ux_icon('ph:graduation-cap', {class: 'h-5 w-5 text-primary'}) }} {{ 'diplome.index.list_title'|trans({}, 'diplome') }}</h2>
    </div>
    <div class="overflow-x-auto p-4">
    <table class="app-table">
        <thead>
            <tr>
                <th>{{ 'diplome.index.col_label'|trans({}, 'diplome') }}</th>
                <th>{{ 'diplome.index.col_sigle'|trans({}, 'diplome') }}</th>
                <th>{{ 'diplome.index.col_based_on'|trans({}, 'diplome') }}</th>
                <th>{{ 'diplome.index.col_duration'|trans({}, 'diplome') }}</th>
                <th>{{ 'diplome.index.col_bcc'|trans({}, 'diplome') }}</th>
                <th>{{ 'diplome.index.col_formations'|trans({}, 'diplome') }}</th>
                <th>{{ 'diplome.index.col_version'|trans({}, 'diplome') }}</th>
                <th class="text-right">{{ 'formation.index.col_actions'|trans({}, 'formation') }}</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            {% set t = row.type %}
            <tr>
                <td>
                    <span class="font-medium text-text">{{ t.label }}</span>
                    {% if t.archived %}<twig:Badge variant="warning" class="ml-1" :label="'diplome.index.badge_archived'|trans({}, 'diplome')"/>{% endif %}
                </td>
                <td class="text-secondary-500">{{ t.sigle }}</td>
                <td class="text-secondary-500">{{ row.basedOn ?? '—' }}</td>
                <td class="text-secondary-500" data-col="duration">{{ row.duration ?? '—' }}</td>
                <td class="text-secondary-500" data-col="bcc">{{ row.bcc ?? '—' }}</td>
                <td class="" data-col="formations">{{ row.formations }}</td>
                <td class="text-secondary-500">{{ row.version ?? '—' }}</td>
                <td class="whitespace-nowrap">
                    <div class="flex items-center justify-end gap-2">
                    {% if row.versionId %}
                        <a href="{{ path('diplome_edit', {id: t.id, versionId: row.versionId, step: row.editStep}) }}" data-action="edit" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-secondary-400 text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white" title="{{ 'diplome.index.edit'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.index.edit'|trans({}, 'diplome') }}">{{ ux_icon('ph:pencil-simple', {class: 'icon'}) }}</a>
                        <form method="post" action="{{ path('diplome_version_new', {id: t.id}) }}">
                            {% include 'diplome/_csrf.html.twig' %}
                            <button data-action="new-version" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-secondary-400 text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white" title="{{ 'diplome.index.new_version'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.index.new_version'|trans({}, 'diplome') }}">{{ ux_icon('ph:calendar-plus', {class: 'icon'}) }}</button>
                        </form>
                        <a href="{{ path('diplome_wizard_start', {depuis: row.versionId}) }}" data-action="duplicate" class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-secondary-400 text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white" title="{{ 'diplome.index.duplicate'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.index.duplicate'|trans({}, 'diplome') }}">{{ ux_icon('ph:copy', {class: 'icon'}) }}</a>
                    {% endif %}
                    {% if t.archived %}
                        <form method="post" action="{{ path('diplome_unarchive', {id: t.id}) }}">
                            {% include 'diplome/_csrf.html.twig' %}
                            <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-secondary-400 text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white" title="{{ 'diplome.index.unarchive'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.index.unarchive'|trans({}, 'diplome') }}">{{ ux_icon('ph:box-arrow-up', {class: 'icon'}) }}</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('diplome_archive', {id: t.id}) }}"
                              data-controller="confirm" data-confirm-message-value="{{ 'diplome.index.archive_confirm'|trans({'%label%': t.label}, 'diplome') }}">
                            {% include 'diplome/_csrf.html.twig' %}
                            <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-secondary-400 text-secondary-600 transition-colors hover:bg-secondary-500 hover:text-white" title="{{ 'diplome.index.archive'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.index.archive'|trans({}, 'diplome') }}">{{ ux_icon('ph:archive-box', {class: 'icon'}) }}</button>
                        </form>
                    {% endif %}
                    {% if row.formations == 0 %}
                        <form method="post" action="{{ path('diplome_delete', {id: t.id}) }}"
                              data-controller="confirm" data-confirm-message-value="{{ 'diplome.index.delete_confirm'|trans({'%label%': t.label}, 'diplome') }}">
                            {% include 'diplome/_csrf.html.twig' %}
                            <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-danger-600 text-danger-700 transition-colors hover:bg-danger-600 hover:text-white" title="{{ 'diplome.index.delete'|trans({}, 'diplome') }}" aria-label="{{ 'diplome.index.delete'|trans({}, 'diplome') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                        </form>
                    {% else %}
                        {# suppression impossible : poubelle grisée, la raison au survol #}
                        <span class="inline-flex h-8 w-8 cursor-not-allowed items-center justify-center rounded-md border border-secondary-200 text-secondary-300"
                              title="{{ 'diplome.index.delete_blocked'|trans({'%count%': row.formations}, 'diplome') }}" aria-disabled="true" data-action="delete-blocked">{{ ux_icon('ph:trash', {class: 'icon'}) }}</span>
                    {% endif %}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="8" class="px-4 py-6 text-center text-secondary-500">{{ 'diplome.index.empty'|trans({}, 'diplome') }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</section>
{% endblock %}
