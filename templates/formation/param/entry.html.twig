{# Gabarit générique d'une entrée de fiche : les sections Formation et Parcours
   partagent la même structure ; les champs adossés à l'entité sont inclus depuis
   templates/formation/param/bound/. #}
{% import 'formation/param/_fields.html.twig' as fld %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ entryKey }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ title }}</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ breadcrumb|join(' › ') }}</div>
    </div>

    <div class="panel-scroll">
    <form method="post" action="{{ saveUrl }}" data-turbo-frame="_top"
          data-controller="autosave" data-autosave-key-value="{{ entryKey }}"
          class="panel-card space-y-5">

        {% for f in fields %}
            {% if f.type == 'separator' %}
                {{ fld.divider(f.label) }}
            {% elseif f.key in fiche.bound|keys %}
                <div>{% include 'formation/param/bound/' ~ fiche.fiche ~ '/' ~ f.key ~ '.html.twig' with {f: f, value: fiche.bound[f.key]} only %}</div>
            {% else %}
                <div>{{ fld.field(f.key, f, data, issues[f.key] ?? [], hints[f.key] ?? null) }}</div>
            {% endif %}
        {% endfor %}

        <div class="pt-2 border-t" style="border-color:var(--c-border)">
            <button data-autosave-target="submit" class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <span data-autosave-target="status" class="text-xs" style="color:var(--c-muted)" aria-live="polite"></span>
        </div>
    </form>
    </div>
</div>
</turbo-frame>
