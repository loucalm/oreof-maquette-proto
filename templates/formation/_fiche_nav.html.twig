{# Liens d'une fiche, générés depuis le canevas de la version (cf. App\Formulaire\FicheNavigation). #}
{# Les entrées du parcours unique (formation sans parcours) suivent celles de la formation, sans intertitre. #}
{% for item in items %}
    {% set navKey = (item.group ? item.group ~ '.') ~ item.key %}
    <a href="{{ item.url }}" data-turbo-frame="node-panel" data-nav-key="{{ navKey }}"
       class="nav-section flex items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-gray-50 {{ item.current ? 'is-active' }}">
        {% if item.status %}<span class="status-dot" data-status="{{ item.status }}" data-param-status-key="{{ navKey }}"></span>{% endif %}{{ item.number }} | {{ item.label }}
    </a>
{% endfor %}
