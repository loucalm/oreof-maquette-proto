{# Tête de la colonne gauche de l'éditeur (reprise de l'aside « Configuration formation » de v2) :
   title (libellé en petites capitales), name, sub, progress (variable du contexte). #}
<div class="shrink-0 border-b border-secondary-200">
    <div class="px-6 pt-4">
        <p class="text-[10px] font-black uppercase tracking-widest text-secondary-400">{{ title }}</p>
        <div class="mt-1 truncate font-bold text-secondary-900">{{ name }}</div>
        {% if sub %}<div class="truncate text-xs text-secondary-500">{{ sub }}</div>{% endif %}
    </div>
    <div class="mt-3 bg-secondary-200/70 px-6 py-4">
        {% set _full = progress >= 100 %}
        <div class="mb-2 flex items-end justify-between">
            <span class="text-[10px] font-bold uppercase tracking-widest text-secondary-500">{{ 'formation.editor.completude'|trans({}, 'formation') }}</span>
            <span class="text-xs font-bold italic {{ _full ? 'text-success-600' : 'text-warning-600' }}">{{ progress|number_format(2, ',', ' ') }}%</span>
        </div>
        <div class="h-1 w-full overflow-hidden rounded-full bg-secondary-700">
            <div class="h-full {{ _full ? 'bg-success-500' : 'bg-warning-500' }}" style="width: {{ progress }}%"></div>
        </div>
    </div>
</div>
