{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'templates' %}
{% block title %}{{ 'template.index.title'|trans({}, 'template') }}{% endblock %}

{% block admin_body %}
<div class="flex items-start justify-between gap-4">
    <div>
        <h2 class="text-lg font-bold">{{ 'template.index.heading'|trans({}, 'template') }}</h2>
        <p class="text-sm mb-5" style="color:var(--c-muted)">
            {{ 'template.index.description'|trans({'%lock_icon%': ux_icon('ph:lock-simple-fill', {class: 'icon'})}, 'template')|raw }}
        </p>
    </div>
    <form method="post" action="{{ path('template_new') }}" class="shrink-0">
        <input type="hidden" name="label" value="{{ 'template.index.new_label'|trans({}, 'template') }}">
        <button class="rounded-md px-3 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'template.index.new_button'|trans({}, 'template') }}</button>
    </form>
</div>

<div class="grid gap-4 md:grid-cols-2">
    {% for tpl in templates %}
        <a href="{{ path('template_edit', {id: tpl.id}) }}"
           class="block rounded-xl border bg-white p-4 hover:shadow-sm" style="border-color:var(--c-border)">
            <div class="flex items-center gap-2">
                <span class="font-semibold">{{ tpl.label }}</span>
                {% if tpl.diplome %}<span class="pill" style="background:var(--c-primary-soft);color:var(--c-primary)">{{ 'template.index.diplome_badge'|trans({'%diplome%': tpl.diplome}, 'template') }}</span>{% endif %}
            </div>
            <div class="text-xs mb-2" style="color:var(--c-muted)">
                <code>{{ tpl.key }}</code> · {{ tpl.avecParcours ? 'template.index.multi_parcours'|trans({}, 'template') : 'template.index.mono_parcours'|trans({}, 'template') }} · {{ 'template.index.root_count'|trans({'%count%': tpl.tree|length}, 'template') }}
            </div>
            <p class="text-sm" style="color:var(--c-muted)">{{ tpl.description }}</p>
        </a>
    {% endfor %}
</div>
{% endblock %}
