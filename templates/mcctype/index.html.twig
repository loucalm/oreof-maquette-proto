{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'mcctypes' %}
{% block title %}{{ 'mcctype.index.title'|trans({}, 'mcctype') }}{% endblock %}

{% block admin_body %}
<div class="-mx-6 -mt-6 mb-6 flex items-start justify-between gap-4 border-b border-secondary-200 px-6 py-4">
    <div>
        <h2 class="flex items-center gap-2 text-lg font-semibold text-text">{{ ux_icon(_sections[adminSection].icon, {class: 'h-5 w-5 text-primary'}) }} {{ 'mcctype.index.heading'|trans({}, 'mcctype') }}</h2>
        <p class="mt-1 text-sm text-secondary">
            {{ 'mcctype.index.description'|trans({}, 'mcctype') }}
        </p>
    </div>
    <a href="{{ path('mcctype_new') }}" data-turbo-frame="_top" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'mcctype.index.new_button'|trans({}, 'mcctype') }}</a>
</div>

<div class="rounded-xl border bg-white overflow-hidden border-secondary-200">
    <table class="w-full text-sm">
        <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600">
            <tr class="border-b border-secondary-200">
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_type'|trans({}, 'mcctype') }}</th>
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_profiles'|trans({}, 'mcctype') }}</th>
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_evaluations'|trans({}, 'mcctype') }}</th>
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_rules'|trans({}, 'mcctype') }}</th>
                <th class="px-4 py-2.5"></th>
            </tr>
        </thead>
        <tbody>
        {% for t in types %}
            <tr class="border-b border-secondary-200 last:border-0 hover:bg-secondary-50/50">
                <td class="px-4 py-2.5">
                    <span class="font-medium">{{ t.shortLabel }}</span> — {{ t.label }}
                    {% if t.system %}<span class="pill ml-1">{{ 'common.badge_socle'|trans({}, 'common') }}</span>{% endif %}
                    {% if t.description %}<div class="fld-help mt-0.5">{{ t.description }}</div>{% endif %}
                </td>
                <td class="px-4 py-2.5 text-secondary-500">{{ t.profiles is empty ? '—' : t.profiles|map(p => p.label)|join(', ') }}</td>
                <td class="px-4 py-2.5 text-secondary-500">{{ t.hasEvaluations ? t.evaluationsLabel : '—' }}</td>
                <td class="px-4 py-2.5 text-secondary-500">{{ t.profiles|reduce((carry, p) => carry + (p.rules|length), 0) }}</td>
                <td class="px-4 py-2.5 text-right whitespace-nowrap">
                    <a href="{{ path('mcctype_edit', {id: t.id}) }}" data-turbo-frame="_top" class="inline-flex items-center gap-1 rounded-md border border-warning-500 px-2 py-1 text-xs font-medium text-warning-700 transition-colors hover:bg-warning-500 hover:text-secondary-900">{{ ux_icon('ph:pencil-simple', {class: 'h-3.5 w-3.5'}) }} {{ 'common.edit'|trans({}, 'common') }}</a>
                    {% if not t.system %}
                        <form method="post" action="{{ path('mcctype_delete', {id: t.id}) }}" class="inline"
                              data-controller="confirm" data-confirm-message-value="{{ 'mcctype.index.delete_confirm'|trans({'%label%': t.label}, 'mcctype') }}">
                            <button class="text-xs text-danger-600 hover:underline ml-2">{{ 'common.delete'|trans({}, 'common') }}</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<p class="text-xs mt-3 text-secondary-500">
    {{ 'mcctype.index.footer_note'|trans({}, 'mcctype') }}
</p>
{% endblock %}
