{% import 'formation/param/_fields.html.twig' as fld %}
{% set R = 'App\\Maquette\\Referentiels' %}
{% set regimeChoices = constant(R ~ '::REGIMES_INSCRIPTION') %}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="param:{{ key }}" data-controller="modal">
    <div class="panel-head">
        <h2 class="text-xl font-bold">Gestion de la formation</h2>
        <div class="text-sm text-gray-400">{{ label }}</div>
        <div class="text-sm text-gray-400 mt-1">{{ formation.name }} › {{ label }}</div>
    </div>

    <div class="panel-scroll">
    <div class="panel-card space-y-6">

        {# ── Nombre de parcours ── #}
        {{ fld.divider('Nombre de parcours') }}
        <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" data-turbo-frame="_top" data-controller="confirm">
            <input type="hidden" name="name" value="{{ formation.name }}">
            <input type="hidden" name="diplome" value="{{ formation.diplome }}">
            <input type="hidden" name="domaine" value="{{ formation.domaine }}">
            <input type="hidden" name="composante" value="{{ formation.composante }}">
            {{ fld.label('La formation contient-elle des parcours ?', true, 'Oui → chaque parcours est un nœud racine. Non → le niveau parcours reste invisible, la formation le porte elle-même.') }}
            <p class="fld-help">⚠️ Changement important : bascule l'organisation de l'arbre existant, confirmation demandée.</p>
            <div class="flex flex-wrap gap-8 mt-2 text-sm">
                <label class="flex items-center gap-2">
                    <input type="radio" name="multiParcours" value="1" {{ formation.multiParcours ? 'checked' }}
                           data-confirm-target="restore" data-confirm-checked="{{ formation.multiParcours ? '1' : '0' }}"
                           data-action="change->confirm#confirmChange"
                           data-confirm-message-param="⚠️ Passer en multi-parcours va rassembler les nœuds actuels de la formation dans un nouveau parcours. Continuer ?">
                    Oui (options)
                </label>
                <label class="flex items-center gap-2">
                    <input type="radio" name="multiParcours" value="0" {{ not formation.multiParcours ? 'checked' }}
                           data-confirm-target="restore" data-confirm-checked="{{ not formation.multiParcours ? '1' : '0' }}"
                           data-action="change->confirm#confirmChange"
                           data-confirm-message-param="⚠️ Passer en mono-parcours va supprimer le(s) parcours et remonter leurs nœuds à la racine de la formation. Continuer ?">
                    Non (mono-parcours)
                </label>
            </div>
        </form>

        {# ── Dimension temporelle ── #}
        {{ fld.divider('Dimension temporelle') }}
        {% set unit = period_unit(formation) %}
        <p class="text-xs text-gray-500 -mt-2">
            Sur combien de temps la formation se déroule : 3 ans, 6 mois, 12 semaines…
            Par défaut l'unité suit le type du 1er niveau du squelette (actuellement <strong>{{ unit }}</strong>) ;
            renseigne un libellé pour le forcer.
        </p>
        <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" data-turbo-frame="_top" class="grid gap-4 sm:grid-cols-2">
            <input type="hidden" name="name" value="{{ formation.name }}">
            <input type="hidden" name="diplome" value="{{ formation.diplome }}">
            <input type="hidden" name="domaine" value="{{ formation.domaine }}">
            <input type="hidden" name="composante" value="{{ formation.composante }}">
            <input type="hidden" name="multiParcours" value="{{ formation.multiParcours ? '1' : '0' }}">
            <input type="hidden" name="ectsTotal" value="{{ formation.ectsTotal }}">
            <div>
                {{ fld.label('Unité de temps', false, 'Vide = ' ~ unit) }}
                <input name="calendarUnit" value="{{ formation.calendarUnit }}" placeholder="{{ unit }}" class="fld mt-1">
            </div>
            <div>
                {{ fld.label('Durée (nombre de ' ~ unit|lower ~ 's)', false, 'Vide = déduit de l’arbre / des parcours') }}
                <div class="flex items-end gap-2">
                    <input type="number" min="1" name="calendarSpan" value="{{ formation.calendarSpan }}" class="fld mt-1">
                    <button class="rounded-lg px-3 py-2 text-sm font-semibold text-white shrink-0" style="background:var(--c-primary)">OK</button>
                </div>
            </div>
        </form>

        {# ── Propriétés du parcours invisible (mono-parcours) ── #}
        {% if formation.isMono %}
            {{ fld.divider('Propriétés formation mono-parcours') }}
            <p class="text-xs text-gray-500 -mt-2">
                Ces propriétés seraient portées par un nœud <span class="type-badge">🧭 Parcours</span> ; en mono-parcours ce nœud
                est <strong>invisible et verrouillé</strong> : la formation les porte directement.
            </p>
            <form method="post" action="{{ path('formation_settings', {id: formation.id}) }}" data-turbo-frame="_top" class="space-y-4">
                <input type="hidden" name="name" value="{{ formation.name }}">
                <input type="hidden" name="diplome" value="{{ formation.diplome }}">
                <input type="hidden" name="domaine" value="{{ formation.domaine }}">
                <input type="hidden" name="multiParcours" value="0">

                <div>
                    {{ fld.label('Intitulé de mono parcours', false, "Si laissé vide, celui de la formation servira d'intitulé") }}
                    {{ fld.text('intituleMono', data.intituleMono ?? '') }}
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <div>
                        {{ fld.label("Volume d'ECTS total", true, "Cela servira à vérifier le total d'ECTS de votre formation mono-parcours") }}
                        <input type="number" name="ectsTotal" value="{{ formation.ectsTotal }}" class="fld mt-1">
                    </div>
                    <div>
                        {{ fld.label("Composante d'inscription", true, "Composante(s) à laquelle les étudiants pourront s'inscrire") }}
                        <input name="composante" value="{{ formation.composante }}" class="fld mt-1">
                        <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">＋ Ajouter une composante d'inscription</span></div>
                    </div>
                </div>

                <div>
                    {{ fld.label("Régime(s) d'inscription", true, "Choix multiples") }}
                    <div class="grid gap-2 sm:grid-cols-2 mt-2 text-sm">
                        {% set curRegimes = data.regimes ?? [] %}
                        {% for rv, rl in regimeChoices %}
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="regimes[]" value="{{ rv }}" {{ rv in curRegimes ? 'checked' }}> {{ rl }}
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div>
                    {{ fld.label("Précisez les modalités de l'alternance", true) }}
                    {{ fld.textarea('modalitesAlternance', data.modalitesAlternance ?? '', 'Indiquez en 3000 caractères maximum les périodes et leurs durées en centre ou en entreprise.') }}
                </div>

                <div>
                    {{ fld.label("Langue d'enseignement", true, "Langue dans laquelle sont dispensés les cours (à l'exception des cours de langue)") }}
                    {{ fld.select('langue', data.langue ?? '', constant(R ~ '::LANGUES')) }}
                    <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">＋ Ajouter une langue</span></div>
                </div>

                {{ fld.divider('Et après…') }}

                <div>
                    {{ fld.label("Poursuite d'études envisageables", true) }}
                    {{ fld.textarea('poursuiteEtudes', data.poursuiteEtudes ?? '', 'Indiquez en 3000 caractères maximum quelles sont les poursuites d’études envisageables.') }}
                </div>
                <div>
                    {{ fld.label('Débouchés', true) }}
                    {{ fld.textarea('debouches', data.debouches ?? '', 'Indiquez les principaux débouchés professionnels accessibles à l’issue de cette formation.') }}
                </div>
                <div>
                    {{ fld.label('Code(s) ROME', true, 'Ajoutez les codes ROME pour préciser les métiers accessibles aux diplômés.') }}
                    {{ fld.select('codesRome', data.codesRome ?? '', constant(R ~ '::CODES_ROME')) }}
                    <div class="text-right mt-1"><span class="text-xs text-gray-400 cursor-default">＋ Ajouter un code ROME</span></div>
                </div>

                <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">Enregistrer</button>
            </form>
        {% endif %}

        {# ── Structure : la hiérarchie des TYPES de nœud ── #}
        {{ fld.divider('Structure') }}

        {% if not is_admin() %}
            {# vue responsable : la hiérarchie des niveaux est imposée, lecture seule #}
            <p class="text-xs text-gray-500 -mt-2">
                La hiérarchie des niveaux est définie par le diplôme (administrateur SES). Vous construisez
                l'arbre à l'intérieur de ce cadre depuis l'éditeur.
            </p>
            <div class="flex flex-wrap items-center gap-1.5">
                {% for row in structure_rows(formation) %}
                    {% if not loop.first %}<span class="text-gray-300">›</span>{% endif %}
                    <span class="type-badge">{{ row.type ? row.type.icon }} [{{ row.type ? row.type.label : row.key }}]</span>
                    {%- if row.mono %}<span class="text-[11px] text-gray-400">(porté par la formation)</span>{% endif -%}
                {% endfor %}
            </div>
        {% else %}
        <p class="text-xs text-gray-500 -mt-2">
            Définissez la hiérarchie : chaque ligne est le type des enfants de la ligne du dessus.
            L'éditeur ne proposera que ces types lors de la construction de l'arbre.
        </p>

        {% set rows = structure_rows(formation) %}
        {% set body_keys = rows|filter(r => not r.fixed)|map(r => r.key) %}
        {% set addable = structure_addable(formation) %}

        <div class="overflow-hidden rounded-lg border" style="border-color:var(--c-border)">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
                    <tr>
                        <th class="w-8"></th>
                        <th class="text-left px-3 py-2.5">Ordre</th>
                        <th class="text-left px-3 py-2.5">Type de nœud</th>
                        <th class="text-right px-4 py-2.5">Actions</th>
                    </tr>
                </thead>
                <tbody data-controller="chain" data-chain-save-url-value="{{ path('formation_structure_save', {id: formation.id}) }}">
                {% for row in rows %}
                    <tr class="border-t" style="border-color:var(--c-border)"
                        {{ not row.fixed ? 'data-chain-key=' ~ row.key }}>
                        <td class="px-2 text-center text-gray-300">
                            {% if not row.fixed %}<span class="drag-handle" title="Glisser pour réordonner">⠿</span>{% endif %}
                        </td>
                        <td class="px-3 py-2.5 text-gray-400">{{ loop.index0 }}</td>
                        <td class="px-3 py-2.5">
                            <span class="type-badge">{{ row.type ? row.type.icon : '❓' }} [{{ row.type ? row.type.label : row.key }}]</span>
                            {% if row.mono %}<span class="pill ml-1">invisible · porté par la formation</span>
                            {% elseif row.fixed %}<span class="pill ml-1">racine · figé</span>{% endif %}
                            {% if loop.index0 > 0 %}
                                <span class="text-[11px] text-gray-400 ml-1">
                                    {{- rows[loop.index0 - 1].mono ? 'racine visible de l\'arbre' : 'enfant de ' ~ (rows[loop.index0 - 1].type ? rows[loop.index0 - 1].type.label : rows[loop.index0 - 1].key) -}}
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-2.5 text-right whitespace-nowrap">
                            {% if row.type and not row.mono %}
                                <a href="{{ path('node_type_edit', {id: row.type.id}) }}" target="_blank" class="text-xs hover:underline">Modifier</a>
                            {% endif %}
                            {% if not row.fixed %}
                                <form method="post" action="{{ path('formation_structure_save', {id: formation.id}) }}" data-turbo-frame="_top" class="inline ml-3"
                                      data-controller="confirm" data-confirm-message-value="Retirer « {{ row.type ? row.type.label : row.key }} » du squelette ? (les nœuds déjà créés ne sont pas supprimés)">
                                    {% for k in body_keys|filter(k => k != row.key) %}<input type="hidden" name="chain[]" value="{{ k }}">{% endfor %}
                                    <button class="text-xs text-red-600 hover:underline">Retirer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="border-t" style="border-color:var(--c-border)">
                        <td colspan="4" class="px-4 py-3 text-center" style="background:#f0fdf4">
                            <button type="button" data-action="modal#open" class="text-sm font-medium text-green-700 hover:underline">＋ Ajouter un nœud</button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {# ── modale « Ajouter un nœud » ── #}
        <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
                class="rounded-2xl border-0 p-0 w-[min(440px,92vw)] backdrop:bg-black/40">
            <form method="post" action="{{ path('formation_structure_save', {id: formation.id}) }}" data-turbo-frame="_top" class="p-6 space-y-4">
                {% for k in body_keys %}<input type="hidden" name="chain[]" value="{{ k }}">{% endfor %}
                <h3 class="text-lg font-bold">Ajouter un nœud</h3>
                <div>
                    {{ fld.label('Nœud', true, 'Peut être changé plus tard') }}
                    <select name="chain[]" required class="fld mt-1">
                        <option value="">— Choisir —</option>
                        {% for t in addable %}<option value="{{ t.key }}">{{ t.icon }} {{ t.label }}</option>{% endfor %}
                    </select>
                    {% if addable is empty %}
                        <p class="fld-help">Tous les types disponibles sont déjà dans le squelette. Créez-en de nouveaux dans <a href="{{ path('node_type_index') }}" target="_blank" class="underline">les types de nœud</a>.</p>
                    {% endif %}
                </div>
                <div class="flex items-center justify-end gap-2 pt-1">
                    <button type="button" data-action="modal#close" class="rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">Annuler</button>
                    <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--st-ok)">＋ Ajouter</button>
                </div>
            </form>
        </dialog>
        <p class="text-xs text-gray-400">
            {{ nodeCount }} nœud(s) déjà construit(s) dans l'arbre ·
            les types sont gérés par les administrateurs —
            <a href="{{ path('node_type_index') }}" target="_blank" class="underline">voir / éditer les types</a>.
        </p>

        {# ── Charger un template ── #}
        {{ fld.divider('Charger un template') }}
        <form method="post" action="{{ path('formation_apply_template', {id: formation.id}) }}" data-turbo-frame="_top"
              data-controller="confirm" data-confirm-message-value="⚠️ Charger ce template ÉCRASE le squelette ET les nœuds actuels. Continuer ?"
              class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-[220px]">
                <select name="template" class="fld">
                    {% for tpl in templates %}<option value="{{ tpl.key }}">{{ tpl.label }}</option>{% endfor %}
                </select>
            </div>
            <button class="rounded-lg border px-4 py-2.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">Charger</button>
        </form>
        <p class="text-xs text-gray-400">
            Un template fixe le squelette et pré-remplit un arbre de départ, ensuite librement modifiable —
            <a href="{{ path('template_index') }}" target="_blank" class="underline">liste des templates</a>.
        </p>

        {# ── enregistrer / vider ── #}
        <div class="flex flex-wrap items-center gap-3 pt-2 border-t" style="border-color:var(--c-border)">
            <form method="post" action="{{ path('template_from_formation', {id: formation.id}) }}" data-turbo-frame="_top" class="flex items-end gap-2">
                <input name="label" placeholder="Nom du template" required class="fld w-52">
                <button class="rounded-lg border px-3 py-2.5 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border)">💾 Enregistrer comme template</button>
            </form>
            <form method="post" action="{{ path('formation_reset', {id: formation.id}) }}" data-turbo-frame="_top" class="ml-auto"
                  data-controller="confirm" data-confirm-message-value="Vider tous les nœuds de l'arbre ? (le squelette et les nœuds imposés sont conservés)">
                <button class="rounded-lg border px-3 py-2.5 text-sm text-red-600 hover:bg-red-50" style="border-color:var(--c-border)">🗑 Vider les nœuds</button>
            </form>
        </div>
        {% endif %}
    </div>
    </div>
</div>
</turbo-frame>
