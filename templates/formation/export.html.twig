{% extends 'base.html.twig' %}
{% block title %}Export · {{ formation.name }}{% endblock %}

{% block body %}
<div data-controller="json">
    <div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
        <div class="flex items-start justify-between gap-4">
            <div>
                <div class="text-xs text-gray-400">
                    {{ ux_icon('ph:house', {class: 'icon'}) }} <span class="fake-link">Accueil</span> ›
                    <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formation</a> ›
                    <a href="{{ path('formation_editor', {id: formation.id}) }}" class="hover:underline">{{ formation.name }}</a> ›
                    Export
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight mt-1">Export JSON — {{ formation.name }}</h1>
                <p class="text-sm text-gray-500">Structure de stockage de la maquette (aperçu).</p>
            </div>
            <a href="{{ path('formation_editor', {id: formation.id}) }}"
               class="rounded-lg border px-3 py-2 text-sm hover:bg-gray-50 shrink-0" style="border-color:var(--c-border)">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} Éditeur</a>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
            <div class="inline-flex rounded-lg border overflow-hidden text-sm" style="border-color:var(--c-border)">
                <a href="{{ path('formation_export', {id: formation.id, view: 'raw'}) }}"
                   class="px-3 py-1.5 {{ view == 'raw' ? 'font-semibold text-white' : 'hover:bg-gray-50' }}"
                   style="{{ view == 'raw' ? 'background:var(--c-primary)' }}">Brut · 3 documents stockés</a>
                <a href="{{ path('formation_export', {id: formation.id, view: 'enriched'}) }}"
                   class="px-3 py-1.5 border-l {{ view == 'enriched' ? 'font-semibold text-white' : 'hover:bg-gray-50' }}"
                   style="border-color:var(--c-border);{{ view == 'enriched' ? 'background:var(--c-primary)' }}">Enrichi · arbre calculé</a>
            </div>

            <span class="text-xs text-gray-400">
                {{ view == 'raw'
                    ? 'parametres (props formation) · dataParcours (props parcours) · arbre (structure + BCC + données des nœuds)'
                    : 'libellés de type résolus, référence hiérarchique, agrégats heures / ECTS, statut' }}
            </span>

            <div class="ml-auto flex items-center gap-2">
                <button type="button" data-action="json#copy" data-json-target="btn"
                        class="rounded-lg border px-3 py-1.5 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:copy', {class: 'icon'}) }} Copier</button>
                <a href="{{ path('formation_export_json', {id: formation.id, view: view}) }}"
                   class="rounded-lg border px-3 py-1.5 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:download-simple', {class: 'icon'}) }} Télécharger .json</a>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
        <pre class="json-view"><code data-json-target="src">{{ json }}</code></pre>
    </div>
</div>
{% endblock %}
