{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'mcctypes' %}
{% block title %}{{ 'mcctype.index.title'|trans({}, 'mcctype') }}{% endblock %}

{% block admin_body %}
<div class="flex items-start justify-between mb-5">
    <div>
        <h2 class="text-lg font-bold">{{ 'mcctype.index.heading'|trans({}, 'mcctype') }}</h2>
        <p class="text-sm" style="color:var(--c-muted)">
            {{ 'mcctype.index.description'|trans({}, 'mcctype') }}
        </p>
    </div>
    <a href="{{ path('mcctype_new') }}" data-turbo-frame="_top" class="rounded-md px-3 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'mcctype.index.new_button'|trans({}, 'mcctype') }}</a>
</div>

<div class="rounded-xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
    <table class="w-full text-sm">
        <thead class="text-xs uppercase tracking-wide" style="color:var(--c-muted)">
            <tr class="border-b" style="border-color:var(--c-border)">
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_type'|trans({}, 'mcctype') }}</th>
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_profiles'|trans({}, 'mcctype') }}</th>
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_evaluations'|trans({}, 'mcctype') }}</th>
                <th class="text-left px-4 py-2.5">{{ 'mcctype.index.col_rules'|trans({}, 'mcctype') }}</th>
                <th class="px-4 py-2.5"></th>
            </tr>
        </thead>
        <tbody>
        {% for t in types %}
            <tr class="border-b last:border-0" style="border-color:var(--c-border)">
                <td class="px-4 py-2.5">
                    <span class="font-medium">{{ t.shortLabel }}</span> — {{ t.label }}
                    {% if t.system %}<span class="pill ml-1">{{ 'common.badge_socle'|trans({}, 'common') }}</span>{% endif %}
                    {% if t.description %}<div class="fld-help mt-0.5">{{ t.description }}</div>{% endif %}
                </td>
                <td class="px-4 py-2.5" style="color:var(--c-muted)">{{ t.profiles is empty ? '—' : t.profiles|map(p => p.label)|join(', ') }}</td>
                <td class="px-4 py-2.5" style="color:var(--c-muted)">{{ t.hasEvaluations ? t.evaluationsLabel : '—' }}</td>
                <td class="px-4 py-2.5" style="color:var(--c-muted)">{{ t.profiles|reduce((carry, p) => carry + (p.rules|length), 0) }}</td>
                <td class="px-4 py-2.5 text-right whitespace-nowrap">
                    <a href="{{ path('mcctype_edit', {id: t.id}) }}" data-turbo-frame="_top" class="text-xs hover:underline">{{ 'common.edit'|trans({}, 'common') }}</a>
                    {% if not t.system %}
                        <form method="post" action="{{ path('mcctype_delete', {id: t.id}) }}" class="inline"
                              data-controller="confirm" data-confirm-message-value="{{ 'mcctype.index.delete_confirm'|trans({'%label%': t.label}, 'mcctype') }}">
                            <button class="text-xs text-red-600 hover:underline ml-2">{{ 'common.delete'|trans({}, 'common') }}</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<p class="text-xs mt-3" style="color:var(--c-muted)">
    {{ 'mcctype.index.footer_note'|trans({}, 'mcctype') }}
</p>
{% endblock %}
