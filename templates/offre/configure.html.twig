{% extends 'base.html.twig' %}
{% import 'offre/_macros.html.twig' as o %}
{% set f = offre.formation %}
{% block title %}{{ 'offre.configure_title'|trans({'%name%': f.name}, 'offre') }}{% endblock %}

{% set header_title = f.name %}
{% set header_description = (offre.typeLabel ?: '—') ~ ' · ' ~ (offre.composante ?: 'offre.no_composante'|trans({}, 'offre')) ~ (f.anneeUniversitaire ? ' · ' ~ f.anneeUniversitaire) %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: 'offre.title'|trans({}, 'offre'), url: path('offre_index')},
    {label: f.name},
] %}

{% block bouton_header %}
    <twig:Button variant="warning" :soft="false" :outline="true" icon="ph:pencil-simple" :label="'offre.open_editor'|trans({}, 'offre')" :href="path('formation_editor', {id: f.id})"/>
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'offre.back'|trans({}, 'offre')" :href="path('offre_index')"/>
{% endblock %}

{% block body %}
{% if f.phase.value == 'consolidation' %}
        <div class="mb-4 flex flex-wrap items-center gap-3 rounded-2xl border border-warning-200 bg-warning-50 px-4 py-3 text-sm" data-consolidation>
            <span class="text-warning-800">{{ ux_icon('ph:hourglass-medium', {class: 'icon'}) }} {{ 'offre.consolidation_help'|trans({}, 'offre') }}</span>
            <form method="post" action="{{ path('formation_phase_batch') }}" class="ml-auto"
                  data-controller="confirm" data-confirm-message-value="{{ 'formation.index.batch_construction_confirm'|trans({}, 'formation') }}">
                <input type="hidden" name="ids[]" value="{{ f.id }}">
                <button class="inline-flex items-center justify-center gap-1.5 rounded-md border border-secondary-300 bg-secondary-50 font-medium text-secondary-600 transition-colors hover:bg-secondary-100 hover:text-secondary-800 px-3 py-1.5 text-sm">{{ ux_icon('ph:arrow-right', {class: 'icon'}) }} {{ 'offre.to_construction'|trans({}, 'offre') }}</button>
            </form>
        </div>
    {% endif %}

<form method="post" action="{{ path('offre_configure_save', {id: f.id}) }}" data-controller="dirty-form">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mb-4">
        {{ o.kpi('offre.kpi.ouverts'|trans({}, 'offre'), (offre.parcours|filter(p => p.ouvert)|length) ~ ' / ' ~ offre.parcours|length, 'success', 'ph:check-circle', 'offre.kpi.ouverts_help'|trans({}, 'offre')) }}
        {{ o.kpi('offre.kpi.plateformes'|trans({}, 'offre'), offre.plateformes|length, 'primary', 'ph:globe', 'offre.kpi.plateformes_help'|trans({}, 'offre')) }}
        {{ o.kpi('offre.kpi.capacite'|trans({}, 'offre'), offre.capacite, 'info', 'ph:users', 'offre.kpi.capacite_help'|trans({}, 'offre'), 'offre.places'|trans({}, 'offre')) }}
        {{ o.kpi('offre.kpi.anomalies'|trans({}, 'offre'), offre.anomalies|length, offre.anomalies is empty ? 'muted' : 'warning', offre.anomalies is empty ? 'ph:check-circle' : 'ph:warning', 'offre.kpi.anomalies_help'|trans({}, 'offre')) }}
    </div>

    <div class="rounded-2xl border bg-white px-6 py-5 mb-4 border-secondary-200">
        <h2 class="font-semibold mb-3">{{ 'offre.check_title'|trans({}, 'offre') }}</h2>
        {% if offre.anomalies is empty %}
            <p class="text-sm text-success-700">{{ ux_icon('ph:check-circle', {class: 'icon'}) }} {{ 'offre.check_ok'|trans({}, 'offre') }}</p>
        {% else %}
            <ul class="list-disc pl-5 text-sm text-warning-800 space-y-0.5" data-offre-anomalies>
                {% for a in offre.anomalies %}<li>{{ a }}</li>{% endfor %}
            </ul>
        {% endif %}
        <div class="mt-4 flex flex-wrap items-center gap-2 border-t pt-3 text-sm border-secondary-200">
            <span class="text-secondary-500">{{ 'offre.col.statut'|trans({}, 'offre') }} :</span> {{ o.statut(offre.statut) }} {{ o.documents(offre) }}
            <span class="text-xs text-secondary-400">{{ 'offre.statut_note'|trans({}, 'offre') }}</span>
            <button class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm ml-auto">{{ 'common.save'|trans({}, 'common') }}</button>
        </div>
    </div>

    {% for p in offre.parcours %}
        <section class="rounded-2xl border bg-white px-6 py-5 mb-4 border-secondary-200" data-offre-parcours="{{ p.nid }}">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h2 class="text-lg font-bold">{{ ux_icon('ph:stack', {class: 'icon'}) }} {{ p.nid == '_formation' ? 'offre.annees_formation'|trans({}, 'offre') : p.label }}</h2>
                    {% if p.chemin %}<div class="text-xs text-secondary-400">{{ 'offre.chemin'|trans({'%chemin%': p.chemin}, 'offre') }}</div>{% endif %}
                </div>
                <label class="flex items-center gap-2 text-sm">
                    <span class="text-secondary-500">{{ 'offre.ouverture_label'|trans({}, 'offre') }}</span>
                    <select name="parcours[{{ p.nid }}][ouverture]" class="fld" style="width:auto">
                        {% for v in ['ouvert', 'non_ouvert', 'fermeture'] %}
                            <option value="{{ v }}" {{ p.ouverture == v ? 'selected' }}>{{ ('offre.ouverture.' ~ v)|trans({}, 'offre') }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>

            {% if p.annees is empty %}
                <p class="mt-3 text-sm text-secondary-400">{{ 'offre.no_annees'|trans({}, 'offre') }}</p>
            {% else %}
                <table class="mt-3 w-full text-sm">
                    <thead class="bg-secondary-50 text-left text-[11px] font-semibold uppercase tracking-wider text-secondary-600">
                        <tr class="border-b border-secondary-200">
                            <th class="text-left py-2">{{ 'offre.col.annee'|trans({}, 'offre') }}</th>
                            <th class="text-center py-2 px-3">{{ 'offre.col.ouverte'|trans({}, 'offre') }}</th>
                            <th class="text-left py-2 px-3">{{ 'offre.col.capacite_accueil'|trans({}, 'offre') }}</th>
                            <th class="text-left py-2 px-3">{{ 'offre.col.plateformes'|trans({}, 'offre') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for a in p.annees %}
                        {# une année commune se saisit une fois : la ligne des autres parcours y renvoie #}
                        {% set first = offre.parcours|filter(q => a.nid in q.annees|map(x => x.nid))|first %}
                        <tr class="border-b border-secondary-200 last:border-0 hover:bg-secondary-50/50" data-offre-annee="{{ a.nid }}">
                            <td class="py-2">
                                {{ a.label }}
                                {% if a.partage %}<span class="ml-1">{{ o.badge('offre.annee_commune'|trans({'%count%': a.partage}, 'offre'), 'info', 'ph:users-three') }}</span>{% endif %}
                            </td>
                            {% if first.nid == p.nid %}
                                <td class="py-2 px-3 text-center">
                                    <input type="hidden" name="annees[{{ a.nid }}][ouvert]" value="0">
                                    <input type="checkbox" name="annees[{{ a.nid }}][ouvert]" value="1" {{ a.ouvert ? 'checked' }} aria-label="{{ 'offre.col.ouverte'|trans({}, 'offre') }} — {{ a.label }}">
                                </td>
                                <td class="py-2 px-3">
                                    <div class="relative w-32">
                                        <input type="number" min="0" step="1" name="annees[{{ a.nid }}][capacite]" value="{{ a.capacite }}" class="fld pr-12" aria-label="{{ 'offre.col.capacite_accueil'|trans({}, 'offre') }} — {{ a.label }}">
                                        <span class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-xs text-secondary-400">{{ 'offre.places'|trans({}, 'offre') }}</span>
                                    </div>
                                </td>
                                <td class="py-2 px-3">
                                    <input type="hidden" name="annees[{{ a.nid }}][plateformes][]" value="">
                                    {% for pl in a.plateformes %}
                                        <label class="mr-3 inline-flex items-center gap-1.5"><input type="checkbox" name="annees[{{ a.nid }}][plateformes][]" value="{{ pl.key }}" {{ pl.active ? 'checked' }}> {{ pl.label }}</label>
                                    {% else %}
                                        <span class="text-xs text-secondary-400">—</span>
                                    {% endfor %}
                                </td>
                            {% else %}
                                <td colspan="3" class="py-2 px-3 text-xs text-secondary-400">{{ 'offre.annee_saisie_ailleurs'|trans({'%parcours%': first.label}, 'offre') }}</td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    {% endfor %}

    <div class="flex justify-end">
        <button class="inline-flex items-center justify-center gap-1.5 rounded-md border border-transparent bg-primary-600 font-medium text-white transition-colors hover:bg-primary-700 px-3 py-1.5 text-sm">{{ 'common.save'|trans({}, 'common') }}</button>
    </div>
</form>
{% endblock %}
