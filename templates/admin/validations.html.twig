{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'validations' %}
{% block title %}{{ 'admin.validations.title'|trans({}, 'admin') }}{% endblock %}

{% block admin_body %}
<div class="mb-5">
    <h2 class="text-lg font-bold">{{ 'admin.validations.heading'|trans({}, 'admin') }}</h2>
    <p class="text-sm text-gray-500">{{ 'admin.validations.description'|trans({}, 'admin') }}</p>
</div>

<div class="space-y-4">
    {% for row in rows %}
        <div class="rounded-xl border bg-white p-5 space-y-3" style="border-color:var(--c-border)">
            <div class="flex items-start justify-between gap-3">
                <div class="font-semibold">{{ ux_icon(row.type.icon ?: 'ph:puzzle-piece', {class: 'icon'}) }} {{ row.type.label }} <code class="text-xs font-normal" style="color:var(--c-muted)">{{ row.type.key }}</code></div>
                <a href="{{ path('node_type_edit', {id: row.type.id}) }}" data-turbo-frame="_top" class="shrink-0 text-xs hover:underline">{{ 'common.edit'|trans({}, 'common') }}</a>
            </div>
            {% for r in row.rules %}
                <div class="flex items-start gap-2 text-sm">
                    <span class="pill shrink-0">{{ r.tab }}</span>
                    <span>{{ r.text }}</span>
                </div>
            {% endfor %}
            {% if row.bounded is not empty %}
                <div class="text-xs" style="color:var(--c-muted)">
                    {{ 'admin.validations.bounds_label'|trans({}, 'admin') }}
                    {% for f in row.bounded %}
                        <span class="pill">{{ f.label }} : {{ f.min is not null ? 'min ' ~ f.min }}{{ f.min is not null and f.max is not null ? ' · ' }}{{ f.max is not null ? 'max ' ~ f.max }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="rounded-xl border border-dashed p-8 text-center text-sm text-gray-500" style="border-color:var(--c-border)">
            {{ 'admin.validations.empty'|trans({}, 'admin') }}
        </div>
    {% endfor %}
</div>
{% endblock %}
