{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'node_type.edit.new_title'|trans({}, 'node_type') : nodeType.label }}{% endblock %}

{# ─── formulaire partagé pour ajouter/éditer un champ du formulaire associé ─── #}
{# Les réglages affichés dépendent du type choisi : c'est le registre des types
   (App\FieldType, cf. fieldTypesConfig) qui dit lesquels, pas ce gabarit. #}
{% macro fieldForm(action, field, referentiels, fieldTypes, fieldTypesConfig, submitLabel, togglableDefault) %}
    <form method="post" action="{{ action }}" class="grid grid-cols-2 gap-x-3 gap-y-2 rounded-md border p-3" style="border-color:var(--c-border)"
          data-controller="field-config"
          data-field-config-types-value="{{ fieldTypesConfig|json_encode }}"
          data-field-config-bounds-labels-value="{{ {
              value: ['node_type.edit.field_min_value'|trans({}, 'node_type'), 'node_type.edit.field_max_value'|trans({}, 'node_type'), 'node_type.edit.field_bounds_help_number'|trans({}, 'node_type')],
              length: ['node_type.edit.field_min_length'|trans({}, 'node_type'), 'node_type.edit.field_max_length'|trans({}, 'node_type'), 'node_type.edit.field_bounds_help_text'|trans({}, 'node_type')],
              count: ['node_type.edit.field_min_count'|trans({}, 'node_type'), 'node_type.edit.field_max_count'|trans({}, 'node_type'), 'node_type.edit.field_bounds_help_count'|trans({}, 'node_type')],
          }|json_encode }}">
        <label class="block">
            <span class="text-xs font-medium">{{ 'node_type.edit.field_type_field'|trans({}, 'node_type') }}</span>
            <select name="type" data-field-config-target="type" data-action="field-config#update" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                {% for k, lbl in fieldTypes %}<option value="{{ k }}" {{ (field.type ?? 'text') == k ? 'selected' }}>{{ lbl }}</option>{% endfor %}
            </select>
        </label>
        <label class="block">
            <span class="text-xs font-medium">{{ 'node_type.edit.field_label_field'|trans({}, 'node_type') }}</span>
            <input name="label" value="{{ field.label ?? '' }}" required class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
        </label>
        {% if field is null %}
            <label class="block">
                <span class="text-xs font-medium">{{ 'node_type.edit.field_key_field'|trans({}, 'node_type') }}</span>
                <input name="key" list="existing-field-keys" placeholder="{{ 'node_type.edit.field_key_placeholder'|trans({}, 'node_type') }}" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'node_type.edit.field_tab_field'|trans({}, 'node_type') }}</span>
                <input name="tab" value="props" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
            </label>
        {% endif %}
        <label class="flex items-center gap-2 text-sm pt-4">
            <input type="checkbox" name="required" value="1" {{ (field.required ?? false) ? 'checked' }}>
            {{ 'node_type.edit.field_required_label'|trans({}, 'node_type') }}
        </label>
        <label class="block col-span-2">
            <span class="text-xs font-medium">{{ 'node_type.edit.field_help_field'|trans({}, 'node_type') }}</span>
            <input name="help" value="{{ field.help ?? '' }}" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
        </label>
        <label class="block" data-field-config-target="setting" data-setting="referentiel">
            <span class="text-xs font-medium">{{ 'node_type.edit.field_referentiel_field'|trans({}, 'node_type') }}</span>
            <select name="referentielKey" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                <option value="">{{ 'node_type.edit.field_referentiel_none'|trans({}, 'node_type') }}</option>
                {% for r in referentiels %}<option value="{{ r.key }}" {{ (field.referentielKey ?? '') == r.key ? 'selected' }}>{{ r.label }}</option>{% endfor %}
            </select>
            <span class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.field_referentiel_help'|trans({}, 'node_type') }}</span>
        </label>
        <div class="flex flex-col gap-1 justify-end pb-1">
            <label class="flex items-center gap-2 text-sm" data-field-config-target="setting" data-setting="allowExtra">
                <input type="checkbox" name="allowExtra" value="1" {{ (field.allowExtra ?? false) ? 'checked' }}>
                {{ 'node_type.edit.field_allow_extra_label'|trans({}, 'node_type') }}
            </label>
            <label class="flex items-center gap-2 text-sm" data-field-config-target="setting" data-setting="quickAdd">
                <input type="checkbox" name="quickAdd" value="1" {{ (field.quickAdd ?? false) ? 'checked' }}>
                {{ 'node_type.edit.field_quick_add_label'|trans({}, 'node_type') }}
            </label>
        </div>
        {# bornes : leur sens dépend du type (valeur, longueur, nombre de choix) ; masquées si le type n'en a pas #}
        <div class="col-span-2 grid grid-cols-2 gap-x-3" data-field-config-target="bounds">
            <label class="block">
                <span class="text-xs font-medium" data-field-config-target="minLabel">{{ 'node_type.edit.field_min_field'|trans({}, 'node_type') }}</span>
                <input type="number" step="any" name="min" value="{{ field.min ?? '' }}" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium" data-field-config-target="maxLabel">{{ 'node_type.edit.field_max_field'|trans({}, 'node_type') }}</span>
                <input type="number" step="any" name="max" value="{{ field.max ?? '' }}" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
            </label>
            <span class="col-span-2 text-[11px]" style="color:var(--c-muted)" data-field-config-target="boundsHelp"></span>
        </div>
        {% if field is null %}
            <label class="block col-span-2" data-field-config-target="setting" data-setting="options">
                <span class="text-xs font-medium">{{ 'node_type.edit.field_options_field'|trans({}, 'node_type')|raw }}</span>
                <textarea name="options" rows="3" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm font-mono" style="border-color:var(--c-border)"></textarea>
            </label>
        {% endif %}
        <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="togglable" value="1" {{ togglableDefault ? 'checked' }}>
            {{ 'node_type.edit.field_togglable_label'|trans({}, 'node_type') }}
        </label>
        <div class="col-span-2 flex justify-end">
            <button class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ submitLabel }}</button>
        </div>
    </form>
{% endmacro %}

{# ─── règles de validation d'un onglet : s'ajoutent aux champs obligatoires, pilotent la pastille de l'onglet ─── #}
{% macro tabRules(nodeType, tab, fields, form, tabRules) %}
    {% set inputs = fields|filter(f => f.type != 'separator') %}
    {% set allInputs = [] %}
    {% for t, fs in form %}{% set allInputs = allInputs|merge(fs|filter(f => f.type != 'separator')) %}{% endfor %}
    {% set fld = 'mt-1 w-full rounded-md border px-2 py-1.5 text-sm' %}
    <details class="mt-3 rounded-md border" style="border-color:var(--c-border)" {{ tabRules is not empty ? 'open' }}>
        <summary class="cursor-pointer px-3 py-2 text-sm font-medium" style="color:var(--c-primary)">
            {{ ux_icon('ph:check-square-offset', {class: 'icon'}) }} {{ 'node_type.edit.rules_title'|trans({'%count%': tabRules|length}, 'node_type') }}
        </summary>
        <div class="space-y-3 border-t p-3" style="border-color:var(--c-border)">
            <p class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.rules_help'|trans({}, 'node_type') }}</p>
            {% for r in tabRules %}
                <div class="flex items-start gap-2 rounded-md px-3 py-2 text-sm" style="background:#f8f9fb">
                    <span class="flex-1">{{ r.text }}{% if r.message %}<span class="block text-xs" style="color:var(--c-muted)">{{ 'node_type.edit.rule_message_shown'|trans({'%message%': r.message}, 'node_type') }}</span>{% endif %}</span>
                    <form method="post" action="{{ path('node_type_rule_remove', {id: nodeType.id, ruleId: r.id}) }}">
                        <button class="text-xs text-red-600 hover:underline">{{ 'common.remove'|trans({}, 'common') }}</button>
                    </form>
                </div>
            {% endfor %}

            {# obligatoire sous condition #}
            <form method="post" action="{{ path('node_type_rule_add', {id: nodeType.id}) }}" class="grid grid-cols-2 gap-x-3 gap-y-2 rounded-md border p-3" style="border-color:var(--c-border)">
                <input type="hidden" name="kind" value="required_if">
                <input type="hidden" name="tab" value="{{ tab }}">
                <div class="col-span-2 text-xs font-semibold">{{ 'node_type.edit.rule_required_if_title'|trans({}, 'node_type') }}</div>
                <label class="block col-span-2">
                    <span class="text-xs font-medium">{{ 'node_type.edit.rule_field'|trans({}, 'node_type') }}</span>
                    <select name="field" class="{{ fld }}" style="border-color:var(--c-border)">
                        {% for f in inputs|filter(f => not f.required) %}<option value="{{ f.key }}">{{ f.label }}</option>{% endfor %}
                    </select>
                </label>
                <label class="block">
                    <span class="text-xs font-medium">{{ 'node_type.edit.rule_when_field'|trans({}, 'node_type') }}</span>
                    <select name="whenField" class="{{ fld }}" style="border-color:var(--c-border)">
                        {% for f in allInputs %}<option value="{{ f.key }}">{{ f.label }}</option>{% endfor %}
                    </select>
                </label>
                <label class="block">
                    <span class="text-xs font-medium">{{ 'node_type.edit.rule_when_op'|trans({}, 'node_type') }}</span>
                    <select name="whenOp" class="{{ fld }}" style="border-color:var(--c-border)">
                        {% for op, lbl in constant('App\\Validation\\ValidationRule::OPERATORS') %}<option value="{{ op }}">{{ lbl }}</option>{% endfor %}
                    </select>
                </label>
                <label class="block col-span-2">
                    <span class="text-xs font-medium">{{ 'node_type.edit.rule_when_value'|trans({}, 'node_type') }}</span>
                    <input name="whenValue" list="rule-values-{{ tab }}" placeholder="{{ 'node_type.edit.rule_when_value_placeholder'|trans({}, 'node_type') }}" class="{{ fld }}" style="border-color:var(--c-border)">
                    <datalist id="rule-values-{{ tab }}">
                        {% for f in allInputs %}
                            {% for v, l in (f.referentielKey ? referentiel(f.referentielKey) : f.options) %}<option value="{{ v }}">{{ f.label }} : {{ l }}</option>{% endfor %}
                        {% endfor %}
                    </datalist>
                </label>
                <label class="block col-span-2">
                    <span class="text-xs font-medium">{{ 'node_type.edit.rule_message'|trans({}, 'node_type') }}</span>
                    <input name="message" placeholder="{{ 'node_type.edit.rule_message_placeholder'|trans({}, 'node_type') }}" class="{{ fld }}" style="border-color:var(--c-border)">
                </label>
                <div class="col-span-2 flex justify-end">
                    <button class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'node_type.edit.rule_add_button'|trans({}, 'node_type') }}</button>
                </div>
            </form>

            {# au moins un parmi #}
            <form method="post" action="{{ path('node_type_rule_add', {id: nodeType.id}) }}" class="space-y-2 rounded-md border p-3" style="border-color:var(--c-border)">
                <input type="hidden" name="kind" value="one_of">
                <input type="hidden" name="tab" value="{{ tab }}">
                <div class="text-xs font-semibold">{{ 'node_type.edit.rule_one_of_title'|trans({}, 'node_type') }}</div>
                <div class="flex flex-wrap gap-x-5 gap-y-1">
                    {% for f in inputs %}
                        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="fields[]" value="{{ f.key }}"> {{ f.label }}</label>
                    {% endfor %}
                </div>
                <input name="message" placeholder="{{ 'node_type.edit.rule_message_placeholder'|trans({}, 'node_type') }}" class="{{ fld }}" style="border-color:var(--c-border)">
                <div class="flex justify-end">
                    <button class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'node_type.edit.rule_add_button'|trans({}, 'node_type') }}</button>
                </div>
            </form>
        </div>
    </details>
{% endmacro %}

{# ─── badges d'origine : en quoi ce champ diffère de son formulaire de départ ─── #}
{# Un formulaire sans parent n'hérite de rien : le badge « hérité » y est vide de sens. #}
{% macro origins(f, hasParent) %}
    {% for o in f.origins %}
        {% if not (o == 'inherited' and not hasParent) %}
            <span class="pill ml-1">{{ ('node_type.edit.origin.' ~ o)|trans({}, 'node_type') }}</span>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block body %}
<turbo-frame id="admin-content">
<div class="max-w-3xl mx-auto" data-controller="impact">
    {% if retour %}
        <div class="mb-3">
            <a href="{{ retour }}" data-turbo-frame="_top" class="text-sm hover:underline" style="color:var(--c-primary)">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} {{ 'node_type.edit.back_to_canvas'|trans({}, 'node_type') }}</a>
        </div>
    {% endif %}
    <div class="text-xs" style="color:var(--c-muted)">
        <a href="{{ path('node_type_index') }}" data-turbo-frame="_top" class="hover:underline">{{ 'node_type.index.heading'|trans({}, 'node_type') }}</a> › {{ isNew ? 'node_type.edit.breadcrumb_new'|trans({}, 'node_type') : nodeType.label }}
    </div>
    <h1 class="text-xl font-bold mt-1 mb-5">{{ isNew ? 'node_type.edit.new_heading'|trans({}, 'node_type') : 'node_type.edit.edit_heading'|trans({'%label%': nodeType.label}, 'node_type') }}</h1>

    {% set isParam = not isNew and nodeType.family.value == 'parameter' %}

    {# ─── variante : rappel du formulaire de départ ─── #}
    {% if not isNew and nodeType.parent %}
        {% set parentLink = '<a href="' ~ path('node_type_edit', {id: nodeType.parent.id}) ~ '" class="underline">' ~ nodeType.parent.label|e('html') ~ '</a>' %}
        <div data-variant-of="{{ nodeType.parent.key }}" class="rounded-xl border px-4 py-3 mb-5" style="border-color:var(--c-border);background:#f8f9fb">
            <div class="text-sm font-semibold">{{ 'node_type.edit.variant_of'|trans({'%parent%': parentLink}, 'node_type')|raw }}</div>
            <p class="text-xs mt-1" style="color:var(--c-muted)">{{ 'node_type.edit.variant_help'|trans({}, 'node_type') }}</p>
        </div>
    {% endif %}

    {# ─── diplômes utilisateurs : la modification s'applique à tous, d'où la confirmation ─── #}
    {% if isParam %}
        <form method="post" action="{{ path('node_type_preview', {id: nodeType.id}) }}" target="_blank" class="mb-3 flex justify-end">
            <button class="rounded-md border px-3 py-1.5 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:eye', {class: 'icon'}) }} {{ 'diplome.wizard.formulaires.preview'|trans({}, 'diplome') }} ↗</button>
        </form>
        <div data-form-usage class="rounded-xl border px-4 py-3 mb-5" style="border-color:var(--c-border)">
            <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'node_type.edit.usage_title'|trans({}, 'node_type') }}</div>
            {% if usage is not empty %}
                <ul class="mt-2 space-y-1 text-sm">
                    {% for v in usage %}
                        <li>{{ v.typeDiplome.label }} — {{ v.anneeUniversitaire }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="mt-2 text-sm" style="color:var(--c-muted)">{{ 'node_type.edit.usage_none'|trans({}, 'node_type') }}</p>
            {% endif %}
            {% if concerned is not empty %}
                <label class="mt-3 flex items-start gap-2 text-sm">
                    <input type="checkbox" data-impact-confirm>
                    <span>{{ 'node_type.edit.impact_confirm'|trans({'%count%': concerned|length}, 'node_type') }}</span>
                </label>
            {% endif %}
        </div>
    {% endif %}

    {# ─── champs apparus dans le formulaire de départ depuis la dernière visite ─── #}
    {% if newParentFields is not empty %}
        <div data-new-parent-fields class="rounded-xl border px-4 py-3 mb-5" style="border-color:var(--c-border);background:#f8f9fb">
            <div class="text-sm font-semibold">{{ 'node_type.edit.new_parent_fields'|trans({}, 'node_type') }}</div>
            <ul class="mt-2 space-y-1 text-sm">
                {% for f in newParentFields %}
                    <li>{{ f.label }} <code class="text-xs" style="color:var(--c-muted)">{{ f.key }}</code></li>
                {% endfor %}
            </ul>
            <form method="post" action="{{ path('node_type_variant_ack', {id: nodeType.id}) }}" class="mt-3 flex justify-end">
                <button class="rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'node_type.edit.new_parent_fields_ack'|trans({}, 'node_type') }}</button>
            </form>
        </div>
    {% endif %}

    <form method="post" {{ isNew ? 'data-turbo-frame="_top"' }} class="rounded-xl border bg-white p-5 space-y-4 mb-5" style="border-color:var(--c-border)">
        <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'node_type.edit.properties_title'|trans({}, 'node_type') }}</div>
        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'node_type.edit.label_field'|trans({}, 'node_type') }}</span>
                <input name="label" required value="{{ nodeType.label ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <div class="block relative" data-controller="icon-picker">
                <label for="node-type-icon" class="text-xs font-medium">{{ 'node_type.edit.icon_field'|trans({}, 'node_type') }}</label>
                <div class="mt-1 flex items-stretch gap-1">
                    <button type="button" class="icon-picker-trigger" data-action="icon-picker#toggle" title="{{ 'node_type.edit.icon_pick'|trans({}, 'node_type') }}" aria-label="{{ 'node_type.edit.icon_pick'|trans({}, 'node_type') }}">
                        <span data-icon-picker-target="preview"></span>
                    </button>
                    <input id="node-type-icon" name="icon" value="{{ nodeType.icon ?? '' }}" placeholder="ph:puzzle-piece" data-icon-picker-target="input" data-action="input->icon-picker#refreshPreview" class="min-w-0 flex-1 rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                </div>
                <span class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.icon_help'|trans({'%link%': '<a href="https://icones.js.org/collection/ph" target="_blank" class="underline">Phosphor</a>', '%example%': '<code>ph:calendar</code>'}, 'node_type')|raw }}</span>
                <div class="icon-picker-panel" data-icon-picker-target="panel" data-action="keydown->icon-picker#keydown" hidden>
                    <div class="flex gap-2">
                        <input type="search" data-icon-picker-target="search" data-action="input->icon-picker#search" placeholder="{{ 'node_type.edit.icon_search'|trans({}, 'node_type') }}" class="min-w-0 flex-1 rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                        <select data-icon-picker-target="weight" data-action="icon-picker#render" class="rounded-md border px-1 py-1.5 text-xs" style="border-color:var(--c-border)" aria-label="{{ 'node_type.edit.icon_weight'|trans({}, 'node_type') }}">
                            <option value="">Normal</option>
                            <option value="-bold">Gras</option>
                            <option value="-fill">Plein</option>
                            <option value="-duotone">Duotone</option>
                            <option value="-light">Fin</option>
                            <option value="-thin">Très fin</option>
                        </select>
                    </div>
                    <div class="mt-2 text-[11px]" style="color:var(--c-muted)" data-icon-picker-target="status"></div>
                    <div class="icon-picker-grid mt-1" data-icon-picker-target="grid"></div>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
            {# Clé = identifiant technique (référencé par les formations, templates, champs) : générée
               depuis le libellé et unique ; seul le super-administrateur peut la saisir ou la changer. #}
            {% if is_super_admin() %}
                <label class="block">
                    <span class="text-xs font-medium">{{ 'node_type.edit.key_field'|trans({}, 'node_type') }}</span>
                    <input name="key" value="{{ nodeType.key ?? '' }}" placeholder="{{ 'node_type.edit.key_placeholder'|trans({}, 'node_type') }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm font-mono" style="border-color:var(--c-border)">
                    <span class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.key_help_superadmin'|trans({}, 'node_type') }}</span>
                </label>
            {% else %}
                <div class="block">
                    <span class="text-xs font-medium">{{ 'node_type.edit.key_field'|trans({}, 'node_type') }}</span>
                    <div class="mt-1 rounded-md border bg-gray-50 px-3 py-2 text-sm font-mono break-all" style="border-color:var(--c-border);color:var(--c-muted)">{{ isNew ? 'node_type.edit.key_auto'|trans({}, 'node_type') : nodeType.key }}</div>
                    <span class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.key_help'|trans({}, 'node_type') }}</span>
                </div>
            {% endif %}
            <label class="block">
                <span class="text-xs font-medium">{{ 'node_type.edit.position_field'|trans({}, 'node_type') }}</span>
                <input type="number" name="position" value="{{ nodeType.position ?? 0 }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                <span class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.position_help'|trans({}, 'node_type') }}</span>
            </label>
        </div>

        {% if not isParam %}
        <label class="block max-w-xs">
            <span class="text-xs font-medium">{{ 'node_type.edit.kind_field'|trans({}, 'node_type') }}</span>
            <select name="kind" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                {% for k in kinds %}<option value="{{ k.value }}" {{ (nodeType.kind ?? null) == k ? 'selected' }}>{{ k.label }}</option>{% endfor %}
            </select>
            <span class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.kind_help'|trans({}, 'node_type') }}</span>
        </label>

        <fieldset class="rounded-md border p-3" style="border-color:var(--c-border)">
            <legend class="text-xs font-medium px-1">{{ 'node_type.edit.elp_params_legend'|trans({}, 'node_type') }}</legend>
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="mutualisable" value="1" {{ (not isNew and nodeType.hasCapability('mutualisable')) ? 'checked' }}>
                {{ 'node_type.edit.mutualisable_label'|trans({}, 'node_type') }}
            </label>
            <label class="mt-2 flex items-center gap-2 text-sm">
                <input type="checkbox" name="choiceTransformable" value="1" {{ (nodeType.choiceTransformable ?? true) ? 'checked' }}>
                {{ 'node_type.edit.choice_transformable_label'|trans({}, 'node_type') }}
            </label>
        </fieldset>

        <fieldset class="rounded-md border p-3" style="border-color:var(--c-border)">
            <legend class="text-xs font-medium px-1">{{ 'node_type.edit.numbering_legend'|trans({}, 'node_type') }}</legend>
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="numbered" value="1" {{ (nodeType.numbered ?? false) ? 'checked' }}>
                {{ 'node_type.edit.numbered_label'|trans({}, 'node_type') }}
            </label>
            <label class="mt-2 flex items-center gap-2 text-sm">
                <span class="text-xs" style="color:var(--c-muted)">{{ 'node_type.edit.number_style_label'|trans({}, 'node_type') }}</span>
                <select name="numberStyle" class="rounded-md border px-2 py-1 text-sm" style="border-color:var(--c-border)">
                    {% for v, l in constant('App\\Entity\\NodeType::NUMBER_STYLES') %}
                        <option value="{{ v }}" {{ (nodeType.numberStyle ?? 'decimal') == v ? 'selected' }}>{{ l }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="mt-2 flex items-center gap-2 text-sm">
                <input type="checkbox" name="heritee" value="1" {{ not (nodeType.globalNumbering ?? false) ? 'checked' }}>
                {{ 'node_type.edit.heritee_label'|trans({}, 'node_type') }}
            </label>
            <p class="mt-2 text-xs" style="color:var(--c-muted)">{{ 'node_type.edit.numbering_help'|trans({}, 'node_type') }}</p>
        </fieldset>
        {% endif %}

        <div class="flex gap-2 pt-1">
            <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <a href="{{ path('node_type_index') }}" data-turbo-frame="_top" class="rounded-md border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</a>
        </div>
    </form>

    {% if not isNew %}
    {% import _self as ui %}
    <div class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div>
            <div class="text-xs font-bold uppercase tracking-wide" style="color:var(--c-primary)">{{ 'node_type.edit.form_builder_title'|trans({}, 'node_type') }}</div>
            <p class="text-xs mt-1" style="color:var(--c-muted)">{{ 'node_type.edit.form_builder_help'|trans({}, 'node_type') }}</p>
        </div>

        {% for tab, fields in form %}
            <div class="rounded-lg border p-3" style="border-color:var(--c-border)">
                <div class="text-sm font-semibold mb-2">{{ 'node_type.edit.tab_label'|trans({'%tab%': tab}, 'node_type') }}</div>
                <ul data-controller="chain" data-chain-save-url-value="{{ path('node_type_fields_reorder', {id: nodeType.id, tab: tab}) }}" class="space-y-2">
                    {% for f in fields %}
                        <li data-chain-key="{{ f.key }}" class="flex items-start gap-1.5">
                            <span class="drag-handle mt-2.5 shrink-0 text-gray-300" title="{{ 'formation.tree.drag_title'|trans({}, 'formation') }}">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                            <div class="flex-1 min-w-0">
                                {% if f.type == 'separator' %}
                                    <div class="flex items-center gap-2 rounded-md border px-3 py-2" style="border-color:var(--c-border);background:#fafafa">
                                        <span class="text-[11px] uppercase tracking-wide shrink-0" style="color:var(--c-muted)">{{ 'node_type.edit.separator_pill'|trans({}, 'node_type') }}</span>
                                        <form method="post" action="{{ path('node_type_field_edit', {id: nodeType.id, fieldId: f.id}) }}" class="flex-1 flex items-center gap-2">
                                            <input name="label" value="{{ f.label }}" class="flex-1 rounded border px-2 py-1 text-sm" style="border-color:var(--c-border)">
                                            <button class="text-xs hover:underline shrink-0">{{ 'common.save'|trans({}, 'common') }}</button>
                                        </form>
                                        <form method="post" action="{{ path('node_type_field_remove', {id: nodeType.id, fieldId: f.id}) }}" class="shrink-0">
                                            <button class="inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-200" style="color:#dc2626" title="{{ 'common.remove'|trans({}, 'common') }}" aria-label="{{ 'common.remove'|trans({}, 'common') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                                        </form>
                                    </div>
                                {% elseif f.locked %}
                                    <div class="flex items-center gap-2 rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border);background:#fafafa">
                                        <span class="flex-1">{{ f.label }} <code class="text-xs" style="color:var(--c-muted)">{{ f.key }}</code>
                                            {% if f.required %}<span class="pill ml-1" style="background:#fee2e2;color:#dc2626">{{ 'node_type.edit.field_required_badge'|trans({}, 'node_type') }}</span>{% endif %}
                                        </span>
                                        <span class="text-xs" style="color:var(--c-muted)">{{ fieldTypes[f.type] }}</span>
                                        <span class="pill" title="{{ 'node_type.edit.field_locked_title'|trans({}, 'node_type') }}">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }}</span>
                                    </div>
                                {% elseif isParam and f.hidden %}
                                    {# champ masqué dans ce formulaire : on ne peut plus l'éditer, seulement le réafficher #}
                                    <div class="flex items-center gap-2 rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border);background:#f1f3f5;color:var(--c-muted)">
                                        <span class="flex-1 min-w-0">{{ f.label }} <code class="text-xs" style="color:var(--c-muted)">{{ f.key }}</code>
                                            {% if f.required %}<span class="pill ml-1" style="background:#fee2e2;color:#dc2626">{{ 'node_type.edit.field_required_badge'|trans({}, 'node_type') }}</span>{% endif %}
                                            {{ ui.origins(f, nodeType.parent is not null) }}
                                        </span>
                                        <span class="ml-auto flex shrink-0 items-center gap-1">
                                        <form method="post" action="{{ path('node_type_field_visibility', {id: nodeType.id, fieldId: f.id}) }}">
                                            <input type="hidden" name="visible" value="1">
                                            <button class="inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-200" title="{{ 'node_type.edit.show_field'|trans({}, 'node_type') }}" aria-label="{{ 'node_type.edit.show_field'|trans({}, 'node_type') }}">{{ ux_icon('ph:eye-slash', {class: 'icon'}) }}</button>
                                        </form>
                                            <form method="post" action="{{ path('node_type_field_remove', {id: nodeType.id, fieldId: f.id}) }}"
                                                  data-controller="confirm" data-confirm-message-value="{{ 'node_type.edit.remove_field_confirm'|trans({'%label%': f.label}, 'node_type') }}">
                                                <button class="inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-200" style="color:#dc2626" title="{{ 'common.remove'|trans({}, 'common') }}" aria-label="{{ 'common.remove'|trans({}, 'common') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                                            </form>
                                        </span>
                                    </div>
                                {% else %}
                                    {% set togglableDefault = not nodeType.isCapabilityLocked(f.key) %}
                                    <details class="rounded-md border" style="border-color:var(--c-border)">
                                        <summary class="flex items-center justify-between gap-2 px-3 py-2 cursor-pointer text-sm">
                                            <span class="flex-1 min-w-0">{{ f.label }} <code class="text-xs" style="color:var(--c-muted)">{{ f.key }}</code>
                                                {% if isParam %}{{ ui.origins(f, nodeType.parent is not null) }}{% endif %}
                                                {% if not togglableDefault %}<span class="pill ml-1" title="{{ 'node_type.edit.not_togglable_title'|trans({}, 'node_type') }}">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }}</span>{% endif %}
                                            </span>
                                            <span class="ml-auto flex shrink-0 items-center gap-1">
                                                {% if isParam %}
                                                    <form method="post" action="{{ path('node_type_field_visibility', {id: nodeType.id, fieldId: f.id}) }}" onclick="event.stopPropagation()">
                                                        <input type="hidden" name="visible" value="0">
                                                        <button class="inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-200" title="{{ 'node_type.edit.hide_field'|trans({}, 'node_type') }}" aria-label="{{ 'node_type.edit.hide_field'|trans({}, 'node_type') }}">{{ ux_icon('ph:eye', {class: 'icon'}) }}</button>
                                                    </form>
                                                {% endif %}
                                                <form method="post" action="{{ path('node_type_field_remove', {id: nodeType.id, fieldId: f.id}) }}" onclick="event.stopPropagation()"
                                                      data-controller="confirm" data-confirm-message-value="{{ 'node_type.edit.remove_field_confirm'|trans({'%label%': f.label}, 'node_type') }}">
                                                    <button class="inline-flex h-7 w-7 items-center justify-center rounded hover:bg-gray-200" style="color:#dc2626" title="{{ 'common.remove'|trans({}, 'common') }}" aria-label="{{ 'common.remove'|trans({}, 'common') }}">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                                                </form>
                                            </span>
                                        </summary>
                                        <div class="p-3 border-t" style="border-color:var(--c-border)">
                                            {{ ui.fieldForm(path('node_type_field_edit', {id: nodeType.id, fieldId: f.id}), f, referentiels, fieldTypes, fieldTypesConfig, 'common.save'|trans({}, 'common'), togglableDefault) }}
                                        </div>
                                    </details>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                {{ ui.tabRules(nodeType, tab, fields, form, rules[tab] ?? []) }}
            </div>
        {% else %}
            <p class="text-sm" style="color:var(--c-muted)">{{ 'node_type.edit.form_builder_empty'|trans({}, 'node_type') }}</p>
        {% endfor %}

        <div class="flex flex-wrap gap-2">
            {# ── modale « Ajouter un champ » ── #}
            <div data-controller="modal" class="flex-1 min-w-[200px]">
                <button type="button" data-action="modal#open" class="w-full rounded-md border px-3 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border);color:var(--c-primary)">
                    {{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'node_type.edit.add_field_button'|trans({}, 'node_type') }}
                </button>
                <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
                        class="rounded-2xl border-0 p-0 w-[min(560px,92vw)] backdrop:bg-black/40">
                    <div class="p-6 space-y-3">
                        <h3 class="text-lg font-bold">{{ 'node_type.edit.add_field_button'|trans({}, 'node_type') }}</h3>
                        <datalist id="existing-field-keys">{% for f in catalog %}<option value="{{ f.key }}">{% endfor %}</datalist>
                        {{ ui.fieldForm(path('node_type_field_add', {id: nodeType.id}), null, referentiels, fieldTypes, fieldTypesConfig, 'node_type.edit.add_field_button'|trans({}, 'node_type'), true) }}
                        <p class="text-[11px]" style="color:var(--c-muted)">{{ 'node_type.edit.add_field_reuse_help'|trans({}, 'node_type') }}</p>
                        <div class="flex justify-end">
                            <button type="button" data-action="modal#close" class="rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</button>
                        </div>
                    </div>
                </dialog>
            </div>

            {# ── modale « Ajouter un séparateur » ── #}
            <div data-controller="modal" class="flex-1 min-w-[200px]">
                <button type="button" data-action="modal#open" class="w-full rounded-md border px-3 py-2 text-sm font-medium hover:bg-gray-50" style="border-color:var(--c-border);color:var(--c-primary)">
                    {{ ux_icon('ph:minus', {class: 'icon'}) }} {{ 'node_type.edit.add_separator_button'|trans({}, 'node_type') }}
                </button>
                <dialog data-modal-target="dialog" data-action="click->modal#clickOutside"
                        class="rounded-2xl border-0 p-0 w-[min(420px,92vw)] backdrop:bg-black/40">
                    <form method="post" action="{{ path('node_type_separator_add', {id: nodeType.id}) }}" class="p-6 space-y-3">
                        <h3 class="text-lg font-bold">{{ 'node_type.edit.add_separator_button'|trans({}, 'node_type') }}</h3>
                        <label class="block">
                            <span class="text-xs font-medium">{{ 'node_type.edit.field_tab_field'|trans({}, 'node_type') }}</span>
                            <input name="tab" value="props" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                        </label>
                        <label class="block">
                            <span class="text-xs font-medium">{{ 'node_type.edit.field_label_field'|trans({}, 'node_type') }}</span>
                            <input name="label" required placeholder="{{ 'node_type.edit.separator_label_placeholder'|trans({}, 'node_type') }}" class="mt-1 w-full rounded-md border px-2 py-1.5 text-sm" style="border-color:var(--c-border)">
                        </label>
                        <div class="flex justify-end gap-2 pt-1">
                            <button type="button" data-action="modal#close" class="rounded-lg border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</button>
                            <button class="rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ 'node_type.edit.add_separator_button'|trans({}, 'node_type') }}</button>
                        </div>
                    </form>
                </dialog>
            </div>
        </div>
    </div>
    {% endif %}
</div>
</turbo-frame>
{% endblock %}
