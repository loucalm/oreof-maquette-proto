{% extends 'base.html.twig' %}
{% block title %}{{ isNew ? 'field.edit.new_title'|trans({}, 'field') : field.label }}{% endblock %}

{% block body %}
<div class="max-w-2xl">
    <div class="text-xs" style="color:var(--c-muted)">
        <a href="{{ path('field_index') }}" class="hover:underline">{{ 'field.edit.breadcrumb_root'|trans({}, 'field') }}</a> › {{ isNew ? 'field.edit.breadcrumb_new'|trans({}, 'field') : field.label }}
    </div>
    <h1 class="text-xl font-bold mt-1 mb-5">{{ isNew ? 'field.edit.new_heading'|trans({}, 'field') : 'field.edit.edit_heading'|trans({'%label%': field.label}, 'field') }}</h1>

    <form method="post" class="rounded-xl border bg-white p-5 space-y-4" style="border-color:var(--c-border)">
        <div class="grid grid-cols-3 gap-3">
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'field.edit.label_field'|trans({}, 'field') }}</span>
                <input name="label" required value="{{ field.label ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.key_field'|trans({}, 'field') }}</span>
                <input name="key" value="{{ field.key ?? '' }}" placeholder="{{ 'field.edit.key_placeholder'|trans({}, 'field') }}" {{ not isNew and field.system ? 'readonly' }}
                       class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3">
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.tab_field'|trans({}, 'field') }}</span>
                <input name="tab" list="tabs" value="{{ field.tab ?? 'props' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                <datalist id="tabs">{% for t in tabs %}<option value="{{ t }}">{% endfor %}</datalist>
            </label>
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.category_field'|trans({}, 'field') }}</span>
                <input name="category" value="{{ field.category ?? '' }}" placeholder="{{ 'field.edit.category_placeholder'|trans({}, 'field') }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.order_field'|trans({}, 'field') }}</span>
                <input type="number" name="position" value="{{ field.position ?? 100 }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <div class="grid grid-cols-3 gap-3 items-end">
            <label class="block col-span-2">
                <span class="text-xs font-medium">{{ 'field.edit.type_field'|trans({}, 'field') }}</span>
                <select name="type" {{ not isNew and field.isSystemType ? 'disabled' }} class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                    {% for k, lbl in types %}<option value="{{ k }}" {{ (field.type ?? 'text') == k ? 'selected' }}>{{ lbl }}</option>{% endfor %}
                </select>
                {% if not isNew and field.isSystemType %}
                    <input type="hidden" name="type" value="{{ field.type }}">
                    <span class="text-[11px]" style="color:var(--c-muted)">{{ 'field.edit.system_type_note'|trans({}, 'field') }}</span>
                {% endif %}
            </label>
            <label class="flex items-center gap-2 text-sm pb-2">
                <input type="checkbox" name="required" value="1" {{ (field.required ?? false) ? 'checked' }}>
                {{ 'field.edit.required_label'|trans({}, 'field') }}
            </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.referentiel_field'|trans({}, 'field') }}</span>
                <select name="referentielKey" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
                    <option value="">{{ 'field.edit.referentiel_none'|trans({}, 'field') }}</option>
                    {% for r in referentiels %}
                        <option value="{{ r.key }}" {{ (field.referentielKey ?? '') == r.key ? 'selected' }}>{{ r.label }}</option>
                    {% endfor %}
                </select>
                <span class="text-[11px]" style="color:var(--c-muted)">{{ 'field.edit.referentiel_help'|trans({}, 'field') }}</span>
            </label>
            <div class="flex flex-col gap-1.5 justify-end pb-1.5">
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="allowExtra" value="1" {{ (field.allowExtra ?? false) ? 'checked' }}>
                    {{ 'field.edit.allow_extra_label'|trans({}, 'field') }}
                </label>
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="quickAdd" value="1" {{ (field.quickAdd ?? false) ? 'checked' }}>
                    {{ 'field.edit.quick_add_label'|trans({}, 'field') }}
                </label>
            </div>
        </div>

        <label class="block">
            <span class="text-xs font-medium">{{ 'field.edit.options_label'|trans({}, 'field')|raw }}</span>
            <textarea name="options" rows="4" class="mt-1 w-full rounded-md border px-3 py-2 text-sm font-mono" style="border-color:var(--c-border)"
                >{% for v, l in (field.options ?? {}) %}{{ v }}|{{ l }}
{% endfor %}</textarea>
            <span class="text-[11px]" style="color:var(--c-muted)">{{ 'field.edit.options_help'|trans({}, 'field') }}</span>
        </label>

        <div class="grid grid-cols-2 gap-3">
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.min_field'|trans({}, 'field') }}</span>
                <input type="number" step="any" name="min" value="{{ field.min ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
            <label class="block">
                <span class="text-xs font-medium">{{ 'field.edit.max_field'|trans({}, 'field') }}</span>
                <input type="number" step="any" name="max" value="{{ field.max ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
            </label>
        </div>

        <label class="block">
            <span class="text-xs font-medium">{{ 'field.edit.help_label'|trans({}, 'field') }}</span>
            <input name="help" value="{{ field.help ?? '' }}" class="mt-1 w-full rounded-md border px-3 py-2 text-sm" style="border-color:var(--c-border)">
        </label>

        <div class="flex gap-2 pt-1">
            <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ 'common.save'|trans({}, 'common') }}</button>
            <a href="{{ path('field_index') }}" class="rounded-md border px-4 py-2 text-sm hover:bg-gray-50" style="border-color:var(--c-border)">{{ 'common.cancel'|trans({}, 'common') }}</a>
        </div>
    </form>
</div>
{% endblock %}
