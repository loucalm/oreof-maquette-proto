{% extends 'diplome/wizard/_layout.html.twig' %}
{% block step_content %}
{% for section in sections %}
    <h3 class="text-sm font-semibold mt-4 mb-1">{{ section.title }}</h3>
    <dl class="grid grid-cols-3 gap-y-1 text-sm">
        {% for row in section.rows %}
            <dt style="color:var(--c-muted)">{{ row[0] }}</dt><dd class="col-span-2">{{ row[1] }}</dd>
        {% endfor %}
    </dl>
{% endfor %}

{% if base %}
    <h3 class="text-sm font-semibold mt-6 mb-2">{{ 'diplome.wizard.recap.differences'|trans({'%base%': base.typeDiplome.label ~ ' ' ~ base.anneeUniversitaire}, 'diplome') }}</h3>
    {% if diff is empty %}
        <p class="text-sm" style="color:var(--c-muted)" data-no-diff>{{ 'diplome.wizard.recap.identical'|trans({}, 'diplome') }}</p>
    {% else %}
        <ul class="text-sm space-y-1" data-diff>
        {% for change in diff %}
            <li data-path="{{ change.path }}"><span class="font-medium">{{ change.label }}</span> : {{ change.from }} → {{ change.to }}</li>
        {% endfor %}
        </ul>
    {% endif %}
{% endif %}
{% endblock %}
{% block step_next %}
    <form method="post" action="{{ path('diplome_wizard_save') }}">
        {% include 'diplome/_csrf.html.twig' %}
        <button class="rounded-md px-4 py-2 text-sm font-medium text-white" style="background:var(--c-primary)">{{ 'diplome.wizard.create'|trans({}, 'diplome') }}</button>
    </form>
{% endblock %}
