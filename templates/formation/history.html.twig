{% extends 'base.html.twig' %}
{% block title %}Historique · {{ formation.name }}{% endblock %}

{% block body %}
<div class="rounded-2xl border bg-white px-7 py-6 mb-4" style="border-color:var(--c-border)">
    <div class="flex items-start justify-between gap-4">
        <div>
            <div class="text-xs text-gray-400">
                {{ ux_icon('ph:house', {class: 'icon'}) }} <span class="fake-link">Accueil</span> ›
                <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formation</a> ›
                <a href="{{ path('formation_editor', {id: formation.id}) }}" class="hover:underline">{{ formation.name }}</a> ›
                Historique
            </div>
            <h1 class="text-2xl font-extrabold tracking-tight mt-1">Historique — {{ formation.name }}</h1>
            <p class="text-sm text-gray-500 max-w-2xl">
                Chaque modification importante est archivée automatiquement, la plus récente en haut.
                <strong class="text-gray-700">Restaurer une ligne annule aussi tous les changements plus récents qu'elle</strong> —
                pas seulement le sien. Rien n'est perdu : l'état actuel est lui-même archivé avant chaque
                restauration, et reste consultable et restaurable ci-dessous.
            </p>
        </div>
        <a href="{{ path('formation_editor', {id: formation.id}) }}"
           class="rounded-lg border px-3 py-2 text-sm hover:bg-gray-50 shrink-0" style="border-color:var(--c-border)">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} Éditeur</a>
    </div>
</div>

<div class="rounded-2xl border bg-white overflow-hidden" style="border-color:var(--c-border)">
    {% if revisions is empty %}
        <div class="p-10 text-center text-sm text-gray-400">
            Aucune modification archivée pour l'instant — l'historique se remplit au fil des changements.
        </div>
    {% else %}
        <table class="w-full text-sm history-table">
            <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
                <tr>
                    <th class="text-left px-4 py-3 w-52">Date</th>
                    <th class="text-left px-4 py-3">Modification</th>
                    <th class="text-right px-4 py-3 w-40">Action</th>
                </tr>
            </thead>
            <tbody>
            {% for r in revisions %}
                {% set extra = loop.index0 %}
                {% set dateShort = r.createdAt|date('d/m/Y à H:i') %}
                <tr class="border-t" style="border-color:var(--c-border)">
                    <td class="px-4 py-3 text-gray-500 whitespace-nowrap align-top">{{ r.createdAt|date('d/m/Y à H:i:s') }}</td>
                    <td class="px-4 py-3 align-top">
                        <div>{{ r.label }}</div>
                        {% if extra > 0 %}
                            <div class="mt-1 flex items-center gap-1 text-xs" style="color:#b45309">
                                {{ ux_icon('ph:warning', {class: 'icon'}) }} restaurer annule aussi {{ extra }} changement(s) plus récent(s)
                            </div>
                        {% else %}
                            <div class="mt-1 text-xs text-gray-400">changement le plus récent — rien d'autre à annuler</div>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-right align-top">
                        <form method="post" action="{{ path('formation_history_restore', {id: formation.id, revisionId: r.id}) }}"
                              data-turbo-frame="_top" data-controller="confirm"
                              data-confirm-message-value="{{ extra > 0
                                  ? "Restaurer l'état du " ~ dateShort ~ " (" ~ r.label|lower ~ ") ? Cela annule aussi " ~ extra ~ " changement(s) plus récent(s) effectué(s) depuis — pas seulement celui-ci. Rien n'est perdu : l'état actuel restera consultable et restaurable dans l'historique."
                                  : "Restaurer l'état du " ~ dateShort ~ " (" ~ r.label|lower ~ ") ? C'est le changement le plus récent : lui seul sera annulé. L'état actuel restera consultable et restaurable dans l'historique."
                              }}">
                            <button title="Annule {{ extra + 1 }} changement(s)"
                                    class="rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50" style="border-color:var(--c-border)">{{ ux_icon('ph:arrow-u-up-left', {class: 'icon'}) }} Restaurer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <p class="px-4 py-3 text-xs text-gray-400 border-t" style="border-color:var(--c-border)">
            {{ revisions|length }} modification(s) conservée(s) (les plus anciennes sont purgées au-delà de 50).
        </p>
    {% endif %}
</div>
{% endblock %}
