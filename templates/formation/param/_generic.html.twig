{# Formulaire de section « paramètre » générique, piloté par une liste de champs.
   Utilisé pour les paramètres d'un parcours (data = Node.parametres[key]). #}
<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="{{ panelToken }}">
    <div class="panel-head">
        <h2 class="text-xl font-bold">{{ title }}</h2>
        <div class="text-sm text-gray-400">{{ contextName }}</div>
    </div>

    <div class="panel-scroll">
    <form method="post" action="{{ saveUrl }}" data-turbo-frame="_top"
          class="panel-card space-y-5">
        {% for f in fields %}
            <div>
                <div class="fld-label">{{ f.label }}</div>
                {% if f.long ?? false %}
                    <textarea name="p[{{ f.key }}]" rows="3" class="fld mt-1">{{ data[f.key] ?? '' }}</textarea>
                {% else %}
                    <input name="p[{{ f.key }}]" value="{{ data[f.key] ?? '' }}" class="fld mt-1">
                {% endif %}
            </div>
        {% endfor %}
        <div class="pt-2 border-t" style="border-color:var(--c-border)">
            <button class="rounded-lg px-5 py-2.5 text-sm font-semibold text-white" style="background:var(--c-primary)">Enregistrer</button>
        </div>
    </form>
    </div>
</div>
</turbo-frame>
