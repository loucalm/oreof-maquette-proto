{% extends 'admin/_layout.html.twig' %}
{% set adminSection = 'overview' %}
{% block title %}{{ 'admin.index.title'|trans({}, 'admin') }}{% endblock %}

{% block admin_body %}
{% set sections = constant('App\\Controller\\AdminController::SECTIONS') %}

<div class="grid gap-4 md:grid-cols-2">
    {% for card in cards %}
        {% set s = sections[card.section] %}
        <a href="{{ path(s.route) }}" data-turbo-frame="_top"
           class="group flex flex-col rounded-xl border bg-white p-5 hover:shadow-sm hover:border-gray-300 transition"
           style="border-color:var(--c-border)">
            <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="grid h-9 w-9 place-items-center rounded-lg text-lg" style="background:var(--c-primary-soft);color:var(--c-primary)">{{ ux_icon(s.icon, {class: 'icon', style: 'width:1.15em;height:1.15em'}) }}</span>
                    <div>
                        <div class="font-semibold">{{ s.label }}</div>
                        <div class="text-xs text-gray-400">{{ card.count }} · {{ card.sub }}</div>
                    </div>
                </div>
                <span class="text-gray-300 group-hover:text-[var(--c-primary)]">{{ ux_icon('ph:arrow-right', {class: 'icon'}) }}</span>
            </div>
            <p class="mt-3 text-sm text-gray-500">{{ card.text }}</p>
        </a>
    {% endfor %}
</div>

<div class="mt-6 rounded-xl border px-5 py-4 text-sm" style="border-color:#c7d2fe;background:var(--c-primary-soft)">
    <div class="font-semibold" style="color:var(--c-primary)">{{ 'admin.index.where_title'|trans({}, 'admin') }}</div>
    <ul class="mt-1.5 space-y-1 text-gray-600">
        <li>• {{ 'admin.index.where_hierarchy'|trans({}, 'admin')|raw }}</li>
        <li>• {{ 'admin.index.where_params'|trans({}, 'admin')|raw }}</li>
        <li>• {{ 'admin.index.where_common'|trans({}, 'admin')|raw }}</li>
    </ul>
</div>
{% endblock %}
