{# Arborescence des parcours (ramification).
   - dans l'éditeur : fragment <turbo-frame id="node-panel"> (standalone = false)
   - ouvert directement : page complète avec en-tête + Tailwind (standalone = true) #}
{% extends standalone ? 'base.html.twig' : '_frame.html.twig' %}
{% block title %}{{ formation.name }} · arborescence des parcours{% endblock %}

{% block body %}
{% set g = graph %}
{# candidats de parenté calculés une fois par parcours, réutilisés par la boîte SVG (data-candidates) et par le <select> du tableau #}
{% set candidatesByNode = {} %}
{% if not standalone %}
    {% for r in g.rows %}
        {% set candidatesByNode = candidatesByNode|merge({(r.node.id): parcours_candidates(r.node)}) %}
    {% endfor %}
{% endif %}

<turbo-frame id="node-panel">
<div class="panel-body" data-panel-active="parcours">
    <div class="panel-head">
        {% if standalone %}
            <div class="mb-2 text-xs text-gray-400">
                {{ ux_icon('ph:house', {class: 'icon'}) }} <span class="fake-link">Accueil</span> ›
                <a href="{{ path('formation_index') }}" class="hover:underline">Liste des formations</a> ›
                <a href="{{ path('formation_view', {id: formation.id}) }}" class="hover:underline">{{ formation.name }}</a> ›
                Arborescence des parcours
            </div>
        {% endif %}
        <div class="flex items-center justify-between gap-3">
            <div>
                <h2 class="text-xl font-bold">Arborescence des parcours</h2>
                <div class="text-sm text-gray-400">{{ formation.name }} · {{ g.parcours|length }} parcours</div>
            </div>
            <a href="{{ path('formation_editor', {id: formation.id, param: 'structure'}) }}" data-turbo-frame="node-panel"
               class="rounded-lg border px-3 py-1.5 text-xs font-medium hover:bg-gray-50 shrink-0" style="border-color:var(--c-border)">{{ ux_icon('ph:arrow-left', {class: 'icon'}) }} Configuration de la structure</a>
        </div>
        <p class="text-xs text-gray-400 mt-1">
            Axe : <strong>{{ g.unit|lower }}</strong> (dimension temporelle de la formation, réglable dans « Configuration de la structure »).
            {% if standalone %}
                Le parent d'un parcours et ses {{ g.unit|lower }}s de début / fin se règlent depuis l'éditeur de la formation.
            {% else %}
                Glissez d'un parcours vers un autre sur le graphe pour le désigner comme parent, ou utilisez le tableau ci-dessous.
            {% endif %}
        </p>
    </div>

    <div class="panel-scroll">
    {% if g.parcours is empty %}
        <div class="rounded-xl border border-dashed p-8 text-center text-sm text-gray-500" style="border-color:var(--c-border)">
            Aucun parcours. Ajoutez-en depuis « Configuration de la structure ».
        </div>
    {% else %}
        <div {{ not standalone ? 'data-controller=ramification' }}>
        <div class="overflow-auto rounded-xl border bg-white" style="border-color:var(--c-border)">
            <svg viewBox="0 0 {{ g.width }} {{ g.height }}" width="{{ g.width }}" height="{{ g.height }}" class="block" style="min-width:100%"
                 {{ not standalone ? 'data-ramification-target=svg' }}>
                <defs>
                    <marker id="pg-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M0 0 L10 5 L0 10 z" fill="#6366f1"/>
                    </marker>
                </defs>

                {# colonnes de périodes (grille de fond, discrète) #}
                {% for a in 1..g.cols %}
                    {% set cx = g.pad + (a - 1) * g.colW %}
                    {% if a > 1 %}<line x1="{{ cx }}" y1="{{ g.headerH - 6 }}" x2="{{ cx }}" y2="{{ g.height - 8 }}" stroke="#eef1f4" stroke-dasharray="2 5"/>{% endif %}
                    <text x="{{ cx + 12 }}" y="{{ g.headerH - 16 }}" font-size="13" font-weight="600" fill="#374151">
                        {%- if g.unit|lower == 'année' %}{{ a == 1 ? '1ère' : a ~ 'ème' }} année{% else %}{{ g.unit }} {{ a }}{% endif -%}
                    </text>
                {% endfor %}
                <line x1="{{ g.pad }}" y1="{{ g.headerH - 4 }}" x2="{{ g.width - g.pad }}" y2="{{ g.headerH - 4 }}" stroke="#e5e7eb"/>

                {# liens parent → enfant (tracé pré-calculé côté PHP) :
                   halo blanc d'abord (toutes les arêtes), puis le trait coloré,
                   pour que les connecteurs restent lisibles sur la grille et entre eux #}
                {% for e in g.edges %}
                    <path d="{{ e.path }}" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                {% endfor %}
                {% for e in g.edges %}
                    <path d="{{ e.path }}" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" marker-end="url(#pg-arrow)"/>
                {% endfor %}
                {% if not standalone %}
                    {# survol/clic élargi (invisible) sur chaque connecteur, pour le retirer #}
                    {% for e in g.edges %}
                        <path d="{{ e.path }}" fill="none" stroke="transparent" stroke-width="14" stroke-linecap="round" stroke-linejoin="round"
                              data-ramification-target="edge" data-child="{{ e.to }}" data-action="click->ramification#clearEdge" style="cursor:pointer">
                            <title>Retirer ce lien de ramification</title>
                        </path>
                    {% endfor %}
                {% endif %}

                {# boîtes parcours — lien SVG en xlink:href (Turbo ne sait pas lire
                   le href des <a> SVG) : navigation pleine page vers l'éditeur du parcours,
                   sauf si un glisser vient d'avoir lieu (ramification_controller#suppressIfDragged) #}
                {% for r in g.rows %}
                    {% set b = g.boxes[r.node.id] %}
                    {% set isCurrent = current and r.node.id == current %}
                    <a xlink:href="{{ path('parcours_editor', {fid: formation.id, nid: r.node.id}) }}" style="cursor:pointer"
                       {% if not standalone %}
                           data-ramification-target="box" data-nid="{{ r.node.id }}"
                           data-candidates="{{ candidatesByNode[r.node.id]|map(c => c.id)|join(' ') }}"
                           data-action="pointerdown->ramification#startDrag click->ramification#suppressIfDragged"
                       {% endif %}>
                        {% if isCurrent %}
                            <text x="{{ b.cx }}" y="{{ b.y - 7 }}" text-anchor="middle" font-size="10" font-weight="700" fill="#4f46e5" letter-spacing="0.3">VOUS ÊTES ICI</text>
                        {% endif %}
                        <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ b.w }}" height="{{ g.boxH }}" rx="10"
                              fill="{{ isCurrent ? '#c7d2fe' : '#eef2ff' }}" stroke="{{ isCurrent ? '#4f46e5' : '#c7d2fe' }}" stroke-width="{{ isCurrent ? 2.5 : 1.5 }}"/>
                        <text x="{{ b.x + b.w / 2 }}" y="{{ b.cy + 4 }}" text-anchor="middle" font-size="13" font-weight="{{ isCurrent ? 700 : 600 }}" fill="#3730a3">{{ r.node.label ?: 'Parcours' }}</text>
                    </a>
                {% endfor %}

                {% if not standalone %}
                    <line data-ramification-target="dragLine" x1="0" y1="0" x2="0" y2="0" stroke="#4f46e5" stroke-width="2.5" stroke-dasharray="6 4"
                          marker-end="url(#pg-arrow)" pointer-events="none" hidden/>
                {% endif %}
            </svg>
        </div>

        {% if standalone %}
            <ul class="mt-4 space-y-1 text-sm">
                {% for r in g.rows %}
                    {% set isCurrent = current and r.node.id == current %}
                    <li class="flex flex-wrap items-center gap-2 rounded-lg px-2 py-1 -mx-2"
                        style="{{ isCurrent ? 'background:var(--c-primary-soft)' : '' }}">
                        <span class="type-badge">{{ ux_icon('ph:compass', {class: 'icon'}) }} Parcours</span>
                        <a href="{{ path('parcours_editor', {fid: formation.id, nid: r.node.id}) }}" class="font-medium hover:underline">{{ r.node.label ?: '—' }}</a>
                        <span class="text-xs text-gray-400">{{ g.unit|lower }}s {{ r.colStart }}–{{ r.colEnd }}</span>
                        {% if r.node.parcoursParent %}<span class="text-xs text-gray-400">· enfant de « {{ r.node.parcoursParent.label ?: '—' }} »</span>{% endif %}
                        {% if isCurrent %}<span class="pill" style="background:var(--c-primary);color:#fff">{{ ux_icon('ph:map-pin', {class: 'icon'}) }} Vous êtes ici</span>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <form method="post" action="{{ path('node_ramification_save', {fid: formation.id}) }}" data-turbo-frame="node-panel" class="mt-4">
                <div class="overflow-auto rounded-xl border" style="border-color:var(--c-border)">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
                            <tr>
                                <th class="text-left px-4 py-2.5">Parcours</th>
                                <th class="text-left px-4 py-2.5">{{ g.unit }} de début</th>
                                <th class="text-left px-4 py-2.5">{{ g.unit }} de fin</th>
                                <th class="text-left px-4 py-2.5">Parcours parent</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for r in g.rows %}
                            {% set isCurrent = current and r.node.id == current %}
                            <tr class="border-t" style="border-color:var(--c-border);{{ isCurrent ? 'background:var(--c-primary-soft)' }}">
                                <td class="px-4 py-2.5">
                                    <span class="type-badge">{{ ux_icon('ph:compass', {class: 'icon'}) }} Parcours</span>
                                    <a href="{{ path('parcours_editor', {fid: formation.id, nid: r.node.id}) }}" class="font-medium hover:underline ml-1">{{ r.node.label ?: '—' }}</a>
                                    {% if isCurrent %}<span class="pill ml-1" style="background:var(--c-primary);color:#fff">{{ ux_icon('ph:map-pin', {class: 'icon'}) }} Vous êtes ici</span>{% endif %}
                                </td>
                                <td class="px-4 py-2.5"><input type="number" min="1" name="periodeDebut[{{ r.node.id }}]" value="{{ r.node.periodeDebut }}" class="fld w-24"></td>
                                <td class="px-4 py-2.5"><input type="number" min="1" name="periodeFin[{{ r.node.id }}]" value="{{ r.node.periodeFin }}" class="fld w-24"></td>
                                <td class="px-4 py-2.5">
                                    <select name="parentId[{{ r.node.id }}]" class="fld" data-ramification-target="parentSelect" data-nid="{{ r.node.id }}">
                                        <option value="">— Aucun (parcours racine) —</option>
                                        {% for cand in candidatesByNode[r.node.id] %}
                                            <option value="{{ cand.id }}" {{ r.node.parcoursParent and r.node.parcoursParent.id == cand.id ? 'selected' }}>{{ cand.label ?: '—' }} · {{ g.unit|lower }}s {{ cand.periodeDebut }}–{{ cand.periodeFin }}</option>
                                        {% endfor %}
                                    </select>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <button class="mt-3 rounded-lg px-4 py-2 text-sm font-semibold text-white" style="background:var(--c-primary)">{{ ux_icon('ph:floppy-disk', {class: 'icon'}) }} Enregistrer la ramification</button>
            </form>
        {% endif %}
        </div>
    {% endif %}
    </div>
</div>
</turbo-frame>
{% endblock %}
