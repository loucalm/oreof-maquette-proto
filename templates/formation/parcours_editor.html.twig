{% extends 'base.html.twig' %}
{% block title %}{{ parcours.displayLabel }} · {{ 'formation.parcours_editor.title_suffix'|trans({}, 'formation') }}{% endblock %}

{% set focus = app.request.query.get('focus') %}
{% set param = app.request.query.get('param') %}
{% set bcc = app.request.query.get('bcc') %}
{% set frameSrc = bcc ? path('bcc_parcours_editor', {fid: formation.id, nid: parcours.id})
    : (param ? path('parcours_param', {fid: formation.id, nid: parcours.id, key: param})
    : (focus ? path('node_panel', {fid: formation.id, nid: focus}) : null)) %}
{% set typeMeta = type_meta() %}
{% set bodyRoot = typeMeta[formation.getChildTypeKey('parcours')] ?? null %}

{% set header_title = parcours.displayLabel %}
{% set header_description = 'formation.parcours_editor.header_description'|trans({'%formation%': formation.name}, 'formation') %}
{% set header_breadcrumb = [
    {label: 'formation.index.breadcrumb_offer'|trans({}, 'formation')},
    {label: 'formation.index.heading'|trans({}, 'formation'), url: path('formation_index')},
    {label: formation.name, url: path('formation_editor', {id: formation.id})},
    {label: parcours.displayLabel},
] %}
{% set header_sticky = false %}

{% block bouton_header %}
    <twig:Button variant="info" :soft="false" :outline="true" icon="ph:eye" :label="'formation.editor.view_sheet'|trans({}, 'formation')" :href="path('formation_view', {id: formation.id})"/>
    <twig:Button variant="success" :soft="false" :outline="true" icon="ph:arrow-left" :label="'formation.parcours_editor.back_to_formation'|trans({}, 'formation')" :href="path('formation_editor', {id: formation.id})"/>
{% endblock %}

{% block body %}
{% include 'formation/_preview_banner.html.twig' %}

{% include 'formation/_formation_header.html.twig' with {mode: 'edit', parcours: parcours} %}

{# ═══ éditeur ═══ #}
<div class="editor-shell grid lg:h-[calc(100vh-var(--topbar-height)-2rem)] min-h-[560px]" data-controller="resizable">
        {{ include('formation/_aside_resizer.html.twig') }}


        {# ─── panneau structure ─── #}
        <div class="editor-aside flex flex-col overflow-hidden"
             data-controller="tree modal treefilter"
             data-modal-auto-open-value="{{ app.request.query.has('derogation') ? 'true' : 'false' }}"
             data-tree-move-url-value="{{ path('node_move', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-dup-url-value="{{ path('node_duplicate', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-del-url-value="{{ path('node_delete', {fid: formation.id, nid: '__ID__'}) }}"
             data-tree-chain-value="{{ formation.effectiveStructure|json_encode|e('html_attr') }}"
             data-tree-type-meta-value="{{ typeMeta|json_encode|e('html_attr') }}"
             data-tree-root-key-value="{{ formation.getChildTypeKey('parcours') }}"
             data-tree-base-parent-value="{{ parcours.id }}">

            {% include 'formation/_aside_head.html.twig' with {title: 'formation.parcours_editor.structure_label'|trans({}, 'formation'), name: parcours.displayLabel, sub: formation.name} %}

            <div class="flex-1 overflow-y-auto">
                <div class="border-b border-secondary-200 px-3 py-3">
                    <p class="mb-2 px-3 text-[10px] font-black uppercase tracking-widest text-secondary-400">{{ 'formation.parcours_editor.param_section_label'|trans({}, 'formation') }}</p>
                    {% include 'formation/_fiche_nav.html.twig' with {items: fiche_nav(formation, parcours, app.request.query.all)} %}
                </div>

                <a href="{{ path('formation_editor', {id: formation.id}) }}"
                   class="mx-3 mt-3 flex items-center gap-2 rounded-2xl border border-primary-200 bg-primary-50 px-3 py-2.5 text-sm font-bold text-primary-700 transition hover:bg-primary-100">
                    {{ ux_icon('ph:arrow-left', {class: 'icon'}) }} {{ 'formation.parcours_editor.back_to_formation'|trans({}, 'formation') }}
                </a>

                <div class="tree-search" role="search">
                    <input type="search" data-treefilter-target="input" placeholder="{{ 'formation.tree.search_placeholder'|trans({}, 'formation') }}"
                           aria-label="{{ 'formation.tree.search_aria'|trans({}, 'formation') }}" class="fld text-sm">
                    <div class="mt-1.5 flex items-center gap-1.5 text-xs">
                        <button type="button" data-treefilter-target="mode" data-mode="all" class="tf-mode">{{ 'formation.tree.filter_all'|trans({}, 'formation') }}</button>
                        <button type="button" data-treefilter-target="mode" data-mode="todo" class="tf-mode">{{ 'formation.tree.filter_todo'|trans({}, 'formation') }}</button>
                        <span class="ml-auto text-secondary-400" data-treefilter-target="count" aria-live="polite"></span>
                    </div>
                    <p data-treefilter-target="empty" hidden class="mt-2 text-xs text-secondary-400">{{ 'formation.tree.search_empty'|trans({}, 'formation') }}</p>
                </div>
                <div class="p-2" data-treefilter-target="tree">
                    {% if roots is not empty %}
                        {{ include('formation/_tree.html.twig', {views: roots, parentId: parcours.id, focus: focus, parentIsChoice: false, parentChoiceLabel: null}) }}
                    {% else %}
                        <p class="text-sm px-2 py-8 text-center text-secondary-400">
                            {{ 'formation.parcours_editor.no_root_note'|trans({'%type%': bodyRoot ? bodyRoot.label|lower : 'formation.parcours_editor.generic_level'|trans({}, 'formation')}, 'formation') }}
                        </p>
                    {% endif %}
                </div>
            </div>

            {# ─── barre d'actions ─── #}
            <div class="flex shrink-0 items-center gap-2 border-t border-secondary-200 bg-secondary-50/60 px-3 py-3">
                <form method="post" action="{{ path('node_add', {fid: formation.id}) }}" data-turbo-frame="_top"
                      class="flex-1" data-tree-target="addForm">
                    <input type="hidden" name="parentId" value="{{ parcours.id }}" data-tree-target="addParent">
                    <input type="hidden" name="typeKey" value="{{ formation.getChildTypeKey('parcours') }}" data-tree-target="addType">
                        <input type="hidden" name="afterId" value="" data-tree-target="addAfter">
                    <button data-tree-target="addButton" class="tree-add-btn">{{ ux_icon('ph:plus', {class: 'icon'}) }} {{ 'common.add'|trans({}, 'common') }} {{ bodyRoot ? ux_icon(bodyRoot.icon, {class: 'icon'}) }} {{ bodyRoot ? bodyRoot.label }}</button>
                </form>

                <button type="button" data-tree-target="addChoiceButton" data-action="tree#addChoiceBloc" hidden
                        class="tree-act-btn tree-act-btn--choice"
                        title="{{ 'formation.editor.add_choice_title'|trans({}, 'formation') }}">{{ ux_icon('ph:shuffle', {class: 'icon'}) }}</button>

                <form method="post" data-turbo-frame="_top" data-tree-target="dupForm">
                    <button type="submit" data-tree-target="dupButton" disabled title="{{ 'formation.editor.duplicate_title'|trans({}, 'formation') }}"
                            class="tree-act-btn">{{ ux_icon('ph:copy', {class: 'icon'}) }}</button>
                </form>
                <form method="post" data-turbo-frame="_top" data-tree-target="delForm"
                      data-controller="confirm" data-confirm-message-value="{{ 'formation.editor.delete_node_confirm'|trans({}, 'formation') }}">
                    <button type="submit" data-tree-target="delButton" disabled title="{{ 'formation.editor.delete_title'|trans({}, 'formation') }}"
                            class="tree-act-btn tree-act-btn-danger">{{ ux_icon('ph:trash', {class: 'icon'}) }}</button>
                </form>
                <button type="button" data-action="modal#open"
                        class="tree-act-btn border-warning-200 bg-warning-50 text-warning-700" title="{{ 'formation.editor.request_derogation_title'|trans({}, 'formation') }}">
                    {{ ux_icon('ph:flag', {class: 'icon'}) }}
                </button>
            </div>

            {% include 'formation/_derogation_modal.html.twig' %}
        </div>

        {# ─── panneau d'édition ─── #}
        <turbo-frame id="node-panel" class="panel-frame min-w-0" refresh="morph"
                     {% if frameSrc %}src="{{ frameSrc }}"{% endif %}>
            {% if not frameSrc %}
                <div class="panel-empty">{{ 'formation.editor.select_prompt'|trans({}, 'formation') }}</div>
            {% endif %}
        </turbo-frame>
</div>
{% endblock %}
