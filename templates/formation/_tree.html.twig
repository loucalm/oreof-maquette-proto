{# Arbre récursif façon maquette Figma. Params : views (list<NodeView>), parentId, focus,
   parentIsChoice, parentChoiceLabel : les enfants directs d'un bloc de choix s'affichent
   SANS indentation supplémentaire (au même niveau que les autres ELP de leur famille,
   choix ou non) — seuls une barre violette et un renvoi textuel signalent leur bloc. #}
<ul class="tree-list {{ parentId is not null ? 'tree-children' : '' }} {{ parentIsChoice ? 'tree-children--choice' }}"
    data-parent-id="{{ parentId ?? '' }}">
    {% for view in views %}
        {% set node = view.node %}
        {% set isChoice = node.isChoiceBloc() %}
        {% set hasChildren = view.children is not empty %}
        {% set canHaveChildren = types_allowed_for(node) is not empty %}
        {% set lockedDel = node.isLocked('delete') %}
        <li data-node-id="{{ node.id }}" data-node-type="{{ node.type.key }}" data-node-host-type="{{ node.getEffectiveHostTypeKey() }}"
            {{ lockedDel ? 'data-locked="1"' }} {{ node.isLocked('move') ? 'data-locked-move="1"' }}>
            <div class="tree-row {{ isChoice ? 'tree-row--choice' }} {{ parentIsChoice ? 'tree-row--choice-alt' }} {{ focus and focus == node.id ~ '' ? 'is-active' }}">
                <span class="drag-handle" title="Glisser pour déplacer">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                <span class="status-dot" data-status="{{ view.status }}"
                      title="{{ view.status == 'ok' ? 'Complet' : (view.status == 'incomplete' ? 'Incomplet' : 'Vide') }}"></span>
                {% if lockedDel %}<span class="tree-lock" title="ELP imposé par le diplôme">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }}</span>{% endif %}
                <span class="type-badge"><span class="opacity-70">{{ ux_icon(node.type.icon, {class: 'icon'}) }}</span> [{{ node.type.label }}]</span>
                {% if view.ref %}<span class="tree-ref" title="Référence calculée">{{ view.ref }}</span>{% endif %}
                <a href="{{ node_url(node) }}" data-turbo-frame="node-panel"
                   class="tree-label">{{ node.label ?: '—' }}</a>
                {% if isChoice %}
                    <span class="choice-count" title="Nombre à choisir parmi les options de ce bloc">{{ node.getAttribute('choiceCount') ?: '?' }} parmi {{ view.children|length }}</span>
                {% elseif parentIsChoice %}
                    <span class="choice-alt-tag" title="Cet ELP est une alternative du bloc de choix « {{ parentChoiceLabel }} »">{{ ux_icon('ph:shuffle', {class: 'icon'}) }} {{ parentChoiceLabel }}</span>
                {% endif %}

                {% if view.ectsTarget %}
                    <span class="tree-ects {{ view.ectsReached ? 'text-green-600' : 'text-gray-400' }}">{{ view.totalEcts|round }}/{{ view.ectsTarget }}</span>
                {% endif %}

                {% if hasChildren %}
                    <button type="button" class="tree-chevron" data-action="tree#toggle" aria-label="Plier/déplier">{{ ux_icon('ph:caret-right', {class: 'icon'}) }}</button>
                {% else %}
                    <span class="tree-chevron-spacer"></span>
                {% endif %}
            </div>
            {% if hasChildren %}
                {{ include('formation/_tree.html.twig', {views: view.children, parentId: node.id, focus: focus, parentIsChoice: isChoice, parentChoiceLabel: isChoice ? node.getDisplayLabel() : null}) }}
            {% elseif canHaveChildren %}
                {# nœud non-feuille encore vide : zone de dépôt pour le glisser-déposer #}
                <ul class="tree-list tree-children tree-list--empty {{ isChoice ? 'tree-children--choice' }}"
                    data-parent-id="{{ node.id }}"></ul>
            {% endif %}
        </li>
    {% endfor %}
</ul>
