{# Arbre récursif façon maquette Figma. Params : views (list<NodeView>), parentId, focus,
   parentIsChoice, parentChoiceLabel : les enfants directs d'un bloc de choix s'affichent
   SANS indentation supplémentaire (au même niveau que les autres ELP de leur famille,
   choix ou non) — seuls une barre violette et un renvoi textuel signalent leur bloc. #}
<ul class="tree-list {{ parentId is not null ? 'tree-children' : '' }} {{ parentIsChoice ? 'tree-children--choice' }}"
    data-parent-id="{{ parentId ?? '' }}">
    {% for view in views %}
        {% set node = view.node %}
        {% set isChoice = node.isChoiceBloc() %}
        {% set hasChildren = view.children is not empty %}
        {% set canHaveChildren = types_allowed_for(node) is not empty %}
        {% set lockedDel = node.isLocked('delete') %}
        <li data-node-id="{{ node.id }}" data-node-type="{{ node.type.key }}" data-node-host-type="{{ node.getEffectiveHostTypeKey() }}"
            {{ lockedDel ? 'data-locked="1"' }} {{ node.isLocked('move') ? 'data-locked-move="1"' }} {{ node.isLocked('add') ? 'data-locked-add="1"' }}>
            <div class="tree-row {{ isChoice ? 'tree-row--choice' }} {{ parentIsChoice ? 'tree-row--choice-alt' }} {{ focus and focus == node.id ~ '' ? 'is-active' }}">
                <span class="drag-handle" title="{{ 'formation.tree.drag_title'|trans({}, 'formation') }}">{{ ux_icon('ph:dots-six-vertical', {class: 'icon'}) }}</span>
                <span class="status-dot" data-status="{{ view.status }}"
                      title="{{ view.status == 'ok' ? 'formation.index.bcc_complete'|trans({}, 'formation') : (view.status == 'incomplete' ? 'formation.index.bcc_incomplete'|trans({}, 'formation') : 'formation.index.bcc_empty'|trans({}, 'formation')) }}"></span>
                {% if lockedDel %}<span class="tree-lock" title="{{ 'formation.tree.locked_title'|trans({}, 'formation') }}">{{ ux_icon('ph:lock-simple-fill', {class: 'icon'}) }}</span>{% endif %}
                <span class="type-badge"><span class="opacity-70">{{ ux_icon(node.type.icon, {class: 'icon'}) }}</span> [{{ node.type.label }}]</span>
                {% if view.ref %}<span class="tree-ref" title="{{ 'formation.tree.ref_title'|trans({}, 'formation') }}">{{ view.ref }}</span>{% endif %}
                <a href="{{ node_url(node) }}" data-turbo-frame="node-panel"
                   class="tree-label">{{ node.type.temporel ? node_display_label(node, view.ref) : (node.label ?: '—') }}</a>
                {% if isChoice %}
                    <span class="choice-count" title="{{ 'formation.tree.choice_count_title'|trans({}, 'formation') }}">{{ 'formation.tree.choice_count'|trans({'%chosen%': node.getAttribute('choiceCount') ?: '?', '%total%': view.children|length}, 'formation') }}</span>
                {% elseif parentIsChoice %}
                    <span class="choice-alt-tag" title="{{ 'formation.tree.choice_alt_title'|trans({'%label%': parentChoiceLabel}, 'formation') }}">{{ ux_icon('ph:shuffle', {class: 'icon'}) }} {{ parentChoiceLabel }}</span>
                {% endif %}

                {% set gap = view.ectsTarget ? view.totalEcts - view.ectsTarget : 0 %}
                {% set hoursTitle = 'formation.tree.hours_title'|trans({'%h%': view.totalHours|round(1)}, 'formation') %}
                {% if view.ectsTarget %}
                    <span class="tree-ects {{ view.ectsReached ? 'text-green-600' : (view.totalEcts > 0 ? 'text-amber-600' : 'text-gray-400') }}"
                          title="{{ view.ectsReached ? hoursTitle : (gap < 0 ? 'formation.tree.ects_missing_title' : 'formation.tree.ects_excess_title')|trans({'%gap%': gap|abs|round(1)}, 'formation') ~ ' · ' ~ hoursTitle }}">{{ view.totalEcts|round(1) }}/{{ view.ectsTarget }}{% if not view.ectsReached and view.totalEcts > 0 %} <span class="tree-gap">({{ gap > 0 ? '+' }}{{ gap|round(1) }})</span>{% endif %}</span>
                {% elseif view.totalEcts > 0 or view.totalHours > 0 %}
                    <span class="tree-ects text-gray-400" title="{{ hoursTitle }}">{% if view.totalEcts > 0 %}{{ view.totalEcts|round(1) }} ECTS{% endif %}{% if view.totalHours > 0 %}{{ view.totalEcts > 0 ? ' · ' }}{{ view.totalHours|round }}h{% endif %}</span>
                {% endif %}

                {% if hasChildren %}
                    <button type="button" class="tree-chevron" data-action="tree#toggle" aria-label="{{ 'formation.tree.toggle_aria'|trans({}, 'formation') }}">{{ ux_icon('ph:caret-right', {class: 'icon'}) }}</button>
                {% else %}
                    <span class="tree-chevron-spacer"></span>
                {% endif %}
            </div>
            {% if hasChildren %}
                {{ include('formation/_tree.html.twig', {views: view.children, parentId: node.id, focus: focus, parentIsChoice: isChoice, parentChoiceLabel: isChoice ? node.getDisplayLabel() : null}) }}
            {% elseif canHaveChildren %}
                {# nœud non-feuille encore vide : zone de dépôt pour le glisser-déposer #}
                <ul class="tree-list tree-children tree-list--empty {{ isChoice ? 'tree-children--choice' }}"
                    data-parent-id="{{ node.id }}"></ul>
            {% endif %}
        </li>
    {% endfor %}
</ul>
